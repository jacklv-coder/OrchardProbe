      unless malformed_xcodegen_rejected
        UI.user_error!("Unversioned XcodeGen evidence was accepted.")
      end

      complete_evidence_directory = File.join(
        workspace,
        "CompleteEvidence"
      )
      Dir.mkdir(complete_evidence_directory, 0o700)
      complete_ipa = File.join(
        complete_evidence_directory,
        "DemoLab-1.ipa"
      )
      FileUtils.cp(check_ipa, complete_ipa)
      complete_archive_applications = File.join(
        complete_evidence_directory,
        "DemoLab.xcarchive",
        "Products",
        "Applications"
      )
      FileUtils.mkdir_p(complete_archive_applications)
      FileUtils.cp_r(application, complete_archive_applications)
      complete_evidence_path = File.join(
        complete_evidence_directory,
        "demolab-pre-upload-evidence.json"
      )
      File.write(
        complete_evidence_path,
        "#{JSON.generate(complete_evidence)}\n"
      )
      File.chmod(0o600, complete_evidence_path)
      previous_evidence = ENV["DEMO_LAB_EVIDENCE_PATH"]
      ENV["DEMO_LAB_EVIDENCE_PATH"] = complete_evidence_path
      begin
        app_identifier_was_set = ENV.key?("DEMO_LAB_APP_BUNDLE_ID")
        share_identifier_was_set = ENV.key?("DEMO_LAB_SHARE_BUNDLE_ID")
        previous_app_identifier = ENV.delete("DEMO_LAB_APP_BUNDLE_ID")
        previous_share_identifier = ENV.delete("DEMO_LAB_SHARE_BUNDLE_ID")
        begin
          reconciliation_evidence_path, reconciliation_evidence =
            load_demolab_evidence
          unless reconciliation_evidence_path == complete_evidence_path &&
                 reconciliation_evidence == complete_evidence
            UI.user_error!(
              "DemoLab reconciliation evidence did not round-trip."
            )
          end
        ensure
          if app_identifier_was_set
            ENV["DEMO_LAB_APP_BUNDLE_ID"] = previous_app_identifier
          end
          if share_identifier_was_set
            ENV["DEMO_LAB_SHARE_BUNDLE_ID"] = previous_share_identifier
          end
        end

        loaded_evidence_path, loaded_evidence, loaded_ipa, loaded_archive =
          load_upload_evidence(
            app_identifier: "com.example.orchardprobe.demolab",
            share_identifier: "com.example.orchardprobe.demolab.share",
            xcode_toolchain: xcode_toolchain
          )
        unless loaded_evidence_path == complete_evidence_path &&
               loaded_evidence == complete_evidence &&
               loaded_ipa == complete_ipa &&
               loaded_archive == File.join(
                 complete_evidence_directory,
                 "DemoLab.xcarchive"
               )
          UI.user_error!("Complete DemoLab upload evidence did not round-trip.")
        end

        archive_main_binary = demolab_archive_binary_inputs(
          loaded_archive
        ).first.first
        original_archive_main = File.binread(archive_main_binary)
        archive_revalidation_rejected = false
        begin
          File.open(archive_main_binary, "ab") { |file| file.write("changed") }
          verify_evidence_bound_archive!(
            loaded_archive,
            loaded_evidence,
            xcode_toolchain: xcode_toolchain
          )
        rescue FastlaneCore::Interface::FastlaneError
          archive_revalidation_rejected = true
        ensure
          File.binwrite(archive_main_binary, original_archive_main)
        end
        unless archive_revalidation_rejected
          UI.user_error!(
            "A post-load DemoLab archive change passed upload revalidation."
          )
        end
      ensure
        if previous_evidence
          ENV["DEMO_LAB_EVIDENCE_PATH"] = previous_evidence
        else
          ENV.delete("DEMO_LAB_EVIDENCE_PATH")
        end
      end

      altered_archive = JSON.parse(JSON.generate(complete_evidence))
      altered_archive["artifacts"]["archive_binaries"][0]["sha256"] =
        "0" * 64
      altered_archive_path = File.join(
        complete_evidence_directory,
        "altered-archive-evidence.json"
