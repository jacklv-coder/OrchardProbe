        expected_binaries[1],
        xcode_toolchain: xcode_toolchain
      )
      invalid_framework_path =
        "/Library/Frameworks/DemoFramework.framework/DemoFramework"
      invalid_linkage = "fixture:\n#{invalid_framework_path}\n"
