def repository_root
  File.expand_path("..", __dir__)
end

def command_output(*command, chdir: repository_root)
  stdout, stderr, status = Open3.capture3(
    sanitized_dynamic_loader_environment,
    *command,
    chdir: chdir
  )
  return stdout.strip if status.success?

  UI.user_error!(
    "Command failed (#{command.shelljoin}):\n#{stderr.strip}"
  )
end

def command_output_with_environment(environment, *command, chdir: repository_root)
  stdout, stderr, status = Open3.capture3(
    sanitized_dynamic_loader_environment(environment),
    *command,
    chdir: chdir
  )
  return stdout.strip if status.success?

  UI.user_error!(
    "Command failed (#{command.shelljoin}):\n#{stderr.strip}"
  )
end

def sanitized_dynamic_loader_environment(additional = {})
  sanitized = additional.dup
  (ENV.keys | additional.keys).each do |key|
    if DEMO_LAB_DYNAMIC_LOADER_ENVIRONMENT_PATTERNS.any? { |pattern| pattern.match?(key) }
      sanitized[key] = nil
    end
  end
  sanitized
end

def command_output_without_loader_overrides(*command, chdir: repository_root)
  command_output_with_environment(
    sanitized_dynamic_loader_environment,
    *command,
    chdir: chdir
  )
end

def git_command_output(*arguments)
  command_output_with_environment(
    DEMO_LAB_XCODE_OVERRIDE_KEYS.to_h { |key| [key, nil] },
    "/usr/bin/git",
    *arguments
  )
end

def pinned_executable(path, label, required_root: nil)
  unless Pathname.new(path).absolute?
    UI.user_error!("#{label} path must be absolute.")
  end
  resolved = File.realpath(path)
  if required_root
    root = File.realpath(required_root)
    unless resolved.start_with?("#{root}#{File::SEPARATOR}")
      UI.user_error!("#{label} escaped the selected Xcode.")
    end
  end
  stat = File.stat(resolved)
  unless stat.file? &&
         File.executable?(resolved) &&
         stat.uid.zero? &&
         (stat.mode & 0o022).zero?
    UI.user_error!("#{label} must be a root-owned, non-writable executable.")
  end
  {
    "path" => resolved,
    "identity" => [
      stat.dev,
      stat.ino,
      stat.size,
      stat.mtime.to_i,
      Digest::SHA256.file(resolved).hexdigest,
    ],
  }
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT
  UI.user_error!("Unable to resolve #{label} safely.")
end

def selected_xcode_toolchain
  developer_dir_output = command_output_with_environment(
    { "DEVELOPER_DIR" => nil },
    "/usr/bin/xcode-select",
    "--print-path"
  )
  unless Pathname.new(developer_dir_output).absolute?
    UI.user_error!("The selected Xcode developer directory must be absolute.")
  end
  developer_dir = File.realpath(developer_dir_output)
  contents_dir = File.dirname(developer_dir)
  xcode_bundle_root = File.realpath(File.dirname(contents_dir))
  unless File.basename(developer_dir) == "Developer" &&
         File.basename(contents_dir) == "Contents" &&
         File.basename(xcode_bundle_root).end_with?(".app")
    UI.user_error!("The selected developer directory is not inside an Xcode app.")
  end
  developer_stat = File.stat(developer_dir)
  bundle_stat = File.stat(xcode_bundle_root)
  unless developer_stat.directory? &&
         developer_stat.uid.zero? &&
         (developer_stat.mode & 0o022).zero? &&
         bundle_stat.directory? &&
         bundle_stat.uid.zero? &&
         (bundle_stat.mode & 0o022).zero?
    UI.user_error!(
      "The selected Xcode app and developer directory must be root-owned and non-writable."
    )
  end

  xcodebuild = pinned_executable(
    File.join(developer_dir, "usr", "bin", "xcodebuild"),
    "Selected Xcode xcodebuild",
    required_root: developer_dir
  )
  xcrun = pinned_executable("/usr/bin/xcrun", "System xcrun")
  plutil = pinned_executable("/usr/bin/plutil", "System plutil")
  environment = sanitized_dynamic_loader_environment(
    "DEVELOPER_DIR" => developer_dir,
    "PATH" =>
      "#{File.dirname(xcodebuild.fetch('path'))}:#{DEMO_LAB_PINNED_SYSTEM_PATH}",
    "SDKROOT" => nil,
    "TOOLCHAINS" => nil,
    "XCODE_XCCONFIG_FILE" => nil
  )
  dwarfdump_path = command_output_with_environment(
    environment,
    xcrun.fetch("path"),
    "--find",
    "dwarfdump"
  )
  lipo_path = command_output_with_environment(
    environment,
    xcrun.fetch("path"),
    "--find",
    "lipo"
  )
  otool_path = command_output_with_environment(
    environment,
    xcrun.fetch("path"),
    "--find",
    "otool"
  )
  dwarfdump = pinned_executable(
    dwarfdump_path,
    "Selected Xcode dwarfdump",
    required_root: developer_dir
  )
  lipo = pinned_executable(
    lipo_path,
    "Selected Xcode lipo",
    required_root: developer_dir
  )
  otool = pinned_executable(
    otool_path,
    "Selected Xcode otool",
    required_root: developer_dir
  )
  toolchain_binary_directories = [
    File.dirname(dwarfdump.fetch("path")),
    File.dirname(lipo.fetch("path")),
    File.dirname(otool.fetch("path")),
  ].uniq
  toolchain_binary_directories.each do |directory|
    resolved_directory = File.realpath(directory)
    directory_stat = File.stat(resolved_directory)
    unless resolved_directory.start_with?(
      "#{developer_dir}#{File::SEPARATOR}"
    ) &&
           directory_stat.directory? &&
           directory_stat.uid.zero? &&
           (directory_stat.mode & 0o022).zero?
      UI.user_error!(
        "Selected Xcode toolchain binary directories must be root-owned and non-writable."
      )
    end
  end
  environment["PATH"] = [
    *toolchain_binary_directories,
    File.dirname(xcodebuild.fetch("path")),
    DEMO_LAB_PINNED_SYSTEM_PATH,
  ].uniq.join(File::PATH_SEPARATOR)
  xcode_version = command_output_with_environment(
    environment,
    xcodebuild.fetch("path"),
    "-version"
  ).lines
  unless xcode_version.length == 2 &&
         xcode_version.all? { |line| !line.strip.empty? && line.bytesize <= 256 }
    UI.user_error!("The selected Xcode returned an unexpected version.")
  end

  {
    "xcode_bundle_root" => xcode_bundle_root,
    "xcode_bundle_identity" => [
      bundle_stat.dev,
      bundle_stat.ino,
      bundle_stat.mtime.to_i,
    ],
    "developer_dir" => developer_dir,
    "developer_dir_identity" => [
      developer_stat.dev,
      developer_stat.ino,
      developer_stat.mtime.to_i,
    ],
    "environment" => environment,
    "xcodebuild" => xcodebuild,
    "xcrun" => xcrun,
    "plutil" => plutil,
    "dwarfdump" => dwarfdump,
    "lipo" => lipo,
    "otool" => otool,
    "xcode_version" => xcode_version,
    "iphoneos_sdk_version" => command_output_with_environment(
      environment,
      xcrun.fetch("path"),
      "--sdk",
      "iphoneos",
      "--show-sdk-version"
    ),
    "iphoneos_sdk_build" => command_output_with_environment(
      environment,
      xcrun.fetch("path"),
      "--sdk",
      "iphoneos",
      "--show-sdk-build-version"
    ),
  }
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT
  UI.user_error!("Unable to resolve the selected Xcode safely.")
end

def verify_selected_xcode_toolchain!(toolchain)
  bundle_stat = File.stat(toolchain.fetch("xcode_bundle_root"))
  observed_bundle_identity = [
    bundle_stat.dev,
    bundle_stat.ino,
    bundle_stat.mtime.to_i,
  ]
  unless observed_bundle_identity == toolchain.fetch("xcode_bundle_identity")
    UI.user_error!("The selected Xcode app changed during use.")
  end

  developer_stat = File.stat(toolchain.fetch("developer_dir"))
  observed_developer_identity = [
    developer_stat.dev,
    developer_stat.ino,
    developer_stat.mtime.to_i,
  ]
  unless observed_developer_identity == toolchain.fetch(
    "developer_dir_identity"
  )
    UI.user_error!("The selected Xcode developer directory changed during use.")
  end

  %w[xcodebuild xcrun plutil dwarfdump lipo otool].each do |name|
    executable = toolchain.fetch(name)
    observed = pinned_executable(
      executable.fetch("path"),
      "Pinned #{name}",
      required_root: %w[xcodebuild dwarfdump lipo otool].include?(name) ?
        toolchain.fetch("developer_dir") : nil
    )
    unless observed == executable
      UI.user_error!("The pinned #{name} executable changed during use.")
    end
  end

  environment = toolchain.fetch("environment")
  observed_xcode_version = command_output_with_environment(
    environment,
    toolchain.dig("xcodebuild", "path"),
    "-version"
  ).lines
  observed_sdk_version = command_output_with_environment(
    environment,
    toolchain.dig("xcrun", "path"),
    "--sdk",
    "iphoneos",
    "--show-sdk-version"
  )
  observed_sdk_build = command_output_with_environment(
    environment,
    toolchain.dig("xcrun", "path"),
    "--sdk",
    "iphoneos",
    "--show-sdk-build-version"
  )
  unless observed_xcode_version == toolchain.fetch("xcode_version") &&
         observed_sdk_version == toolchain.fetch("iphoneos_sdk_version") &&
         observed_sdk_build == toolchain.fetch("iphoneos_sdk_build")
    UI.user_error!("The selected Xcode metadata changed during use.")
  end
  true
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT
  UI.user_error!("Unable to revalidate the selected Xcode safely.")
end

def with_pinned_xcode_environment(toolchain)
  environment = toolchain.fetch("environment")
  previous = {}
  environment.each_key do |key|
    previous[key] = ENV.key?(key) ? [true, ENV[key]] : [false, nil]
  end
  environment.each do |key, value|
    value.nil? ? ENV.delete(key) : ENV[key] = value
  end
  yield
ensure
  previous&.each do |key, (existed, value)|
    existed ? ENV[key] = value : ENV.delete(key)
  end
end

def required_environment(name, pattern: nil)
  value = ENV[name]&.strip
  UI.user_error!("Set #{name} before running this lane.") if value.nil? || value.empty?
  if pattern && !pattern.match?(value)
    UI.user_error!("#{name} has an invalid format.")
  end
  value
end

def valid_utc_timestamp?(value)
  return false unless value.is_a?(String) && value.end_with?("Z")

  !Time.iso8601(value).nil?
rescue ArgumentError
  false
end

def ensure_tool(name)
  command_output("/usr/bin/which", name)
end

def selected_xcodegen
  discovered = ensure_tool("xcodegen")
  unless Pathname.new(discovered).absolute?
    UI.user_error!("The selected XcodeGen path must be absolute.")
  end
  resolved = File.realpath(discovered)
  before = File.stat(resolved)
  unless before.file? &&
         File.executable?(resolved) &&
         (before.mode & 0o222).zero?
    UI.user_error!("The selected XcodeGen must be a non-writable executable.")
  end
  architecture = command_output("/usr/bin/uname", "-m")
  trusted_binaries = DEMO_LAB_TRUSTED_XCODEGEN_BINARIES[architecture]
  UI.user_error!("This architecture has no trusted XcodeGen binary.") unless trusted_binaries
  observed_sha256 = Digest::SHA256.file(resolved).hexdigest
  expected_version = trusted_binaries[observed_sha256]
  unless expected_version
    UI.user_error!(
      "The selected XcodeGen binary is not in the reviewed content allowlist."
    )
  end

  after_path = File.realpath(discovered)
  after = File.stat(resolved)
  after_sha256 = Digest::SHA256.file(resolved).hexdigest
  unless after_path == resolved &&
         after.file? &&
         File.executable?(resolved) &&
         (after.mode & 0o222).zero? &&
         [after.dev, after.ino, after.size, after.mtime.to_i, after_sha256] ==
           [
             before.dev,
             before.ino,
             before.size,
             before.mtime.to_i,
             observed_sha256,
           ]
    UI.user_error!("The selected XcodeGen changed while it was being verified.")
  end
  [
    resolved,
    expected_version,
    [
      before.dev,
      before.ino,
      before.size,
      before.mtime.to_i,
      observed_sha256,
    ],
  ]
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT
  UI.user_error!("Unable to resolve the selected XcodeGen safely.")
end

def verify_locked_xcodegen_snapshot!(
  snapshot,
  snapshot_path,
  expected_identity,
  workspace_identity
)
  current_workspace_identity = private_directory_identity!(
    File.dirname(snapshot_path),
    "XcodeGen snapshot workspace"
  )
  opened = snapshot.stat
  path_stat = File.lstat(snapshot_path)
  access_mode = snapshot.fcntl(Fcntl::F_GETFL) & Fcntl::O_ACCMODE
  observed_identity = [
    opened.dev,
    opened.ino,
    opened.size,
    opened.mtime.to_i,
    digest_open_file(snapshot),
  ]
  unless current_workspace_identity == workspace_identity &&
         opened.file? &&
         opened.uid == Process.uid &&
         (opened.mode & 0o777) == 0o500 &&
         access_mode == Fcntl::O_RDONLY &&
         !path_stat.symlink? &&
         path_stat.dev == opened.dev &&
         path_stat.ino == opened.ino &&
         observed_identity == expected_identity
    UI.user_error!("The locked XcodeGen snapshot changed during generation.")
  end
  true
rescue Errno::EACCES, Errno::EBADF, Errno::ELOOP, Errno::ENOENT, Errno::ENOTDIR
  UI.user_error!("Unable to verify the locked XcodeGen snapshot safely.")
end

def stage_locked_xcodegen_snapshot!(
  source_path,
  source_identity,
  expected_version,
  workspace
)
  workspace_identity = private_directory_identity!(
    workspace,
    "XcodeGen snapshot workspace"
  )
  snapshot_path = File.join(
    workspace_identity.first,
    ".xcodegen-#{SecureRandom.hex(12)}"
  )
  source = nil
  writable_snapshot = nil
  locked_snapshot = nil

  begin
    source_flags = File::RDONLY | File::NONBLOCK
    source_flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
    source = File.open(source_path, source_flags)
    source_before = source.stat
    source_path_stat = File.lstat(source_path)
    source_hash = digest_open_file(source)
    observed_source_identity = [
      source_before.dev,
      source_before.ino,
      source_before.size,
      source_before.mtime.to_i,
      source_hash,
    ]
    unless source_before.file? &&
           (source_before.mode & 0o111).positive? &&
           (source_before.mode & 0o222).zero? &&
           !source_path_stat.symlink? &&
           source_path_stat.dev == source_before.dev &&
           source_path_stat.ino == source_before.ino &&
           observed_source_identity == source_identity
      UI.user_error!("The selected XcodeGen changed before private staging.")
    end

    destination_flags = File::WRONLY | File::CREAT | File::EXCL
    destination_flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
    writable_snapshot = File.open(snapshot_path, destination_flags, 0o600)
    copied = IO.copy_stream(source, writable_snapshot, source_before.size + 1)
    source_after = source.stat
    unless copied == source_before.size &&
           [
             source_after.dev,
             source_after.ino,
             source_after.size,
             source_after.mtime.to_i,
             digest_open_file(source),
           ] == source_identity
      UI.user_error!("The selected XcodeGen changed while being privately staged.")
    end
    writable_snapshot.flush
    writable_snapshot.fsync
    writable_snapshot.chmod(0o500)
    writable_snapshot.close
    writable_snapshot = nil

    snapshot_flags = File::RDONLY | File::NONBLOCK
    snapshot_flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
    locked_snapshot = File.open(snapshot_path, snapshot_flags)
    unless locked_snapshot.flock(File::LOCK_EX | File::LOCK_NB)
      UI.user_error!("Unable to lock the private XcodeGen snapshot.")
    end
    snapshot_stat = locked_snapshot.stat
    snapshot_identity = [
      snapshot_stat.dev,
      snapshot_stat.ino,
      snapshot_stat.size,
      snapshot_stat.mtime.to_i,
      digest_open_file(locked_snapshot),
    ]
    unless snapshot_stat.size == source_before.size &&
           snapshot_identity.last == source_hash
      UI.user_error!("The private XcodeGen snapshot does not match its source.")
    end
    verify_locked_xcodegen_snapshot!(
      locked_snapshot,
      snapshot_path,
      snapshot_identity,
      workspace_identity
    )

    output = command_output_without_loader_overrides(snapshot_path, "--version")
    match = output.match(/\AVersion: ([0-9]+\.[0-9]+\.[0-9]+)\z/)
    unless match && match[1] == expected_version
      UI.user_error!("The private XcodeGen snapshot returned an unexpected version.")
    end
    verify_locked_xcodegen_snapshot!(
      locked_snapshot,
      snapshot_path,
      snapshot_identity,
      workspace_identity
    )
    [locked_snapshot, snapshot_path, snapshot_identity, workspace_identity]
  rescue
    if locked_snapshot
      locked_snapshot.flock(File::LOCK_UN) rescue nil
      locked_snapshot.close rescue nil
    end
    FileUtils.rm_f(snapshot_path)
    raise
  ensure
    source.close if source && !source.closed?
    if writable_snapshot && !writable_snapshot.closed?
      writable_snapshot.close
    end
  end
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT, Errno::ENOTDIR
  UI.user_error!("Unable to stage the selected XcodeGen safely.")
end

def ensure_clean_source!
  root = git_command_output("rev-parse", "--show-toplevel")
  unless File.realpath(root) == File.realpath(repository_root)
    UI.user_error!("Run Fastlane from this OrchardProbe checkout.")
  end

  status = git_command_output(
    "status",
    "--porcelain=v1",
    "--untracked-files=all"
  )
  UI.user_error!("Commit or remove every local change before creating evidence.") unless status.empty?
end

def ensure_manual_lane!
  detected_ci_keys = DEMO_LAB_CI_ENVIRONMENT_KEYS.select { |key| ENV.key?(key) }
  unless detected_ci_keys.empty?
    UI.user_error!(
      "Controlled signing and upload lanes must never run in CI " \
      "(detected #{detected_ci_keys.join(', ')})."
    )
  end

  confirmation = required_environment("DEMO_LAB_CONFIRM_LOCAL_MANUAL_RUN")
  unless confirmation == DEMO_LAB_LOCAL_RUN_CONFIRMATION
    UI.user_error!("Explicit local manual-run confirmation is missing.")
  end
end

def reject_pilot_environment_overrides!
  overrides = ENV.keys.select do |key|
    key.start_with?("PILOT_") || key == "DEMO_ACCOUNT_REQUIRED"
  end.sort
  return if overrides.empty?

  UI.user_error!(
    "Unset every Pilot-affecting variable before the controlled upload " \
    "(detected #{overrides.join(', ')})."
  )
end

def reject_gym_environment_overrides!
  overrides = ENV.keys.grep(/\AGYM_/).sort
  return if overrides.empty?

  UI.user_error!(
    "Unset every GYM_* variable before the controlled archive " \
    "(detected #{overrides.join(', ')})."
  )
end

def reject_repository_path!(path, label)
  root = File.realpath(repository_root)
  if path == root || path.start_with?("#{root}#{File::SEPARATOR}")
    UI.user_error!("#{label} must stay outside the Git checkout.")
  end
end

def ensure_outside_repository!(path, label)
  resolved = File.realpath(path)
  reject_repository_path!(resolved, label)
  resolved
end

def validate_regular_file_beneath_root!(path, root, label)
  expanded_root = File.expand_path(root)
  root_lstat = File.lstat(expanded_root)
  unless root_lstat.directory? && !root_lstat.symlink?
    UI.user_error!("#{label} root must be a non-symlink directory.")
  end
  resolved_root = File.realpath(expanded_root)
  expanded_path = File.expand_path(path)
  unless expanded_path.start_with?("#{expanded_root}#{File::SEPARATOR}")
    UI.user_error!("#{label} escaped its expected root.")
  end
  relative = Pathname.new(expanded_path).relative_path_from(
    Pathname.new(expanded_root)
  )
  components = relative.each_filename.to_a
  if components.empty? ||
     components.any? { |component| component.empty? || %w[. ..].include?(component) }
    UI.user_error!("#{label} has an unsafe relative path.")
  end

  current = resolved_root
  components.each_with_index do |component, index|
    current = File.join(current, component)
    stat = File.lstat(current)
    UI.user_error!("#{label} contains a symbolic-link component.") if stat.symlink?
    if index == components.length - 1
      UI.user_error!("#{label} must be a regular file.") unless stat.file?
    else
      UI.user_error!("#{label} ancestor must be a directory.") unless stat.directory?
    end
  end
  resolved_path = File.realpath(current)
  unless resolved_path.start_with?("#{resolved_root}#{File::SEPARATOR}")
    UI.user_error!("#{label} resolved outside its expected root.")
  end
  resolved_path
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT, Errno::ENOTDIR
  UI.user_error!("Unable to validate #{label} beneath its expected root.")
end

def validate_creatable_external_directory!(path, label)
  expanded = File.expand_path(path)
  reject_repository_path!(expanded, label)

  existing_ancestor = expanded
  until File.exist?(existing_ancestor) || File.symlink?(existing_ancestor)
    parent = File.dirname(existing_ancestor)
    UI.user_error!("Unable to resolve #{label}.") if parent == existing_ancestor
    existing_ancestor = parent
  end
  resolved_ancestor = File.realpath(existing_ancestor)
  suffix = Pathname.new(expanded).relative_path_from(
    Pathname.new(existing_ancestor)
  )
  resolved_candidate = File.expand_path(suffix.to_s, resolved_ancestor)
  reject_repository_path!(resolved_candidate, label)
  expanded
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT
  UI.user_error!("Unable to resolve #{label} safely.")
end

def private_directory_identity!(path, label)
  stat = File.lstat(path)
  UI.user_error!("#{label} must not be a symbolic link.") if stat.symlink?
  UI.user_error!("#{label} must name a directory.") unless stat.directory?
  unless stat.uid == Process.uid
    UI.user_error!("#{label} must be owned by the current user.")
  end
  unless (stat.mode & 0o777) == 0o700
    UI.user_error!("#{label} must already have mode 0700.")
  end
  resolved = ensure_outside_repository!(path, label)
  [resolved, stat.dev, stat.ino]
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT
  UI.user_error!("Unable to validate #{label} safely.")
end

def verify_private_directory!(path, label)
  private_directory_identity!(path, label).first
end

def validate_fastlane_path_characters!(path, label)
  unsafe_bytes = path.each_byte.any? { |byte| byte < 0x20 || byte == 0x7f }
  if path.include?("'") || unsafe_bytes
    UI.user_error!("#{label} contains characters unsafe for Fastlane shell paths.")
  end
  path
end

def create_exclusive_private_directory!(
  path,
  label,
  private_parent_identity: nil
)
  validated_path = validate_creatable_external_directory!(path, label)
  parent = File.dirname(validated_path)
  unless File.directory?(parent) && !File.symlink?(parent)
    UI.user_error!("#{label} parent must be an existing non-symlink directory.")
  end
  parent_identity = if private_parent_identity
                      observed_identity = private_directory_identity!(
                        parent,
                        "#{label} parent"
                      )
                      unless observed_identity == private_parent_identity
                        UI.user_error!("#{label} parent changed before reservation.")
                      end
                      observed_identity
                    end

  begin
    Dir.mkdir(validated_path, 0o700)
  rescue Errno::EEXIST, Errno::ELOOP
    UI.user_error!("Refusing to reuse an existing #{label}.")
  rescue Errno::EACCES, Errno::ENOENT, Errno::ENOTDIR
    UI.user_error!("Unable to create #{label} safely.")
  end

  if parent_identity
    current_parent_identity = private_directory_identity!(
      parent,
      "#{label} parent"
    )
    unless current_parent_identity == parent_identity
      UI.user_error!(
        "#{label} parent changed while the directory was being reserved."
      )
    end
  end
  private_directory_identity!(validated_path, label)
end

def private_output_directory
  raw_path = required_environment("DEMO_LAB_OUTPUT_DIR")
  unless Pathname.new(raw_path).absolute?
    UI.user_error!("DEMO_LAB_OUTPUT_DIR must be an absolute path.")
  end

  expanded = File.expand_path(raw_path)
  validate_fastlane_path_characters!(expanded, "DEMO_LAB_OUTPUT_DIR")
  reject_repository_path!(expanded, "DEMO_LAB_OUTPUT_DIR")
  unless File.exist?(expanded) || File.symlink?(expanded)
    UI.user_error!(
      "DEMO_LAB_OUTPUT_DIR must be created as a private directory before the lane runs."
    )
  end
  identity = private_directory_identity!(expanded, "DEMO_LAB_OUTPUT_DIR")
  validate_fastlane_path_characters!(identity.first, "Resolved DEMO_LAB_OUTPUT_DIR")
  identity
end

def with_locked_private_directory(path, expected_identity, label)
  flags = File::RDONLY
  flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
  handle = File.open(path, flags)
  observed = handle.stat
  unless observed.directory? &&
         observed.uid == Process.uid &&
         (observed.mode & 0o777) == 0o700 &&
         [File.realpath(path), observed.dev, observed.ino] == expected_identity
    UI.user_error!("#{label} changed before it could be locked.")
  end
  unless handle.flock(File::LOCK_EX | File::LOCK_NB)
    UI.user_error!("#{label} is already in use by another controlled lane.")
  end

  begin
    yield handle
  ensure
    handle.flock(File::LOCK_UN)
    handle.close
  end
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT
  UI.user_error!("Unable to lock #{label} safely.")
end

def verify_locked_directory!(
  handle,
  path,
  expected_identity,
  label
)
  held = handle.stat
  current = private_directory_identity!(path, label)
  unless held.directory? &&
         held.uid == Process.uid &&
         (held.mode & 0o777) == 0o700 &&
         [current[0], held.dev, held.ino] == expected_identity &&
         current == expected_identity
    UI.user_error!("#{label} changed during the controlled operation.")
  end
  current
end

def rename_exclusive_no_follow!(source, destination, label)
  flags = DemoLabDarwin::RENAME_EXCL | DemoLabDarwin::RENAME_NOFOLLOW_ANY
  return if DemoLabDarwin.renamex_np(source, destination, flags).zero?

  error = SystemCallError.new("renamex_np", Fiddle.last_error)
  if error.is_a?(Errno::EEXIST)
    UI.user_error!("Refusing to overwrite an existing #{label}.")
  end
  UI.user_error!("Unable to publish #{label} safely.")
end

def external_temporary_base
  configured_tmpdir = ENV["TMPDIR"]
  expanded = File.expand_path(
    if configured_tmpdir.nil? || configured_tmpdir.empty?
      Dir.tmpdir
    else
      configured_tmpdir
    end
  )
  validate_fastlane_path_characters!(expanded, "DemoLab temporary directory")
  resolved = ensure_outside_repository!(expanded, "DemoLab temporary directory")
  validate_fastlane_path_characters!(
    resolved,
    "Resolved DemoLab temporary directory"
  )
  stat = File.stat(resolved)
  UI.user_error!("DemoLab temporary directory must be a directory.") unless stat.directory?
  private_parent = stat.uid == Process.uid && (stat.mode & 0o077).zero?
  sticky_parent = (stat.mode & 0o1000) == 0o1000
  unless private_parent || sticky_parent
    UI.user_error!(
      "DemoLab temporary directory must be private or protected by the sticky bit."
    )
  end
  UI.user_error!("DemoLab temporary directory is not writable.") unless File.writable?(resolved)
  resolved
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT
  UI.user_error!("Unable to validate the DemoLab temporary directory safely.")
end

def external_temporary_directory(prefix)
  workspace = nil
  begin
    workspace = Dir.mktmpdir(prefix, external_temporary_base)
    private_directory_identity!(
      workspace,
      "DemoLab temporary workspace"
    ).first
  rescue
    FileUtils.rm_rf(workspace) if workspace
    raise
  end
end

def with_external_temporary_file(basename)
  workspace = external_temporary_directory("orchardprobe-demolab-file-")
  begin
    Tempfile.create(basename, workspace) do |file|
      stat = file.stat
      unless stat.file? &&
             stat.uid == Process.uid &&
             (stat.mode & 0o077).zero?
        UI.user_error!("DemoLab temporary file is not private.")
      end
      ensure_outside_repository!(file.path, "DemoLab temporary file")
      yield file
    end
  ensure
    FileUtils.rm_rf(workspace)
  end
end

def existing_external_file(name, private: false)
  raw_path = required_environment(name)
  unless Pathname.new(raw_path).absolute?
    UI.user_error!("#{name} must be an absolute path.")
  end
  UI.user_error!("#{name} must name a regular file.") unless File.file?(raw_path)
  UI.user_error!("#{name} must not be a symbolic link.") if File.symlink?(raw_path)

  resolved = ensure_outside_repository!(raw_path, name)
  stat = File.stat(resolved)
  if private && stat.uid != Process.uid
    UI.user_error!("#{name} must be owned by the current user.")
  end
  if private && (stat.mode & 0o077) != 0
    UI.user_error!(
      "#{name} must not be readable or writable by group or other users."
    )
  end
  resolved
end

def demolab_bundle_identifiers
  app_identifier = required_environment(
    "DEMO_LAB_APP_BUNDLE_ID",
    pattern: /\A[A-Za-z0-9][A-Za-z0-9.-]*\z/
  )
  if app_identifier.start_with?("com.example.")
    UI.user_error!("Use the registered first-party DemoLab bundle identifier.")
  end
  share_identifier = required_environment(
    "DEMO_LAB_SHARE_BUNDLE_ID",
    pattern: /\A[A-Za-z0-9][A-Za-z0-9.-]*\z/
  )
  unless share_identifier.start_with?("#{app_identifier}.")
    UI.user_error!("The share-extension identifier must be nested below the app identifier.")
  end

  [app_identifier, share_identifier]
end

def copy_tracked_demolab_fixture(workspace)
  prefix = "fixtures/DemoLab/"
  listing, stderr, status = Open3.capture3(
    sanitized_dynamic_loader_environment(
      DEMO_LAB_XCODE_OVERRIDE_KEYS.to_h { |key| [key, nil] }
    ),
    "/usr/bin/git",
    "ls-files",
    "--cached",
    "-z",
    "--",
    "fixtures/DemoLab",
    chdir: repository_root
  )
  unless status.success?
    UI.user_error!("Unable to enumerate tracked DemoLab sources:\n#{stderr.strip}")
  end

  relative_paths = listing.split("\0")
  UI.user_error!("The tracked DemoLab fixture is empty.") if relative_paths.empty?
  fixture = File.join(workspace, "DemoLab")
  FileUtils.mkdir_p(fixture, mode: 0o700)
  source_root = File.realpath(File.join(repository_root, "fixtures", "DemoLab"))

  relative_paths.each do |relative_path|
    unless relative_path.start_with?(prefix)
      UI.user_error!("Tracked DemoLab source escaped its fixture prefix.")
    end
    fixture_relative_path = relative_path.delete_prefix(prefix)
    components = fixture_relative_path.split("/")
    if fixture_relative_path.empty? ||
       components.any? { |component| component.empty? || %w[. ..].include?(component) }
      UI.user_error!("Tracked DemoLab source has an unsafe relative path.")
    end

    source_path = File.join(repository_root, relative_path)
    source_stat = File.lstat(source_path)
    unless source_stat.file? && !source_stat.symlink?
      UI.user_error!("Tracked DemoLab sources must be regular files.")
    end
    resolved_source = File.realpath(source_path)
    unless resolved_source.start_with?("#{source_root}#{File::SEPARATOR}")
      UI.user_error!("Tracked DemoLab source escaped its fixture directory.")
    end

    destination_path = File.join(fixture, fixture_relative_path)
    FileUtils.mkdir_p(File.dirname(destination_path), mode: 0o700)
    FileUtils.copy_file(source_path, destination_path, true)
  end
  fixture
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT
  UI.user_error!("Unable to snapshot tracked DemoLab sources safely.")
end

def prepare_demolab_project(source_commit: nil)
  xcodegen_path, xcodegen_version, xcodegen_identity = selected_xcodegen
  workspace = external_temporary_directory("orchardprobe-demolab-")
  xcodegen_snapshot = nil
  xcodegen_snapshot_path = nil
  begin
    xcodegen_snapshot,
      xcodegen_snapshot_path,
      snapshot_identity,
      workspace_identity = stage_locked_xcodegen_snapshot!(
        xcodegen_path,
        xcodegen_identity,
        xcodegen_version,
        workspace
      )
    if source_commit
      unless /\A[0-9a-f]{40,64}\z/.match?(source_commit)
        UI.user_error!("DemoLab source commit has an invalid format.")
      end
      archive = File.join(workspace, "demolab-source.tar")
      git_command_output(
        "archive",
        "--format=tar",
        "--output=#{archive}",
        source_commit,
        "--",
        "fixtures/DemoLab"
      )
      command_output("/usr/bin/tar", "-xf", archive, "-C", workspace)
      FileUtils.rm_f(archive)
      fixture = File.join(workspace, "fixtures", "DemoLab")
    else
      fixture = copy_tracked_demolab_fixture(workspace)
    end

    UI.user_error!("DemoLab fixture snapshot is missing.") unless File.directory?(fixture)
    Find.find(fixture) do |path|
      UI.user_error!("DemoLab fixture must not contain symbolic links.") if File.symlink?(path)
    end
    verify_locked_xcodegen_snapshot!(
      xcodegen_snapshot,
      xcodegen_snapshot_path,
      snapshot_identity,
      workspace_identity
    )
    command_output_without_loader_overrides(
      xcodegen_snapshot_path,
      "generate",
      "--spec",
      File.join(fixture, "project.yml"),
      "--project",
      fixture
    )
    verify_locked_xcodegen_snapshot!(
      xcodegen_snapshot,
      xcodegen_snapshot_path,
      snapshot_identity,
      workspace_identity
    )
    verified_path, verified_version, verified_identity = selected_xcodegen
    unless verified_path == xcodegen_path &&
           verified_version == xcodegen_version &&
           verified_identity == xcodegen_identity
      UI.user_error!("The selected XcodeGen changed during project generation.")
    end
    xcodegen_snapshot.flock(File::LOCK_UN)
    xcodegen_snapshot.close
    xcodegen_snapshot = nil
    FileUtils.rm_f(xcodegen_snapshot_path)
    [
      workspace,
      fixture,
      File.join(fixture, "DemoLab.xcodeproj"),
      xcodegen_version,
    ]
  rescue
    if xcodegen_snapshot
      xcodegen_snapshot.flock(File::LOCK_UN) rescue nil
      xcodegen_snapshot.close rescue nil
    end
    FileUtils.rm_rf(workspace)
    raise
  end
end

def sha256(path)
  Digest::SHA256.file(path).hexdigest
end

def read_regular_file_snapshot(path, maximum_size, label)
  flags = File::RDONLY
  flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
  File.open(path, flags) do |source|
    before = source.stat
    UI.user_error!("#{label} must be a regular file.") unless before.file?
    if before.size <= 0 || before.size > maximum_size
      UI.user_error!("#{label} has an invalid size.")
    end

    content = source.read(maximum_size + 1)
    after = source.stat
    unless content.bytesize == before.size &&
           content.bytesize <= maximum_size &&
           before.dev == after.dev &&
           before.ino == after.ino &&
           before.size == after.size
      UI.user_error!("#{label} changed while it was being read.")
    end
    content
  end
rescue Errno::ELOOP
  UI.user_error!("#{label} must not be a symbolic link.")
end

def private_external_file_snapshot_with_path(name, maximum_size, label)
  raw_path = required_environment(name)
  unless Pathname.new(raw_path).absolute?
    UI.user_error!("#{name} must be an absolute path.")
  end

  expanded = File.expand_path(raw_path)
  reject_repository_path!(expanded, label)
  flags = File::RDONLY | File::NONBLOCK
  flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
  File.open(expanded, flags) do |source|
    opened = source.stat
    UI.user_error!("#{label} must be a regular file.") unless opened.file?
    UI.user_error!("#{label} must be owned by the current user.") unless opened.uid == Process.uid
    if (opened.mode & 0o077) != 0
      UI.user_error!("#{label} must not be accessible by group or other users.")
    end
    if opened.size <= 0 || opened.size > maximum_size
      UI.user_error!("#{label} has an invalid size.")
    end

    resolved = ensure_outside_repository!(expanded, label)
    resolved_stat = File.stat(resolved)
    path_stat = File.lstat(expanded)
    stable_path = !path_stat.symlink? &&
                  resolved_stat.dev == opened.dev &&
                  resolved_stat.ino == opened.ino &&
                  path_stat.dev == opened.dev &&
                  path_stat.ino == opened.ino
    UI.user_error!("#{label} path changed during validation.") unless stable_path

    content = source.read(maximum_size + 1)
    after = source.stat
    unless content.bytesize == opened.size &&
           content.bytesize <= maximum_size &&
           opened.dev == after.dev &&
           opened.ino == after.ino &&
           opened.size == after.size
      UI.user_error!("#{label} changed while it was being read.")
    end
    [resolved, content]
  end
rescue Errno::EACCES,
       Errno::EAGAIN,
       Errno::ELOOP,
       Errno::ENODEV,
       Errno::ENOENT,
       Errno::ENXIO
  UI.user_error!("Unable to snapshot #{label} safely.")
end

def private_external_file_snapshot(name, maximum_size, label)
  _, content = private_external_file_snapshot_with_path(
    name,
    maximum_size,
    label
  )
  content
end

def binary_evidence(path, relative_path, role, xcode_toolchain:)
  content = read_regular_file_snapshot(
    path,
    DEMO_LAB_MAX_BINARY_BYTES,
    "Archived DemoLab binary"
  )
  with_external_temporary_file(
    ["orchardprobe-demolab-binary-", ".macho"]
  ) do |file|
    file.binmode
    file.write(content)
    file.flush

    uuid_lines = command_output(
      xcode_toolchain.dig("dwarfdump", "path"),
      "--uuid",
      file.path
    ).lines
    uuids = uuid_lines.filter_map do |line|
      match = line.match(/UUID: ([0-9A-Fa-f-]+) \(([^)]+)\)/)
      next unless match

      {
        "architecture" => match[2],
        "uuid" => match[1].downcase,
      }
    end

    {
      "role" => role,
      "relative_path" => relative_path,
      "size" => content.bytesize,
      "sha256" => Digest::SHA256.hexdigest(content),
      "architectures" => command_output(
        xcode_toolchain.dig("lipo", "path"),
        "-archs",
        file.path
      ).split,
      "slices" => uuids,
      "initial_protection_status" => "not_observed",
      "expected_plaintext_status" => "candidate_pre_upload_archive_only",
    }
  end
end

def read_zip_entry(entry, maximum_size)
  if entry.directory? || entry.symlink? || entry.encrypted?
    UI.user_error!("DemoLab IPA contains an unsupported required entry.")
  end
  if entry.size.negative? || entry.size > maximum_size
    UI.user_error!("DemoLab IPA contains an oversized required entry.")
  end

  content = entry.get_input_stream.read(maximum_size + 1)
  if content.bytesize != entry.size || content.bytesize > maximum_size
    UI.user_error!("DemoLab IPA entry size does not match its metadata.")
  end
  content
end

def plist_value_from_zip_entry(entry, key, xcode_toolchain:)
  content = read_zip_entry(entry, DEMO_LAB_MAX_PLIST_BYTES)
  with_external_temporary_file(["orchardprobe-demolab-", ".plist"]) do |file|
    file.binmode
    file.write(content)
    file.flush
    command_output(
      xcode_toolchain.dig("plutil", "path"),
      "-extract",
      key,
      "raw",
      file.path
    )
  end
end

def zip_binary_evidence(content, relative_path, role)
  {
    "role" => role,
    "relative_path" => relative_path,
    "size" => content.bytesize,
    "sha256" => Digest::SHA256.hexdigest(content),
    "initial_protection_status" => "not_observed",
    "expected_plaintext_status" => "candidate_pre_upload_archive_only",
  }
end

def validate_demolab_dynamic_linkage_outputs!(
  framework_id_output,
  main_dependencies_output
)
  expected_framework_path =
    "@rpath/DemoFramework.framework/DemoFramework"
  framework_ids = framework_id_output.lines.map(&:strip).reject do |line|
    line.empty? || line.end_with?(":")
  end
  unless framework_ids.length.between?(1, 8) &&
         framework_ids.uniq == [expected_framework_path]
    UI.user_error!(
      "DemoFramework must use the expected @rpath install name."
    )
  end

  main_dependencies = main_dependencies_output.lines.map(&:strip).reject do |line|
    line.empty? || line.end_with?(":")
  end.map do |line|
    match = line.match(/\A(.+?) \(compatibility version /)
    match && match[1]
  end.compact
  framework_dependencies = main_dependencies.select do |path|
    path.end_with?("/DemoFramework.framework/DemoFramework")
  end
  unless framework_dependencies.length.between?(1, 8) &&
         framework_dependencies.uniq == [expected_framework_path]
    UI.user_error!(
      "DemoLab must load DemoFramework through the expected @rpath."
    )
  end
  true
end

def validate_demolab_dynamic_linkage_content!(
  main_content,
  framework_content,
  xcode_toolchain:
)
  with_external_temporary_file(
    ["orchardprobe-demolab-main-", ".macho"]
  ) do |main_file|
    main_file.binmode
    main_file.write(main_content)
    main_file.flush
    with_external_temporary_file(
      ["orchardprobe-demolab-framework-", ".macho"]
    ) do |framework_file|
      framework_file.binmode
      framework_file.write(framework_content)
      framework_file.flush

      framework_id_output = command_output(
        xcode_toolchain.dig("otool", "path"),
        "-D",
        framework_file.path
      )
      main_dependencies_output = command_output(
        xcode_toolchain.dig("otool", "path"),
        "-L",
        main_file.path
      )
      validate_demolab_dynamic_linkage_outputs!(
        framework_id_output,
        main_dependencies_output
      )
    end
  end
  true
end

def validate_demolab_dynamic_linkage_paths!(
  main_path,
  framework_path,
  xcode_toolchain:
)
  main_content = read_regular_file_snapshot(
    main_path,
    DEMO_LAB_MAX_BINARY_BYTES,
    "DemoLab main executable"
  )
  framework_content = read_regular_file_snapshot(
    framework_path,
    DEMO_LAB_MAX_BINARY_BYTES,
    "DemoFramework executable"
  )
  validate_demolab_dynamic_linkage_content!(
    main_content,
    framework_content,
    xcode_toolchain: xcode_toolchain
  )
end

def inspect_demolab_ipa!(
  ipa_path,
  app_identifier:,
  share_identifier:,
  marketing_version:,
  build_number:,
  xcode_toolchain:
)
  ipa_content = read_regular_file_snapshot(
    ipa_path,
    DEMO_LAB_MAX_IPA_BYTES,
    "Evidence-bound IPA"
  )
  ipa_measurement = {
    "size" => ipa_content.bytesize,
    "sha256" => Digest::SHA256.hexdigest(ipa_content),
  }

  inspection = nil
  Zip::File.open_buffer(StringIO.new(ipa_content)) do |archive|
    entries = archive.entries
    if entries.empty? || entries.length > DEMO_LAB_MAX_ZIP_ENTRIES
      UI.user_error!("DemoLab IPA has an invalid entry count.")
    end

    seen_names = {}
    entries.each do |entry|
      name = entry.name
      unless entry.name_safe? && !name.include?("\\") && !name.include?("\0")
        UI.user_error!("DemoLab IPA contains an unsafe entry name.")
      end
      UI.user_error!("DemoLab IPA contains duplicate entries.") if seen_names[name]
      UI.user_error!("DemoLab IPA must not contain symbolic links.") if entry.symlink?
      seen_names[name] = true
    end

    app_root = "Payload/DemoLab.app"
    app_plist = archive.find_entry("#{app_root}/Info.plist")
    share_plist = archive.find_entry(
      "#{app_root}/PlugIns/DemoShareExtension.appex/Info.plist"
    )
    framework_plist = archive.find_entry(
      "#{app_root}/Frameworks/DemoFramework.framework/Info.plist"
    )
    unless app_plist && share_plist && framework_plist
      UI.user_error!("IPA is not the expected DemoLab app/framework/extension package.")
    end

    root_app_plists = entries.select do |entry|
      entry.name.match?(%r{\APayload/[^/]+\.app/Info\.plist\z})
    end
    unless root_app_plists.map(&:name) == ["#{app_root}/Info.plist"]
      UI.user_error!("IPA must contain exactly one DemoLab application.")
    end

    expected_plist_values = [
      [app_plist, "CFBundleIdentifier", app_identifier],
      [app_plist, "CFBundleExecutable", "DemoLab"],
      [app_plist, "CFBundleShortVersionString", marketing_version],
      [app_plist, "CFBundleVersion", build_number],
      [app_plist, "ITSAppUsesNonExemptEncryption", "false"],
      [share_plist, "CFBundleIdentifier", share_identifier],
      [share_plist, "CFBundleExecutable", "DemoShareExtension"],
      [share_plist, "CFBundleShortVersionString", marketing_version],
      [share_plist, "CFBundleVersion", build_number],
      [framework_plist, "CFBundleIdentifier", "#{app_identifier}.framework"],
      [framework_plist, "CFBundleExecutable", "DemoFramework"],
      [framework_plist, "CFBundleShortVersionString", marketing_version],
      [framework_plist, "CFBundleVersion", build_number],
    ]
    expected_plist_values.each do |entry, key, expected|
      unless plist_value_from_zip_entry(
        entry,
        key,
        xcode_toolchain: xcode_toolchain
      ) == expected
        UI.user_error!("IPA identity does not match the authorized DemoLab package.")
      end
    end

    binary_specs = [
      [
        "#{app_root}/DemoLab",
        "DemoLab.app/DemoLab",
        "main_executable",
      ],
      [
        "#{app_root}/Frameworks/DemoFramework.framework/DemoFramework",
        "DemoLab.app/Frameworks/DemoFramework.framework/DemoFramework",
        "dynamic_framework",
      ],
      [
        "#{app_root}/PlugIns/DemoShareExtension.appex/DemoShareExtension",
        "DemoLab.app/PlugIns/DemoShareExtension.appex/DemoShareExtension",
        "app_extension",
      ],
    ]
    binaries = binary_specs.map do |entry_name, relative_path, role|
      entry = archive.find_entry(entry_name)
      UI.user_error!("DemoLab IPA is missing a required packaged binary.") unless entry
      content = read_zip_entry(entry, DEMO_LAB_MAX_BINARY_BYTES)
      [
        zip_binary_evidence(content, relative_path, role),
        content,
      ]
    end
    validate_demolab_dynamic_linkage_content!(
      binaries[0][1],
      binaries[1][1],
      xcode_toolchain: xcode_toolchain
    )

    inspection = {
      "application" => "DemoLab.app",
      "identity_validated" => true,
      "export_compliance_validated" => true,
      "archive" => ipa_measurement,
      "binaries" => binaries.map(&:first),
    }
  end
  inspection
rescue Zip::Error => error
  UI.user_error!("Unable to validate DemoLab IPA: #{error.class}.")
end

def demolab_archive_binary_inputs(archive_path)
  DEMO_LAB_BINARY_SPECS.map do |specification|
    [
      File.join(
        archive_path,
        "Products",
        "Applications",
        specification["relative_path"]
      ),
      specification["relative_path"],
      specification["role"],
    ]
  end
end

def write_pre_upload_evidence(
  run_directory:,
  archive_path:,
  ipa_path:,
  source_commit:,
  xcodegen_version:,
  marketing_version:,
  build_number:,
  app_identifier:,
  share_identifier:,
  xcode_toolchain:
)
  binaries = demolab_archive_binary_inputs(archive_path).map do |path, relative_path, role|
    [
      validate_regular_file_beneath_root!(
        path,
        archive_path,
        "Archived DemoLab binary"
      ),
      relative_path,
      role,
    ]
  end
  validate_demolab_dynamic_linkage_paths!(
    binaries[0][0],
    binaries[1][0],
    xcode_toolchain: xcode_toolchain
  )
  packaged = inspect_demolab_ipa!(
    ipa_path,
    app_identifier: app_identifier,
    share_identifier: share_identifier,
    marketing_version: marketing_version,
    build_number: build_number,
    xcode_toolchain: xcode_toolchain
  )

  evidence = {
    "schema_version" => 1,
    "profile" => DEMO_LAB_EVIDENCE_PROFILE,
    "purpose" => DEMO_LAB_EVIDENCE_PURPOSE,
    "decision" => DEMO_LAB_EVIDENCE_DECISION,
    "created_at" => Time.now.utc.iso8601,
    "source" => {
      "commit" => source_commit,
      "tree_clean" => true,
      "fixture" => "fixtures/DemoLab",
    },
    "toolchain" => {
      "fastlane_version" => Fastlane::VERSION,
      "xcodegen_version" => xcodegen_version,
      "xcode" => xcode_toolchain.fetch("xcode_version"),
      "iphoneos_sdk_version" =>
        xcode_toolchain.fetch("iphoneos_sdk_version"),
      "iphoneos_sdk_build" =>
        xcode_toolchain.fetch("iphoneos_sdk_build"),
    },
    "build" => {
      "configuration" => "Release",
      "marketing_version" => marketing_version,
      "build_number" => build_number,
      "distribution" => "app-store",
      "bundle_identifiers" => "operator-provided first-party identifiers; redacted",
    },
    "artifacts" => {
      "ipa" => {
        "filename" => File.basename(ipa_path),
        "size" => packaged.dig("archive", "size"),
        "sha256" => packaged.dig("archive", "sha256"),
      },
      "archive_binaries" => binaries.map do |path, relative_path, role|
        binary_evidence(
          path,
          relative_path,
          role,
          xcode_toolchain: xcode_toolchain
        )
      end,
      "package" => packaged.reject do |key, _|
        ["archive", "binaries"].include?(key)
      end,
      "ipa_binaries" => packaged["binaries"],
    },
    "lineage" => {
      "uploaded_ipa_bound" => false,
      "installed_artifact_bound" => false,
      "note" => DEMO_LAB_LINEAGE_NOTE,
    },
  }

  validate_upload_evidence_structure!(evidence)
  evidence_path = File.join(run_directory, "demolab-pre-upload-evidence.json")
  evidence_file = open_exclusive_private_file(evidence_path)
  begin
    persist_json_record!(evidence_file, evidence)
  ensure
    evidence_file.close
  end
  evidence_path
end

def require_exact_hash_keys!(value, expected_keys, label)
  unless value.is_a?(Hash) && value.keys.sort == expected_keys.sort
    UI.user_error!("#{label} has an incomplete or unexpected structure.")
  end
end

def validate_binary_measurement!(measurement, specification, archive:)
  keys = %w[
    role
    relative_path
    size
    sha256
    initial_protection_status
    expected_plaintext_status
  ]
  keys += %w[architectures slices] if archive
  require_exact_hash_keys!(measurement, keys, "DemoLab binary evidence")

  unless measurement["role"] == specification["role"] &&
         measurement["relative_path"] == specification["relative_path"] &&
         measurement["size"].is_a?(Integer) &&
         measurement["size"].positive? &&
         measurement["size"] <= DEMO_LAB_MAX_BINARY_BYTES &&
         measurement["sha256"].is_a?(String) &&
         /\A[0-9a-f]{64}\z/.match?(measurement["sha256"]) &&
         measurement["initial_protection_status"] == "not_observed" &&
         measurement["expected_plaintext_status"] ==
           "candidate_pre_upload_archive_only"
    UI.user_error!("DemoLab binary evidence is incomplete.")
  end
  return unless archive

  architectures = measurement["architectures"]
  slices = measurement["slices"]
  architectures_valid =
    architectures.is_a?(Array) &&
    architectures.length.between?(1, 8) &&
    architectures.uniq.length == architectures.length &&
    architectures.all? { |architecture|
      architecture.is_a?(String) &&
        /\A[A-Za-z0-9_]+\z/.match?(architecture)
    }
  slices_valid =
    slices.is_a?(Array) &&
    architectures.is_a?(Array) &&
    slices.length == architectures.length
  unless architectures_valid && slices_valid
    UI.user_error!("DemoLab archive architecture evidence is incomplete.")
  end

  slice_architectures = slices.map do |slice|
    require_exact_hash_keys!(
      slice,
      %w[architecture uuid],
      "DemoLab archive slice evidence"
    )
    architecture = slice["architecture"]
    uuid = slice["uuid"]
    unless architecture.is_a?(String) &&
           uuid.is_a?(String) &&
           /\A[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\z/.match?(
             uuid
           )
      UI.user_error!("DemoLab archive slice evidence is incomplete.")
    end
    architecture
  end
  unless slice_architectures.uniq.length == slice_architectures.length &&
         slice_architectures.sort == architectures.sort
    UI.user_error!("DemoLab archive slice evidence does not match its architectures.")
  end
end

def validate_upload_evidence_structure!(evidence)
  require_exact_hash_keys!(
    evidence,
    %w[
      schema_version
      profile
      purpose
      decision
      created_at
      source
      toolchain
      build
      artifacts
      lineage
    ],
    "DemoLab evidence"
  )

  created_at = evidence["created_at"]
  unless valid_utc_timestamp?(created_at)
    UI.user_error!("DemoLab evidence creation time is invalid.")
  end

  source = evidence["source"]
  require_exact_hash_keys!(
    source,
    %w[commit tree_clean fixture],
    "DemoLab source evidence"
  )
  unless source["commit"].is_a?(String) &&
         /\A[0-9a-f]{40,64}\z/.match?(source["commit"]) &&
         source["tree_clean"] == true &&
         source["fixture"] == "fixtures/DemoLab"
    UI.user_error!("DemoLab source evidence is incomplete.")
  end

  toolchain = evidence["toolchain"]
  require_exact_hash_keys!(
    toolchain,
    %w[
      fastlane_version
      xcodegen_version
      xcode
      iphoneos_sdk_version
      iphoneos_sdk_build
    ],
    "DemoLab toolchain evidence"
  )
  xcode_lines = toolchain["xcode"]
  xcode_lines_valid =
    xcode_lines.is_a?(Array) &&
    xcode_lines.length == 2 &&
    xcode_lines.all? { |line|
      line.is_a?(String) && !line.empty? && line.bytesize <= 256
    }
  toolchain_valid =
    toolchain["fastlane_version"] == Fastlane::VERSION &&
    toolchain["xcodegen_version"].is_a?(String) &&
    /\A[0-9]+\.[0-9]+\.[0-9]+\z/.match?(
      toolchain["xcodegen_version"]
    ) &&
    xcode_lines_valid &&
    toolchain["iphoneos_sdk_version"].is_a?(String) &&
    /\A[0-9]+(?:\.[0-9]+){0,2}\z/.match?(
      toolchain["iphoneos_sdk_version"]
    ) &&
    toolchain["iphoneos_sdk_build"].is_a?(String) &&
    /\A[A-Za-z0-9.]+\z/.match?(toolchain["iphoneos_sdk_build"])
  unless toolchain_valid
    UI.user_error!("DemoLab toolchain evidence is incomplete.")
  end

  build = evidence["build"]
  require_exact_hash_keys!(
    build,
    %w[
      configuration
      marketing_version
      build_number
      distribution
      bundle_identifiers
    ],
    "DemoLab build evidence"
  )
  unless build["configuration"] == "Release" &&
         build["marketing_version"].is_a?(String) &&
         /\A[0-9]+(?:\.[0-9]+){0,2}\z/.match?(
           build["marketing_version"]
         ) &&
         build["build_number"].is_a?(String) &&
         /\A[1-9][0-9]{0,17}\z/.match?(build["build_number"]) &&
         build["distribution"] == "app-store" &&
         build["bundle_identifiers"] ==
           "operator-provided first-party identifiers; redacted"
    UI.user_error!("DemoLab build evidence is incomplete.")
  end

  artifacts = evidence["artifacts"]
  require_exact_hash_keys!(
    artifacts,
    %w[ipa archive_binaries package ipa_binaries],
    "DemoLab artifact evidence"
  )
  ipa = artifacts["ipa"]
  require_exact_hash_keys!(ipa, %w[filename size sha256], "DemoLab IPA evidence")
  unless ipa["filename"].is_a?(String) &&
         ipa["filename"] == "DemoLab-#{build['build_number']}.ipa" &&
         ipa["size"].is_a?(Integer) &&
         ipa["size"].positive? &&
         ipa["size"] <= DEMO_LAB_MAX_IPA_BYTES &&
         ipa["sha256"].is_a?(String) &&
         /\A[0-9a-f]{64}\z/.match?(ipa["sha256"])
    UI.user_error!("DemoLab IPA evidence is incomplete.")
  end

  package = artifacts["package"]
  require_exact_hash_keys!(
    package,
    %w[application identity_validated export_compliance_validated],
    "DemoLab package evidence"
  )
  unless package == {
    "application" => "DemoLab.app",
    "identity_validated" => true,
    "export_compliance_validated" => true,
  }
    UI.user_error!("DemoLab package evidence is incomplete.")
  end

  archive_binaries = artifacts["archive_binaries"]
  ipa_binaries = artifacts["ipa_binaries"]
  unless archive_binaries.is_a?(Array) &&
         ipa_binaries.is_a?(Array) &&
         archive_binaries.length == DEMO_LAB_BINARY_SPECS.length &&
         ipa_binaries.length == DEMO_LAB_BINARY_SPECS.length
    UI.user_error!("DemoLab evidence must contain all required binaries.")
  end
  DEMO_LAB_BINARY_SPECS.each_with_index do |specification, index|
    validate_binary_measurement!(
      archive_binaries[index],
      specification,
      archive: true
    )
    validate_binary_measurement!(
      ipa_binaries[index],
      specification,
      archive: false
    )
  end

  lineage = evidence["lineage"]
  require_exact_hash_keys!(
    lineage,
    %w[uploaded_ipa_bound installed_artifact_bound note],
    "DemoLab lineage evidence"
  )
  unless lineage == {
    "uploaded_ipa_bound" => false,
    "installed_artifact_bound" => false,
    "note" => DEMO_LAB_LINEAGE_NOTE,
  }
    UI.user_error!("DemoLab lineage evidence is incomplete.")
  end
end

def load_demolab_evidence
  evidence_path, evidence_content = private_external_file_snapshot_with_path(
    "DEMO_LAB_EVIDENCE_PATH",
    DEMO_LAB_MAX_PLIST_BYTES,
    "DemoLab evidence"
  )
  begin
    evidence = JSON.parse(evidence_content)
  rescue JSON::ParserError
    UI.user_error!("DemoLab evidence is not valid JSON.")
  end
  unless evidence.is_a?(Hash)
    UI.user_error!("DemoLab evidence root must be a JSON object.")
  end

  expected_profile = {
    "schema_version" => 1,
    "profile" => DEMO_LAB_EVIDENCE_PROFILE,
    "purpose" => DEMO_LAB_EVIDENCE_PURPOSE,
    "decision" => DEMO_LAB_EVIDENCE_DECISION,
  }
  expected_profile.each do |key, expected|
    UI.user_error!("Evidence is not a DemoLab pre-upload record.") unless evidence[key] == expected
  end
  validate_upload_evidence_structure!(evidence)
  unless evidence.dig("source", "tree_clean") == true &&
         evidence.dig("source", "fixture") == "fixtures/DemoLab" &&
         evidence.dig("build", "distribution") == "app-store" &&
         evidence.dig("artifacts", "package", "application") == "DemoLab.app" &&
         evidence.dig("artifacts", "package", "identity_validated") == true &&
         evidence.dig(
           "artifacts",
           "package",
           "export_compliance_validated"
         ) == true
    UI.user_error!("Evidence does not describe an authorized DemoLab App Store candidate.")
  end

  source_commit = evidence.dig("source", "commit")
  current_commit = git_command_output("rev-parse", "HEAD")
  unless source_commit == current_commit
    UI.user_error!("Evidence source commit does not match the current checkout.")
  end

  [evidence_path, evidence]
end

def verify_evidence_bound_archive!(
  archive_path,
  evidence,
  xcode_toolchain:
)
  unless File.directory?(archive_path) && !File.symlink?(archive_path)
    UI.user_error!("Evidence-bound DemoLab archive is missing or unsafe.")
  end
  ensure_outside_repository!(archive_path, "Evidence-bound DemoLab archive")
  archive_binaries =
    demolab_archive_binary_inputs(archive_path).map do |path, relative_path, role|
      resolved_path = validate_regular_file_beneath_root!(
        path,
        archive_path,
        "Evidence-bound archive binary"
      )
      ensure_outside_repository!(resolved_path, "Evidence-bound archive binary")
      [resolved_path, relative_path, role]
    end
  validate_demolab_dynamic_linkage_paths!(
    archive_binaries[0][0],
    archive_binaries[1][0],
    xcode_toolchain: xcode_toolchain
  )
  observed_archive_binaries = archive_binaries.map do |path, relative_path, role|
    binary_evidence(
      path,
      relative_path,
      role,
      xcode_toolchain: xcode_toolchain
    )
  end
  unless observed_archive_binaries == evidence.dig(
    "artifacts",
    "archive_binaries"
  )
    UI.user_error!("Archived DemoLab binaries do not match the evidence.")
  end
  true
end

def load_upload_evidence(
  app_identifier:,
  share_identifier:,
  xcode_toolchain:
)
  evidence_path, evidence = load_demolab_evidence
  archive_path = File.join(File.dirname(evidence_path), "DemoLab.xcarchive")
  verify_evidence_bound_archive!(
    archive_path,
    evidence,
    xcode_toolchain: xcode_toolchain
  )

  filename = evidence.dig("artifacts", "ipa", "filename")
  expected_size = evidence.dig("artifacts", "ipa", "size")
  expected_sha256 = evidence.dig("artifacts", "ipa", "sha256")
  unless filename.is_a?(String) && File.basename(filename) == filename
    UI.user_error!("Evidence contains an unsafe IPA filename.")
  end
  marketing_version = evidence.dig("build", "marketing_version")
  build_number = evidence.dig("build", "build_number")
  unless marketing_version.is_a?(String) &&
         /\A[0-9]+(?:\.[0-9]+){0,2}\z/.match?(marketing_version)
    UI.user_error!("Evidence contains an invalid DemoLab marketing version.")
  end
  unless build_number.is_a?(String) &&
         /\A[1-9][0-9]{0,17}\z/.match?(build_number) &&
         filename == "DemoLab-#{build_number}.ipa"
    UI.user_error!("Evidence IPA filename does not match the DemoLab build.")
  end
  unless expected_size.is_a?(Integer) &&
         expected_size.positive? &&
         expected_size <= DEMO_LAB_MAX_IPA_BYTES
    UI.user_error!("Evidence contains an invalid IPA size.")
  end
  unless expected_sha256.is_a?(String) && /\A[0-9a-f]{64}\z/.match?(expected_sha256)
    UI.user_error!("Evidence contains an invalid IPA SHA-256.")
  end

  ipa_path = File.join(File.dirname(evidence_path), filename)
  UI.user_error!("Evidence-bound IPA is missing.") unless File.file?(ipa_path)
  ensure_outside_repository!(ipa_path, "Evidence-bound IPA")
  UI.user_error!("IPA size does not match the evidence.") unless File.size(ipa_path) == expected_size
  UI.user_error!("IPA SHA-256 does not match the evidence.") unless sha256(ipa_path) == expected_sha256
  observed_package = inspect_demolab_ipa!(
    ipa_path,
    app_identifier: app_identifier,
    share_identifier: share_identifier,
    marketing_version: marketing_version,
    build_number: build_number,
    xcode_toolchain: xcode_toolchain
  )
  unless observed_package["archive"] == {
    "size" => expected_size,
    "sha256" => expected_sha256,
  }
    UI.user_error!("Inspected DemoLab IPA bytes do not match the evidence.")
  end
  observed_package_summary = observed_package.reject do |key, _|
    ["archive", "binaries"].include?(key)
  end
  unless observed_package_summary == evidence.dig("artifacts", "package")
    UI.user_error!("Packaged DemoLab metadata does not match the archive evidence.")
  end
  unless observed_package["binaries"] == evidence.dig("artifacts", "ipa_binaries")
    UI.user_error!("Packaged DemoLab binaries do not match the archive evidence.")
  end

  [evidence_path, evidence, ipa_path, archive_path]
end

def digest_open_file(file)
  digest = Digest::SHA256.new
  file.rewind
  while (chunk = file.read(1024 * 1024))
    digest.update(chunk)
  end
  file.rewind
  digest.hexdigest
end

def reopen_snapshot_read_only!(
  writable_snapshot,
  expected_size:,
  expected_sha256:,
  label:
)
  writable_snapshot.flush
  writable_snapshot.fsync
  writable_snapshot.chmod(0o400)
  snapshot_path = writable_snapshot.path
  written = writable_snapshot.stat
  writable_snapshot.close

  flags = File::RDONLY | File::NONBLOCK
  flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
  read_only_snapshot = File.open(snapshot_path, flags)
  opened = read_only_snapshot.stat
  linked = File.lstat(snapshot_path)
  access_mode =
    read_only_snapshot.fcntl(Fcntl::F_GETFL) & Fcntl::O_ACCMODE
  unless written.file? &&
         opened.file? &&
         !linked.symlink? &&
         written.dev == opened.dev &&
         written.ino == opened.ino &&
         linked.dev == opened.dev &&
         linked.ino == opened.ino &&
         opened.size == expected_size &&
         (opened.mode & 0o777) == 0o400 &&
         access_mode == Fcntl::O_RDONLY &&
         digest_open_file(read_only_snapshot) == expected_sha256
    UI.user_error!("Read-only #{label} snapshot identity check failed.")
  end

  File.unlink(snapshot_path)
  read_only_snapshot.rewind
  read_only_snapshot
rescue Errno::EACCES,
       Errno::EBADF,
       Errno::ELOOP,
       Errno::ENOENT,
       Errno::ENOTDIR
  read_only_snapshot&.close
  UI.user_error!("Unable to reopen the #{label} snapshot read-only.")
rescue
  read_only_snapshot&.close
  raise
end

def verify_locked_ipa_snapshot!(
  snapshot,
  snapshot_path,
  expected_identity,
  workspace_identity
)
  current_workspace_identity = private_directory_identity!(
    File.dirname(snapshot_path),
    "DemoLab IPA snapshot workspace"
  )
  opened = snapshot.stat
  path_stat = File.lstat(snapshot_path)
  access_mode = snapshot.fcntl(Fcntl::F_GETFL) & Fcntl::O_ACCMODE
  observed_identity = [
    opened.dev,
    opened.ino,
    opened.size,
    opened.mtime.to_i,
    digest_open_file(snapshot),
  ]
  unless current_workspace_identity == workspace_identity &&
         File.basename(snapshot_path) == "DemoLab.ipa" &&
         opened.file? &&
         opened.uid == Process.uid &&
         (opened.mode & 0o777) == 0o400 &&
         access_mode == Fcntl::O_RDONLY &&
         !path_stat.symlink? &&
         path_stat.dev == opened.dev &&
         path_stat.ino == opened.ino &&
         observed_identity == expected_identity
    UI.user_error!("The locked DemoLab IPA snapshot changed during upload.")
  end
  true
rescue Errno::EACCES,
       Errno::EBADF,
       Errno::ELOOP,
       Errno::ENOENT,
       Errno::ENOTDIR
  UI.user_error!("Unable to verify the locked DemoLab IPA snapshot safely.")
end

def open_locked_snapshot_from_path(
  source_path,
  expected_size:,
  expected_sha256:,
  label:
)
  workspace = external_temporary_directory("orchardprobe-demolab-ipa-")
  workspace_identity = private_directory_identity!(
    workspace,
    "DemoLab IPA snapshot workspace"
  )
  snapshot_path = File.join(workspace, "DemoLab.ipa")
  writable_snapshot = nil
  locked_snapshot = nil
  begin
    flags = File::RDONLY | File::NONBLOCK
    flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
    File.open(source_path, flags) do |source|
      before = source.stat
      UI.user_error!("#{label} must be a regular file.") unless before.file?
      unless before.size == expected_size &&
             expected_size.positive? &&
             expected_size <= DEMO_LAB_MAX_IPA_BYTES
        UI.user_error!("#{label} has an invalid size.")
      end

      destination_flags = File::WRONLY | File::CREAT | File::EXCL
      destination_flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
      writable_snapshot = File.open(
        snapshot_path,
        destination_flags,
        0o600
      )
      copied = 0
      digest = Digest::SHA256.new
      while (chunk = source.read([1024 * 1024, expected_size - copied + 1].min))
        copied += chunk.bytesize
        UI.user_error!("#{label} exceeded its evidence-bound size.") if copied > expected_size
        digest.update(chunk)
        writable_snapshot.write(chunk)
      end
      after = source.stat
      unless copied == expected_size &&
             digest.hexdigest == expected_sha256 &&
             before.dev == after.dev &&
             before.ino == after.ino &&
             before.size == after.size
        UI.user_error!("#{label} changed or did not match its evidence.")
      end
    end

    writable_snapshot.flush
    writable_snapshot.fsync
    writable_snapshot.chmod(0o400)
    written = writable_snapshot.stat
    writable_snapshot.close
    writable_snapshot = nil

    snapshot_flags = File::RDONLY | File::NONBLOCK
    snapshot_flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
    locked_snapshot = File.open(snapshot_path, snapshot_flags)
    unless locked_snapshot.flock(File::LOCK_EX | File::LOCK_NB)
      UI.user_error!("Unable to lock the private DemoLab IPA snapshot.")
    end
    opened = locked_snapshot.stat
    snapshot_identity = [
      opened.dev,
      opened.ino,
      opened.size,
      opened.mtime.to_i,
      digest_open_file(locked_snapshot),
    ]
    unless written.dev == opened.dev &&
           written.ino == opened.ino &&
           opened.size == expected_size &&
           snapshot_identity.last == expected_sha256
      UI.user_error!("The private DemoLab IPA snapshot does not match its source.")
    end
    verify_locked_ipa_snapshot!(
      locked_snapshot,
      snapshot_path,
      snapshot_identity,
      workspace_identity
    )
    [
      locked_snapshot,
      snapshot_path,
      snapshot_identity,
      workspace_identity,
    ]
  rescue
    if locked_snapshot
      locked_snapshot.flock(File::LOCK_UN) rescue nil
      locked_snapshot.close rescue nil
    end
    writable_snapshot&.close
    FileUtils.rm_rf(workspace) if workspace
    raise
  end
end

def open_unlinked_snapshot_from_content(content, label:, suffix: "")
  UI.user_error!("#{label} is empty.") if content.nil? || content.empty?
  expected_size = content.bytesize
  expected_sha256 = Digest::SHA256.hexdigest(content)
  workspace = external_temporary_directory("orchardprobe-demolab-fd-")
  writable_snapshot = nil
  read_only_snapshot = nil
  begin
    writable_snapshot = Tempfile.new(["snapshot-", suffix], workspace)
    writable_snapshot.binmode
    writable_snapshot.chmod(0o600)
    writable_snapshot.write(content)
    read_only_snapshot = reopen_snapshot_read_only!(
      writable_snapshot,
      expected_size: expected_size,
      expected_sha256: expected_sha256,
      label: label
    )
    FileUtils.rmdir(workspace)
    workspace = nil
    read_only_snapshot
  rescue
    read_only_snapshot&.close
    writable_snapshot&.close!
    FileUtils.rm_rf(workspace) if workspace
    raise
  end
end

def stage_evidence_bound_ipa(ipa_path, evidence)
  expected_size = evidence.dig("artifacts", "ipa", "size")
  expected_sha256 = evidence.dig("artifacts", "ipa", "sha256")
  open_locked_snapshot_from_path(
    ipa_path,
    expected_size: expected_size,
    expected_sha256: expected_sha256,
    label: "Evidence-bound IPA"
  )
end

def read_bounded_altool_output!(file, label)
  file.flush
  size = file.stat.size
  if size > DEMO_LAB_MAX_ALTOOL_OUTPUT_BYTES
    UI.user_error!("#{label} exceeded the bounded output limit.")
  end
  file.rewind
  content = file.read(DEMO_LAB_MAX_ALTOOL_OUTPUT_BYTES + 1)
  if content.bytesize != size || content.bytesize > DEMO_LAB_MAX_ALTOOL_OUTPUT_BYTES
    UI.user_error!("#{label} changed while it was being read.")
  end
  content
end

def validate_altool_upload_result!(output, process_success:)
  result = JSON.parse(output)
  unless result.is_a?(Hash)
    UI.user_error!("Apple altool returned an unexpected JSON result.")
  end

  product_errors = result["product-errors"]
  unless product_errors.nil? || product_errors.is_a?(Array)
    UI.user_error!("Apple altool returned malformed product-errors.")
  end
  unless product_errors.nil? || product_errors.empty?
    UI.user_error!(
      "Apple altool reported product-errors; the upload is not accepted."
    )
  end
  unless process_success
    UI.user_error!(
      "Apple altool did not report a successful DemoLab upload process."
    )
  end

  success_message = result["success-message"]
  unless success_message.is_a?(String) && !success_message.strip.empty?
    UI.user_error!(
      "Apple altool did not return an explicit upload success message."
    )
  end
  result
rescue JSON::ParserError
  UI.user_error!("Apple altool returned invalid JSON; upload state is unknown.")
end

def selected_altool(xcode_toolchain)
  discovered = command_output_with_environment(
    xcode_toolchain.fetch("environment"),
    xcode_toolchain.dig("xcrun", "path"),
    "--find",
    "altool"
  )
  unless Pathname.new(discovered).absolute?
    UI.user_error!("The selected Xcode returned a non-absolute altool path.")
  end
  selected = File.realpath(discovered)
  candidate =
    case File.basename(selected)
    when "altool"
      selected
    when "altoolShim"
      File.join(File.dirname(selected), "altool")
    else
      UI.user_error!("The selected Xcode returned an unexpected altool target.")
    end
  resolved_candidate = File.realpath(candidate)
  unless File.dirname(resolved_candidate) == File.dirname(selected) &&
         File.basename(resolved_candidate) == "altool"
    UI.user_error!("The selected Xcode real altool escaped its resource directory.")
  end
  pinned_executable(
    resolved_candidate,
    "Selected Xcode real altool",
    required_root: xcode_toolchain.fetch("xcode_bundle_root")
  )
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT
  UI.user_error!("Unable to resolve the selected Xcode real altool safely.")
end

def verify_selected_altool!(xcode_toolchain, altool)
  observed = selected_altool(xcode_toolchain)
  unless observed == altool
    UI.user_error!("The selected Xcode real altool changed during use.")
  end
  true
end

def terminate_process_group_and_reap(pid)
  begin
    Process.kill("TERM", -pid)
  rescue Errno::ESRCH
    nil
  end

  deadline =
    Process.clock_gettime(Process::CLOCK_MONOTONIC) +
    DEMO_LAB_PROCESS_TERMINATION_GRACE_SECONDS
  loop do
    waited_pid, status = Process.waitpid2(pid, Process::WNOHANG)
    if waited_pid
      begin
        Process.kill("KILL", -pid)
      rescue Errno::ESRCH
        nil
      end
      return status
    end
    break if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline

    sleep(0.1)
  end

  begin
    Process.kill("KILL", -pid)
  rescue Errno::ESRCH
    nil
  end
  _, status = Process.waitpid2(pid)
  status
rescue Errno::ECHILD
  UI.user_error!("Unable to reconcile the bounded Apple upload process.")
end

def wait_for_bounded_process(pid, timeout_seconds:)
  deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + timeout_seconds
  loop do
    waited_pid, status = Process.waitpid2(pid, Process::WNOHANG)
    return [status, false] if waited_pid
    break if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline

    sleep(0.1)
  end
  [terminate_process_group_and_reap(pid), true]
rescue Errno::ECHILD
  UI.user_error!("Unable to reconcile the bounded Apple upload process.")
end

def validate_private_altool_logs!(log_directory)
  workspace = File.dirname(log_directory)
  workspace_identity = private_directory_identity!(
    workspace,
    "Apple altool private workspace"
  )
  log_root = File.lstat(log_directory)
  unless log_root.directory? &&
         !log_root.symlink? &&
         log_root.uid == Process.uid &&
         (log_root.mode & 0o022).zero?
    UI.user_error!("Apple altool log root is not safely contained.")
  end

  entry_count = 0
  file_count = 0
  total_bytes = 0
  Find.find(log_directory) do |path|
    next if path == log_directory

    entry_count += 1
    if entry_count > DEMO_LAB_MAX_ALTOOL_LOG_ENTRIES
      UI.user_error!("Apple altool log output exceeded its entry limit.")
    end
    stat = File.lstat(path)
    if stat.symlink?
      Find.prune if File.directory?(path)
      UI.user_error!("Apple altool log output contains a symbolic link.")
    end
    unless stat.directory? || stat.file?
      UI.user_error!("Apple altool log output contains a special file.")
    end
    unless stat.uid == Process.uid && (stat.mode & 0o022).zero?
      UI.user_error!("Apple altool log output is writable by another user.")
    end
    next if stat.directory?

    file_count += 1
    total_bytes += stat.size
    if file_count > DEMO_LAB_MAX_ALTOOL_LOG_FILES ||
       stat.size > DEMO_LAB_MAX_ALTOOL_LOG_BYTES ||
       total_bytes > DEMO_LAB_MAX_ALTOOL_LOG_TOTAL_BYTES
      UI.user_error!("Apple altool log output exceeded its safety bounds.")
    end
  end
  unless private_directory_identity!(
    workspace,
    "Apple altool private workspace"
  ) == workspace_identity
    UI.user_error!("Apple altool private workspace changed during validation.")
  end
end

def altool_api_key_arguments(key_type:, key_id:, team_issuer_id:)
  case key_type
  when "team"
    unless team_issuer_id
      UI.user_error!("A team API key requires its App Store Connect issuer ID.")
    end
    [
      "--api-key",
      key_id,
      "--api-issuer",
      team_issuer_id,
    ]
  when "individual"
    unless team_issuer_id.nil?
      UI.user_error!("An individual API key does not use an issuer ID.")
    end
    [
      "--api-key",
      key_id,
      # Xcode 26 altool still requires --api-issuer at argument-parsing time
      # for individual keys. The key ID is its compatibility placeholder;
      # --api-key-subject selects Apple's individual-key authentication path.
      "--api-issuer",
      key_id,
      "--api-key-subject",
      "user",
    ]
  else
    UI.user_error!("App Store Connect API key type is invalid.")
  end
end

def upload_demolab_with_altool!(
  ipa_snapshot:,
  ipa_snapshot_path:,
  ipa_snapshot_identity:,
  ipa_workspace_identity:,
  key_snapshot:,
  archive_path:,
  evidence:,
  altool:,
  xcode_toolchain:,
  key_id:,
  key_type:,
  team_issuer_id:,
  apple_id:,
  app_identifier:,
  marketing_version:,
  build_number:
)
  verify_locked_ipa_snapshot!(
    ipa_snapshot,
    ipa_snapshot_path,
    ipa_snapshot_identity,
    ipa_workspace_identity
  )
  key_snapshot.rewind
  stdout_capture = nil
  stderr_capture = nil
  tool_workspace = external_temporary_directory(
    "orchardprobe-demolab-altool-"
  )
  log_directory = File.join(tool_workspace, "logs")
  Dir.mkdir(log_directory, 0o700)
  stdout_capture = Tempfile.new("stdout-", tool_workspace)
  stderr_capture = Tempfile.new("stderr-", tool_workspace)
  stdout_capture.chmod(0o600)
  stderr_capture.chmod(0o600)
  environment = {
    # selected_altool resolves Xcode's altoolShim to the real sibling
    # executable before this function is called. The shim is intentionally
    # never launched here because it requires a downloaded Defaults.properties
    # file in Home; the real ContentDelivery executable supports an empty
    # private Home and is verified that way by demolab_check.
    "CFFIXED_USER_HOME" => tool_workspace,
    "HOME" => tool_workspace,
    "LANG" => ENV.fetch("LANG", "en_US.UTF-8"),
    "LC_ALL" => ENV.fetch("LC_ALL", "en_US.UTF-8"),
    "PATH" => "/usr/bin:/bin",
    "TMPDIR" => tool_workspace,
  }
  command = [
    altool.fetch("path"),
    "--upload-package",
    ipa_snapshot_path,
    "--platform",
    "ios",
    "--apple-id",
    apple_id,
    "--bundle-version",
    build_number,
    "--bundle-short-version-string",
    marketing_version,
    "--bundle-id",
    app_identifier,
    "--p8-file-path",
    "/dev/fd/#{DEMO_LAB_UPLOAD_KEY_FD}",
    "--log-dir",
    log_directory,
  ]
  command.concat(
    altool_api_key_arguments(
      key_type: key_type,
      key_id: key_id,
      team_issuer_id: team_issuer_id
    )
  )
  command.concat(
    [
      "--wait",
      "--output-format",
      "json",
    ]
  )

  prior_umask = File.umask(0o077)
  begin
    verify_evidence_bound_archive!(
      archive_path,
      evidence,
      xcode_toolchain: xcode_toolchain
    )
    verify_selected_xcode_toolchain!(xcode_toolchain)
    verify_selected_altool!(xcode_toolchain, altool)
    pid = Process.spawn(
      environment,
      *command,
      DEMO_LAB_UPLOAD_KEY_FD => key_snapshot,
      out: stdout_capture,
      err: stderr_capture,
      pgroup: true,
      rlimit_fsize: DEMO_LAB_MAX_ALTOOL_LOG_BYTES,
      unsetenv_others: true
    )
    process_status, timed_out = wait_for_bounded_process(
      pid,
      timeout_seconds: DEMO_LAB_ALTOOL_TIMEOUT_SECONDS
    )
    verify_selected_xcode_toolchain!(xcode_toolchain)
    verify_selected_altool!(xcode_toolchain, altool)
  ensure
    File.umask(prior_umask)
  end
  verify_locked_ipa_snapshot!(
    ipa_snapshot,
    ipa_snapshot_path,
    ipa_snapshot_identity,
    ipa_workspace_identity
  )
  validate_private_altool_logs!(log_directory)
  stdout = read_bounded_altool_output!(stdout_capture, "Apple altool stdout")
  read_bounded_altool_output!(stderr_capture, "Apple altool stderr")
  if timed_out
    UI.user_error!(
      "Apple altool exceeded the 30-minute upload deadline; state is unknown."
    )
  end
  validate_altool_upload_result!(
    stdout,
    process_success: process_status.success?
  )
ensure
  ipa_snapshot&.rewind
  key_snapshot&.rewind
  stdout_capture&.close!
  stderr_capture&.close!
  FileUtils.rm_rf(tool_workspace) if tool_workspace
end

def open_exclusive_private_file(path)
  flags = File::WRONLY | File::CREAT | File::EXCL
  flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
  file = File.open(path, flags, 0o600)
  unless file.flock(File::LOCK_EX | File::LOCK_NB)
    file.close
    UI.user_error!("Unable to lock the newly created private record.")
  end
  file
end

def persist_json_record!(file, record)
  serialized = "#{JSON.pretty_generate(record)}\n"
  if serialized.bytesize > DEMO_LAB_MAX_UPLOAD_RESULT_BYTES
    UI.user_error!("DemoLab JSON record exceeded its bounded size.")
  end
  file.rewind
  file.write(serialized)
  file.truncate(file.pos)
  file.flush
  file.fsync
end

def private_json_temporary_path(path)
  File.join(
    File.dirname(path),
    ".#{File.basename(path)}.tmp-#{SecureRandom.hex(12)}"
  )
end

def verify_private_record_path_identity!(path, file, label)
  current = File.lstat(path)
  held = file.stat
  unless current.file? &&
         !current.symlink? &&
         current.uid == Process.uid &&
         (current.mode & 0o077).zero? &&
         current.dev == held.dev &&
         current.ino == held.ino
    UI.user_error!("#{label} path changed during atomic publication.")
  end
end

def prepare_private_json_temporary_record(path, record)
  temporary_path = private_json_temporary_path(path)
  temporary_file = open_exclusive_private_file(temporary_path)
  persist_json_record!(temporary_file, record)
  [temporary_path, temporary_file]
rescue
  temporary_file&.flock(File::LOCK_UN)
  temporary_file&.close
  FileUtils.rm_f(temporary_path) if temporary_path
  raise
end

def publish_new_private_json_record!(path, record, label)
  expanded = File.expand_path(path)
  reject_repository_path!(expanded, label)
  private_directory_identity!(File.dirname(expanded), "#{label} parent")
  temporary_path = nil
  temporary_file = nil
  published = false
  begin
    temporary_path, temporary_file =
      prepare_private_json_temporary_record(expanded, record)
    rename_exclusive_no_follow!(temporary_path, expanded, label)
    published = true
    verify_private_record_path_identity!(expanded, temporary_file, label)
    fsync_parent_directory!(expanded)
    temporary_file
  rescue
    temporary_file&.flock(File::LOCK_UN)
    temporary_file&.close
    raise
  ensure
    FileUtils.rm_f(temporary_path) if temporary_path && !published
  end
end

def rename_replace_no_follow!(source, destination, label)
  flags = DemoLabDarwin::RENAME_NOFOLLOW_ANY
  return if DemoLabDarwin.renamex_np(source, destination, flags).zero?

  UI.user_error!("Unable to atomically replace #{label} safely.")
end

def replace_locked_private_json_record!(path, current_file, record, label)
  expanded = File.expand_path(path)
  reject_repository_path!(expanded, label)
  private_directory_identity!(File.dirname(expanded), "#{label} parent")
  verify_private_record_path_identity!(expanded, current_file, label)
  temporary_path = nil
  temporary_file = nil
  published = false
  begin
    temporary_path, temporary_file =
      prepare_private_json_temporary_record(expanded, record)
    verify_private_record_path_identity!(expanded, current_file, label)
    rename_replace_no_follow!(temporary_path, expanded, label)
    published = true
    verify_private_record_path_identity!(expanded, temporary_file, label)
    fsync_parent_directory!(expanded)
    temporary_file
  rescue
    temporary_file&.flock(File::LOCK_UN)
    temporary_file&.close
    raise
  ensure
    FileUtils.rm_f(temporary_path) if temporary_path && !published
  end
end

def fsync_parent_directory!(path)
  parent = File.dirname(path)
  flags = File::RDONLY
  flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
  File.open(parent, flags) do |directory|
    stat = directory.stat
    UI.user_error!("DemoLab record parent is not a directory.") unless stat.directory?
    directory.fsync
  end
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT
  UI.user_error!("Unable to make the DemoLab record directory entry durable.")
end

def with_locked_private_record(path, maximum_size, label)
  expanded = File.expand_path(path)
  reject_repository_path!(expanded, label)
  flags = File::RDWR | File::NONBLOCK
  flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
  File.open(expanded, flags) do |file|
    unless file.flock(File::LOCK_EX | File::LOCK_NB)
      UI.user_error!("#{label} is still in use by another upload process.")
    end
    opened = file.stat
    unless opened.file? &&
           opened.uid == Process.uid &&
           (opened.mode & 0o077).zero? &&
           opened.size.positive? &&
           opened.size <= maximum_size
      UI.user_error!("#{label} is not a bounded private regular file.")
    end

    resolved = ensure_outside_repository!(expanded, label)
    resolved_stat = File.stat(resolved)
    path_stat = File.lstat(expanded)
    unless !path_stat.symlink? &&
           resolved_stat.dev == opened.dev &&
           resolved_stat.ino == opened.ino &&
           path_stat.dev == opened.dev &&
           path_stat.ino == opened.ino
      UI.user_error!("#{label} path changed during validation.")
    end

    content = file.read(maximum_size + 1)
    after = file.stat
    unless content.bytesize == opened.size &&
           content.bytesize <= maximum_size &&
           opened.dev == after.dev &&
           opened.ino == after.ino &&
           opened.size == after.size
      UI.user_error!("#{label} changed while it was being read.")
    end
    file.rewind
    yield file, content
  ensure
    file.flock(File::LOCK_UN)
  end
rescue Errno::EACCES,
       Errno::EAGAIN,
       Errno::ELOOP,
       Errno::ENODEV,
       Errno::ENOENT,
       Errno::ENXIO
  UI.user_error!("Unable to lock and snapshot #{label} safely.")
end

def validate_reconcilable_upload_result!(record, evidence)
  unless record.is_a?(Hash)
    UI.user_error!("Indeterminate upload result must be a JSON object.")
  end
  common_keys = %w[
    schema_version
    source_commit
    ipa_sha256
    attempt_started_at
    destination
    external_distribution
    status
    note
  ]
  expected_keys =
    if record["status"] == "reconciled_absent"
      common_keys + %w[reconciled_at reconciliation]
    else
      common_keys
    end
  require_exact_hash_keys!(
    record,
    expected_keys,
    "Indeterminate upload result"
  )

  unless record["schema_version"] == 1 &&
         record["source_commit"] == evidence.dig("source", "commit") &&
         record["ipa_sha256"] == evidence.dig(
           "artifacts",
           "ipa",
           "sha256"
         ) &&
         valid_utc_timestamp?(record["attempt_started_at"]) &&
         record["destination"] == "TestFlight internal preparation" &&
         record["external_distribution"] == false
    UI.user_error!("Indeterminate upload result does not match this evidence.")
  end

  case record["status"]
  when "indeterminate"
    unless record["note"] == DEMO_LAB_UPLOAD_INDETERMINATE_NOTE
      UI.user_error!("Indeterminate upload result has an unexpected note.")
    end
  when "reconciled_absent"
    unless valid_utc_timestamp?(record["reconciled_at"]) &&
           record["reconciliation"] ==
             "operator_confirmed_absent_in_app_store_connect" &&
           record["note"] == DEMO_LAB_RECONCILED_ABSENT_NOTE
      UI.user_error!("Reconciled upload result is incomplete.")
    end
  else
    UI.user_error!("Only an indeterminate upload result can be reconciled.")
  end
  record
end

def reconcile_indeterminate_upload_result!(
  result_path,
  evidence,
  expected_attempt_started_at:
)
  archive_path = File.join(
    File.dirname(result_path),
    "demolab-upload-result-reconciled-#{SecureRandom.hex(12)}.json"
  )
  reconciled_record = nil
  replacement_file = nil
  with_locked_private_record(
    result_path,
    DEMO_LAB_MAX_UPLOAD_RESULT_BYTES,
    "Indeterminate DemoLab upload result"
  ) do |file, content|
    begin
      record = JSON.parse(content)
    rescue JSON::ParserError
      UI.user_error!("Indeterminate upload result is not valid JSON.")
    end
    validate_reconcilable_upload_result!(record, evidence)
    unless record["attempt_started_at"] == expected_attempt_started_at
      UI.user_error!(
        "The reconciled attempt timestamp does not match the current result."
      )
    end

    if record["status"] == "indeterminate"
      record = record.merge(
        "status" => "reconciled_absent",
        "reconciled_at" => Time.now.utc.iso8601,
        "reconciliation" =>
          "operator_confirmed_absent_in_app_store_connect",
        "note" => DEMO_LAB_RECONCILED_ABSENT_NOTE
      )
      replacement_file = replace_locked_private_json_record!(
        result_path,
        file,
        record,
        "reconciled upload result"
      )
    end
    reconciled_record = validate_reconcilable_upload_result!(record, evidence)

    current = File.lstat(result_path)
    held = (replacement_file || file).stat
    unless !current.symlink? &&
           current.dev == held.dev &&
           current.ino == held.ino
      UI.user_error!("Upload result path changed before reconciliation.")
    end
    rename_exclusive_no_follow!(
      result_path,
      archive_path,
      "reconciled upload result"
    )
    archived = File.lstat(archive_path)
    unless archived.file? &&
           !archived.symlink? &&
           archived.dev == held.dev &&
           archived.ino == held.ino
      UI.user_error!("Reconciled upload result publication changed identity.")
    end
    fsync_parent_directory!(archive_path)
  end
  [archive_path, reconciled_record]
ensure
  replacement_file&.flock(File::LOCK_UN)
  replacement_file&.close
end

default_platform(:ios)

platform :ios do
  desc "Build the unsigned DemoLab simulator fixture without Apple credentials"
  lane :demolab_check do
    xcode_toolchain = selected_xcode_toolchain
    loader_key = "DYLD_INSERT_LIBRARIES"
    loader_key_was_set = ENV.key?(loader_key)
    previous_loader_value = ENV[loader_key]
    ENV[loader_key] = "/private/tmp/orchardprobe-untrusted-loader.dylib"
    begin
      sanitized_loader_environment = sanitized_dynamic_loader_environment
      observed_loader_value = command_output_with_environment(
        sanitized_loader_environment,
        RbConfig.ruby,
        "-e",
        "print ENV.fetch('DYLD_INSERT_LIBRARIES', 'cleared')"
      )
      observed_default_command_loader_value = command_output(
        RbConfig.ruby,
        "-e",
        "print ENV.fetch('DYLD_INSERT_LIBRARIES', 'cleared')"
      )
      unless sanitized_loader_environment[loader_key].nil? &&
             observed_loader_value == "cleared" &&
             observed_default_command_loader_value == "cleared"
        UI.user_error!("A dynamic-loader override reached a controlled subprocess.")
      end
    ensure
      if loader_key_was_set
        ENV[loader_key] = previous_loader_value
      else
        ENV.delete(loader_key)
      end
    end

    previous_tmpdir = ENV["TMPDIR"]
    ENV["TMPDIR"] = repository_root
    repository_tmpdir_rejected = false
    begin
      external_temporary_base
    rescue FastlaneCore::Interface::FastlaneError
      repository_tmpdir_rejected = true
    ensure
      if previous_tmpdir
        ENV["TMPDIR"] = previous_tmpdir
      else
        ENV.delete("TMPDIR")
      end
    end
    unless repository_tmpdir_rejected
      UI.user_error!("A DemoLab temporary directory inside Git was accepted.")
    end

    ["'", "\n"].each do |unsafe_character|
      unsafe_tmpdir = File.join(
        "/private/tmp",
        "orchardprobe-demolab-unsafe-#{Process.pid}-#{unsafe_character}"
      )
      previous_tmpdir = ENV["TMPDIR"]
      ENV["TMPDIR"] = unsafe_tmpdir
      unsafe_tmpdir_rejected = false
      begin
        external_temporary_base
      rescue FastlaneCore::Interface::FastlaneError
        unsafe_tmpdir_rejected = true
      ensure
        if previous_tmpdir
          ENV["TMPDIR"] = previous_tmpdir
        else
          ENV.delete("TMPDIR")
        end
      end
      unless unsafe_tmpdir_rejected && !File.exist?(unsafe_tmpdir)
        UI.user_error!("A shell-unsafe DemoLab temporary directory was accepted.")
      end
    end

    rejected_output = File.join(
      repository_root,
      ".demolab-rejected-output-#{Process.pid}"
    )
    previous_output = ENV["DEMO_LAB_OUTPUT_DIR"]
    ENV["DEMO_LAB_OUTPUT_DIR"] = rejected_output
    output_rejected = false
    begin
      private_output_directory
    rescue FastlaneCore::Interface::FastlaneError
      output_rejected = true
    ensure
      if previous_output
        ENV["DEMO_LAB_OUTPUT_DIR"] = previous_output
      else
        ENV.delete("DEMO_LAB_OUTPUT_DIR")
      end
    end
    unless output_rejected && !File.exist?(rejected_output)
      UI.user_error!("Rejected DemoLab output path left repository side effects.")
    end

    workspace, _, project = prepare_demolab_project
    begin
      shadow_tools = File.join(workspace, "shadow-developer-tools")
      Dir.mkdir(shadow_tools, 0o700)
      %w[xcodebuild xcrun plutil dwarfdump lipo otool xcodegen].each do |name|
        shadow_path = File.join(shadow_tools, name)
        File.write(shadow_path, "#!/bin/sh\nprintf 'shadow-tool\\n'\n")
        File.chmod(0o500, shadow_path)
      end
      previous_path = ENV["PATH"]
      ENV["PATH"] = "#{shadow_tools}:#{previous_path}"
      begin
        shadow_xcodegen_rejected = false
        begin
          selected_xcodegen
        rescue FastlaneCore::Interface::FastlaneError
          shadow_xcodegen_rejected = true
        end
        unless shadow_xcodegen_rejected
          UI.user_error!("A PATH-shadowed XcodeGen binary was selected.")
        end

        shadow_selection = selected_xcode_toolchain
        unless %w[xcodebuild xcrun plutil dwarfdump lipo otool].all? { |name|
          shadow_selection.fetch(name) == xcode_toolchain.fetch(name) &&
            !shadow_selection.dig(name, "path").start_with?(
              "#{shadow_tools}#{File::SEPARATOR}"
            )
        }
          UI.user_error!("A PATH-shadowed developer tool was selected.")
        end
        previous_xcconfig = ENV["XCODE_XCCONFIG_FILE"]
        ENV["XCODE_XCCONFIG_FILE"] = File.join(workspace, "untrusted.xcconfig")
        begin
          with_pinned_xcode_environment(xcode_toolchain) do
            unless %w[xcodebuild xcrun plutil dwarfdump lipo otool].all? { |name|
              resolved_from_path = pinned_executable(
                command_output("/usr/bin/which", name),
                "PATH-selected #{name}",
                required_root: %w[xcodebuild dwarfdump lipo otool].include?(name) ?
                  xcode_toolchain.fetch("developer_dir") : nil
              )
              resolved_from_path == xcode_toolchain.fetch(name)
            }
              UI.user_error!("Pinned Xcode PATH retained a shadow developer tool.")
            end
            if ENV.key?("XCODE_XCCONFIG_FILE")
              UI.user_error!("Pinned Xcode environment retained an xcconfig override.")
            end
          end
          unless ENV["XCODE_XCCONFIG_FILE"] ==
                 File.join(workspace, "untrusted.xcconfig")
            UI.user_error!("Pinned Xcode environment did not restore its caller.")
          end
        ensure
          if previous_xcconfig
            ENV["XCODE_XCCONFIG_FILE"] = previous_xcconfig
          else
            ENV.delete("XCODE_XCCONFIG_FILE")
          end
        end
      ensure
        previous_path ? ENV["PATH"] = previous_path : ENV.delete("PATH")
      end
      verify_selected_xcode_toolchain!(xcode_toolchain)

      shared_output = File.join(workspace, "shared-output")
      Dir.mkdir(shared_output, 0o755)
      File.chmod(0o755, shared_output)
      shared_output_mode = File.stat(shared_output).mode & 0o777
      previous_output = ENV["DEMO_LAB_OUTPUT_DIR"]
      ENV["DEMO_LAB_OUTPUT_DIR"] = shared_output
      shared_output_rejected = false
      begin
        private_output_directory
      rescue FastlaneCore::Interface::FastlaneError
        shared_output_rejected = true
      ensure
        if previous_output
          ENV["DEMO_LAB_OUTPUT_DIR"] = previous_output
        else
          ENV.delete("DEMO_LAB_OUTPUT_DIR")
        end
      end
      unless shared_output_rejected &&
             (File.stat(shared_output).mode & 0o777) == shared_output_mode
        UI.user_error!("Unsafe DemoLab output permissions were mutated.")
      end

      missing_output = File.join(workspace, "missing-output")
      previous_output = ENV["DEMO_LAB_OUTPUT_DIR"]
      ENV["DEMO_LAB_OUTPUT_DIR"] = missing_output
      missing_output_rejected = false
      begin
        private_output_directory
      rescue FastlaneCore::Interface::FastlaneError
        missing_output_rejected = true
      ensure
        if previous_output
          ENV["DEMO_LAB_OUTPUT_DIR"] = previous_output
        else
          ENV.delete("DEMO_LAB_OUTPUT_DIR")
        end
      end
      unless missing_output_rejected && !File.exist?(missing_output)
        UI.user_error!("Missing DemoLab output root was created by the lane.")
      end

      unsafe_output = File.join(workspace, "unsafe'output")
      Dir.mkdir(unsafe_output, 0o700)
      previous_output = ENV["DEMO_LAB_OUTPUT_DIR"]
      ENV["DEMO_LAB_OUTPUT_DIR"] = unsafe_output
      unsafe_output_rejected = false
      begin
        private_output_directory
      rescue FastlaneCore::Interface::FastlaneError
        unsafe_output_rejected = true
      ensure
        if previous_output
          ENV["DEMO_LAB_OUTPUT_DIR"] = previous_output
        else
          ENV.delete("DEMO_LAB_OUTPUT_DIR")
        end
      end
      unless unsafe_output_rejected
        UI.user_error!("Shell-unsafe DemoLab output path was accepted.")
      end

      reserved_run = File.join(workspace, "reserved-run")
      workspace_identity = private_directory_identity!(
        workspace,
        "DemoLab output root"
      )
      create_exclusive_private_directory!(
        reserved_run,
        "DemoLab run directory",
        private_parent_identity: workspace_identity
      )
      reservation_rejected = false
      begin
        create_exclusive_private_directory!(
          reserved_run,
          "DemoLab run directory",
          private_parent_identity: workspace_identity
        )
      rescue FastlaneCore::Interface::FastlaneError
        reservation_rejected = true
      end
      unless reservation_rejected &&
             (File.stat(reserved_run).mode & 0o777) == 0o700
        UI.user_error!("DemoLab run directory reservation is not exclusive.")
      end

      replaced_output = File.join(workspace, "replaced-output")
      displaced_output = File.join(workspace, "displaced-output")
      Dir.mkdir(replaced_output, 0o700)
      original_output_identity = private_directory_identity!(
        replaced_output,
        "DemoLab output root"
      )
      File.rename(replaced_output, displaced_output)
      Dir.mkdir(replaced_output, 0o700)
      replaced_run = File.join(replaced_output, "run")
      replaced_output_rejected = false
      begin
        create_exclusive_private_directory!(
          replaced_run,
          "DemoLab run directory",
          private_parent_identity: original_output_identity
        )
      rescue FastlaneCore::Interface::FastlaneError
        replaced_output_rejected = true
      end
      unless replaced_output_rejected && !File.exist?(replaced_run)
        UI.user_error!("Replaced DemoLab output root was accepted.")
      end

      locked_output = File.join(workspace, "locked-output")
      Dir.mkdir(locked_output, 0o700)
      locked_output_identity = private_directory_identity!(
        locked_output,
        "DemoLab output root"
      )
      with_locked_private_directory(
        locked_output,
        locked_output_identity,
        "DemoLab output root"
      ) do |locked_handle|
        verify_locked_directory!(
          locked_handle,
          locked_output,
          locked_output_identity,
          "DemoLab output root"
        )
      end

      publish_source = File.join(workspace, "publish-source")
      publish_destination = File.join(workspace, "publish-destination")
      Dir.mkdir(publish_source, 0o700)
      Dir.mkdir(publish_destination, 0o700)
      publish_collision_rejected = false
      begin
        rename_exclusive_no_follow!(
