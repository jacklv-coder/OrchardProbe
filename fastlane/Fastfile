      File.write(
        incomplete_evidence_path,
        "#{JSON.generate(incomplete_evidence)}\n"
      )
      File.chmod(0o600, incomplete_evidence_path)
      previous_evidence = ENV["DEMO_LAB_EVIDENCE_PATH"]
      ENV["DEMO_LAB_EVIDENCE_PATH"] = incomplete_evidence_path
      incomplete_evidence_rejected = false
      begin
        load_upload_evidence(
          app_identifier: "com.example.orchardprobe.demolab",
          share_identifier: "com.example.orchardprobe.demolab.share",
          xcode_toolchain: xcode_toolchain
        )
      rescue FastlaneCore::Interface::FastlaneError
        incomplete_evidence_rejected = true
      ensure
        if previous_evidence
          ENV["DEMO_LAB_EVIDENCE_PATH"] = previous_evidence
        else
          ENV.delete("DEMO_LAB_EVIDENCE_PATH")
        end
      end
      unless incomplete_evidence_rejected
        UI.user_error!("Incomplete DemoLab upload evidence was accepted.")
      end

      altered_lineage = JSON.parse(JSON.generate(complete_evidence))
      altered_lineage["lineage"]["uploaded_ipa_bound"] = true
      altered_lineage_rejected = false
      begin
        validate_upload_evidence_structure!(altered_lineage)
      rescue FastlaneCore::Interface::FastlaneError
        altered_lineage_rejected = true
      end
      unless altered_lineage_rejected
        UI.user_error!("Altered DemoLab lineage evidence was accepted.")
      end

      invalid_package_root = File.join(workspace, "InvalidPackage")
      invalid_payload = File.join(invalid_package_root, "Payload")
      FileUtils.mkdir_p(invalid_payload)
      FileUtils.cp_r(application, invalid_payload)
      command_output(
        xcode_toolchain.dig("plutil", "path"),
        "-remove",
        "ITSAppUsesNonExemptEncryption",
        File.join(invalid_payload, "DemoLab.app", "Info.plist")
      )
      invalid_ipa = File.join(workspace, "DemoLab-invalid-compliance.ipa")
      sh(
        "/usr/bin/ditto",
        "-c",
        "-k",
        "--norsrc",
        "--keepParent",
        invalid_payload,
        invalid_ipa
      )
      compliance_rejected = false
      begin
        inspect_demolab_ipa!(
          invalid_ipa,
          app_identifier: "com.example.orchardprobe.demolab",
          share_identifier: "com.example.orchardprobe.demolab.share",
          marketing_version: "1.0",
          build_number: "1",
          xcode_toolchain: xcode_toolchain
        )
      rescue FastlaneCore::Interface::FastlaneError
        compliance_rejected = true
      end
      unless compliance_rejected
        UI.user_error!("DemoLab IPA without export compliance was accepted.")
      end

      snapshot_evidence = {
        "artifacts" => {
          "ipa" => {
            "size" => File.size(check_ipa),
            "sha256" => sha256(check_ipa),
          },
        },
      }
      upload_snapshot,
        snapshot_path,
        snapshot_identity,
        snapshot_workspace_identity = stage_evidence_bound_ipa(
          check_ipa,
          snapshot_evidence
        )
      begin
        expected_snapshot_sha256 = sha256(check_ipa)
        File.write(check_ipa, "replacement-after-snapshot")
        descriptor_write_rejected = false
        begin
          upload_snapshot.write("mutation")
        rescue IOError, Errno::EBADF
          descriptor_write_rejected = true
        end
        upload_snapshot.rewind
        child_output, child_status = Open3.capture2(
          sanitized_dynamic_loader_environment,
          "/usr/bin/shasum",
          "-a",
          "256",
          snapshot_path
        )
        unless File.file?(snapshot_path) &&
               File.basename(snapshot_path) == "DemoLab.ipa" &&
               upload_snapshot.stat.size == snapshot_evidence.dig(
                 "artifacts",
                 "ipa",
                 "size"
               ) &&
               digest_open_file(upload_snapshot) == expected_snapshot_sha256 &&
               (upload_snapshot.stat.mode & 0o777) == 0o400 &&
               (upload_snapshot.fcntl(Fcntl::F_GETFL) & Fcntl::O_ACCMODE) ==
                 Fcntl::O_RDONLY &&
               descriptor_write_rejected &&
               child_status.success? &&
               child_output.split.first == expected_snapshot_sha256 &&
               verify_locked_ipa_snapshot!(
                 upload_snapshot,
                 snapshot_path,
                 snapshot_identity,
                 snapshot_workspace_identity
               )
          UI.user_error!("Locked DemoLab upload snapshot check failed.")
        end
      ensure
        upload_snapshot.flock(File::LOCK_UN) rescue nil
        upload_snapshot.close rescue nil
        FileUtils.rm_rf(File.dirname(snapshot_path))
      end

      tamper_ipa = File.join(workspace, "DemoLab-snapshot-tamper.ipa")
      FileUtils.cp(complete_ipa, tamper_ipa)
      tamper_evidence = {
        "artifacts" => {
          "ipa" => {
            "size" => File.size(tamper_ipa),
            "sha256" => sha256(tamper_ipa),
          },
        },
      }
      tampered_snapshot,
        tampered_snapshot_path,
        tampered_snapshot_identity,
        tampered_workspace_identity = stage_evidence_bound_ipa(
          tamper_ipa,
          tamper_evidence
        )
      begin
        File.unlink(tampered_snapshot_path)
        File.write(tampered_snapshot_path, "replacement-snapshot")
        named_snapshot_replacement_rejected = false
        begin
          verify_locked_ipa_snapshot!(
            tampered_snapshot,
            tampered_snapshot_path,
            tampered_snapshot_identity,
            tampered_workspace_identity
          )
        rescue FastlaneCore::Interface::FastlaneError
          named_snapshot_replacement_rejected = true
        end
        unless named_snapshot_replacement_rejected
          UI.user_error!("Replaced DemoLab upload snapshot path was accepted.")
        end
      ensure
        tampered_snapshot.flock(File::LOCK_UN) rescue nil
        tampered_snapshot.close rescue nil
        FileUtils.rm_rf(File.dirname(tampered_snapshot_path))
      end

      altool_success = {
        "success-message" => "Package uploaded",
        "tool-version" => "test",
      }
      unless validate_altool_upload_result!(
        JSON.generate(altool_success),
        process_success: true
      ) == altool_success
        UI.user_error!("Valid Apple altool JSON was not accepted.")
      end
      altool_product_error_rejected = false
      begin
        validate_altool_upload_result!(
          JSON.generate(
            {
              "product-errors" => [
                {
                  "code" => -1,
                  "message" => "simulated upload rejection",
                },
              ],
            }
          ),
          process_success: true
        )
      rescue FastlaneCore::Interface::FastlaneError
        altool_product_error_rejected = true
      end
      unless altool_product_error_rejected
        UI.user_error!("Apple altool product-errors were accepted.")
      end
      team_issuer = "12345678-1234-1234-1234-123456789012"
      unless altool_api_key_arguments(
        key_type: "team",
        key_id: "ABCDEFGHIJ",
        team_issuer_id: team_issuer
      ) == [
        "--api-key",
        "ABCDEFGHIJ",
        "--api-issuer",
        team_issuer,
      ] &&
             altool_api_key_arguments(
               key_type: "individual",
               key_id: "ABCDEFGHIJ",
               team_issuer_id: nil
             ) == [
               "--api-key",
               "ABCDEFGHIJ",
               "--api-issuer",
               "ABCDEFGHIJ",
               "--api-key-subject",
               "user",
             ]
        UI.user_error!("Apple altool API-key argument selection failed.")
      end
      invalid_api_key_arguments = [
        {
          key_type: "team",
          key_id: "ABCDEFGHIJ",
          team_issuer_id: nil,
        },
        {
          key_type: "individual",
          key_id: "ABCDEFGHIJ",
          team_issuer_id: team_issuer,
        },
        {
          key_type: "unknown",
          key_id: "ABCDEFGHIJ",
          team_issuer_id: nil,
        },
      ]
      invalid_api_key_arguments.each do |arguments|
        rejected = false
        begin
          altool_api_key_arguments(**arguments)
        rescue FastlaneCore::Interface::FastlaneError
          rejected = true
        end
        unless rejected
          UI.user_error!("Invalid Apple altool API-key arguments were accepted.")
        end
      end
      altool = selected_altool(xcode_toolchain)
      resolved_altool = altool.fetch("path")
      discovered_altool = File.realpath(
        command_output_with_environment(
          xcode_toolchain.fetch("environment"),
          xcode_toolchain.dig("xcrun", "path"),
          "--find",
          "altool"
        )
      )
      unless Pathname.new(resolved_altool).absolute? &&
             File.file?(resolved_altool) &&
             File.executable?(resolved_altool) &&
             File.realpath(resolved_altool) == resolved_altool &&
             File.basename(resolved_altool) == "altool"
        UI.user_error!("Selected Xcode altool path validation failed.")
      end
      verify_selected_altool!(xcode_toolchain, altool)
      changed_altool_rejected = false
      begin
        changed_identity = altool.fetch("identity").dup
        changed_identity[1] += 1
        verify_selected_altool!(
          xcode_toolchain,
          altool.merge("identity" => changed_identity)
        )
      rescue FastlaneCore::Interface::FastlaneError
        changed_altool_rejected = true
      end
      unless changed_altool_rejected
        UI.user_error!("A changed Apple altool identity was accepted.")
      end
      if File.basename(discovered_altool) == "altoolShim"
        unless resolved_altool != discovered_altool &&
               File.dirname(resolved_altool) == File.dirname(discovered_altool)
          UI.user_error!("Xcode altoolShim was not replaced by its real sibling.")
        end
      end
      altool_home = external_temporary_directory(
        "orchardprobe-demolab-altool-help-"
      )
      begin
        help_stdout, help_stderr, help_status = Open3.capture3(
          {
            "CFFIXED_USER_HOME" => altool_home,
            "HOME" => altool_home,
            "LANG" => "en_US.UTF-8",
            "LC_ALL" => "en_US.UTF-8",
            "PATH" => "/usr/bin:/bin",
            "TMPDIR" => altool_home,
          },
          resolved_altool,
          "--help",
          unsetenv_others: true
        )
        help_output = "#{help_stdout}\n#{help_stderr}"
        unless help_status.success? &&
               help_output.bytesize <= DEMO_LAB_MAX_ALTOOL_OUTPUT_BYTES &&
               help_output.include?("--upload-package") &&
               help_output.include?("--p8-file-path") &&
               help_output.include?("--api-key-subject")
          UI.user_error!(
            "Selected Xcode real altool failed with a private empty home."
          )
        end
      ensure
        FileUtils.rm_rf(altool_home)
      end
      timeout_pid = Process.spawn(
        sanitized_dynamic_loader_environment,
        "/bin/sleep",
        "5",
        out: File::NULL,
        err: File::NULL,
        pgroup: true
      )
      timeout_status, timeout_triggered = wait_for_bounded_process(
        timeout_pid,
        timeout_seconds: 0.1
      )
      unless timeout_triggered && !timeout_status.success?
        UI.user_error!("Bounded Apple upload process check failed.")
      end

      result_target = File.join(workspace, "result-target.json")
      result_link = File.join(workspace, "demolab-upload-result.json")
      File.write(result_target, "preserve")
      File.symlink(result_target, result_link)
      result_link_rejected = false
      begin
        open_exclusive_private_file(result_link).close
      rescue Errno::EEXIST, Errno::ELOOP
        result_link_rejected = true
      end
      unless result_link_rejected && File.read(result_target) == "preserve"
        UI.user_error!("Exclusive upload-result creation followed a symbolic link.")
      end

      upload_state_path = File.join(workspace, "upload-state.json")
      upload_state_file = publish_new_private_json_record!(
        upload_state_path,
        {
          "status" => "indeterminate",
          "note" => "longer record retained until reconciliation",
        },
        "DemoLab check upload result"
      )
      unless JSON.parse(File.read(upload_state_path))["status"] == "indeterminate"
        UI.user_error!("Indeterminate upload state was not persisted.")
      end
      original_upload_state_inode = upload_state_file.stat.ino
      original_upload_state_content = File.read(upload_state_path)
      oversized_atomic_update_rejected = false
      begin
        replace_locked_private_json_record!(
          upload_state_path,
          upload_state_file,
          { "status" => "accepted", "padding" => "x" * 65_536 },
          "DemoLab check upload result"
        )
      rescue FastlaneCore::Interface::FastlaneError
        oversized_atomic_update_rejected = true
      end
      unless oversized_atomic_update_rejected &&
             File.stat(upload_state_path).ino == original_upload_state_inode &&
             File.read(upload_state_path) == original_upload_state_content &&
             Dir.glob(
               File.join(workspace, ".upload-state.json.tmp-*")
             ).empty?
        UI.user_error!("Failed atomic upload-state update changed the live record.")
      end
      replacement_upload_state_file = replace_locked_private_json_record!(
        upload_state_path,
        upload_state_file,
        { "status" => "accepted" },
        "DemoLab check upload result"
      )
      upload_state_file.flock(File::LOCK_UN)
      upload_state_file.close
      upload_state_file = replacement_upload_state_file
      unless JSON.parse(File.read(upload_state_path)) == { "status" => "accepted" }
        UI.user_error!("Accepted upload state did not replace the prior record.")
      end
      unless File.stat(upload_state_path).ino != original_upload_state_inode
        UI.user_error!("Accepted upload state was not atomically replaced.")
      end
      upload_state_file.flock(File::LOCK_UN)
      upload_state_file.close

      retry_result_path = File.join(
        workspace,
        "retry-demolab-upload-result.json"
      )
      retry_attempt_started_at = Time.now.utc.iso8601
      retry_result = {
        "schema_version" => 1,
        "source_commit" => complete_evidence.dig("source", "commit"),
        "ipa_sha256" => complete_evidence.dig(
          "artifacts",
          "ipa",
          "sha256"
        ),
        "attempt_started_at" => retry_attempt_started_at,
        "destination" => "TestFlight internal preparation",
        "external_distribution" => false,
        "status" => "indeterminate",
        "note" => DEMO_LAB_UPLOAD_INDETERMINATE_NOTE,
      }
      retry_result_file = publish_new_private_json_record!(
        retry_result_path,
        retry_result,
        "DemoLab check retry result"
      )
      begin
        active_upload_reconciliation_rejected = false
        begin
          reconcile_indeterminate_upload_result!(
            retry_result_path,
            complete_evidence,
            expected_attempt_started_at: retry_attempt_started_at
          )
        rescue FastlaneCore::Interface::FastlaneError
          active_upload_reconciliation_rejected = true
        end
        unless active_upload_reconciliation_rejected
          UI.user_error!("An active upload result was reconciled.")
        end
      ensure
        retry_result_file.close
      end
      wrong_retry_timestamp_rejected = false
      begin
        reconcile_indeterminate_upload_result!(
          retry_result_path,
          complete_evidence,
          expected_attempt_started_at: "2000-01-01T00:00:00Z"
        )
      rescue FastlaneCore::Interface::FastlaneError
        wrong_retry_timestamp_rejected = true
      end
      unless wrong_retry_timestamp_rejected && File.file?(retry_result_path)
        UI.user_error!("Mismatched upload reconciliation was accepted.")
      end

      reconciled_path, reconciled_record =
        reconcile_indeterminate_upload_result!(
          retry_result_path,
          complete_evidence,
          expected_attempt_started_at: retry_attempt_started_at
        )
      unless !File.exist?(retry_result_path) &&
             File.file?(reconciled_path) &&
             (File.stat(reconciled_path).mode & 0o077).zero? &&
             reconciled_record["status"] == "reconciled_absent" &&
             JSON.parse(File.read(reconciled_path)) == reconciled_record
        UI.user_error!("Indeterminate upload reconciliation did not publish safely.")
      end
      retry_reservation = open_exclusive_private_file(retry_result_path)
      retry_reservation.close

      safe_log_directory = File.join(workspace, "safe-altool-logs")
      Dir.mkdir(safe_log_directory, 0o700)
      File.chmod(0o755, safe_log_directory)
      safe_log = File.join(safe_log_directory, "delivery.log")
      File.open(safe_log, File::WRONLY | File::CREAT | File::EXCL, 0o600) do |file|
        file.write("bounded")
      end
      File.chmod(0o644, safe_log)
      validate_private_altool_logs!(safe_log_directory)

      oversized_log_directory = File.join(workspace, "oversized-altool-logs")
      Dir.mkdir(oversized_log_directory, 0o700)
      oversized_log = File.join(oversized_log_directory, "delivery.log")
      File.open(
        oversized_log,
        File::WRONLY | File::CREAT | File::EXCL,
        0o600
      ) do |file|
        file.truncate(DEMO_LAB_MAX_ALTOOL_LOG_BYTES + 1)
      end
      oversized_log_rejected = false
      begin
        validate_private_altool_logs!(oversized_log_directory)
      rescue FastlaneCore::Interface::FastlaneError
        oversized_log_rejected = true
      end
      unless oversized_log_rejected
        UI.user_error!("Oversized Apple altool log output was accepted.")
      end

      snapshot_workspace, snapshot_fixture, = prepare_demolab_project(
        source_commit: source_commit
      )
      begin
        fixture_plist = "fixtures/DemoLab/App/Info.plist"
        expected_blob = git_command_output(
          "rev-parse",
          "#{source_commit}:#{fixture_plist}"
        )
        observed_blob = git_command_output(
          "hash-object",
          File.join(snapshot_fixture, "App", "Info.plist")
        )
        unless observed_blob == expected_blob
          UI.user_error!("Immutable DemoLab source snapshot check failed.")
        end
      ensure
        FileUtils.rm_rf(snapshot_workspace)
      end

      UI.success("Unsigned DemoLab simulator fixture passed.")
    ensure
      FileUtils.rm_rf(workspace)
    end
  end

  desc "Create private LAB-002 authorization and build inputs outside Git"
  lane :demolab_prepare_lab002 do
    ensure_manual_lane!
    ensure_clean_source!
    source_commit = reviewed_main_source_commit
    xcode_toolchain = selected_xcode_toolchain

    app_identifier, share_identifier = demolab_bundle_identifiers
    app_group_identifier = required_environment(
      "DEMO_LAB_APP_GROUP_ID",
      pattern: /\Agroup\.[A-Za-z0-9][A-Za-z0-9.-]*\z/
    )
    if app_group_identifier.start_with?("group.com.example.")
      UI.user_error!("Use the registered first-party DemoLab App Group.")
    end
    team_identifier = required_environment(
      "DEMO_LAB_TEAM_ID",
      pattern: /\A[A-Z0-9]{10}\z/
    )
    marketing_version = ENV.fetch("DEMO_LAB_MARKETING_VERSION", "1.0").strip
    unless /\A[0-9]+(?:\.[0-9]+){0,2}\z/.match?(marketing_version)
      UI.user_error!("DEMO_LAB_MARKETING_VERSION has an invalid format.")
    end
    build_number = required_environment(
      "DEMO_LAB_BUILD_NUMBER",
      pattern: /\A[1-9][0-9]{0,17}\z/
    )
    unless marketing_version ==
             DEMO_LAB_LAB002_CHECKPOINT_3_MARKETING_VERSION &&
           build_number == DEMO_LAB_LAB002_CHECKPOINT_3_BUILD_NUMBER
      UI.user_error!(
        "This reviewed LAB-002 checkpoint only authorizes DemoLab 1.0 (3)."
      )
    end
    output_identity = private_output_directory
    output_root = output_identity.first
    unless /\A[0-9a-f]{40}\z/.match?(source_commit)
      UI.user_error!(
        "LAB-002 requires the frozen 40-hex source_commit wire format."
      )
    end

    result = nil
    final_name =
      "lab002-prebuild-#{marketing_version}-#{build_number}-#{source_commit}"
    with_locked_private_directory(
      output_root,
      output_identity,
      "DEMO_LAB_OUTPUT_DIR"
    ) do |output_handle|
      verify_locked_directory!(
        output_handle,
        output_root,
        output_identity,
        "DEMO_LAB_OUTPUT_DIR"
      )
      ensure_clean_source!
      unless reviewed_main_source_commit == source_commit
        UI.user_error!("LAB-002 source commit changed during preparation.")
      end
      result = with_lab002_publication_rollback!(
        output_handle,
        final_name
      ) do |arm_rollback|
        result = prepare_lab002_private_inputs!(
          output_root: output_root,
          output_handle: output_handle,
          output_identity: output_identity,
          source_commit: source_commit,
          marketing_version: marketing_version,
          build_number: build_number,
          app_identifier: app_identifier,
          share_identifier: share_identifier,
          app_group_identifier: app_group_identifier,
          team_identifier: team_identifier,
          xcode_toolchain: xcode_toolchain
        ) do |state|
          arm_rollback.call(state)
        end
        verify_locked_directory!(
          output_handle,
          output_root,
          output_identity,
          "DEMO_LAB_OUTPUT_DIR"
        )
        result
      end
    end
    UI.success(
      "Private LAB-002 inputs published: " \
      "#{result.fetch('prebuild_directory')}"
    )
  end

  desc "Archive and export one signed first-party DemoLab candidate outside Git"
  lane :demolab_archive do
    ensure_manual_lane!
    ensure_clean_source!
    reject_gym_environment_overrides!
    xcode_toolchain = selected_xcode_toolchain

    app_identifier, share_identifier = demolab_bundle_identifiers
    app_group_identifier = required_environment(
      "DEMO_LAB_APP_GROUP_ID",
      pattern: /\Agroup\.[A-Za-z0-9][A-Za-z0-9.-]*\z/
    )
    if app_group_identifier.start_with?("group.com.example.")
      UI.user_error!("Use the registered first-party DemoLab App Group.")
    end
    team_identifier = required_environment(
      "DEMO_LAB_TEAM_ID",
      pattern: /\A[A-Z0-9]{10}\z/
    )
    marketing_version = ENV.fetch("DEMO_LAB_MARKETING_VERSION", "1.0").strip
    unless /\A[0-9]+(?:\.[0-9]+){0,2}\z/.match?(marketing_version)
      UI.user_error!("DEMO_LAB_MARKETING_VERSION has an invalid format.")
    end
    build_number = required_environment(
      "DEMO_LAB_BUILD_NUMBER",
      pattern: /\A[1-9][0-9]{0,17}\z/
    )
    unless marketing_version ==
             DEMO_LAB_LAB002_CHECKPOINT_3_MARKETING_VERSION &&
           build_number == DEMO_LAB_LAB002_CHECKPOINT_3_BUILD_NUMBER
      UI.user_error!(
        "This reviewed LAB-002 checkpoint only authorizes DemoLab 1.0 (3)."
      )
    end

    output_identity = private_output_directory
    output_root = output_identity.first
    source_commit = reviewed_main_source_commit
    unless /\A[0-9a-f]{40}\z/.match?(source_commit)
      UI.user_error!(
        "LAB-002 requires the frozen 40-hex source_commit wire format."
      )
    end
    prebuild_directory = File.join(
      output_root,
      "lab002-prebuild-#{marketing_version}-#{build_number}-#{source_commit}"
    )
    prebuild_identity = private_directory_identity!(
      prebuild_directory,
      "LAB-002 prebuild directory"
    )
    run_directory = File.join(
      output_root,
      "#{marketing_version}-#{build_number}-#{source_commit[0, 12]}"
    )

    workspace, _, project, project_xcodegen_version =
      prepare_demolab_project(source_commit: source_commit)
    staging_directory = nil
    gym_scratch_root = nil
    published = false
    retain_staging = false
    begin
      with_locked_private_directory(
        output_root,
        output_identity,
        "DEMO_LAB_OUTPUT_DIR"
      ) do |output_handle|
        verify_locked_directory!(
          output_handle,
          output_root,
          output_identity,
          "DEMO_LAB_OUTPUT_DIR"
        )
        retained_staging_names =
          retained_demolab_staging_names!(output_handle)
        unless retained_staging_names.empty?
          UI.user_error!(
            "Reconcile retained DemoLab staging before retry: " \
            "#{retained_staging_names.join(', ')}"
          )
        end
        prebuild_inputs = nil
        with_locked_private_directory(
          prebuild_directory,
          prebuild_identity,
          "LAB-002 prebuild directory"
        ) do |prebuild_handle|
          prebuild_inputs = inspect_lab002_private_inputs!(
            prebuild_directory: prebuild_directory,
            prebuild_handle: prebuild_handle,
            prebuild_identity: prebuild_identity,
            source_commit: source_commit,
            marketing_version: marketing_version,
            build_number: build_number,
            app_identifier: app_identifier,
            share_identifier: share_identifier,
            app_group_identifier: app_group_identifier,
            team_identifier: team_identifier,
            xcode_toolchain: xcode_toolchain
          )
        end
        build_binding_sha256 =
          prebuild_inputs.fetch("build_binding_sha256")
        identity_nonce = prebuild_inputs.fetch("identity_nonce")
        authorization_public_key =
          prebuild_inputs.fetch("authorization_public_key")
        if File.exist?(run_directory) || File.symlink?(run_directory)
          UI.user_error!("Refusing to overwrite an existing DemoLab run directory.")
        end

        staging_directory = Dir.mktmpdir(".demolab-staging-", output_root)
        File.chmod(0o700, staging_directory)
        staging_identity = private_directory_identity!(
          staging_directory,
          "DemoLab staging directory"
        )
        with_locked_private_directory(
          staging_directory,
          staging_identity,
          "DemoLab staging directory"
        ) do |staging_handle|
          gym_scratch_root = File.join(
            staging_directory,
            ".gym-scratch-#{SecureRandom.hex(12)}"
          )
          gym_scratch_identity = create_exclusive_private_directory!(
            gym_scratch_root,
            "Gym scratch root",
            private_parent_identity: staging_identity
          )
          archive_path = File.join(staging_directory, "DemoLab.xcarchive")
          xcargs = [
            "-allowProvisioningUpdates",
            "CODE_SIGN_STYLE=Automatic",
            "CURRENT_PROJECT_VERSION=#{build_number}",
            "DEVELOPMENT_TEAM=#{team_identifier}",
            "DEMO_LAB_APP_BUNDLE_ID=#{app_identifier}",
            "DEMO_LAB_APP_GROUP_ID=#{app_group_identifier}",
            "DEMO_LAB_AUTHORIZATION_PUBLIC_KEY=" \
              "#{authorization_public_key}",
            "DEMO_LAB_FRAMEWORK_BUNDLE_ID=#{app_identifier}.framework",
            "DEMO_LAB_BUILD_BINDING_SHA256=#{build_binding_sha256}",
            "DEMO_LAB_IDENTITY_NONCE=#{identity_nonce}",
            "DEMO_LAB_KEYCHAIN_ACCESS_GROUP=" \
              "#{team_identifier}.#{app_identifier}",
            "DEMO_LAB_OBSERVER_REVISION=lab002-observer-v1",
            "DEMO_LAB_SHARE_BUNDLE_ID=#{share_identifier}",
            "DEMO_LAB_SOURCE_COMMIT=#{source_commit}",
            "MARKETING_VERSION=#{marketing_version}",
          ].shelljoin

          ipa_path = nil
          evidence_path = nil
          evidence_identity = nil
          oracle_result = nil
          with_pinned_xcode_environment(xcode_toolchain) do
            verify_selected_xcode_toolchain!(xcode_toolchain)
            tmpdir_was_set = ENV.key?("TMPDIR")
            previous_tmpdir = ENV["TMPDIR"]
            ENV["TMPDIR"] = gym_scratch_root
            begin
              ipa_path = build_app(
                project: project,
                scheme: "DemoLab",
                configuration: "Release",
                clean: true,
                sdk: "iphoneos",
                archive_path: archive_path,
                derived_data_path: File.join(workspace, "DerivedData"),
                output_directory: gym_scratch_root,
                output_name: "DemoLab-#{build_number}.ipa",
                buildlog_path: gym_scratch_root,
                export_method: "app-store",
                export_options: {
                  method: "app-store",
                  signingStyle: "automatic",
                  teamID: team_identifier,
                  manageAppVersionAndBuildNumber: false,
                },
                xcargs: xcargs,
                export_xcargs: "-allowProvisioningUpdates",
                result_bundle: true,
                result_bundle_path: File.join(
                  gym_scratch_root,
                  "DemoLab-#{build_number}.xcresult"
                ),
                xcodebuild_command: Shellwords.escape(
                  xcode_toolchain.dig("xcodebuild", "path")
                ),
                xcodebuild_formatter: ""
              )
            ensure
              if tmpdir_was_set
                ENV["TMPDIR"] = previous_tmpdir
              else
                ENV.delete("TMPDIR")
              end
            end
            gym_export_path = Gym.cache&.fetch(:temporary_output_path, nil)
            unless gym_export_path &&
                   Pathname.new(gym_export_path).absolute?
              UI.user_error!("Gym did not report its controlled export scratch path.")
            end
            gym_export_stat = File.lstat(gym_export_path)
            resolved_gym_export = File.realpath(gym_export_path)
            unless gym_export_stat.directory? &&
                   !gym_export_stat.symlink? &&
                   File.dirname(resolved_gym_export) == gym_scratch_identity.first
              UI.user_error!("Gym export scratch escaped the controlled staging root.")
            end
            unless private_directory_identity!(
              gym_scratch_root,
              "Gym scratch root"
            ) == gym_scratch_identity
              UI.user_error!("Gym scratch root changed during export.")
            end
            resolved_ipa = validate_regular_file_beneath_root!(
              ipa_path,
              gym_scratch_root,
              "Gym-exported DemoLab IPA"
            )
            staged_ipa = File.join(
              staging_directory,
              File.basename(resolved_ipa)
            )
            rename_exclusive_no_follow!(
              resolved_ipa,
              staged_ipa,
              "DemoLab IPA"
            )
            ipa_path = staged_ipa
            FileUtils.rm_rf(gym_scratch_root)
            if File.exist?(gym_scratch_root) || File.symlink?(gym_scratch_root)
              UI.user_error!("Unable to remove Gym export scratch artifacts.")
            end
            gym_scratch_root = nil
            verify_selected_xcode_toolchain!(xcode_toolchain)

            with_locked_private_directory(
              prebuild_directory,
              prebuild_identity,
              "LAB-002 prebuild directory"
            ) do |prebuild_handle|
              oracle_result = create_lab002_private_oracle!(
                prebuild_directory: prebuild_identity.first,
                prebuild_handle: prebuild_handle,
                prebuild_identity: prebuild_identity,
                run_directory: staging_identity.first,
                run_handle: staging_handle,
                run_identity: staging_identity,
                source_commit: source_commit,
                marketing_version: marketing_version,
                build_number: build_number,
                app_identifier: app_identifier,
                share_identifier: share_identifier,
                app_group_identifier: app_group_identifier,
                team_identifier: team_identifier,
                xcode_toolchain: xcode_toolchain,
                on_retention_change: ->(retain) { retain_staging = retain }
              )
              manifest_identity = lab002_published_artifact_identity!(
                prebuild_handle,
                DEMO_LAB_LAB002_MANIFEST_NAME
              )
              evidence_path, evidence_identity = write_pre_upload_evidence(
                run_directory: staging_directory,
                archive_path: archive_path,
                ipa_path: ipa_path,
                oracle_result: oracle_result,
                manifest_identity: manifest_identity,
                prebuild_inputs: prebuild_inputs,
                source_commit: source_commit,
                xcodegen_version: project_xcodegen_version,
                marketing_version: marketing_version,
                build_number: build_number,
                app_identifier: app_identifier,
                share_identifier: share_identifier,
                xcode_toolchain: xcode_toolchain
              )
            end
            verify_selected_xcode_toolchain!(xcode_toolchain)
          end
          publish_verified_lab002_staged_run!(
            output_handle: output_handle,
            output_root: output_root,
            output_identity: output_identity,
            run_directory: run_directory,
            staging_handle: staging_handle,
            staging_directory: staging_directory,
            staging_identity: staging_identity,
            archive_path: archive_path,
            ipa_path: ipa_path,
            evidence_path: evidence_path,
            evidence_identity: evidence_identity,
            oracle_result: oracle_result,
            on_publication_change: lambda do
              published = true
              retain_staging = true
              staging_directory = nil
            end
          )
          retain_staging = false

          published_ipa = File.join(
            run_directory,
            File.basename(ipa_path)
          )
          published_evidence = File.join(
            run_directory,
            File.basename(evidence_path)
          )
          published_oracle = File.join(
            run_directory,
            oracle_result.fetch("oracle_name")
          )
          UI.success("Created first-party archive candidate: #{published_ipa}")
          UI.success("Created private LAB-002 oracle: #{published_oracle}")
          UI.success("Created pre-upload evidence: #{published_evidence}")
        end
      end
    ensure
      FileUtils.rm_rf(gym_scratch_root) if gym_scratch_root && !published
      cleanup_unpublished_demolab_staging!(
        staging_directory,
        published: published,
        retain_staging: retain_staging
      )
      FileUtils.rm_rf(workspace)
    end
  end

  desc "Reconcile and archive one indeterminate DemoLab upload result"
  lane :demolab_reconcile_indeterminate_upload do
    ensure_manual_lane!
    ensure_clean_source!
    reject_pilot_environment_overrides!
    confirmation = required_environment(
      "DEMO_LAB_CONFIRM_RETRY_AFTER_RECONCILIATION"
    )
    unless confirmation == DEMO_LAB_RETRY_CONFIRMATION
      UI.user_error!(
        "Explicit confirmation that the exact build is absent is missing."
      )
    end
    expected_attempt_started_at = required_environment(
      "DEMO_LAB_RECONCILED_ATTEMPT_STARTED_AT"
    )
    unless valid_utc_timestamp?(expected_attempt_started_at)
      UI.user_error!("The reconciled upload-attempt timestamp is invalid.")
    end

    evidence_path, evidence = load_demolab_evidence
    result_path = File.join(
      File.dirname(evidence_path),
      "demolab-upload-result.json"
    )
    archive_path, = reconcile_indeterminate_upload_result!(
      result_path,
      evidence,
      expected_attempt_started_at: expected_attempt_started_at
    )
    UI.success(
      "Archived the reconciled absent upload attempt: #{archive_path}"
    )
    UI.important(
      "A new upload attempt is now permitted. Recheck the exact account, " \
      "version, build number, and evidence before running the upload lane."
    )
  end

  desc "Explicitly upload the evidence-bound first-party IPA to TestFlight"
  lane :demolab_upload_testflight do
    ensure_manual_lane!
    ensure_clean_source!
    reject_pilot_environment_overrides!
    xcode_toolchain = selected_xcode_toolchain
    altool = selected_altool(xcode_toolchain)
    confirmation = required_environment("DEMO_LAB_CONFIRM_UPLOAD")
    unless confirmation == "I_OWN_AND_AUTHORIZE_THIS_FIRST_PARTY_FIXTURE"
      UI.user_error!("Explicit first-party upload confirmation is missing.")
    end

    app_identifier, share_identifier = demolab_bundle_identifiers
    evidence_path, evidence, ipa_path, archive_path = load_upload_evidence(
      app_identifier: app_identifier,
      share_identifier: share_identifier,
      xcode_toolchain: xcode_toolchain
    )
    verify_selected_xcode_toolchain!(xcode_toolchain)
    key_id = required_environment(
      "APP_STORE_CONNECT_KEY_ID",
      pattern: /\A[A-Z0-9]{10}\z/
    )
    key_type = required_environment(
      "APP_STORE_CONNECT_KEY_TYPE",
      pattern: /\A(?:team|individual)\z/
    )
    team_issuer_id =
      if key_type == "team"
        required_environment(
          "APP_STORE_CONNECT_ISSUER_ID",
          pattern: /\A[0-9a-fA-F-]{36}\z/
        )
      else
        if ENV.key?("APP_STORE_CONNECT_ISSUER_ID")
          UI.user_error!(
            "APP_STORE_CONNECT_ISSUER_ID must be unset for an individual API key."
          )
        end
        nil
      end
    apple_id = required_environment(
      "DEMO_LAB_APPLE_ID",
      pattern: /\A[0-9]{5,20}\z/
    )

    result_path = File.join(
      File.dirname(evidence_path),
      "demolab-upload-result.json"
    )
    key_content = nil
    key_snapshot = nil
    upload_snapshot = nil
    upload_snapshot_path = nil
    upload_snapshot_identity = nil
    upload_workspace_identity = nil
    result_file = nil
    attempt_recorded = false
    upload_accepted = false
    begin
      key_content = private_external_file_snapshot(
        "APP_STORE_CONNECT_KEY_PATH",
        DEMO_LAB_MAX_API_KEY_BYTES,
        "App Store Connect API key"
      )
      key_snapshot = open_unlinked_snapshot_from_content(
        key_content,
        label: "App Store Connect API key",
        suffix: ".p8"
      )
      key_content.clear
      key_content = nil
      upload_snapshot,
        upload_snapshot_path,
      upload_snapshot_identity,
        upload_workspace_identity = stage_evidence_bound_ipa(
          ipa_path,
          evidence
        )
      verify_lab002_upload_gate!(
        evidence_path,
        evidence,
        xcode_toolchain: xcode_toolchain
      )
      attempt = {
        "schema_version" => 1,
        "source_commit" => evidence.dig("source", "commit"),
        "ipa_sha256" => evidence.dig("artifacts", "ipa", "sha256"),
        "attempt_started_at" => Time.now.utc.iso8601,
        "destination" => "TestFlight internal preparation",
        "external_distribution" => false,
        "status" => "indeterminate",
        "note" => DEMO_LAB_UPLOAD_INDETERMINATE_NOTE,
      }
      result_file = publish_new_private_json_record!(
        result_path,
        attempt,
        "upload result"
      )
      attempt_recorded = true

      upload_demolab_with_altool!(
        ipa_snapshot: upload_snapshot,
        ipa_snapshot_path: upload_snapshot_path,
        ipa_snapshot_identity: upload_snapshot_identity,
        ipa_workspace_identity: upload_workspace_identity,
        key_snapshot: key_snapshot,
        archive_path: archive_path,
        evidence: evidence,
        altool: altool,
        xcode_toolchain: xcode_toolchain,
        key_id: key_id,
        key_type: key_type,
        team_issuer_id: team_issuer_id,
        apple_id: apple_id,
        app_identifier: app_identifier,
        marketing_version: evidence.dig("build", "marketing_version"),
        build_number: evidence.dig("build", "build_number")
      )
      verify_locked_ipa_snapshot!(
        upload_snapshot,
        upload_snapshot_path,
        upload_snapshot_identity,
        upload_workspace_identity
      )

      result = {
        "schema_version" => 1,
        "source_commit" => evidence.dig("source", "commit"),
        "ipa_sha256" => evidence.dig("artifacts", "ipa", "sha256"),
        "attempt_started_at" => attempt["attempt_started_at"],
        "uploaded_at" => Time.now.utc.iso8601,
        "destination" => "TestFlight internal preparation",
        "external_distribution" => false,
        "status" => "accepted",
        "note" =>
          "Apple altool returned explicit success without product-errors for " \
          "the evidence-bound upload; confirm TestFlight readiness in " \
          "App Store Connect. This does not establish installed lineage, " \
          "protection, or plaintext.",
      }
      accepted_result_file = replace_locked_private_json_record!(
        result_path,
        result_file,
        result,
        "upload result"
      )
      result_file.flock(File::LOCK_UN)
      result_file.close
      result_file = accepted_result_file
      upload_accepted = true
      UI.success("Recorded sanitized upload result: #{result_path}")
    ensure
      result_file&.close
      key_content&.clear
      key_snapshot&.close
      if upload_snapshot
        upload_snapshot.flock(File::LOCK_UN) rescue nil
        upload_snapshot.close rescue nil
      end
      if upload_snapshot_path
        FileUtils.rm_rf(File.dirname(upload_snapshot_path))
      end
      if attempt_recorded && !upload_accepted
        UI.important(
          "The upload result remains indeterminate. Reconcile the exact " \
          "version, build, and IPA SHA-256 in App Store Connect before retrying."
        )
      end
    end
  end
end
