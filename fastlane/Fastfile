          xcode_toolchain.dig("plutil", "path"),
          "-extract",
          "CFBundleIdentifier",
          "raw",
          plist
        )
        unless observed_identifier == expected_identifier
          UI.user_error!("Unexpected DemoLab bundle identifier.")
        end
      end

      UI.user_error!("DemoLab asset catalog is missing.") unless File.file?(
        File.join(application, "Assets.car")
      )
      unless command_output(
        xcode_toolchain.dig("plutil", "path"),
        "-extract",
        "ITSAppUsesNonExemptEncryption",
        "raw",
        File.join(application, "Info.plist")
      ) == "false"
        UI.user_error!("DemoLab export-compliance declaration is missing.")
      end

      package_root = File.join(workspace, "Package")
      payload = File.join(package_root, "Payload")
      FileUtils.mkdir_p(payload)
      FileUtils.cp_r(application, payload)
      check_ipa = File.join(workspace, "DemoLab-check.ipa")
      sh(
        "/usr/bin/ditto",
        "-c",
        "-k",
        "--norsrc",
        "--keepParent",
        payload,
        check_ipa
      )
      Zip::File.open(check_ipa) do |archive|
        info = archive.find_entry("Payload/DemoLab.app/Info.plist")
        unless info&.incomplete?
          UI.user_error!("DemoLab check IPA did not exercise ZIP data descriptors.")
        end
      end
      packaged = inspect_demolab_ipa!(
        check_ipa,
        app_identifier: "com.example.orchardprobe.demolab",
        share_identifier: "com.example.orchardprobe.demolab.share",
        marketing_version: "1.0",
        build_number: "1",
        xcode_toolchain: xcode_toolchain
      )
      unless packaged["archive"] == {
        "size" => File.size(check_ipa),
        "sha256" => sha256(check_ipa),
      }
        UI.user_error!("DemoLab IPA inspection did not bind the measured bytes.")
      end
      statuses_valid = packaged["binaries"].all? do |binary|
        binary["initial_protection_status"] == "not_observed" &&
          binary["expected_plaintext_status"] == "candidate_pre_upload_archive_only"
      end
      UI.user_error!("DemoLab package evidence status is incomplete.") unless statuses_valid

      source_commit = git_command_output("rev-parse", "HEAD")
      complete_evidence = {
        "schema_version" => 1,
        "profile" => DEMO_LAB_EVIDENCE_PROFILE,
        "purpose" => DEMO_LAB_EVIDENCE_PURPOSE,
        "decision" => DEMO_LAB_EVIDENCE_DECISION,
        "created_at" => Time.now.utc.iso8601,
        "source" => {
          "commit" => source_commit,
          "tree_clean" => true,
          "fixture" => "fixtures/DemoLab",
        },
        "toolchain" => {
          "fastlane_version" => Fastlane::VERSION,
          "xcodegen_version" => selected_xcodegen[1],
          "xcode" => xcode_toolchain.fetch("xcode_version"),
          "iphoneos_sdk_version" =>
            xcode_toolchain.fetch("iphoneos_sdk_version"),
          "iphoneos_sdk_build" =>
            xcode_toolchain.fetch("iphoneos_sdk_build"),
        },
        "build" => {
          "configuration" => "Release",
          "marketing_version" => "1.0",
          "build_number" => "1",
          "distribution" => "app-store",
          "bundle_identifiers" =>
            "operator-provided first-party identifiers; redacted",
        },
        "artifacts" => {
          "ipa" => {
            "filename" => "DemoLab-1.ipa",
            "size" => File.size(check_ipa),
            "sha256" => sha256(check_ipa),
          },
          "archive_binaries" => expected_binaries.each_with_index.map do |path, index|
            specification = DEMO_LAB_BINARY_SPECS[index]
            binary_evidence(
              path,
              specification["relative_path"],
              specification["role"],
              xcode_toolchain: xcode_toolchain
            )
          end,
          "package" => packaged.reject do |key, _|
            ["archive", "binaries"].include?(key)
          end,
          "ipa_binaries" => packaged["binaries"],
        },
        "lineage" => {
          "uploaded_ipa_bound" => false,
          "installed_artifact_bound" => false,
          "note" => DEMO_LAB_LINEAGE_NOTE,
        },
      }
      validate_upload_evidence_structure!(complete_evidence)
      unbound_lab002_evidence = JSON.parse(JSON.generate(complete_evidence))
      unbound_lab002_evidence["build"]["build_number"] =
        DEMO_LAB_LAB002_CHECKPOINT_3_BUILD_NUMBER
      unbound_lab002_evidence["artifacts"]["ipa"]["filename"] =
        "DemoLab-#{DEMO_LAB_LAB002_CHECKPOINT_3_BUILD_NUMBER}.ipa"
      unbound_lab002_rejected = false
      begin
        validate_upload_evidence_structure!(unbound_lab002_evidence)
      rescue FastlaneCore::Interface::FastlaneError
        unbound_lab002_rejected = true
      end
      unless unbound_lab002_rejected
        UI.user_error!("LAB-002 evidence without its closed binding was accepted.")
      end
      bound_lab002_evidence = JSON.parse(JSON.generate(unbound_lab002_evidence))
      bound_lab002_evidence["lab002"] = {
        "build_binding_sha256" => "4" * 64,
        "target_identity_set_sha256" => "5" * 64,
        "authorized_target_manifest" => {
          "name" => DEMO_LAB_LAB002_MANIFEST_NAME,
          "device" => "1",
          "inode" => "2",
          "mode" => 0o400,
          "size" => 1024,
          "sha256" => "6" * 64,
        },
        "oracle" => {
          "name" => DEMO_LAB_LAB002_ORACLE_NAME,
          "device" => "1",
          "inode" => "3",
          "mode" => 0o400,
          "size" => 2048,
          "sha256" => "7" * 64,
        },
      }
      validate_upload_evidence_structure!(bound_lab002_evidence)
      altered_oracle_binding = JSON.parse(JSON.generate(bound_lab002_evidence))
      altered_oracle_binding["lab002"]["oracle"]["mode"] = 0o600
      altered_oracle_binding_rejected = false
      begin
        validate_upload_evidence_structure!(altered_oracle_binding)
      rescue FastlaneCore::Interface::FastlaneError
        altered_oracle_binding_rejected = true
