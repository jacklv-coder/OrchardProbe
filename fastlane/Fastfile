      private_key = File.join(workspace, "AuthKey_TEST.p8")
      File.write(private_key, "private-key-snapshot")
      File.chmod(0o600, private_key)
      previous_key = ENV["APP_STORE_CONNECT_KEY_PATH"]
      ENV["APP_STORE_CONNECT_KEY_PATH"] = private_key
      key_snapshot = private_external_file_snapshot(
        "APP_STORE_CONNECT_KEY_PATH",
        DEMO_LAB_MAX_API_KEY_BYTES,
        "App Store Connect API key"
      )
      File.write(private_key, "replacement")
      unless key_snapshot == "private-key-snapshot"
        UI.user_error!("App Store Connect API key snapshot was mutable.")
      end
      key_snapshot.clear
      key_link = File.join(workspace, "AuthKey_LINK.p8")
      File.symlink(private_key, key_link)
      ENV["APP_STORE_CONNECT_KEY_PATH"] = key_link
      key_link_rejected = false
      begin
        private_external_file_snapshot(
          "APP_STORE_CONNECT_KEY_PATH",
          DEMO_LAB_MAX_API_KEY_BYTES,
          "App Store Connect API key"
        )
      rescue FastlaneCore::Interface::FastlaneError
        key_link_rejected = true
      ensure
        if previous_key
          ENV["APP_STORE_CONNECT_KEY_PATH"] = previous_key
        else
          ENV.delete("APP_STORE_CONNECT_KEY_PATH")
        end
      end
      UI.user_error!("Symbolic-link API key was accepted.") unless key_link_rejected

      key_fifo = File.join(workspace, "AuthKey_FIFO.p8")
      File.mkfifo(key_fifo, 0o600)
      ENV["APP_STORE_CONNECT_KEY_PATH"] = key_fifo
      key_fifo_rejected = false
      begin
        private_external_file_snapshot(
          "APP_STORE_CONNECT_KEY_PATH",
          DEMO_LAB_MAX_API_KEY_BYTES,
          "App Store Connect API key"
        )
      rescue FastlaneCore::Interface::FastlaneError
        key_fifo_rejected = true
      ensure
        if previous_key
          ENV["APP_STORE_CONNECT_KEY_PATH"] = previous_key
        else
          ENV.delete("APP_STORE_CONNECT_KEY_PATH")
        end
      end
      UI.user_error!("FIFO API key was accepted.") unless key_fifo_rejected

      previous_pilot_changelog = ENV["PILOT_CHANGELOG"]
      ENV["PILOT_CHANGELOG"] = "unexpected metadata override"
      pilot_override_rejected = false
      begin
        reject_pilot_environment_overrides!
      rescue FastlaneCore::Interface::FastlaneError
        pilot_override_rejected = true
      ensure
        if previous_pilot_changelog
          ENV["PILOT_CHANGELOG"] = previous_pilot_changelog
        else
          ENV.delete("PILOT_CHANGELOG")
        end
      end
      unless pilot_override_rejected
        UI.user_error!("Fastlane Pilot environment override was accepted.")
      end

      previous_demo_account_required = ENV["DEMO_ACCOUNT_REQUIRED"]
      ENV["DEMO_ACCOUNT_REQUIRED"] = "true"
      demo_account_override_rejected = false
      begin
        reject_pilot_environment_overrides!
      rescue FastlaneCore::Interface::FastlaneError
        demo_account_override_rejected = true
      ensure
        if previous_demo_account_required
          ENV["DEMO_ACCOUNT_REQUIRED"] = previous_demo_account_required
        else
          ENV.delete("DEMO_ACCOUNT_REQUIRED")
        end
      end
      unless demo_account_override_rejected
        UI.user_error!("Fastlane demo-account environment override was accepted.")
      end

      previous_gym_result_bundle_path = ENV["GYM_RESULT_BUNDLE_PATH"]
      ENV["GYM_RESULT_BUNDLE_PATH"] = File.join(
        repository_root,
        "unexpected.xcresult"
      )
      gym_override_rejected = false
      begin
        reject_gym_environment_overrides!
      rescue FastlaneCore::Interface::FastlaneError
        gym_override_rejected = true
      ensure
        if previous_gym_result_bundle_path
          ENV["GYM_RESULT_BUNDLE_PATH"] = previous_gym_result_bundle_path
        else
          ENV.delete("GYM_RESULT_BUNDLE_PATH")
        end
