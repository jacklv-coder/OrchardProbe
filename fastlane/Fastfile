module DemoLabDarwin
  extend Fiddle::Importer
  dlload Fiddle.dlopen(nil)
  extern "int fchdir(int)"
  extern "int mkdirat(int, const char *, unsigned int)"
  extern "int openat(int, const char *, int, unsigned int)"
  extern "int renamex_np(const char *, const char *, unsigned int)"
  extern "int unlinkat(int, const char *, int)"
  extern "int csops(int, unsigned int, void *, size_t)"

  RENAME_EXCL = 0x00000004
  RENAME_NOFOLLOW_ANY = 0x00000010
  AT_REMOVEDIR = 0x00000080
  F_GETPATH = 50
  MAXPATHLEN = 1024
end

class Lab002DigestingReader
  attr_reader :digest

  def initialize(io)
    @io = io
    @digest = Digest::SHA256.new
  end

  def read(*arguments)
    bytes = @io.read(*arguments)
    @digest.update(bytes) if bytes
    bytes
  end

  def readpartial(*arguments)
    bytes = @io.readpartial(*arguments)
    @digest.update(bytes)
    bytes
  end
end

