      replacement_source = File.join(helper_workspace, "replacement.c")
      helper_path = File.join(helper_workspace, "helper")
      replacement_path = File.join(helper_workspace, "replacement-helper")
      File.write(
        blocking_source,
        "#include <unistd.h>\n" \
        "int main(void) { char value; " \
        "return read(0, &value, 1) == 1 ? 0 : 1; }\n"
      )
      File.write(
        replacement_source,
        "#include <unistd.h>\n" \
        "int main(void) { char value; " \
        "return read(0, &value, 1) == 1 ? 0 : 2; }\n"
      )
      clang_path = command_output("/usr/bin/xcrun", "--find", "clang")
      clang = pinned_executable(
        clang_path,
        "Selected Xcode clang",
        required_root: File.dirname(File.dirname(File.dirname(clang_path)))
      )
      codesign = pinned_executable(
        "/usr/bin/codesign",
        "System codesign"
      )
      macos_sdk = command_output(
        "/usr/bin/xcrun",
        "--sdk",
        "macosx",
        "--show-sdk-path"
      )
      command_output(
        clang.fetch("path"),
        "-isysroot",
        macos_sdk,
        blocking_source,
        "-o",
        helper_path
      )
      command_output(
        codesign.fetch("path"),
        "--force",
        "--sign",
        "-",
        "--timestamp=none",
        helper_path
      )
      unless pinned_executable(
        "/usr/bin/codesign",
        "System codesign"
      ) == codesign
        UI.user_error!("System codesign changed during the regression.")
      end
      File.chmod(0o500, helper_path)
      helper_identity = lab002_private_tool_identity!(helper_path)
      command_output(
        clang.fetch("path"),
        "-isysroot",
        macos_sdk,
        replacement_source,
        "-o",
        replacement_path
      )
      command_output(
        codesign.fetch("path"),
        "--force",
        "--sign",
        "-",
        "--timestamp=none",
        replacement_path
      )
      unless pinned_executable(
        "/usr/bin/codesign",
        "System codesign"
      ) == codesign
        UI.user_error!("System codesign changed during the regression.")
      end
      File.chmod(0o500, replacement_path)
      replacement_identity =
        lab002_private_tool_identity!(replacement_path)

      Open3.popen3(
        sanitized_dynamic_loader_environment,
        replacement_path,
        close_others: true
      ) do |stdin, stdout, stderr, wait_thread|
        replacement_rejected = false
        begin
          verify_running_lab002_private_tool!(
            wait_thread.pid,
            replacement_identity
          )
          begin
            verify_running_lab002_private_tool!(
              wait_thread.pid,
              helper_identity
            )
          rescue FastlaneCore::Interface::FastlaneError
            replacement_rejected = true
          end
          stdin.write("x")
          stdin.close
          unless wait_thread.value.success? &&
                 replacement_rejected &&
                 stdout.read.empty? &&
                 stderr.read.empty?
            UI.user_error!(
              "LAB-002 running helper identity regression failed."
            )
          end
        ensure
          unless wait_thread.join(0)
            Process.kill("TERM", wait_thread.pid)
            wait_thread.join
          end
        end
      end
    end

    Dir.mktmpdir(
      "orchardprobe-lab002-held-source-check-",
      external_temporary_base
    ) do |held_workspace|
      File.chmod(0o700, held_workspace)
      held_source = File.join(held_workspace, "reviewed-source")
      moved_source = File.join(held_workspace, "moved-source")
      held_marker = File.join(held_source, "marker")
      Dir.mkdir(held_source, 0o700)
      File.write(held_marker, "reviewed\n")
      File.chmod(0o400, held_marker)
      File.chmod(0o500, held_source)
      held_stat = File.lstat(held_source)
      held_handle = File.open(
        held_source,
        File::RDONLY | File::NOFOLLOW
      )
      begin
        held_identity = [held_stat.dev, held_stat.ino]
        verify_held_lab002_source_directory!(
          held_source,
          held_handle,
          held_identity
        )
        File.chmod(0o700, held_source)
        File.rename(held_source, moved_source)
        File.chmod(0o500, moved_source)
        Dir.mkdir(held_source, 0o700)
        File.write(File.join(held_source, "marker"), "replacement\n")
        File.chmod(0o500, held_source)
        substitution_rejected = false
        begin
          verify_held_lab002_source_directory!(
            held_source,
            held_handle,
            held_identity
          )
        rescue FastlaneCore::Interface::FastlaneError
          substitution_rejected = true
        end
        held_stdout, held_stderr, held_status =
          capture3_in_held_directory(
            {},
            held_handle,
            "/bin/cat",
            "marker"
          )
        unless substitution_rejected &&
               held_status.success? &&
               held_stdout == "reviewed\n" &&
               held_stderr.empty?
          UI.user_error!(
            "LAB-002 held source directory regression failed."
          )
        end
      ensure
        held_handle.close
        [
          File.join(moved_source, "marker"),
          File.join(held_source, "marker"),
        ].each do |path|
          File.chmod(0o600, path) if File.exist?(path)
        end
        [moved_source, held_source].each do |path|
          File.chmod(0o700, path) if File.directory?(path)
        end
      end
    end

    Dir.mktmpdir(
      "orchardprobe-lab002-git-replace-check-",
      external_temporary_base
    ) do |replacement_workspace|
      replacement_repository =
        File.join(replacement_workspace, "repository")
      replacement_snapshot =
        File.join(replacement_workspace, "snapshot")
      attribute_snapshot =
        File.join(replacement_workspace, "attribute-snapshot")
      Dir.mkdir(replacement_repository, 0o700)
      Dir.mkdir(replacement_snapshot, 0o700)
      Dir.mkdir(attribute_snapshot, 0o700)
      command_output(
        "/usr/bin/git",
        "init",
        "--quiet",
        chdir: replacement_repository
      )
      original_cargo =
        "[workspace]\nresolver = \"2\"\n# $Format:%H$\n"
      replacement_cargo = "[workspace]\nresolver = \"1\"\n"
      {
        "Cargo.toml" => original_cargo,
        "Cargo.lock" => "version = 4\n",
        "Gemfile.lock" => "BUNDLED WITH\n   4.0.16\n",
        "rust-toolchain.toml" =>
          "[toolchain]\nchannel = \"1.85.0\"\n",
      }.each do |name, content|
        File.write(
          File.join(replacement_repository, name),
          content
        )
      end
      replacement_crates =
        File.join(replacement_repository, "crates")
      Dir.mkdir(replacement_crates, 0o700)
      File.write(
        File.join(replacement_crates, "reviewed.txt"),
        "reviewed\n"
      )
      command_output(
        "/usr/bin/git",
        "add",
        "--",
        "Cargo.toml",
        "Cargo.lock",
        "Gemfile.lock",
        "rust-toolchain.toml",
        "crates",
        chdir: replacement_repository
      )
      command_output(
        "/usr/bin/git",
        "-c",
        "user.name=OrchardProbe",
        "-c",
        "user.email=orchardprobe@example.invalid",
        "commit",
        "--quiet",
        "-m",
        "reviewed",
        chdir: replacement_repository
      )
      reviewed_commit = command_output(
        "/usr/bin/git",
        "rev-parse",
        "HEAD",
        chdir: replacement_repository
      )
      File.write(
        File.join(replacement_repository, "Cargo.toml"),
        replacement_cargo
      )
      command_output(
        "/usr/bin/git",
        "add",
        "--",
        "Cargo.toml",
        chdir: replacement_repository
      )
      command_output(
        "/usr/bin/git",
        "-c",
        "user.name=OrchardProbe",
        "-c",
        "user.email=orchardprobe@example.invalid",
        "commit",
        "--quiet",
        "-m",
        "replacement",
        chdir: replacement_repository
      )
      replacement_commit = command_output(
        "/usr/bin/git",
        "rev-parse",
        "HEAD",
        chdir: replacement_repository
      )
      File.write(
        File.join(replacement_crates, "reviewed.txt"),
        "replacement chain\n"
      )
      command_output(
        "/usr/bin/git",
        "add",
        "--",
        "crates/reviewed.txt",
        chdir: replacement_repository
      )
      command_output(
        "/usr/bin/git",
        "-c",
        "user.name=OrchardProbe",
        "-c",
        "user.email=orchardprobe@example.invalid",
        "commit",
        "--quiet",
        "-m",
        "replacement chain",
        chdir: replacement_repository
      )
      replacement_chain_commit = command_output(
        "/usr/bin/git",
        "rev-parse",
        "HEAD",
        chdir: replacement_repository
      )
      command_output(
        "/usr/bin/git",
        "replace",
        reviewed_commit,
        replacement_chain_commit,
        chdir: replacement_repository
      )
      ancestry_stdout, ancestry_stderr, replaced_ancestry_status =
        Open3.capture3(
          trusted_git_environment,
          "/usr/bin/git",
          "merge-base",
          "--is-ancestor",
          replacement_commit,
          reviewed_commit,
          chdir: replacement_repository,
          unsetenv_others: true
        )
      unless ancestry_stdout.empty? &&
             ancestry_stderr.empty? &&
             replaced_ancestry_status.success? &&
             !git_ancestor_without_replacements?(
               replacement_repository,
               replacement_commit,
               reviewed_commit
             )
        UI.user_error!(
          "LAB-002 reviewed ancestry followed a Git replacement ref."
        )
      end
      replaced_view = command_output(
        "/usr/bin/git",
        "show",
        "#{reviewed_commit}:Cargo.toml",
        chdir: replacement_repository
      )
      lab002_stream_reviewed_source_archive!(
        replacement_repository,
        replacement_snapshot,
        reviewed_commit,
        %w[
          Cargo.toml
          Cargo.lock
          Gemfile.lock
          rust-toolchain.toml
          crates
        ]
      )
      unless replaced_view == replacement_cargo.strip &&
             File.binread(
               File.join(replacement_snapshot, "Cargo.toml")
             ) == original_cargo
        UI.user_error!(
          "LAB-002 reviewed source archive followed a Git replacement ref."
        )
      end
      File.write(
        File.join(
          replacement_repository,
          ".git",
          "info",
          "attributes"
        ),
        "Cargo.toml export-subst\n"
      )
      local_attributes_rejected = false
      begin
        lab002_stream_reviewed_source_archive!(
          replacement_repository,
          attribute_snapshot,
          reviewed_commit,
          %w[
            Cargo.toml
            Cargo.lock
            Gemfile.lock
            rust-toolchain.toml
            crates
          ]
        )
      rescue FastlaneCore::Interface::FastlaneError => error
        local_attributes_rejected =
          error.message.include?("does not match the exact Git blobs")
      end
      unless local_attributes_rejected
        UI.user_error!(
          "LAB-002 accepted repository-local archive attributes."
        )
      end
    end

    if parser_commit.length == 40
      source_snapshot_workspace =
        external_temporary_directory(
          "orchardprobe-lab002-reviewed-source-check-"
        )
      begin
        legacy_archive_path =
          File.join(source_snapshot_workspace, "reviewed-source.tar")
        File.write(legacy_archive_path, "must remain untouched")
        snapshot_root, snapshot_sha256, gemfile_lock_sha256 =
          lab002_reviewed_source_snapshot!(
            source_snapshot_workspace,
            parser_commit
          )
        expected_cargo_lock_blob = git_command_output(
          "rev-parse",
          "#{parser_commit}:Cargo.lock"
        )
        observed_cargo_lock_blob = git_command_output(
          "hash-object",
          File.join(snapshot_root, "Cargo.lock")
        )
        expected_gemfile_lock_blob = git_command_output(
          "rev-parse",
          "#{parser_commit}:Gemfile.lock"
        )
        observed_gemfile_lock_blob = git_command_output(
          "hash-object",
          File.join(snapshot_root, "Gemfile.lock")
        )
        unless expected_cargo_lock_blob == observed_cargo_lock_blob &&
               expected_gemfile_lock_blob == observed_gemfile_lock_blob &&
               gemfile_lock_sha256 ==
                 lab002_reviewed_snapshot_file_sha256!(
                   snapshot_root,
                   "Gemfile.lock"
                 ) &&
               snapshot_sha256 == lab002_rust_toolchain_tree_sha256(
                 snapshot_root,
                 "LAB-002 reviewed source snapshot"
               ) &&
               File.binread(legacy_archive_path) == "must remain untouched"
          UI.user_error!(
            "LAB-002 reviewed source snapshot is not bound to its commit."
          )
        end
        Find.find(snapshot_root) do |path|
          stat = File.lstat(path)
          expected_mode = stat.directory? ? 0o500 : 0o400
          unless (stat.mode & 0o777) == expected_mode
            UI.user_error!(
              "LAB-002 reviewed source snapshot is not read-only."
            )
          end
        end
      ensure
        lab002_remove_readonly_workspace!(
          source_snapshot_workspace,
          "LAB-002 reviewed source workspace"
        )
      end
    end

    Dir.mktmpdir(
      "orchardprobe-lab002-cargo-home-check-",
      external_temporary_base
    ) do |configured_cargo_home|
      File.chmod(0o700, configured_cargo_home)
      previous_cargo_home = ENV["CARGO_HOME"]
      begin
        ENV["CARGO_HOME"] = configured_cargo_home
        unless lab002_configured_cargo_home == File.realpath(
          configured_cargo_home
        )
          UI.user_error!("LAB-002 ignored the configured Cargo home.")
        end
      ensure
        if previous_cargo_home
          ENV["CARGO_HOME"] = previous_cargo_home
        else
          ENV.delete("CARGO_HOME")
        end
      end
    end

    sandbox_vendor_workspace =
      external_temporary_directory(
        "orchardprobe-lab002-sandbox-vendor-check-"
      )
    begin
      sandbox_vendor_root =
        File.join(sandbox_vendor_workspace, "verified-vendor")
      Dir.mkdir(sandbox_vendor_root, 0o700)
      sandbox_vendor_file =
        File.join(sandbox_vendor_root, "Cargo.toml")
      File.write(sandbox_vendor_file, "[package]\nname = \"check\"\n")
      File.chmod(0o400, sandbox_vendor_file)
      File.chmod(0o500, sandbox_vendor_root)
      Dir.mktmpdir(
        "orchardprobe-lab002-sandbox-build-check-",
        external_temporary_base
      ) do |sandbox_build_workspace|
        sandbox_exec, sandbox_profile, = lab002_private_build_sandbox!(
          workspace: sandbox_build_workspace,
          toolchain_root: repository_root,
          vendor_root: sandbox_vendor_root,
          source_root: repository_root
        )
        _, _, mutation_status = Open3.capture3(
          sanitized_dynamic_loader_environment,
          sandbox_exec.fetch("path"),
          "-f",
          sandbox_profile,
          "/bin/chmod",
          "0700",
          sandbox_vendor_root,
          unsetenv_others: true
        )
        if mutation_status.success? ||
           (File.stat(sandbox_vendor_root).mode & 0o777) != 0o500
          UI.user_error!(
            "The LAB-002 build sandbox allowed verified-source mutation."
          )
        end
      end
    ensure
      lab002_remove_verified_vendor!(sandbox_vendor_workspace)
    end

    workspace, _, project = prepare_demolab_project
    begin
      shadow_tools = File.join(workspace, "shadow-developer-tools")
      Dir.mkdir(shadow_tools, 0o700)
      %w[xcodebuild xcrun plutil dwarfdump lipo otool xcodegen].each do |name|
        shadow_path = File.join(shadow_tools, name)
        File.write(shadow_path, "#!/bin/sh\nprintf 'shadow-tool\\n'\n")
        File.chmod(0o500, shadow_path)
      end
      previous_path = ENV["PATH"]
      ENV["PATH"] = "#{shadow_tools}:#{previous_path}"
      begin
        shadow_xcodegen_rejected = false
        begin
          selected_xcodegen
        rescue FastlaneCore::Interface::FastlaneError
          shadow_xcodegen_rejected = true
        end
        unless shadow_xcodegen_rejected
          UI.user_error!("A PATH-shadowed XcodeGen binary was selected.")
        end

        shadow_selection = selected_xcode_toolchain
        unless %w[xcodebuild xcrun plutil dwarfdump lipo otool].all? { |name|
          shadow_selection.fetch(name) == xcode_toolchain.fetch(name) &&
            !shadow_selection.dig(name, "path").start_with?(
              "#{shadow_tools}#{File::SEPARATOR}"
            )
        }
          UI.user_error!("A PATH-shadowed developer tool was selected.")
        end
        previous_xcconfig = ENV["XCODE_XCCONFIG_FILE"]
        ENV["XCODE_XCCONFIG_FILE"] = File.join(workspace, "untrusted.xcconfig")
        begin
          with_pinned_xcode_environment(xcode_toolchain) do
            unless %w[xcodebuild xcrun plutil dwarfdump lipo otool].all? { |name|
              resolved_from_path = pinned_executable(
                command_output("/usr/bin/which", name),
                "PATH-selected #{name}",
                required_root: %w[xcodebuild dwarfdump lipo otool].include?(name) ?
                  xcode_toolchain.fetch("developer_dir") : nil
              )
              resolved_from_path == xcode_toolchain.fetch(name)
            }
              UI.user_error!("Pinned Xcode PATH retained a shadow developer tool.")
            end
            if ENV.key?("XCODE_XCCONFIG_FILE")
              UI.user_error!("Pinned Xcode environment retained an xcconfig override.")
            end
          end
          unless ENV["XCODE_XCCONFIG_FILE"] ==
                 File.join(workspace, "untrusted.xcconfig")
            UI.user_error!("Pinned Xcode environment did not restore its caller.")
          end
        ensure
          if previous_xcconfig
            ENV["XCODE_XCCONFIG_FILE"] = previous_xcconfig
          else
            ENV.delete("XCODE_XCCONFIG_FILE")
          end
        end
      ensure
        previous_path ? ENV["PATH"] = previous_path : ENV.delete("PATH")
      end
      verify_selected_xcode_toolchain!(xcode_toolchain)

      shared_output = File.join(workspace, "shared-output")
      Dir.mkdir(shared_output, 0o755)
      File.chmod(0o755, shared_output)
      shared_output_mode = File.stat(shared_output).mode & 0o777
      previous_output = ENV["DEMO_LAB_OUTPUT_DIR"]
      ENV["DEMO_LAB_OUTPUT_DIR"] = shared_output
      shared_output_rejected = false
      begin
        private_output_directory
      rescue FastlaneCore::Interface::FastlaneError
        shared_output_rejected = true
      ensure
        if previous_output
          ENV["DEMO_LAB_OUTPUT_DIR"] = previous_output
        else
          ENV.delete("DEMO_LAB_OUTPUT_DIR")
        end
      end
      unless shared_output_rejected &&
             (File.stat(shared_output).mode & 0o777) == shared_output_mode
        UI.user_error!("Unsafe DemoLab output permissions were mutated.")
      end

      missing_output = File.join(workspace, "missing-output")
      previous_output = ENV["DEMO_LAB_OUTPUT_DIR"]
      ENV["DEMO_LAB_OUTPUT_DIR"] = missing_output
      missing_output_rejected = false
      begin
        private_output_directory
      rescue FastlaneCore::Interface::FastlaneError
        missing_output_rejected = true
      ensure
        if previous_output
          ENV["DEMO_LAB_OUTPUT_DIR"] = previous_output
        else
          ENV.delete("DEMO_LAB_OUTPUT_DIR")
        end
      end
      unless missing_output_rejected && !File.exist?(missing_output)
        UI.user_error!("Missing DemoLab output root was created by the lane.")
      end

      unsafe_output = File.join(workspace, "unsafe'output")
      Dir.mkdir(unsafe_output, 0o700)
      previous_output = ENV["DEMO_LAB_OUTPUT_DIR"]
      ENV["DEMO_LAB_OUTPUT_DIR"] = unsafe_output
      unsafe_output_rejected = false
      begin
        private_output_directory
      rescue FastlaneCore::Interface::FastlaneError
        unsafe_output_rejected = true
      ensure
        if previous_output
          ENV["DEMO_LAB_OUTPUT_DIR"] = previous_output
        else
          ENV.delete("DEMO_LAB_OUTPUT_DIR")
        end
      end
      unless unsafe_output_rejected
        UI.user_error!("Shell-unsafe DemoLab output path was accepted.")
      end

      reserved_run = File.join(workspace, "reserved-run")
      workspace_identity = private_directory_identity!(
        workspace,
        "DemoLab output root"
      )
      create_exclusive_private_directory!(
        reserved_run,
        "DemoLab run directory",
        private_parent_identity: workspace_identity
      )
      reservation_rejected = false
      begin
        create_exclusive_private_directory!(
          reserved_run,
          "DemoLab run directory",
          private_parent_identity: workspace_identity
        )
      rescue FastlaneCore::Interface::FastlaneError
        reservation_rejected = true
      end
      unless reservation_rejected &&
             (File.stat(reserved_run).mode & 0o777) == 0o700
        UI.user_error!("DemoLab run directory reservation is not exclusive.")
      end

      replaced_output = File.join(workspace, "replaced-output")
      displaced_output = File.join(workspace, "displaced-output")
      Dir.mkdir(replaced_output, 0o700)
      original_output_identity = private_directory_identity!(
        replaced_output,
        "DemoLab output root"
      )
      File.rename(replaced_output, displaced_output)
      Dir.mkdir(replaced_output, 0o700)
      replaced_run = File.join(replaced_output, "run")
      replaced_output_rejected = false
      begin
        create_exclusive_private_directory!(
          replaced_run,
          "DemoLab run directory",
          private_parent_identity: original_output_identity
        )
      rescue FastlaneCore::Interface::FastlaneError
        replaced_output_rejected = true
      end
      unless replaced_output_rejected && !File.exist?(replaced_run)
        UI.user_error!("Replaced DemoLab output root was accepted.")
      end

      locked_output = File.join(workspace, "locked-output")
      Dir.mkdir(locked_output, 0o700)
      locked_output_identity = private_directory_identity!(
        locked_output,
        "DemoLab output root"
      )
      with_locked_private_directory(
        locked_output,
        locked_output_identity,
        "DemoLab output root"
      ) do |locked_handle|
        verify_locked_directory!(
          locked_handle,
          locked_output,
          locked_output_identity,
          "DemoLab output root"
        )
      end

      publish_source = File.join(workspace, "publish-source")
      publish_destination = File.join(workspace, "publish-destination")
      Dir.mkdir(publish_source, 0o700)
      Dir.mkdir(publish_destination, 0o700)
      publish_collision_rejected = false
      begin
        rename_exclusive_no_follow!(
          publish_source,
          publish_destination,
          "DemoLab test directory"
        )
      rescue FastlaneCore::Interface::FastlaneError
        publish_collision_rejected = true
      end
      unless publish_collision_rejected &&
             File.directory?(publish_source) &&
             File.directory?(publish_destination)
        UI.user_error!("Exclusive DemoLab publication overwrote a destination.")
      end
      publish_destination = File.join(workspace, "published-directory")
      rename_exclusive_no_follow!(
        publish_source,
        publish_destination,
        "DemoLab test directory"
      )
      unless !File.exist?(publish_source) &&
             File.directory?(publish_destination)
        UI.user_error!("Exclusive DemoLab publication did not complete.")
      end

      symlink_archive = File.join(workspace, "symlink-ancestor.xcarchive")
      symlink_app = File.join(
        symlink_archive,
        "Products",
        "Applications",
        "DemoLab.app"
      )
      outside_frameworks = File.join(workspace, "outside-frameworks")
      outside_binary = File.join(
        outside_frameworks,
        "DemoFramework.framework",
        "DemoFramework"
      )
      FileUtils.mkdir_p(File.dirname(outside_binary))
      File.write(outside_binary, "external-binary")
      FileUtils.mkdir_p(symlink_app)
      File.symlink(outside_frameworks, File.join(symlink_app, "Frameworks"))
      symlink_ancestor_rejected = false
      begin
        validate_regular_file_beneath_root!(
          File.join(
            symlink_app,
            "Frameworks",
            "DemoFramework.framework",
            "DemoFramework"
          ),
          symlink_archive,
          "DemoLab check archive binary"
        )
      rescue FastlaneCore::Interface::FastlaneError
        symlink_ancestor_rejected = true
      end
      unless symlink_ancestor_rejected
        UI.user_error!("A symlinked archive-binary ancestor was accepted.")
      end

      private_key = File.join(workspace, "AuthKey_TEST.p8")
      File.write(private_key, "private-key-snapshot")
      File.chmod(0o600, private_key)
      previous_key = ENV["APP_STORE_CONNECT_KEY_PATH"]
      ENV["APP_STORE_CONNECT_KEY_PATH"] = private_key
      key_snapshot = private_external_file_snapshot(
        "APP_STORE_CONNECT_KEY_PATH",
        DEMO_LAB_MAX_API_KEY_BYTES,
        "App Store Connect API key"
      )
      File.write(private_key, "replacement")
      unless key_snapshot == "private-key-snapshot"
        UI.user_error!("App Store Connect API key snapshot was mutable.")
      end
      key_snapshot.clear
      key_link = File.join(workspace, "AuthKey_LINK.p8")
      File.symlink(private_key, key_link)
      ENV["APP_STORE_CONNECT_KEY_PATH"] = key_link
      key_link_rejected = false
      begin
        private_external_file_snapshot(
          "APP_STORE_CONNECT_KEY_PATH",
          DEMO_LAB_MAX_API_KEY_BYTES,
          "App Store Connect API key"
        )
      rescue FastlaneCore::Interface::FastlaneError
        key_link_rejected = true
      ensure
        if previous_key
          ENV["APP_STORE_CONNECT_KEY_PATH"] = previous_key
        else
          ENV.delete("APP_STORE_CONNECT_KEY_PATH")
        end
      end
      UI.user_error!("Symbolic-link API key was accepted.") unless key_link_rejected

      key_fifo = File.join(workspace, "AuthKey_FIFO.p8")
      File.mkfifo(key_fifo, 0o600)
      ENV["APP_STORE_CONNECT_KEY_PATH"] = key_fifo
      key_fifo_rejected = false
      begin
        private_external_file_snapshot(
          "APP_STORE_CONNECT_KEY_PATH",
          DEMO_LAB_MAX_API_KEY_BYTES,
          "App Store Connect API key"
        )
      rescue FastlaneCore::Interface::FastlaneError
        key_fifo_rejected = true
      ensure
        if previous_key
          ENV["APP_STORE_CONNECT_KEY_PATH"] = previous_key
        else
          ENV.delete("APP_STORE_CONNECT_KEY_PATH")
        end
      end
      UI.user_error!("FIFO API key was accepted.") unless key_fifo_rejected

      previous_pilot_changelog = ENV["PILOT_CHANGELOG"]
      ENV["PILOT_CHANGELOG"] = "unexpected metadata override"
