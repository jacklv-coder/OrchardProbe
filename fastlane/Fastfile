      end
      unless replaced_source_rejected
        UI.user_error!("A replaced LAB-002 evidence source was accepted.")
      end
    end
    Dir.mktmpdir(
      "orchardprobe-lab002-consumption-check-",
      external_temporary_base
    ) do |output_root|
      File.chmod(0o700, output_root)
      source_commit = git_command_output("rev-parse", "HEAD")
      unless source_commit == parser_commit
        UI.user_error!(
          "DemoLab source HEAD changed during the regression check."
        )
      end
      unless /\A(?:[0-9a-f]{40}|[0-9a-f]{64})\z/.match?(source_commit)
        UI.user_error!("DemoLab check source commit has an invalid format.")
      end
      # LAB-002 v1 freezes a 40-hex source_commit. Preserve the general
      # DemoLab check on SHA-256 repositories while skipping only this
      # checkpoint-specific round trip.
      next if source_commit.length == 64

      output_identity = private_directory_identity!(
        output_root,
        "LAB-002 consumption-check output root"
      )
      final_name =
        "lab002-prebuild-" \
        "#{DEMO_LAB_LAB002_CHECKPOINT_3_MARKETING_VERSION}-" \
        "#{DEMO_LAB_LAB002_CHECKPOINT_3_BUILD_NUMBER}-#{source_commit}"
      prepared = nil
      with_locked_private_directory(
        output_root,
        output_identity,
        "LAB-002 consumption-check output root"
      ) do |output_handle|
        prepared = with_lab002_publication_rollback!(
          output_handle,
          final_name
        ) do |arm_rollback|
          prepare_lab002_private_inputs!(
            output_root: output_root,
            output_handle: output_handle,
            output_identity: output_identity,
            source_commit: source_commit,
            marketing_version:
              DEMO_LAB_LAB002_CHECKPOINT_3_MARKETING_VERSION,
            build_number: DEMO_LAB_LAB002_CHECKPOINT_3_BUILD_NUMBER,
            app_identifier: "com.example.orchardprobe.demolab",
            share_identifier: "com.example.orchardprobe.demolab.share",
            app_group_identifier: "group.com.example.orchardprobe.demolab",
            team_identifier: "ABCDE12345",
            xcode_toolchain: xcode_toolchain
          ) do |state|
            arm_rollback.call(state)
          end
        end
      end
      prebuild_directory = prepared.fetch("prebuild_directory")
      prebuild_identity = private_directory_identity!(
        prebuild_directory,
        "LAB-002 consumption-check prebuild directory"
      )
      inspected = nil
      with_locked_private_directory(
        prebuild_directory,
        prebuild_identity,
        "LAB-002 consumption-check prebuild directory"
      ) do |prebuild_handle|
        inspected = inspect_lab002_private_inputs!(
          prebuild_directory: prebuild_directory,
          prebuild_handle: prebuild_handle,
          prebuild_identity: prebuild_identity,
          source_commit: source_commit,
          marketing_version:
            DEMO_LAB_LAB002_CHECKPOINT_3_MARKETING_VERSION,
          build_number: DEMO_LAB_LAB002_CHECKPOINT_3_BUILD_NUMBER,
          app_identifier: "com.example.orchardprobe.demolab",
          share_identifier: "com.example.orchardprobe.demolab.share",
          app_group_identifier: "group.com.example.orchardprobe.demolab",
          team_identifier: "ABCDE12345",
          xcode_toolchain: xcode_toolchain
        )
      end
      unless %w[
        authorized_target_manifest_sha256
        build_binding_sha256
        target_identity_set_sha256
      ].all? { |name| inspected.fetch(name) == prepared.fetch(name) }
        UI.user_error!(
          "LAB-002 closed prebuild consumption changed a prepared binding."
        )
      end
    end
    DEMO_LAB_WEAK_ED25519_PUBLIC_KEYS.each do |weak_key|
