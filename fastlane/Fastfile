def repository_root
  File.expand_path("..", __dir__)
end

def command_output(*command, chdir: repository_root)
  stdout, stderr, status = Open3.capture3(
    sanitized_dynamic_loader_environment,
    *command,
    chdir: chdir
  )
  return stdout.strip if status.success?

  UI.user_error!(
    "Command failed (#{command.shelljoin}):\n#{stderr.strip}"
  )
end

def command_output_with_environment(environment, *command, chdir: repository_root)
  stdout, stderr, status = Open3.capture3(
    sanitized_dynamic_loader_environment(environment),
    *command,
    chdir: chdir
  )
  return stdout.strip if status.success?

  UI.user_error!(
    "Command failed (#{command.shelljoin}):\n#{stderr.strip}"
  )
end

def sanitized_dynamic_loader_environment(additional = {})
  sanitized = additional.dup
  (ENV.keys | additional.keys).each do |key|
    if DEMO_LAB_DYNAMIC_LOADER_ENVIRONMENT_PATTERNS.any? { |pattern| pattern.match?(key) }
      sanitized[key] = nil
    end
  end
  sanitized
end

def command_output_without_loader_overrides(*command, chdir: repository_root)
  command_output_with_environment(
    sanitized_dynamic_loader_environment,
    *command,
    chdir: chdir
  )
end

def trusted_git_environment
  sanitized_dynamic_loader_environment(
    DEMO_LAB_XCODE_OVERRIDE_KEYS.to_h { |key| [key, nil] }.merge(
      "GIT_CONFIG_COUNT" => "0",
      "GIT_CONFIG_GLOBAL" => "/dev/null",
      "GIT_CONFIG_NOSYSTEM" => "1",
      "GIT_OPTIONAL_LOCKS" => "0"
    )
  )
end

def git_command_output(*arguments)
  stdout, stderr, status = Open3.capture3(
    trusted_git_environment,
    "/usr/bin/git",
    "--no-replace-objects",
    *arguments,
    chdir: repository_root,
    unsetenv_others: true
  )
  return stdout.strip if status.success?

  UI.user_error!(
    "Git command failed (#{arguments.shelljoin}):\n#{stderr.strip}"
  )
end

def pinned_executable(path, label, required_root: nil)
  unless Pathname.new(path).absolute?
    UI.user_error!("#{label} path must be absolute.")
  end
  resolved = File.realpath(path)
  if required_root
    root = File.realpath(required_root)
    unless resolved.start_with?("#{root}#{File::SEPARATOR}")
      UI.user_error!("#{label} escaped the selected Xcode.")
    end
  end
  stat = File.stat(resolved)
  unless stat.file? &&
         File.executable?(resolved) &&
         stat.uid.zero? &&
         (stat.mode & 0o022).zero?
    UI.user_error!("#{label} must be a root-owned, non-writable executable.")
  end
  {
    "path" => resolved,
    "identity" => [
      stat.dev,
      stat.ino,
      stat.size,
      stat.mtime.to_i,
      Digest::SHA256.file(resolved).hexdigest,
    ],
  }
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT
  UI.user_error!("Unable to resolve #{label} safely.")
end

def selected_xcode_toolchain
  developer_dir_output = command_output_with_environment(
    { "DEVELOPER_DIR" => nil },
    "/usr/bin/xcode-select",
    "--print-path"
  )
  unless Pathname.new(developer_dir_output).absolute?
    UI.user_error!("The selected Xcode developer directory must be absolute.")
  end
  developer_dir = File.realpath(developer_dir_output)
  contents_dir = File.dirname(developer_dir)
  xcode_bundle_root = File.realpath(File.dirname(contents_dir))
  unless File.basename(developer_dir) == "Developer" &&
         File.basename(contents_dir) == "Contents" &&
         File.basename(xcode_bundle_root).end_with?(".app")
    UI.user_error!("The selected developer directory is not inside an Xcode app.")
  end
  developer_stat = File.stat(developer_dir)
  bundle_stat = File.stat(xcode_bundle_root)
  unless developer_stat.directory? &&
         developer_stat.uid.zero? &&
         (developer_stat.mode & 0o022).zero? &&
         bundle_stat.directory? &&
         bundle_stat.uid.zero? &&
         (bundle_stat.mode & 0o022).zero?
    UI.user_error!(
      "The selected Xcode app and developer directory must be root-owned and non-writable."
    )
  end

  xcodebuild = pinned_executable(
    File.join(developer_dir, "usr", "bin", "xcodebuild"),
    "Selected Xcode xcodebuild",
    required_root: developer_dir
  )
  xcrun = pinned_executable("/usr/bin/xcrun", "System xcrun")
  plutil = pinned_executable("/usr/bin/plutil", "System plutil")
  environment = sanitized_dynamic_loader_environment(
    "DEVELOPER_DIR" => developer_dir,
    "PATH" =>
      "#{File.dirname(xcodebuild.fetch('path'))}:#{DEMO_LAB_PINNED_SYSTEM_PATH}",
    "SDKROOT" => nil,
    "TOOLCHAINS" => nil,
    "XCODE_XCCONFIG_FILE" => nil
  )
  dwarfdump_path = command_output_with_environment(
    environment,
    xcrun.fetch("path"),
    "--find",
    "dwarfdump"
  )
  lipo_path = command_output_with_environment(
    environment,
    xcrun.fetch("path"),
    "--find",
    "lipo"
  )
  otool_path = command_output_with_environment(
    environment,
    xcrun.fetch("path"),
    "--find",
    "otool"
  )
  dwarfdump = pinned_executable(
    dwarfdump_path,
    "Selected Xcode dwarfdump",
    required_root: developer_dir
  )
  lipo = pinned_executable(
    lipo_path,
    "Selected Xcode lipo",
    required_root: developer_dir
  )
  otool = pinned_executable(
    otool_path,
    "Selected Xcode otool",
    required_root: developer_dir
  )
  toolchain_binary_directories = [
    File.dirname(dwarfdump.fetch("path")),
    File.dirname(lipo.fetch("path")),
    File.dirname(otool.fetch("path")),
  ].uniq
  toolchain_binary_directories.each do |directory|
    resolved_directory = File.realpath(directory)
    directory_stat = File.stat(resolved_directory)
    unless resolved_directory.start_with?(
      "#{developer_dir}#{File::SEPARATOR}"
    ) &&
           directory_stat.directory? &&
           directory_stat.uid.zero? &&
           (directory_stat.mode & 0o022).zero?
      UI.user_error!(
        "Selected Xcode toolchain binary directories must be root-owned and non-writable."
      )
    end
  end
  environment["PATH"] = [
    *toolchain_binary_directories,
    File.dirname(xcodebuild.fetch("path")),
    DEMO_LAB_PINNED_SYSTEM_PATH,
  ].uniq.join(File::PATH_SEPARATOR)
  xcode_version = command_output_with_environment(
    environment,
    xcodebuild.fetch("path"),
    "-version"
  ).lines
  unless xcode_version.length == 2 &&
         xcode_version.all? { |line| !line.strip.empty? && line.bytesize <= 256 }
    UI.user_error!("The selected Xcode returned an unexpected version.")
  end

  {
    "xcode_bundle_root" => xcode_bundle_root,
    "xcode_bundle_identity" => [
      bundle_stat.dev,
      bundle_stat.ino,
      bundle_stat.mtime.to_i,
    ],
    "developer_dir" => developer_dir,
    "developer_dir_identity" => [
      developer_stat.dev,
      developer_stat.ino,
      developer_stat.mtime.to_i,
    ],
    "environment" => environment,
    "xcodebuild" => xcodebuild,
    "xcrun" => xcrun,
    "plutil" => plutil,
    "dwarfdump" => dwarfdump,
    "lipo" => lipo,
    "otool" => otool,
    "xcode_version" => xcode_version,
    "iphoneos_sdk_version" => command_output_with_environment(
      environment,
      xcrun.fetch("path"),
      "--sdk",
      "iphoneos",
      "--show-sdk-version"
    ),
    "iphoneos_sdk_build" => command_output_with_environment(
      environment,
      xcrun.fetch("path"),
      "--sdk",
      "iphoneos",
      "--show-sdk-build-version"
    ),
  }
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT
  UI.user_error!("Unable to resolve the selected Xcode safely.")
end

def verify_selected_xcode_toolchain!(toolchain)
  bundle_stat = File.stat(toolchain.fetch("xcode_bundle_root"))
  observed_bundle_identity = [
    bundle_stat.dev,
    bundle_stat.ino,
    bundle_stat.mtime.to_i,
  ]
  unless observed_bundle_identity == toolchain.fetch("xcode_bundle_identity")
    UI.user_error!("The selected Xcode app changed during use.")
  end

  developer_stat = File.stat(toolchain.fetch("developer_dir"))
  observed_developer_identity = [
    developer_stat.dev,
    developer_stat.ino,
    developer_stat.mtime.to_i,
  ]
  unless observed_developer_identity == toolchain.fetch(
    "developer_dir_identity"
  )
    UI.user_error!("The selected Xcode developer directory changed during use.")
  end

  %w[xcodebuild xcrun plutil dwarfdump lipo otool].each do |name|
    executable = toolchain.fetch(name)
    observed = pinned_executable(
      executable.fetch("path"),
      "Pinned #{name}",
      required_root: %w[xcodebuild dwarfdump lipo otool].include?(name) ?
        toolchain.fetch("developer_dir") : nil
    )
    unless observed == executable
      UI.user_error!("The pinned #{name} executable changed during use.")
    end
  end

  environment = toolchain.fetch("environment")
  observed_xcode_version = command_output_with_environment(
    environment,
    toolchain.dig("xcodebuild", "path"),
    "-version"
  ).lines
  observed_sdk_version = command_output_with_environment(
    environment,
    toolchain.dig("xcrun", "path"),
    "--sdk",
    "iphoneos",
    "--show-sdk-version"
  )
  observed_sdk_build = command_output_with_environment(
    environment,
    toolchain.dig("xcrun", "path"),
    "--sdk",
    "iphoneos",
    "--show-sdk-build-version"
  )
  unless observed_xcode_version == toolchain.fetch("xcode_version") &&
         observed_sdk_version == toolchain.fetch("iphoneos_sdk_version") &&
         observed_sdk_build == toolchain.fetch("iphoneos_sdk_build")
    UI.user_error!("The selected Xcode metadata changed during use.")
  end
  true
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT
  UI.user_error!("Unable to revalidate the selected Xcode safely.")
end

def with_pinned_xcode_environment(toolchain)
  environment = toolchain.fetch("environment")
  previous = {}
  environment.each_key do |key|
    previous[key] = ENV.key?(key) ? [true, ENV[key]] : [false, nil]
  end
  environment.each do |key, value|
    value.nil? ? ENV.delete(key) : ENV[key] = value
  end
  yield
ensure
  previous&.each do |key, (existed, value)|
    existed ? ENV[key] = value : ENV.delete(key)
  end
end

def required_environment(name, pattern: nil)
  value = ENV[name]&.strip
  UI.user_error!("Set #{name} before running this lane.") if value.nil? || value.empty?
  if pattern && !pattern.match?(value)
    UI.user_error!("#{name} has an invalid format.")
  end
  value
end

def validate_demolab_authorization_public_key!(value)
  if DEMO_LAB_WEAK_ED25519_PUBLIC_KEYS.include?(value)
    UI.user_error!("DEMO_LAB_AUTHORIZATION_PUBLIC_KEY is weak.")
  end
  value
end

def lab002_rust_toolchain_name(source_root = repository_root)
  toolchain_file = File.join(source_root, "rust-toolchain.toml")
  content = File.read(toolchain_file, mode: "rb")
  matches = content.scan(/^channel = "([0-9]+\.[0-9]+\.[0-9]+)"$/)
  unless matches.length == 1 && content.start_with?("[toolchain]\n")
    UI.user_error!("The pinned Rust toolchain file is invalid.")
  end
  matches.fetch(0).fetch(0)
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT
  UI.user_error!("Unable to read the pinned Rust toolchain safely.")
end

def lab002_rust_toolchain_tree_sha256(root, label = "Pinned Rust tree")
  root = File.realpath(root)
  entries = []
  Find.find(root) { |path| entries << path }
  entries.sort_by! do |path|
    relative_path =
      path == root ? "." : path.delete_prefix("#{root}#{File::SEPARATOR}")
    [path == root ? 0 : 1, relative_path.b]
  end
  digest = Digest::SHA256.new
  digest.update("orchardprobe.rust-toolchain-tree.v1\0")

  entries.each do |path|
    relative_path =
      path == root ? "." : path.delete_prefix("#{root}#{File::SEPARATOR}")
    stat = File.lstat(path)
    unless stat.uid == Process.uid &&
           (stat.mode & 0o022).zero? &&
           !stat.symlink? &&
           (stat.directory? || stat.file?)
      UI.user_error!(
        "#{label} contains an unsafe node."
      )
    end
    type = stat.directory? ? "d" : "f"
    digest.update([relative_path.bytesize].pack("N"))
    digest.update(relative_path)
    digest.update(type)
    digest.update([stat.mode & 0o7777].pack("N"))
    next if stat.directory?

    flags = File::RDONLY | File::NONBLOCK
    flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
    File.open(path, flags) do |file|
      opened = file.stat
      path_stat = File.lstat(path)
      unless opened.file? &&
             opened.dev == stat.dev &&
             opened.ino == stat.ino &&
             path_stat.dev == opened.dev &&
             path_stat.ino == opened.ino
        UI.user_error!("#{label} file identity changed.")
      end
      file_digest = Digest::SHA256.new
      while (chunk = file.read(1024 * 1024))
        file_digest.update(chunk)
      end
      after = file.stat
      unless [
        after.dev,
        after.ino,
        after.size,
        after.mtime.to_f,
      ] == [
        opened.dev,
        opened.ino,
        opened.size,
        opened.mtime.to_f,
      ]
        UI.user_error!("#{label} file changed while hashing.")
      end
      digest.update([opened.size].pack("Q>"))
      digest.update(file_digest.digest)
    end
  end
  observed_entries = []
  Find.find(root) { |path| observed_entries << path }
  observed_entries.sort_by! do |path|
    relative_path =
      path == root ? "." : path.delete_prefix("#{root}#{File::SEPARATOR}")
    [path == root ? 0 : 1, relative_path.b]
  end
  unless entries == observed_entries
    UI.user_error!("#{label} inventory changed while hashing.")
  end
  digest.hexdigest
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT, Errno::ENOTDIR
  UI.user_error!("Unable to hash #{label.downcase} safely.")
end

def lab002_rust_target_architecture(host_architecture)
  case host_architecture
  when "arm64"
    "aarch64"
  when "x86_64"
    "x86_64"
  else
    UI.user_error!("This host architecture has no LAB-002 Rust target.")
  end
end

def selected_lab002_rust_toolchain(source_root = repository_root)
  channel = lab002_rust_toolchain_name(source_root)
  architecture = lab002_rust_target_architecture(
    command_output("/usr/bin/uname", "-m")
  )
  toolchain_name = "#{channel}-#{architecture}-apple-darwin"
  expected_sha256 = DEMO_LAB_TRUSTED_RUST_TOOLCHAINS[toolchain_name]
  unless expected_sha256
    UI.user_error!("This Rust toolchain has no reviewed content allowlist.")
  end
  owner_home = File.realpath(Etc.getpwuid(Process.uid).dir)
  root = File.join(
    owner_home,
    ".rustup",
    "toolchains",
    toolchain_name
  )
  resolved = File.realpath(root)
  unless resolved == root
    UI.user_error!("The pinned Rust toolchain path is not canonical.")
  end
  root_stat = File.lstat(resolved)
  unless root_stat.directory? &&
         !root_stat.symlink? &&
         root_stat.uid == Process.uid &&
         (root_stat.mode & 0o022).zero?
    UI.user_error!("The pinned Rust toolchain root is unsafe.")
  end
  observed_sha256 = lab002_rust_toolchain_tree_sha256(resolved)
  unless observed_sha256 == expected_sha256
    UI.user_error!("The selected Rust toolchain content is not reviewed.")
  end
  cargo = File.join(resolved, "bin", "cargo")
  rustc = File.join(resolved, "bin", "rustc")
  [toolchain_name, resolved, cargo, rustc, observed_sha256]
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT, Errno::ENOTDIR
  UI.user_error!("Unable to resolve the pinned Rust toolchain safely.")
end

def lab002_locked_registry_packages(lock_path = File.join(repository_root, "Cargo.lock"))
  content = File.read(lock_path, mode: "rb")
  content.force_encoding(Encoding::UTF_8)
  UI.user_error!("Cargo.lock is not valid UTF-8.") unless content.valid_encoding?
  packages = content.split(/(?=^\[\[package\]\]\n)/).each_with_object([]) do |block, result|
    next unless block.start_with?("[[package]]\n")

    fields = {}
    %w[name version source checksum].each do |field|
      matches = block.scan(/^#{field} = "([^"]+)"$/)
      fields[field] = matches.fetch(0).fetch(0) if matches.length == 1
    end
    next unless fields["source"]

    unless fields.keys.sort == %w[checksum name source version] &&
           fields["source"] == DEMO_LAB_CRATES_IO_SOURCE &&
           /\A[A-Za-z0-9_-]+\z/.match?(fields["name"]) &&
           /\A[0-9A-Za-z.+-]+\z/.match?(fields["version"]) &&
           /\A[0-9a-f]{64}\z/.match?(fields["checksum"])
      UI.user_error!("Cargo.lock contains an unsupported registry package.")
    end
    result << fields
  end
  unless packages.any? &&
         packages.map { |package| [package["name"], package["version"]] }.uniq.length ==
           packages.length
    UI.user_error!("Cargo.lock registry package inventory is empty or ambiguous.")
  end
  packages.sort_by { |package| [package["name"].b, package["version"].b] }
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT
  UI.user_error!("Unable to read Cargo.lock safely.")
end

def lab002_verified_crate_archive(package, cargo_home)
  basename = "#{package.fetch('name')}-#{package.fetch('version')}.crate"
  candidates = Dir.glob(
    File.join(cargo_home, "registry", "cache", "*", basename)
  ).sort
  candidates.each do |candidate|
    next if File.symlink?(candidate)

    flags = File::RDONLY | File::NONBLOCK
    flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
    File.open(candidate, flags) do |archive|
      before = archive.stat
      next unless before.file? &&
                  before.uid == Process.uid &&
                  (before.mode & 0o022).zero? &&
                  before.size.positive? &&
                  before.size <= DEMO_LAB_MAX_CRATE_ARCHIVE_BYTES

      digest = digest_open_file(archive)
      after = archive.stat
      next unless [
        after.dev,
        after.ino,
        after.size,
        after.mtime.to_f,
      ] == [
        before.dev,
        before.ino,
        before.size,
        before.mtime.to_f,
      ]
      return candidate if digest == package.fetch("checksum")
    end
  end
  UI.user_error!(
    "The Cargo cache has no checksum-verified archive for #{basename}; " \
    "run `cargo fetch --locked` before the controlled lane."
  )
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT, Errno::ENOTDIR
  UI.user_error!("Unable to inspect cached crate #{basename} safely.")
end

def lab002_safe_relative_crate_path(raw_name, expected_root)
  name = raw_name.dup.force_encoding(Encoding::UTF_8)
  unless name.valid_encoding? &&
         !name.start_with?("/") &&
         !name.include?("\\") &&
         !name.include?("\0")
    UI.user_error!("A verified crate contains an unsafe archive path.")
  end
  components = name.split("/")
  components.pop while components.last == ""
  unless components.first == expected_root &&
         components.all? { |component| !component.empty? && !%w[. ..].include?(component) }
    UI.user_error!("A verified crate escaped its package root.")
  end
  components.drop(1)
end

def lab002_open_directory_at(parent, name, required_mode: 0o700)
  flags = File::RDONLY | File::NOFOLLOW
  descriptor = DemoLabDarwin.openat(parent.fileno, name, flags, 0)
  if descriptor.negative?
    raise SystemCallError.new("openat", Fiddle.last_error)
  end
  directory = File.for_fd(descriptor)
  directory.fcntl(Fcntl::F_SETFD, Fcntl::FD_CLOEXEC)
  stat = directory.stat
  unless stat.directory? &&
         stat.uid == Process.uid &&
         (required_mode.nil? || (stat.mode & 0o777) == required_mode)
    directory.close
    UI.user_error!("A verified crate directory has unsafe metadata.")
  end
  directory
end

def lab002_create_private_ancestors!(root, components, directories)
  current = root.dup
  relative = []
  components.each do |component|
    relative << component
    result = DemoLabDarwin.mkdirat(current.fileno, component, 0o700)
    if result.nonzero?
      error = SystemCallError.new("mkdirat", Fiddle.last_error)
      raise error unless error.is_a?(Errno::EEXIST)
    end
    next_directory = lab002_open_directory_at(current, component)
    current.close
    current = next_directory
    directories[relative.join("/")] = true
  end
  current
rescue
  current&.close
  raise
end

def lab002_open_private_file_at!(parent, name, mode)
  flags = File::WRONLY | File::CREAT | File::EXCL
  flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
  descriptor = DemoLabDarwin.openat(parent.fileno, name, flags, mode)
  if descriptor.negative?
    raise SystemCallError.new("openat", Fiddle.last_error)
  end
  file = File.for_fd(descriptor, "w")
  file.fcntl(Fcntl::F_SETFD, Fcntl::FD_CLOEXEC)
  file
end

def lab002_write_private_file!(parent, name, entry)
  digest = Digest::SHA256.new
  file = lab002_open_private_file_at!(parent, name, 0o600)
  begin
    while (chunk = entry.read(1024 * 1024))
      file.write(chunk)
      digest.update(chunk)
    end
    file.flush
    file.fsync
    file.chmod(0o400)
  ensure
    file.close
  end
  digest.hexdigest
rescue Errno::EEXIST, Errno::ELOOP
  UI.user_error!("A verified crate contains a duplicate archive path.")
end

def lab002_open_directory_path(root, relative)
  current = root.dup
  relative.split("/").each do |component|
    next_directory = lab002_open_directory_at(current, component)
    current.close
    current = next_directory
  end
  current
rescue
  current&.close
  raise
end

def lab002_extract_verified_crate!(archive_path, package, vendor_root)
  package_root = "#{package.fetch('name')}-#{package.fetch('version')}"
  destination = File.join(vendor_root, package_root)
  Dir.mkdir(destination, 0o700)
  created = File.lstat(destination)
  destination_handle = File.open(destination, File::RDONLY | File::NOFOLLOW)
  opened = destination_handle.stat
  unless opened.directory? &&
         opened.uid == Process.uid &&
         (opened.mode & 0o777) == 0o700 &&
         [opened.dev, opened.ino] == [created.dev, created.ino]
    UI.user_error!("A verified crate package root changed after creation.")
  end
  file_hashes = {}
  directories = {}
  entry_count = 0
  expanded_bytes = 0

  flags = File::RDONLY | File::NONBLOCK
  flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
  File.open(archive_path, flags) do |archive|
    before = archive.stat
    observed_checksum = digest_open_file(archive)
    unless observed_checksum == package.fetch("checksum")
      UI.user_error!("A cached crate changed before extraction.")
    end
    archive.rewind
    digesting_archive = Lab002DigestingReader.new(archive)
    gzip = Zlib::GzipReader.new(digesting_archive)
    begin
      Gem::Package::TarReader.new(gzip) do |tar|
        pending_long_name = nil
        tar.each do |entry|
          entry_count += 1
          if entry_count > DEMO_LAB_MAX_CRATE_ENTRIES
            UI.user_error!("A verified crate has too many archive entries.")
          end
          if entry.header.typeflag == "L"
            unless pending_long_name.nil? &&
                   entry.header.size.positive? &&
                   entry.header.size <= 4096
              UI.user_error!("A verified crate has an invalid GNU long-name entry.")
            end
            encoded_name = entry.read
            unless encoded_name.end_with?("\0") &&
                   !encoded_name.delete_suffix("\0").include?("\0")
              UI.user_error!("A verified crate has a malformed GNU long-name entry.")
            end
            pending_long_name = encoded_name.delete_suffix("\0")
            next
          end
          raw_name = pending_long_name || entry.full_name
          pending_long_name = nil
          components =
            lab002_safe_relative_crate_path(raw_name, package_root)
          next if components.empty? && entry.directory?
          UI.user_error!("A verified crate has an invalid root entry.") if components.empty?

          relative = components.join("/")
          if entry.directory?
            directory = lab002_create_private_ancestors!(
              destination_handle,
              components,
              directories
            )
            directory.close
          elsif entry.file?
            expanded_bytes += entry.header.size
            if expanded_bytes > DEMO_LAB_MAX_CRATE_EXPANDED_BYTES
              UI.user_error!("A verified crate expands beyond the safety limit.")
            end
            parent = lab002_create_private_ancestors!(
              destination_handle,
              components[0...-1],
              directories
            )
            begin
              file_hashes[relative] = lab002_write_private_file!(
                parent,
                components.fetch(-1),
                entry
              )
            ensure
              parent.close
            end
          else
            UI.user_error!(
              "A verified crate contains a link or unsupported archive entry."
            )
          end
        end
        unless pending_long_name.nil?
          UI.user_error!("A verified crate ends with an incomplete long-name entry.")
        end
      end
      gzip.read
    ensure
      gzip.finish
    end
    consumed_checksum = digesting_archive.digest.hexdigest
    final_checksum = digest_open_file(archive)
    after = archive.stat
    unless [
      after.dev,
      after.ino,
      after.size,
      after.mtime.to_f,
    ] == [
      before.dev,
      before.ino,
      before.size,
      before.mtime.to_f,
    ] &&
           consumed_checksum == package.fetch("checksum") &&
           final_checksum == package.fetch("checksum")
      UI.user_error!("A cached crate changed during extraction.")
    end
  end
  UI.user_error!("A verified crate extracted no files.") if file_hashes.empty?

  checksum_path = File.join(destination, ".cargo-checksum.json")
  checksum = JSON.generate(
    "files" => file_hashes.sort.to_h,
    "package" => package.fetch("checksum")
  )
  checksum_file =
    lab002_open_private_file_at!(
      destination_handle,
      File.basename(checksum_path),
      0o400
    )
  begin
    file = checksum_file
    file.write(checksum)
    file.flush
    file.fsync
    file.chmod(0o400)
  ensure
    checksum_file.close
  end
  directories.keys.sort_by { |path| -path.count("/") }.each do |relative|
    directory = lab002_open_directory_path(destination_handle, relative)
    begin
      directory.chmod(0o500)
    ensure
      directory.close
    end
  end
  destination_handle.chmod(0o500)
  destination_handle.close
rescue Zlib::Error, Gem::Package::TarInvalidError, EOFError
  UI.user_error!("A checksum-verified crate archive is structurally invalid.")
ensure
  destination_handle&.close unless destination_handle&.closed?
end

def lab002_configured_cargo_home
  owner_home = File.realpath(Etc.getpwuid(Process.uid).dir)
  configured = ENV["CARGO_HOME"]
  if configured&.empty?
    UI.user_error!("CARGO_HOME must not be empty when configured.")
  end
  expanded = File.expand_path(
    configured || File.join(owner_home, ".cargo"),
    repository_root
  )
  validate_fastlane_path_characters!(expanded, "Cargo home")
  resolved = File.realpath(expanded)
  stat = File.lstat(resolved)
  unless stat.directory? &&
         !stat.symlink? &&
         stat.uid == Process.uid &&
         (stat.mode & 0o022).zero?
    UI.user_error!("The configured Cargo home is unsafe.")
  end
  resolved
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT, Errno::ENOTDIR
  UI.user_error!("Unable to resolve the configured Cargo home safely.")
end

def lab002_verified_vendor_source(workspace, lock_path: File.join(repository_root, "Cargo.lock"))
  cargo_cache = lab002_configured_cargo_home
  vendor_root = File.join(workspace, "verified-vendor")
  Dir.mkdir(vendor_root, 0o700)
  lab002_locked_registry_packages(lock_path).each do |package|
    archive = lab002_verified_crate_archive(package, cargo_cache)
    lab002_extract_verified_crate!(archive, package, vendor_root)
  end
  File.chmod(0o500, vendor_root)
  [vendor_root, lab002_rust_toolchain_tree_sha256(vendor_root)]
end

def lab002_remove_readonly_workspace!(workspace, label)
  resolved = ensure_outside_repository!(
    File.realpath(workspace),
    label
  )
  directories = []
  Find.find(resolved) do |path|
    stat = File.lstat(path)
    if stat.symlink?
      UI.user_error!(
        "#{label} gained a symbolic link before cleanup."
      )
    end
    directories << path if stat.directory?
  end
  directories.reverse_each { |path| File.chmod(0o700, path) }
  FileUtils.rm_rf(resolved)
  if File.exist?(resolved) || File.symlink?(resolved)
    UI.user_error!("Unable to remove #{label}.")
  end
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT, Errno::ENOTDIR
  UI.user_error!("Unable to clean #{label} safely.")
end

def lab002_remove_verified_vendor!(workspace)
  lab002_remove_readonly_workspace!(
    workspace,
    "LAB-002 verified Cargo source workspace"
  )
end

def lab002_reviewed_snapshot_file_sha256!(source_root, name)
  unless /\A[A-Za-z0-9][A-Za-z0-9._-]*\z/.match?(name)
    UI.user_error!("LAB-002 reviewed snapshot file name is invalid.")
  end
  source_root = File.realpath(source_root)
  path = File.join(source_root, name)
  flags = File::RDONLY | File::NONBLOCK
  flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
  file = File.open(path, flags)
  before = file.stat
  before_path = File.lstat(path)
  digest = digest_open_file(file)
  after = file.stat
  after_path = File.lstat(path)
  unless before.file? &&
         before.uid == Process.uid &&
         (before.mode & 0o777) == 0o400 &&
         !before_path.symlink? &&
         [
           before.dev,
           before.ino,
           before.size,
           before.mtime.to_f,
         ] == [
           before_path.dev,
           before_path.ino,
           before_path.size,
           before_path.mtime.to_f,
         ] &&
         [
           after.dev,
           after.ino,
           after.size,
           after.mtime.to_f,
         ] == [
           before.dev,
           before.ino,
           before.size,
           before.mtime.to_f,
         ] &&
         [
           after_path.dev,
           after_path.ino,
           after_path.size,
           after_path.mtime.to_f,
         ] == [
           after.dev,
           after.ino,
           after.size,
           after.mtime.to_f,
         ]
    UI.user_error!("LAB-002 reviewed snapshot file changed while hashing.")
  end
  digest
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT, Errno::ENOTDIR
  UI.user_error!("Unable to hash the reviewed LAB-002 snapshot file safely.")
ensure
  file&.close unless file&.closed?
end

def lab002_reviewed_git_blob_oid!(path, object_format)
  digest = case object_format
           when "sha1"
             Digest::SHA1.new
           when "sha256"
             Digest::SHA256.new
           else
             UI.user_error!("The reviewed Git object format is unsupported.")
           end
  flags = File::RDONLY | File::NONBLOCK
  flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
  File.open(path, flags) do |file|
    before = file.stat
    before_path = File.lstat(path)
    unless before.file? &&
           !before_path.symlink? &&
           [before_path.dev, before_path.ino] == [before.dev, before.ino]
      UI.user_error!("A reviewed snapshot file has an invalid identity.")
    end
    digest.update("blob #{before.size}\0")
    while (chunk = file.read(1024 * 1024))
      digest.update(chunk)
    end
    after = file.stat
    after_path = File.lstat(path)
    unless [
      after.dev,
      after.ino,
      after.size,
      after.mtime.to_f,
    ] == [
      before.dev,
      before.ino,
      before.size,
      before.mtime.to_f,
    ] &&
           [
             after_path.dev,
             after_path.ino,
             after_path.size,
             after_path.mtime.to_f,
           ] == [
             after.dev,
             after.ino,
             after.size,
             after.mtime.to_f,
           ]
      UI.user_error!("A reviewed snapshot file changed while binding its blob.")
    end
  end
  digest.hexdigest
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT, Errno::ENOTDIR
  UI.user_error!("Unable to bind a reviewed snapshot file safely.")
end

def lab002_stream_reviewed_source_archive!(
  source_repository,
  source_root,
  source_commit,
  snapshot_paths
)
  archive_environment = trusted_git_environment
  object_format, format_stderr, format_status = Open3.capture3(
    archive_environment,
    "/usr/bin/git",
    "--no-replace-objects",
    "rev-parse",
    "--show-object-format",
    chdir: source_repository,
    unsetenv_others: true
  )
  object_format = object_format.strip
  unless format_status.success? &&
         format_stderr.empty? &&
         %w[sha1 sha256].include?(object_format)
    UI.user_error!("Unable to identify the reviewed Git object format.")
  end
  tree_output, tree_stderr, tree_status = Open3.capture3(
    archive_environment,
    "/usr/bin/git",
    "--no-replace-objects",
    "ls-tree",
    "-r",
    "-z",
    "--full-tree",
    source_commit,
    "--",
    *snapshot_paths,
    chdir: source_repository,
    unsetenv_others: true
  )
  entries = tree_output.b.split("\0", -1)
  unless tree_status.success? &&
         tree_stderr.empty? &&
         entries.pop == ""
    UI.user_error!("Unable to inventory the reviewed Git source tree.")
  end
  oid_pattern = object_format == "sha1" ? "[0-9a-f]{40}" : "[0-9a-f]{64}"
  expected_blobs = entries.to_h do |entry|
    match = /\A(?:100644|100755) blob (#{oid_pattern})\t(.+)\z/m.match(entry)
    unless match
      UI.user_error!("The reviewed Git source tree has an unsupported entry.")
    end
    relative = match[2].dup.force_encoding(Encoding::UTF_8)
    components = relative.split("/")
    unless relative.valid_encoding? &&
           !relative.start_with?("/") &&
           components.all? { |component|
             !component.empty? && !%w[. ..].include?(component)
           }
      UI.user_error!("The reviewed Git source tree has an unsafe path.")
    end
    [relative, match[1]]
  end
  unless expected_blobs.length == entries.length && expected_blobs.any?
    UI.user_error!("The reviewed Git source tree inventory is ambiguous.")
  end
  archive_statuses = Open3.pipeline(
    [
      archive_environment,
      "/usr/bin/git",
      "--no-replace-objects",
      "-c",
      "core.attributesFile=/dev/null",
      "archive",
      "--format=tar",
      source_commit,
      "--",
      *snapshot_paths,
    ],
    [
      archive_environment,
      "/usr/bin/tar",
      "-xf",
      "-",
      "-C",
      source_root,
    ],
    chdir: source_repository,
    unsetenv_others: true
  )
  unless archive_statuses.length == 2 &&
         archive_statuses.all?(&:success?)
    UI.user_error!(
      "Unable to stream the reviewed LAB-002 source snapshot safely."
    )
  end
  observed_blobs = {}
  Find.find(source_root) do |path|
    next if path == source_root

    stat = File.lstat(path)
    next if stat.directory?
    unless stat.file? && !stat.symlink?
      UI.user_error!("The reviewed source archive has an unsupported entry.")
    end
    relative = path.delete_prefix("#{source_root}#{File::SEPARATOR}")
    unless expected_blobs.key?(relative) && !observed_blobs.key?(relative)
      UI.user_error!("The reviewed source archive inventory diverged.")
    end
    observed_blobs[relative] =
      lab002_reviewed_git_blob_oid!(path, object_format)
  end
  unless observed_blobs == expected_blobs
    UI.user_error!(
      "The reviewed source archive does not match the exact Git blobs."
    )
  end
end

def lab002_reviewed_source_snapshot!(workspace, source_commit)
  unless /\A[0-9a-f]{40}\z/.match?(source_commit)
    UI.user_error!("LAB-002 reviewed source commit has an invalid format.")
  end
  workspace = ensure_outside_repository!(
    File.realpath(workspace),
    "LAB-002 reviewed source workspace"
  )
  source_root = File.join(workspace, "reviewed-source")
  Dir.mkdir(source_root, 0o700)
  snapshot_paths = [
    "Cargo.toml",
    "Cargo.lock",
    "Gemfile.lock",
    "rust-toolchain.toml",
    "crates",
  ]
  lab002_stream_reviewed_source_archive!(
    repository_root,
    source_root,
    source_commit,
    snapshot_paths
  )

  required = %w[
    Cargo.toml
    Cargo.lock
    Gemfile.lock
    rust-toolchain.toml
  ].map do |name|
    File.join(source_root, name)
  end
  unless required.all? { |path| File.file?(path) && !File.symlink?(path) }
    UI.user_error!("LAB-002 reviewed source snapshot is incomplete.")
  end

  directories = []
  Find.find(source_root) do |path|
    stat = File.lstat(path)
    unless stat.uid == Process.uid &&
           !stat.symlink? &&
           (stat.directory? || stat.file?)
      UI.user_error!("LAB-002 reviewed source snapshot contains an unsafe node.")
    end
    if stat.directory?
      directories << path
    else
      File.chmod(0o400, path)
    end
  end
  directories.reverse_each { |path| File.chmod(0o500, path) }
  gemfile_lock_sha256 = lab002_reviewed_snapshot_file_sha256!(
    source_root,
    "Gemfile.lock"
  )
  source_sha256 = lab002_rust_toolchain_tree_sha256(
    source_root,
    "LAB-002 reviewed source snapshot"
  )
  unless lab002_reviewed_snapshot_file_sha256!(
    source_root,
    "Gemfile.lock"
  ) == gemfile_lock_sha256
    UI.user_error!(
      "The reviewed LAB-002 Gemfile.lock changed while snapshotting."
    )
  end
  source_stat = File.lstat(source_root)
  unless source_stat.directory? &&
         !source_stat.symlink? &&
         source_stat.uid == Process.uid &&
         (source_stat.mode & 0o777) == 0o500
    UI.user_error!("The reviewed LAB-002 source root identity is invalid.")
  end
  [
    source_root,
    source_sha256,
    gemfile_lock_sha256,
    [source_stat.dev, source_stat.ino],
  ]
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT, Errno::ENOTDIR
  UI.user_error!("Unable to create the reviewed LAB-002 source snapshot safely.")
end

def verify_held_lab002_source_directory!(
  source_root,
  source_handle,
  source_identity
)
  held = source_handle.stat
  linked = File.lstat(source_root)
  unless source_identity.is_a?(Array) &&
         source_identity.length == 2 &&
         held.directory? &&
         held.uid == Process.uid &&
         (held.mode & 0o777) == 0o500 &&
         !linked.symlink? &&
         [held.dev, held.ino] == source_identity &&
         [linked.dev, linked.ino] == source_identity
    UI.user_error!("The reviewed LAB-002 source directory changed.")
  end
  true
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT, Errno::ENOTDIR
  UI.user_error!("Unable to bind the reviewed LAB-002 source directory.")
end

def lab002_open_bound_directory!(
  path,
  label,
  required_mode: nil
)
  flags = File::RDONLY
  flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
  handle = File.open(path, flags)
  held = handle.stat
  linked = File.lstat(path)
  unless held.directory? &&
         held.uid == Process.uid &&
         (held.mode & 0o022).zero? &&
         (required_mode.nil? || (held.mode & 0o777) == required_mode) &&
         !linked.symlink? &&
         [linked.dev, linked.ino] == [held.dev, held.ino]
    handle.close
    UI.user_error!("#{label} root is unsafe.")
  end
  [handle, [held.dev, held.ino]]
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT, Errno::ENOTDIR
  handle&.close
  UI.user_error!("Unable to bind #{label.downcase}.")
end

def verify_held_lab002_directory!(
  path,
  handle,
  identity,
  label,
  required_mode: nil
)
  held = handle.stat
  linked = File.lstat(path)
  unless identity.is_a?(Array) &&
         identity.length == 2 &&
         held.directory? &&
         held.uid == Process.uid &&
         (held.mode & 0o022).zero? &&
         (required_mode.nil? || (held.mode & 0o777) == required_mode) &&
         !linked.symlink? &&
         [held.dev, held.ino] == identity &&
         [linked.dev, linked.ino] == identity
    UI.user_error!("#{label} directory changed.")
  end
  true
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT, Errno::ENOTDIR
  UI.user_error!("Unable to verify the held #{label.downcase}.")
end

def capture3_in_held_directory(environment, directory, *command)
  stdout_reader, stdout_writer = IO.pipe
  stderr_reader, stderr_writer = IO.pipe
  pid = nil
  waited = false
  stdout_thread = nil
  stderr_thread = nil
  pid = fork do
    stdout_reader.close
    stderr_reader.close
    STDOUT.reopen(stdout_writer)
    STDERR.reopen(stderr_writer)
    stdout_writer.close
    stderr_writer.close
    if DemoLabDarwin.fchdir(directory.fileno).nonzero?
      STDERR.write("Unable to enter the held LAB-002 source directory.\n")
      exit! 126
    end
    Process.exec(
      environment,
      *command,
      unsetenv_others: true,
      close_others: true
    )
  rescue StandardError
    STDERR.write("Unable to execute the held LAB-002 build command.\n")
    exit! 126
  end
  stdout_writer.close
  stderr_writer.close
  stdout_thread = Thread.new { stdout_reader.read }
  stderr_thread = Thread.new { stderr_reader.read }
  _, status = Process.wait2(pid)
  waited = true
  [stdout_thread.value, stderr_thread.value, status]
rescue Exception
  if pid && !waited
    Process.kill("TERM", pid) rescue nil
    Process.wait(pid) rescue nil
  end
  raise
ensure
  [
    stdout_reader,
    stdout_writer,
    stderr_reader,
    stderr_writer,
  ].compact.each do |stream|
    stream.close unless stream.closed?
  rescue IOError
    nil
  end
  stdout_thread&.join
  stderr_thread&.join
end

def lab002_private_build_sandbox!(
  workspace:,
  toolchain_root:,
  vendor_root:,
  source_root:
)
  sandbox_exec = pinned_executable(
    "/usr/bin/sandbox-exec",
    "System sandbox-exec"
  )
  isolated_home = File.join(workspace, "isolated-home")
  Dir.mkdir(isolated_home, 0o700)
  profile_path = File.join(workspace, "cargo-build.sb")
  owner_home = File.realpath(Etc.getpwuid(Process.uid).dir)
  readable_roots = [source_root, toolchain_root, vendor_root, workspace]
    .map { |path| File.realpath(path) }
    .uniq
  profile = [
    "(version 1)",
    "(allow default)",
    "(deny network*)",
    "(deny mach-lookup (global-name \"com.apple.securityd\"))",
    "(deny mach-lookup (global-name \"com.apple.secd\"))",
    "(deny file-read-data (subpath #{JSON.generate(owner_home)}))",
    *readable_roots.map do |path|
      "(allow file-read-data (subpath #{JSON.generate(path)}))"
    end,
    "(deny file-write*)",
    "(allow file-write* (subpath #{JSON.generate(workspace)}))",
    "(allow file-write* (literal \"/dev/null\"))",
  ].join("\n") + "\n"
  File.open(profile_path, File::WRONLY | File::CREAT | File::EXCL, 0o400) do |file|
    file.write(profile)
    file.flush
    file.fsync
  end
  [sandbox_exec, profile_path, isolated_home]
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT, Errno::ENOTDIR
  UI.user_error!("Unable to create the private Cargo build sandbox.")
end

def lab002_read_exact_at!(file, offset, length, label)
  unless offset.is_a?(Integer) &&
         length.is_a?(Integer) &&
         offset >= 0 &&
         length >= 0 &&
         offset <= file.stat.size &&
         length <= file.stat.size - offset
    UI.user_error!("#{label} is outside the private helper.")
  end
  file.seek(offset, IO::SEEK_SET)
  bytes = file.read(length)
  unless bytes&.bytesize == length
    UI.user_error!("#{label} is truncated in the private helper.")
  end
  bytes
end

def lab002_private_tool_cdhash!(file)
  header = lab002_read_exact_at!(file, 0, 32, "Mach-O header")
  fields = header.unpack("V8")
  unless fields.fetch(0) == 0xfeedfacf
    UI.user_error!("The private LAB-002 helper is not a thin 64-bit Mach-O.")
  end
  command_count = fields.fetch(4)
  command_bytes = fields.fetch(5)
  unless command_count.positive? &&
         command_count <= 256 &&
         command_bytes >= command_count * 8 &&
         command_bytes <= 1024 * 1024
    UI.user_error!("The private LAB-002 helper load commands are invalid.")
  end
  commands =
    lab002_read_exact_at!(file, 32, command_bytes, "Mach-O load commands")
  command_offset = 0
  signature_range = nil
  command_count.times do
    if command_offset > commands.bytesize - 8
      UI.user_error!("The private LAB-002 helper load commands are truncated.")
    end
    command, command_size =
      commands.byteslice(command_offset, 8).unpack("V2")
    unless command_size >= 8 &&
           command_offset <= commands.bytesize - command_size
      UI.user_error!("The private LAB-002 helper load command is invalid.")
    end
    if command == 0x1d
      unless command_size == 16 && signature_range.nil?
        UI.user_error!("The private LAB-002 helper signature command is invalid.")
      end
      _, _, data_offset, data_size =
        commands.byteslice(command_offset, 16).unpack("V4")
      signature_range = [data_offset, data_size]
    end
    command_offset += command_size
  end
  unless command_offset == commands.bytesize && signature_range
    UI.user_error!("The private LAB-002 helper signature is missing.")
  end

  signature = lab002_read_exact_at!(
    file,
    signature_range.fetch(0),
    signature_range.fetch(1),
    "Mach-O code signature"
  )
  unless signature.bytesize >= 12
    UI.user_error!("The private LAB-002 helper code signature is truncated.")
  end
  magic, signature_length, blob_count =
    signature.byteslice(0, 12).unpack("N3")
  unless magic == 0xfade0cc0 &&
         signature_length >= 12 &&
         signature_length <= signature.bytesize &&
         blob_count.positive? &&
         blob_count <= 32 &&
         12 + blob_count * 8 <= signature_length
    UI.user_error!("The private LAB-002 helper superblob is invalid.")
  end

  cdhashes = []
  blob_count.times do |index|
    entry_offset = 12 + index * 8
    _, blob_offset =
      signature.byteslice(entry_offset, 8).unpack("N2")
    next if blob_offset > signature_length - 8

    blob_magic, blob_length =
      signature.byteslice(blob_offset, 8).unpack("N2")
    next unless blob_magic == 0xfade0c02 &&
                blob_length >= 40 &&
                blob_offset <= signature_length - blob_length

    code_directory = signature.byteslice(blob_offset, blob_length)
    hash_size = code_directory.getbyte(36)
    hash_type = code_directory.getbyte(37)
    next unless hash_size == 32 && hash_type == 2

    cdhashes << Digest::SHA256.digest(code_directory)
      .byteslice(0, DEMO_LAB_LAB002_CDHASH_BYTES)
      .unpack1("H*")
  end
  unless cdhashes.length == 1
    UI.user_error!(
      "The private LAB-002 helper must have one SHA-256 CodeDirectory."
    )
  end
  cdhashes.fetch(0)
ensure
  file.rewind if file
end

def lab002_private_tool_identity!(binary)
  flags = File::RDONLY | File::NONBLOCK
  flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
  File.open(binary, flags) do |file|
    opened = file.stat
    linked = File.lstat(binary)
    unless opened.file? &&
           opened.uid == Process.uid &&
           (opened.mode & 0o777) == 0o500 &&
           !linked.symlink? &&
           [linked.dev, linked.ino] == [opened.dev, opened.ino] &&
           opened.size.positive? &&
           opened.size <= 32 * 1024 * 1024
      UI.user_error!("The private LAB-002 tool product is invalid.")
    end
    [
      opened.dev,
      opened.ino,
      opened.size,
      digest_open_file(file),
      lab002_private_tool_cdhash!(file),
    ]
  end
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT, Errno::ENOTDIR
  UI.user_error!("Unable to inspect the private LAB-002 tool safely.")
end

def verify_trusted_lab002_private_tool!(
  identity,
  source_sha256,
  toolchain_name
)
  expected =
    DEMO_LAB_TRUSTED_LAB002_PRIVATE_TOOLS.dig(
      toolchain_name,
      source_sha256
    )
  observed = {
    "size" => identity.fetch(2),
    "sha256" => identity.fetch(3),
    "cdhash" => identity.fetch(4),
  }
  unless expected.is_a?(Array) && expected.include?(observed)
    UI.user_error!(
      "The private LAB-002 helper product is not independently reviewed."
    )
  end
  true
end

def build_lab002_private_tool(source_commit)
  workspace = nil
  vendor_workspace = nil
  source_workspace = nil
  source_handle = nil
  toolchain_handle = nil
  vendor_handle = nil
  workspace = external_temporary_directory("orchardprobe-lab002-tool-")
  vendor_workspace =
    external_temporary_directory("orchardprobe-lab002-vendor-")
  source_workspace =
    external_temporary_directory("orchardprobe-lab002-source-")
  source_root, source_sha256, gemfile_lock_sha256, source_identity =
    lab002_reviewed_source_snapshot!(source_workspace, source_commit)
  source_flags = File::RDONLY
  source_flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
  source_handle = File.open(source_root, source_flags)
  verify_held_lab002_source_directory!(
    source_root,
    source_handle,
    source_identity
  )
  toolchain_name, toolchain_root, cargo, rustc, toolchain_sha256 =
    selected_lab002_rust_toolchain(source_root)
  vendor_root, vendor_sha256 =
    lab002_verified_vendor_source(
      vendor_workspace,
      lock_path: File.join(source_root, "Cargo.lock")
    )
  toolchain_handle, toolchain_identity =
    lab002_open_bound_directory!(
      toolchain_root,
      "Pinned Rust toolchain"
    )
  vendor_handle, vendor_identity =
    lab002_open_bound_directory!(
      vendor_root,
      "Verified Cargo dependency source",
      required_mode: 0o500
    )
  cargo_home = File.join(workspace, "cargo-home")
  Dir.mkdir(cargo_home, 0o700)
  cargo_config = File.join(cargo_home, "config.toml")
  File.open(cargo_config, File::WRONLY | File::CREAT | File::EXCL, 0o400) do |file|
    file.write(
      <<~TOML
        [net]
        offline = true

        [source.crates-io]
        replace-with = "lab002-verified"

        [source.lab002-verified]
        directory = #{JSON.generate(vendor_root)}
      TOML
    )
    file.flush
    file.fsync
  end
  sandbox_exec, sandbox_profile, isolated_home =
    lab002_private_build_sandbox!(
      workspace: workspace,
      toolchain_root: toolchain_root,
      vendor_root: vendor_root,
      source_root: source_root
    )
  environment = {
    "CARGO_HOME" => cargo_home,
    "CARGO_NET_OFFLINE" => "true",
    "CARGO_TARGET_DIR" => workspace,
    "HOME" => isolated_home,
    "LANG" => "en_US.UTF-8",
    "LC_ALL" => "en_US.UTF-8",
    "PATH" =>
      "#{File.join(toolchain_root, 'bin')}:#{DEMO_LAB_PINNED_SYSTEM_PATH}",
    "RUSTC" => rustc,
    "RUSTFLAGS" =>
      [
        "--remap-path-prefix=#{source_root}=/orchardprobe/reviewed-source",
        "--remap-path-prefix=#{vendor_root}=/orchardprobe/verified-vendor",
        "--remap-path-prefix=#{toolchain_root}=/orchardprobe/rust-toolchain",
      ].join(" "),
    "SOURCE_DATE_EPOCH" => "0",
    "TMPDIR" => workspace,
    "ZERO_AR_DATE" => "1",
  }
  stdout, stderr, status = capture3_in_held_directory(
    environment,
    source_handle,
    sandbox_exec.fetch("path"),
    "-f",
    sandbox_profile,
    cargo,
    "build",
    "--offline",
    "--locked",
    "--release",
    "--package",
    "orchardprobe-lab002-tools"
  )
  unless status.success?
    detail = stderr.strip.empty? ? stdout.strip : stderr.strip
    UI.user_error!(
      "Private LAB-002 tool build failed (#{status.inspect}): #{detail}"
    )
  end
  unless lab002_rust_toolchain_tree_sha256(vendor_root) == vendor_sha256
    UI.user_error!("The verified Cargo dependency source changed during the build.")
  end
  verify_held_lab002_directory!(
    vendor_root,
    vendor_handle,
    vendor_identity,
    "Verified Cargo dependency source",
    required_mode: 0o500
  )
  verify_held_lab002_source_directory!(
    source_root,
    source_handle,
    source_identity
  )
  unless lab002_rust_toolchain_tree_sha256(
    source_root,
    "LAB-002 reviewed source snapshot"
  ) == source_sha256
    UI.user_error!("The reviewed LAB-002 source snapshot changed during the build.")
  end
  verify_held_lab002_source_directory!(
    source_root,
    source_handle,
    source_identity
  )
  unless lab002_rust_toolchain_tree_sha256(toolchain_root) ==
         toolchain_sha256
    UI.user_error!("The pinned Rust toolchain changed during the build.")
  end
  verify_held_lab002_directory!(
    toolchain_root,
    toolchain_handle,
    toolchain_identity,
    "Pinned Rust toolchain"
  )
  binary = File.join(workspace, "release", "oprobe-lab002")
  stat = File.lstat(binary)
  unless stat.file? &&
         !stat.symlink? &&
         stat.uid == Process.uid &&
         File.executable?(binary) &&
         stat.size.positive? &&
         stat.size <= 32 * 1024 * 1024
    UI.user_error!("The private LAB-002 tool product is invalid.")
  end
  File.chmod(0o500, binary)
  identity = lab002_private_tool_identity!(binary)
  verify_trusted_lab002_private_tool!(
    identity,
    source_sha256,
    toolchain_name
  )
  [binary, workspace, identity, gemfile_lock_sha256]
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT
  FileUtils.rm_rf(workspace) if workspace
  UI.user_error!("Unable to build the private LAB-002 tool safely.")
rescue StandardError
  FileUtils.rm_rf(workspace) if workspace
  raise
ensure
  source_handle&.close unless source_handle&.closed?
  toolchain_handle&.close unless toolchain_handle&.closed?
  vendor_handle&.close unless vendor_handle&.closed?
  lab002_remove_verified_vendor!(vendor_workspace) if vendor_workspace
  if source_workspace
    lab002_remove_readonly_workspace!(
      source_workspace,
      "LAB-002 reviewed source workspace"
    )
  end
end

def verify_lab002_private_tool!(binary, workspace, identity)
  resolved = File.realpath(binary)
  unless resolved.start_with?("#{File.realpath(workspace)}#{File::SEPARATOR}") &&
         lab002_private_tool_identity!(resolved) == identity
    UI.user_error!("The private LAB-002 tool changed during use.")
  end
  true
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT
  UI.user_error!("Unable to revalidate the private LAB-002 tool safely.")
end

def verify_running_lab002_private_tool!(pid, identity)
  unless pid.is_a?(Integer) &&
         pid.positive? &&
         identity.is_a?(Array) &&
         identity.length == 5 &&
         identity.fetch(0).is_a?(Integer) &&
         identity.fetch(1).is_a?(Integer) &&
         /\A[0-9a-f]{40}\z/.match?(identity.fetch(4).to_s)
    UI.user_error!("The running LAB-002 helper identity is invalid.")
  end
  lsof = pinned_executable("/usr/sbin/lsof", "System lsof")
  stdout, stderr, status = Open3.capture3(
    sanitized_dynamic_loader_environment,
    lsof.fetch("path"),
    "-a",
    "-p",
    pid.to_s,
    "-d",
    "txt",
    "-F",
    "ftDi",
    unsetenv_others: true
  )
  unless status.success? && stderr.empty?
    UI.user_error!("Unable to inspect the running LAB-002 helper image.")
  end

  records = []
  current = nil
  stdout.each_line do |line|
    line = line.chomp
    case line.byteslice(0, 1)
    when "f"
      records << current if current
      current = {}
    when "t"
      current["type"] = line.byteslice(1..) if current
    when "D"
      current["device"] = Integer(line.byteslice(1..), 0) if current
    when "i"
      current["inode"] = Integer(line.byteslice(1..), 10) if current
    end
  rescue ArgumentError
    UI.user_error!("The running LAB-002 helper image record is invalid.")
  end
  records << current if current
  matching_images = records.select do |record|
    record["type"] == "REG" &&
      record["device"] == identity.fetch(0) &&
      record["inode"] == identity.fetch(1)
  end

  running_cdhash = "\0".b * DEMO_LAB_LAB002_CDHASH_BYTES
  csops_result = DemoLabDarwin.csops(
    pid,
    DEMO_LAB_LAB002_CS_OPS_CDHASH,
    running_cdhash,
    running_cdhash.bytesize
  )
  unless csops_result.zero? &&
         matching_images.length == 1 &&
         running_cdhash.unpack1("H*") == identity.fetch(4) &&
         pinned_executable("/usr/sbin/lsof", "System lsof") == lsof
    UI.user_error!(
      "The running LAB-002 helper does not match the verified image."
    )
  end
  true
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT, Errno::ESRCH
  UI.user_error!("Unable to bind the running LAB-002 helper safely.")
end

def lab002_toolchain_record(xcode_toolchain, gemfile_lock_sha256:)
  unless /\A[0-9a-f]{64}\z/.match?(gemfile_lock_sha256)
    UI.user_error!("Reviewed Gemfile.lock digest is invalid for LAB-002.")
  end
  xcode_lines = xcode_toolchain.fetch("xcode_version").map(&:strip)
  xcode_version = xcode_lines[0]&.delete_prefix("Xcode ")
  xcode_build = xcode_lines[1]&.delete_prefix("Build version ")
  unless /\A[0-9]+(?:\.[0-9]+){0,3}\z/.match?(xcode_version.to_s) &&
         /\A[0-9]+[A-Z][A-Za-z0-9]+\z/.match?(xcode_build.to_s)
    UI.user_error!("Selected Xcode version metadata is invalid for LAB-002.")
  end
  xcodegen_path, xcodegen_version, xcodegen_identity = selected_xcodegen
  record = {
    "xcode_version" => xcode_version,
    "xcode_build" => xcode_build,
    "iphoneos_sdk_version" =>
      xcode_toolchain.fetch("iphoneos_sdk_version"),
    "iphoneos_sdk_build" =>
      xcode_toolchain.fetch("iphoneos_sdk_build"),
    "xcodegen_version" => xcodegen_version,
    "xcodegen_architecture" => command_output("/usr/bin/uname", "-m"),
    "xcodegen_executable_sha256" => xcodegen_identity.fetch(4),
    "fastlane_version" => Fastlane::VERSION,
    "gemfile_lock_sha256" => gemfile_lock_sha256,
  }
  xcodegen_selection = [
    xcodegen_path,
    xcodegen_version,
    xcodegen_identity,
  ]
  verify_selected_xcodegen!(*xcodegen_selection)
  [record, xcodegen_selection]
end

def lab002_entitlement(presence, value = nil)
  record = { "presence" => presence }
  record["value"] = value if value
  record
end

def lab002_app_groups(presence, values = nil)
  record = { "presence" => presence }
  record["values"] = values if values
  record
end

def lab002_authorized_targets(
  app_identifier:,
  share_identifier:,
  app_group_identifier:,
  team_identifier:
)
  present_application_identifier = lambda do |bundle_identifier|
    lab002_entitlement(
      "present",
      "#{team_identifier}.#{bundle_identifier}"
    )
  end
  present_team_identifier =
    lab002_entitlement("present", team_identifier)
  present_app_group =
    lab002_app_groups("present", [app_group_identifier])
  required_absent = lab002_entitlement("required_absent")
  groups_required_absent = lab002_app_groups("required_absent")
  [
    {
      "role" => "main_app",
      "bundle_id" => app_identifier,
      "code_directory_identifier" => app_identifier,
      "code_directory_team_identifier" => team_identifier,
      "application_identifier" =>
        present_application_identifier.call(app_identifier),
      "developer_team_identifier" => present_team_identifier,
      "application_groups" => present_app_group,
    },
    {
      "role" => "framework",
      "bundle_id" => "#{app_identifier}.framework",
      "code_directory_identifier" => "#{app_identifier}.framework",
      "code_directory_team_identifier" => team_identifier,
      "application_identifier" => required_absent,
      "developer_team_identifier" => required_absent,
      "application_groups" => groups_required_absent,
    },
    {
      "role" => "share_extension",
      "bundle_id" => share_identifier,
      "code_directory_identifier" => share_identifier,
      "code_directory_team_identifier" => team_identifier,
      "application_identifier" =>
        present_application_identifier.call(share_identifier),
      "developer_team_identifier" => present_team_identifier,
      "application_groups" => present_app_group,
    },
  ]
end

def prepare_lab002_private_inputs!(
  output_root:,
  output_handle:,
  output_identity:,
  source_commit:,
  marketing_version:,
  build_number:,
  app_identifier:,
  share_identifier:,
  app_group_identifier:,
  team_identifier:,
  xcode_toolchain:
)
  held_output_root = output_handle.stat
  unless output_identity.is_a?(Array) &&
         output_identity.length == 3 &&
         held_output_root.directory? &&
         held_output_root.uid == Process.uid &&
         (held_output_root.mode & 0o777) == 0o700 &&
         [held_output_root.dev, held_output_root.ino] ==
           output_identity.drop(1)
    UI.user_error!("LAB-002 output-root descriptor identity is invalid.")
  end
  targets = lab002_authorized_targets(
    app_identifier: app_identifier,
    share_identifier: share_identifier,
    app_group_identifier: app_group_identifier,
    team_identifier: team_identifier
  )
  binary = nil
  tool_workspace = nil
  acknowledgement_reader = nil
  acknowledgement_writer = nil
  begin
    binary, tool_workspace, tool_identity, gemfile_lock_sha256 =
      build_lab002_private_tool(source_commit)
    toolchain, xcodegen_selection = lab002_toolchain_record(
      xcode_toolchain,
      gemfile_lock_sha256: gemfile_lock_sha256
    )
    request = {
      "schema" => DEMO_LAB_LAB002_PREBUILD_REQUEST_SCHEMA,
      "source_commit" => source_commit,
      "marketing_version" => marketing_version,
      "build_number" => build_number,
      "configuration" => "Release",
      "observer_revision" => "lab002-observer-v1",
      "toolchain" => toolchain,
      "targets" => targets,
    }
    verify_lab002_private_tool!(binary, tool_workspace, tool_identity)
    verify_selected_xcode_toolchain!(xcode_toolchain)
    acknowledgement_reader, acknowledgement_writer = IO.pipe
    result_json = nil
    helper_stderr = ""
    status = nil
    publication_state = nil
    Open3.popen3(
      sanitized_dynamic_loader_environment,
      binary,
      "prepare",
      "--output-root",
      output_root,
      "--output-root-device",
      held_output_root.dev.to_s,
      "--output-root-inode",
      held_output_root.ino.to_s,
      3 => acknowledgement_reader,
      4 => output_handle,
      chdir: repository_root,
      close_others: true
    ) do |stdin, stdout, error_stream, wait_thread|
      acknowledgement_reader.close
      verify_running_lab002_private_tool!(wait_thread.pid, tool_identity)
      stdin.write(JSON.generate(request))
      stdin.close
      identity_line = stdout.gets&.chomp
      identity_match = /\A#{Regexp.escape(
        DEMO_LAB_LAB002_PUBLICATION_IDENTITY_SCHEMA
      )} (\.lab002-prebuild-[0-9a-f]{32}) (0|[1-9][0-9]*) (0|[1-9][0-9]*)\z/
        .match(identity_line.to_s)
      publication_state = if identity_match
                            {
                              "staging_name" => identity_match[1],
                              "identity" => [
                                Integer(identity_match[2], 10),
                                Integer(identity_match[3], 10),
                              ],
                            }
                          end
      if publication_state
        verify_running_lab002_private_tool!(wait_thread.pid, tool_identity)
        yield(publication_state) if block_given?
        acknowledgement_writer.write("A")
      else
        acknowledgement_writer.write("X")
      end
      acknowledgement_writer.flush
      acknowledgement_writer.close
      result_json =
        stdout.read(DEMO_LAB_MAX_LAB002_HELPER_OUTPUT_BYTES + 1)
      helper_stderr =
        error_stream.read(DEMO_LAB_MAX_LAB002_HELPER_OUTPUT_BYTES + 1)
      status = wait_thread.value
    ensure
      acknowledgement_writer.close unless acknowledgement_writer.closed?
    end
    if result_json&.bytesize.to_i >
       DEMO_LAB_MAX_LAB002_HELPER_OUTPUT_BYTES ||
       helper_stderr.to_s.bytesize >
         DEMO_LAB_MAX_LAB002_HELPER_OUTPUT_BYTES
      UI.user_error!("LAB-002 private tool output exceeded its fixed limit.")
    end
    unless status.success?
      UI.user_error!(
        "LAB-002 private input preparation failed: #{helper_stderr.to_s.strip}"
      )
    end
    unless publication_state && !result_json.to_s.empty?
      UI.user_error!("LAB-002 private input result identity is missing.")
    end
    result = JSON.parse(result_json)
    require_exact_hash_keys!(
      result,
      %w[
        schema
        prebuild_directory
        prebuild_directory_device
        prebuild_directory_inode
        authorized_target_manifest_sha256
        build_binding_sha256
        target_identity_set_sha256
        private_artifacts
      ],
      "LAB-002 prebuild result"
    )
    expected_prebuild_directory = File.join(
      output_root,
      "lab002-prebuild-#{marketing_version}-#{build_number}-#{source_commit}"
    )
    unless result["schema"] == DEMO_LAB_LAB002_PREBUILD_RESULT_SCHEMA &&
           result["prebuild_directory"] == expected_prebuild_directory &&
           [
             Integer(result["prebuild_directory_device"], 10),
             Integer(result["prebuild_directory_inode"], 10),
           ] == publication_state.fetch("identity") &&
           %w[
             prebuild_directory_device
             prebuild_directory_inode
           ].all? { |name|
             /\A(?:0|[1-9][0-9]*)\z/.match?(result[name].to_s)
           } &&
           %w[
             authorized_target_manifest_sha256
             build_binding_sha256
             target_identity_set_sha256
           ].all? { |name|
             /\A[0-9a-f]{64}\z/.match?(result[name].to_s)
           } &&
           result["private_artifacts"].is_a?(Array) &&
           result["private_artifacts"].length ==
             DEMO_LAB_LAB002_PRIVATE_ARTIFACT_NAMES.length
      UI.user_error!("LAB-002 private input result is invalid.")
    end
    private_artifacts =
      result["private_artifacts"].each_with_index.map do |artifact, index|
        require_exact_hash_keys!(
          artifact,
          %w[name device inode mode size sha256],
          "LAB-002 private artifact identity"
        )
        expected_name =
          DEMO_LAB_LAB002_PRIVATE_ARTIFACT_NAMES.fetch(index)
        unless artifact["name"] == expected_name &&
               /\A(?:0|[1-9][0-9]*)\z/.match?(artifact["device"].to_s) &&
               /\A(?:0|[1-9][0-9]*)\z/.match?(artifact["inode"].to_s) &&
               artifact["mode"] == 0o400 &&
               artifact["size"].is_a?(Integer) &&
               artifact["size"].positive? &&
               artifact["size"] <= 1024 * 1024 &&
               /\A[0-9a-f]{64}\z/.match?(artifact["sha256"].to_s)
          UI.user_error!("LAB-002 private artifact identity is invalid.")
        end
        {
          "name" => expected_name,
          "device" => Integer(artifact["device"], 10),
          "inode" => Integer(artifact["inode"], 10),
          "mode" => artifact["mode"],
          "size" => artifact["size"],
          "sha256" => artifact["sha256"],
        }
      end
    manifest_identity = private_artifacts.fetch(1)
    unless manifest_identity.fetch("sha256") ==
           result.fetch("authorized_target_manifest_sha256")
      UI.user_error!(
        "LAB-002 authorized-target manifest result digest changed."
      )
    end
    publication_state["artifacts"] = private_artifacts
    verify_selected_xcode_toolchain!(xcode_toolchain)
    verify_lab002_private_tool!(binary, tool_workspace, tool_identity)
    verify_selected_xcodegen!(*xcodegen_selection)
    result
  ensure
    acknowledgement_reader&.close unless acknowledgement_reader&.closed?
    acknowledgement_writer&.close unless acknowledgement_writer&.closed?
    FileUtils.rm_rf(tool_workspace) if tool_workspace
  end
end

def inspect_lab002_private_inputs!(
  prebuild_directory:,
  prebuild_handle:,
  prebuild_identity:,
  source_commit:,
  marketing_version:,
  build_number:,
  app_identifier:,
  share_identifier:,
  app_group_identifier:,
  team_identifier:,
  xcode_toolchain:
)
  held = prebuild_handle.stat
  unless prebuild_identity.is_a?(Array) &&
         prebuild_identity.length == 3 &&
         prebuild_identity.first == prebuild_directory &&
         held.directory? &&
         held.uid == Process.uid &&
         (held.mode & 0o777) == 0o700 &&
         [held.dev, held.ino] == prebuild_identity.drop(1)
    UI.user_error!("LAB-002 prebuild-directory descriptor identity is invalid.")
  end
  targets = lab002_authorized_targets(
    app_identifier: app_identifier,
    share_identifier: share_identifier,
    app_group_identifier: app_group_identifier,
    team_identifier: team_identifier
  )
  binary = nil
  tool_workspace = nil
  begin
    binary, tool_workspace, tool_identity, gemfile_lock_sha256 =
      build_lab002_private_tool(source_commit)
    toolchain, xcodegen_selection = lab002_toolchain_record(
      xcode_toolchain,
      gemfile_lock_sha256: gemfile_lock_sha256
    )
    request = {
      "schema" => DEMO_LAB_LAB002_INSPECT_REQUEST_SCHEMA,
      "source_commit" => source_commit,
      "marketing_version" => marketing_version,
      "build_number" => build_number,
      "configuration" => "Release",
      "observer_revision" => "lab002-observer-v1",
      "toolchain" => toolchain,
      "targets" => targets,
    }
    verify_lab002_private_tool!(binary, tool_workspace, tool_identity)
    verify_selected_xcode_toolchain!(xcode_toolchain)
    verify_held_lab002_directory!(
      prebuild_directory,
      prebuild_handle,
      prebuild_identity.drop(1),
      "LAB-002 prebuild",
      required_mode: 0o700
    )
    result_json = nil
    helper_stderr = ""
    status = nil
    Open3.popen3(
      sanitized_dynamic_loader_environment,
      binary,
      "inspect-prebuild",
      "--prebuild-directory",
      prebuild_directory,
      "--prebuild-directory-device",
      held.dev.to_s,
      "--prebuild-directory-inode",
      held.ino.to_s,
      4 => prebuild_handle,
      chdir: repository_root,
      close_others: true
    ) do |stdin, stdout, error_stream, wait_thread|
      verify_running_lab002_private_tool!(wait_thread.pid, tool_identity)
      stdin.write(JSON.generate(request))
      stdin.close
      result_json =
        stdout.read(DEMO_LAB_MAX_LAB002_HELPER_OUTPUT_BYTES + 1)
      helper_stderr =
        error_stream.read(DEMO_LAB_MAX_LAB002_HELPER_OUTPUT_BYTES + 1)
      status = wait_thread.value
    end
    if result_json&.bytesize.to_i >
       DEMO_LAB_MAX_LAB002_HELPER_OUTPUT_BYTES ||
       helper_stderr.to_s.bytesize >
         DEMO_LAB_MAX_LAB002_HELPER_OUTPUT_BYTES
      UI.user_error!("LAB-002 private tool output exceeded its fixed limit.")
    end
    unless status.success?
      UI.user_error!(
        "LAB-002 private prebuild inspection failed: " \
        "#{helper_stderr.to_s.strip}"
      )
    end
    result = JSON.parse(result_json)
    require_exact_hash_keys!(
      result,
      %w[
        schema
        prebuild_directory_device
        prebuild_directory_inode
        source_commit
        marketing_version
        build_number
        identity_nonce
        authorization_public_key
        authorization_key_id
        authorized_target_manifest_sha256
        build_binding_sha256
        target_identity_set_sha256
        toolchain
      ],
      "LAB-002 inspected prebuild result"
    )
    unless result["schema"] == DEMO_LAB_LAB002_INSPECT_RESULT_SCHEMA &&
           result["prebuild_directory_device"] == held.dev.to_s &&
           result["prebuild_directory_inode"] == held.ino.to_s &&
           result["source_commit"] == source_commit &&
           result["marketing_version"] == marketing_version &&
           result["build_number"] == build_number &&
           result["toolchain"] == toolchain &&
           %w[
             identity_nonce
             authorization_public_key
             authorization_key_id
             authorized_target_manifest_sha256
             build_binding_sha256
             target_identity_set_sha256
           ].all? { |name|
             /\A[0-9a-f]{64}\z/.match?(result[name].to_s)
           }
      UI.user_error!("LAB-002 inspected prebuild result is invalid.")
    end
    validate_demolab_authorization_public_key!(
      result.fetch("authorization_public_key")
    )
    verify_held_lab002_directory!(
      prebuild_directory,
      prebuild_handle,
      prebuild_identity.drop(1),
      "LAB-002 prebuild",
      required_mode: 0o700
    )
    verify_selected_xcode_toolchain!(xcode_toolchain)
    verify_lab002_private_tool!(binary, tool_workspace, tool_identity)
    verify_selected_xcodegen!(*xcodegen_selection)
    result
  rescue JSON::ParserError
    UI.user_error!("LAB-002 private prebuild inspection returned invalid JSON.")
  ensure
    FileUtils.rm_rf(tool_workspace) if tool_workspace
  end
end

def create_lab002_private_oracle!(
  prebuild_directory:,
  prebuild_handle:,
  prebuild_identity:,
  run_directory:,
  run_handle:,
  run_identity:,
  source_commit:,
  marketing_version:,
  build_number:,
  app_identifier:,
  share_identifier:,
  app_group_identifier:,
  team_identifier:,
  xcode_toolchain:,
  on_retention_change: ->(_retain) {}
)
  verify_held_lab002_directory!(
    prebuild_directory,
    prebuild_handle,
    prebuild_identity.drop(1),
    "LAB-002 prebuild",
    required_mode: 0o700
  )
  verify_held_lab002_directory!(
    run_directory,
    run_handle,
    run_identity.drop(1),
    "DemoLab staging",
    required_mode: 0o700
  )
  targets = lab002_authorized_targets(
    app_identifier: app_identifier,
    share_identifier: share_identifier,
    app_group_identifier: app_group_identifier,
    team_identifier: team_identifier
  )
  binary = nil
  tool_workspace = nil
  begin
    binary, tool_workspace, tool_identity, gemfile_lock_sha256 =
      build_lab002_private_tool(source_commit)
    toolchain, xcodegen_selection = lab002_toolchain_record(
      xcode_toolchain,
      gemfile_lock_sha256: gemfile_lock_sha256
    )
    request = {
      "schema" => DEMO_LAB_LAB002_ORACLE_REQUEST_SCHEMA,
      "source_commit" => source_commit,
      "marketing_version" => marketing_version,
      "build_number" => build_number,
      "configuration" => "Release",
      "observer_revision" => "lab002-observer-v1",
      "toolchain" => toolchain,
      "targets" => targets,
    }
    held_prebuild = prebuild_handle.stat
    held_run = run_handle.stat
    verify_lab002_private_tool!(binary, tool_workspace, tool_identity)
    verify_selected_xcode_toolchain!(xcode_toolchain)
    result_json = nil
    helper_stderr = ""
    status = nil
    # Arm conservatively before Open3 can fork. From this point onward even a
    # spawn-time exception or interrupt must retain the private staging tree.
    on_retention_change.call(true)
    Open3.popen3(
      sanitized_dynamic_loader_environment,
      binary,
      "create-oracle",
      "--prebuild-directory",
      prebuild_directory,
      "--prebuild-directory-device",
      held_prebuild.dev.to_s,
      "--prebuild-directory-inode",
      held_prebuild.ino.to_s,
      "--run-directory",
      run_directory,
      "--run-directory-device",
      held_run.dev.to_s,
      "--run-directory-inode",
      held_run.ino.to_s,
      4 => prebuild_handle,
      5 => run_handle,
      chdir: repository_root,
      close_others: true
    ) do |stdin, stdout, error_stream, wait_thread|
      verify_running_lab002_private_tool!(wait_thread.pid, tool_identity)
      stdin.write(JSON.generate(request))
      stdin.close
      result_json =
        stdout.read(DEMO_LAB_MAX_LAB002_HELPER_OUTPUT_BYTES + 1)
      helper_stderr =
        error_stream.read(DEMO_LAB_MAX_LAB002_HELPER_OUTPUT_BYTES + 1)
      status = wait_thread.value
    end
    if result_json&.bytesize.to_i >
       DEMO_LAB_MAX_LAB002_HELPER_OUTPUT_BYTES ||
       helper_stderr.to_s.bytesize >
         DEMO_LAB_MAX_LAB002_HELPER_OUTPUT_BYTES
      UI.user_error!("LAB-002 oracle helper output exceeded its fixed limit.")
    end
    unless status.success?
      if lab002_oracle_publication_indeterminate?(helper_stderr)
        UI.important(
          "Retained private DemoLab staging for reconciliation: " \
          "#{run_directory}"
        )
      end
      UI.user_error!(
        "LAB-002 private oracle generation failed: " \
        "#{helper_stderr.to_s.strip}"
      )
    end
    result = JSON.parse(result_json)
    require_exact_hash_keys!(
      result,
      %w[
        schema
        oracle_name
        archive_app_device
        archive_app_inode
        oracle_device
        oracle_inode
        oracle_mode
        oracle_size
        oracle_sha256
        ipa_size
        ipa_sha256
        archive_files
      ],
      "LAB-002 oracle result"
    )
    unless result["schema"] == DEMO_LAB_LAB002_ORACLE_RESULT_SCHEMA &&
           result["oracle_name"] == DEMO_LAB_LAB002_ORACLE_NAME &&
           %w[
             archive_app_device
             archive_app_inode
             oracle_device
             oracle_inode
           ].all? { |name|
             /\A(?:0|[1-9][0-9]*)\z/.match?(result[name].to_s)
           } &&
           result["oracle_mode"] == 0o400 &&
           result["oracle_size"].is_a?(Integer) &&
           result["oracle_size"].positive? &&
           result["oracle_size"] <= 16 * 1024 &&
           result["ipa_size"].is_a?(Integer) &&
           result["ipa_size"].positive? &&
           result["ipa_size"] <= DEMO_LAB_MAX_IPA_BYTES &&
           %w[oracle_sha256 ipa_sha256].all? { |name|
             /\A[0-9a-f]{64}\z/.match?(result[name].to_s)
           } &&
           result["archive_files"].is_a?(Array) &&
           result["archive_files"].length ==
             DEMO_LAB_LAB002_ARCHIVE_SOURCE_SPECS.length
      UI.user_error!("LAB-002 oracle result is invalid.")
    end
    result["archive_files"].each_with_index do |measurement, index|
      require_exact_hash_keys!(
        measurement,
        %w[relative_path size sha256],
        "LAB-002 oracle Archive source"
      )
      specification = DEMO_LAB_LAB002_ARCHIVE_SOURCE_SPECS.fetch(index)
      unless measurement["relative_path"] ==
               specification.fetch("relative_path") &&
             measurement["size"].is_a?(Integer) &&
             measurement["size"].positive? &&
             measurement["size"] <= specification.fetch("maximum_size") &&
             /\A[0-9a-f]{64}\z/.match?(measurement["sha256"].to_s)
        UI.user_error!("LAB-002 oracle Archive source is invalid.")
      end
    end
    observed = lab002_published_artifact_identity!(
      run_handle,
      DEMO_LAB_LAB002_ORACLE_NAME,
      allowed_names: [DEMO_LAB_LAB002_ORACLE_NAME]
    )
    unless observed == {
      "name" => DEMO_LAB_LAB002_ORACLE_NAME,
      "device" => Integer(result["oracle_device"], 10),
      "inode" => Integer(result["oracle_inode"], 10),
      "mode" => result["oracle_mode"],
      "size" => result["oracle_size"],
      "sha256" => result["oracle_sha256"],
    }
      UI.user_error!("LAB-002 published oracle identity changed.")
    end
    verify_held_lab002_directory!(
      prebuild_directory,
      prebuild_handle,
      prebuild_identity.drop(1),
      "LAB-002 prebuild",
      required_mode: 0o700
    )
    verify_held_lab002_directory!(
      run_directory,
      run_handle,
      run_identity.drop(1),
      "DemoLab staging",
      required_mode: 0o700
    )
    verify_selected_xcode_toolchain!(xcode_toolchain)
    verify_lab002_private_tool!(binary, tool_workspace, tool_identity)
    verify_selected_xcodegen!(*xcodegen_selection)
    result
  rescue JSON::ParserError
    UI.user_error!("LAB-002 private oracle helper returned invalid JSON.")
  ensure
    FileUtils.rm_rf(tool_workspace) if tool_workspace
  end
end

def lab002_oracle_publication_indeterminate?(stderr)
  stderr.to_s.start_with?(DEMO_LAB_LAB002_ORACLE_INDETERMINATE_MARKER)
end

def cleanup_unpublished_demolab_staging!(
  staging_directory,
  published:,
  retain_staging:
)
  return unless staging_directory && !published && !retain_staging

  FileUtils.rm_rf(staging_directory)
end

def retained_demolab_staging_names!(directory)
  reader, writer = IO.pipe
  pid = nil
  waited = false
  pid = fork do
    reader.close
    exit! 126 if DemoLabDarwin.fchdir(directory.fileno).nonzero?

    retained = []
    Dir.foreach(".") do |name|
      next unless name.start_with?(".demolab-staging-")

      unless /\A\.demolab-staging-[A-Za-z0-9._-]+\z/.match?(name)
        exit! 125
      end
      retained << name
      exit! 125 if retained.length > 64
    end
    payload = JSON.generate(retained.sort)
    exit! 125 if payload.bytesize > 8 * 1024

    writer.write(payload)
    writer.close
    exit! 0
  rescue StandardError
    exit! 126
  end
  writer.close
  response = reader.read(8 * 1024 + 1)
  _, status = Process.wait2(pid)
  waited = true
  unless status.success? && response.bytesize <= 8 * 1024
    UI.user_error!("Unable to inspect retained DemoLab staging safely.")
  end
  retained = JSON.parse(response)
  unless retained.is_a?(Array) &&
         retained.length <= 64 &&
         retained.all? { |name|
           name.is_a?(String) &&
             /\A\.demolab-staging-[A-Za-z0-9._-]+\z/.match?(name)
         } &&
         retained == retained.sort &&
         retained.uniq == retained
    UI.user_error!("Retained DemoLab staging inventory is invalid.")
  end
  retained
rescue JSON::ParserError
  UI.user_error!("Retained DemoLab staging inventory is invalid.")
ensure
  if pid && !waited
    Process.kill("TERM", pid) rescue nil
    Process.wait(pid) rescue nil
  end
  reader&.close unless reader&.closed?
  writer&.close unless writer&.closed?
end

def cleanup_lab002_published_prebuild!(
  output_handle,
  final_name,
  publication_state
)
  expected_identity = publication_state.fetch("identity")
  staging_name = publication_state.fetch("staging_name")
  directory = nil
  active_name = nil
  mismatched_names = []
  [staging_name, final_name].each do |candidate|
    begin
      candidate_directory = lab002_open_directory_at(
        output_handle,
        candidate,
        required_mode: 0o700
      )
      candidate_identity = [
        candidate_directory.stat.dev,
        candidate_directory.stat.ino,
      ]
      if candidate_identity == expected_identity
        directory = candidate_directory
        active_name = candidate
        break
      end
      candidate_directory.close
      mismatched_names << candidate
    rescue Errno::ENOENT
      nil
    end
  end
  unless directory
    output_handle.fsync
    if mismatched_names.empty?
      UI.user_error!(
        "LAB-002 publication entries disappeared before rollback; " \
        "private state is indeterminate and no cleanup can be proven."
      )
    end

    UI.user_error!(
      "LAB-002 publication entries changed identity before rollback; " \
      "no files were removed."
    )
  end
  cleanup_lab002_bound_published_prebuild!(
    output_handle,
    final_name,
    publication_state,
    directory,
    active_name
  )
ensure
  directory&.close unless directory&.closed?
end

def lab002_descriptor_path!(directory)
  buffer = "\0".b * DemoLabDarwin::MAXPATHLEN
  directory.fcntl(DemoLabDarwin::F_GETPATH, buffer)
  path = buffer.split("\0".b, 2).first
  unless path && !path.empty? && path.start_with?("/") &&
         path.dup.force_encoding(Encoding::UTF_8).valid_encoding?
    UI.user_error!("LAB-002 held publication path is invalid.")
  end
  path
rescue SystemCallError
  UI.user_error!("Unable to inspect the held LAB-002 publication path.")
end

def cleanup_lab002_bound_published_prebuild!(
  output_handle,
  final_name,
  publication_state,
  directory,
  active_name
)
  expected_identity = publication_state.fetch("identity")
  staging_name = publication_state.fetch("staging_name")
  errors = []
  DEMO_LAB_LAB002_PRIVATE_ARTIFACT_NAMES.each do |name|
    result = DemoLabDarwin.unlinkat(directory.fileno, name, 0)
    next if result.zero?

    errors << SystemCallError.new("unlinkat", Fiddle.last_error)
  end
  begin
    directory.fsync
  rescue SystemCallError => error
    errors << error
  end

  removed = false
  begin
    [active_name, staging_name, final_name].uniq.each do |candidate|
      begin
        current = lab002_open_directory_at(
          output_handle,
          candidate,
          required_mode: nil
        )
        current_identity = [current.stat.dev, current.stat.ino]
        current.close
        next unless current_identity == expected_identity

        result = DemoLabDarwin.unlinkat(
          output_handle.fileno,
          candidate,
          DemoLabDarwin::AT_REMOVEDIR
        )
        if result.nonzero?
          error = SystemCallError.new("unlinkat", Fiddle.last_error)
          errors << error
        else
          removed = true
        end
        break
      rescue Errno::ENOENT
        nil
      end
    end
  end
  unless removed
    errors << RuntimeError.new(
      "the held publication identity vanished before directory removal"
    )
  end
  begin
    output_handle.fsync
  rescue SystemCallError => error
    errors << error
  end

  descriptor_path = lab002_descriptor_path!(directory)
  begin
    linked = File.lstat(descriptor_path)
    if [linked.dev, linked.ino] == expected_identity
      errors << RuntimeError.new(
        "the held publication identity remains linked after rollback"
      )
    else
      errors << RuntimeError.new(
        "the held publication path was replaced during rollback"
      )
    end
  rescue Errno::ENOENT, Errno::ENOTDIR
    nil
  end
  return if removed && errors.empty?

  UI.user_error!(
    "LAB-002 post-publication rollback is indeterminate: " \
    "#{errors.map(&:message).join('; ')}"
  )
end

def lab002_published_artifact_identity!(
  directory,
  name,
  allowed_names: DEMO_LAB_LAB002_PRIVATE_ARTIFACT_NAMES
)
  unless allowed_names.include?(name)
    UI.user_error!("LAB-002 published artifact name is invalid.")
  end
  flags = File::RDONLY | File::NONBLOCK
  flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
  descriptor = DemoLabDarwin.openat(directory.fileno, name, flags, 0)
  if descriptor.negative?
    raise SystemCallError.new("openat", Fiddle.last_error)
  end
  file = File.for_fd(descriptor, "r")
  file.fcntl(Fcntl::F_SETFD, Fcntl::FD_CLOEXEC)
  before = file.stat
  digest = digest_open_file(file)
  after = file.stat
  second_descriptor = DemoLabDarwin.openat(
    directory.fileno,
    name,
    flags,
    0
  )
  if second_descriptor.negative?
    raise SystemCallError.new("openat", Fiddle.last_error)
  end
  second = File.for_fd(second_descriptor, "r")
  second.fcntl(Fcntl::F_SETFD, Fcntl::FD_CLOEXEC)
  reopened_before = second.stat
  reopened_digest = digest_open_file(second)
  reopened_after = second.stat
  unless before.file? &&
         before.uid == Process.uid &&
         (before.mode & 0o777) == 0o400 &&
         before.size.positive? &&
         before.size <= 1024 * 1024 &&
         [
           after.dev,
           after.ino,
           after.mode & 0o777,
           after.size,
           after.mtime.to_f,
         ] == [
           before.dev,
           before.ino,
           before.mode & 0o777,
           before.size,
           before.mtime.to_f,
         ] &&
         reopened_digest == digest &&
         [
           reopened_before.dev,
           reopened_before.ino,
           reopened_before.mode & 0o777,
           reopened_before.size,
           reopened_before.mtime.to_f,
         ] == [
           before.dev,
           before.ino,
           before.mode & 0o777,
           before.size,
           before.mtime.to_f,
         ] &&
         [
           reopened_after.dev,
           reopened_after.ino,
           reopened_after.mode & 0o777,
           reopened_after.size,
           reopened_after.mtime.to_f,
         ] == [
           reopened_before.dev,
           reopened_before.ino,
           reopened_before.mode & 0o777,
           reopened_before.size,
           reopened_before.mtime.to_f,
         ]
    UI.user_error!("LAB-002 published private artifact changed identity.")
  end
  {
    "name" => name,
    "device" => before.dev,
    "inode" => before.ino,
    "mode" => before.mode & 0o777,
    "size" => before.size,
    "sha256" => reopened_digest,
  }
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT, Errno::ENOTDIR
  UI.user_error!("Unable to bind a LAB-002 published private artifact.")
ensure
  file&.close unless file&.closed?
  second&.close unless second&.closed?
end

def verify_lab002_closed_directory!(directory)
  reader, writer = IO.pipe
  pid = nil
  waited = false
  pid = fork do
    reader.close
    exit! 126 if DemoLabDarwin.fchdir(directory.fileno).nonzero?

    entries = []
    Dir.foreach(".") do |name|
      next if [".", ".."].include?(name)

      entries << name
      if entries.length > DEMO_LAB_LAB002_PRIVATE_ARTIFACT_NAMES.length
        exit! 125
      end
    end
    unless entries.sort == DEMO_LAB_LAB002_PRIVATE_ARTIFACT_NAMES.sort
      exit! 125
    end
    writer.write("closed")
    writer.close
    exit! 0
  rescue StandardError
    exit! 126
  end
  writer.close
  response = reader.read(7)
  _, status = Process.wait2(pid)
  waited = true
  unless status.success? && response == "closed"
    UI.user_error!(
      "LAB-002 published directory does not contain exactly the fixed " \
      "private artifacts."
    )
  end
  true
rescue SystemCallError
  UI.user_error!("Unable to enumerate the held LAB-002 publication safely.")
ensure
  reader&.close unless reader&.closed?
  writer&.close unless writer&.closed?
  if pid && !waited
    Process.kill("TERM", pid) rescue nil
    Process.wait(pid) rescue nil
  end
end

def verify_lab002_published_prebuild!(
  output_handle,
  final_name,
  publication_state
)
  final_directory = nil
  directory = lab002_open_directory_at(
    output_handle,
    final_name,
    required_mode: 0o700
  )
  observed_identity = [directory.stat.dev, directory.stat.ino]
  unless observed_identity == publication_state.fetch("identity")
    UI.user_error!(
      "LAB-002 published directory changed identity before success."
    )
  end
  verify_lab002_closed_directory!(directory)
  expected_artifacts = publication_state.fetch("artifacts")
  observed_artifacts =
    DEMO_LAB_LAB002_PRIVATE_ARTIFACT_NAMES.map do |name|
      lab002_published_artifact_identity!(directory, name)
    end
  unless observed_artifacts == expected_artifacts
    UI.user_error!(
      "LAB-002 published private artifacts changed before success."
    )
  end
  verify_lab002_closed_directory!(directory)
  final_directory = lab002_open_directory_at(
    output_handle,
    final_name,
    required_mode: 0o700
  )
  final_identity = [
    final_directory.stat.dev,
    final_directory.stat.ino,
  ]
  unless final_identity == publication_state.fetch("identity")
    UI.user_error!(
      "LAB-002 published directory changed during artifact verification."
    )
  end
  verify_lab002_closed_directory!(final_directory)
ensure
  directory&.close unless directory&.closed?
  final_directory&.close unless final_directory&.closed?
end

def with_lab002_publication_rollback!(output_handle, final_name)
  publication_state = nil
  arm_rollback = lambda do |state|
    if publication_state
      UI.user_error!("LAB-002 publication rollback was armed more than once.")
    end
    publication_state = state
  end
  result = yield(arm_rollback)
  unless publication_state
    UI.user_error!("LAB-002 publication rollback identity is missing.")
  end
  verify_lab002_published_prebuild!(
    output_handle,
    final_name,
    publication_state
  )
  result
rescue StandardError, Interrupt => original_error
  cleanup_error = nil
  if publication_state
    begin
      cleanup_lab002_published_prebuild!(
        output_handle,
        final_name,
        publication_state
      )
    rescue StandardError, Interrupt => error
      cleanup_error = error
    end
  end
  if cleanup_error
    message =
      "LAB-002 preparation failed and rollback is indeterminate: " \
      "#{cleanup_error.message}; original failure: #{original_error.message}"
    if original_error.is_a?(Interrupt) || cleanup_error.is_a?(Interrupt)
      UI.error(message)
      raise(original_error.is_a?(Interrupt) ? original_error : cleanup_error)
    end
    UI.user_error!(message)
  end
  raise
end

def valid_utc_timestamp?(value)
  return false unless value.is_a?(String) && value.end_with?("Z")

  !Time.iso8601(value).nil?
rescue ArgumentError
  false
end

def ensure_tool(name)
  command_output("/usr/bin/which", name)
end

def selected_xcodegen
  discovered = ensure_tool("xcodegen")
  unless Pathname.new(discovered).absolute?
    UI.user_error!("The selected XcodeGen path must be absolute.")
  end
  resolved = File.realpath(discovered)
  before = File.stat(resolved)
  unless before.file? &&
         File.executable?(resolved) &&
         (before.mode & 0o222).zero?
    UI.user_error!("The selected XcodeGen must be a non-writable executable.")
  end
  architecture = command_output("/usr/bin/uname", "-m")
  trusted_binaries = DEMO_LAB_TRUSTED_XCODEGEN_BINARIES[architecture]
  UI.user_error!("This architecture has no trusted XcodeGen binary.") unless trusted_binaries
  observed_sha256 = Digest::SHA256.file(resolved).hexdigest
  expected_version = trusted_binaries[observed_sha256]
  unless expected_version
    UI.user_error!(
      "The selected XcodeGen binary is not in the reviewed content allowlist."
    )
  end

  after_path = File.realpath(discovered)
  after = File.stat(resolved)
  after_sha256 = Digest::SHA256.file(resolved).hexdigest
  unless after_path == resolved &&
         after.file? &&
         File.executable?(resolved) &&
         (after.mode & 0o222).zero? &&
         [after.dev, after.ino, after.size, after.mtime.to_i, after_sha256] ==
           [
             before.dev,
             before.ino,
             before.size,
             before.mtime.to_i,
             observed_sha256,
           ]
    UI.user_error!("The selected XcodeGen changed while it was being verified.")
  end
  [
    resolved,
    expected_version,
    [
      before.dev,
      before.ino,
      before.size,
      before.mtime.to_i,
      observed_sha256,
    ],
  ]
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT
  UI.user_error!("Unable to resolve the selected XcodeGen safely.")
end

def verify_selected_xcodegen!(path, version, identity)
  observed_path, observed_version, observed_identity = selected_xcodegen
  unless observed_path == path &&
         observed_version == version &&
         observed_identity == identity
    UI.user_error!("The selected XcodeGen changed during LAB-002 preparation.")
  end
  true
end

def verify_locked_xcodegen_snapshot!(
  snapshot,
  snapshot_path,
  expected_identity,
  workspace_identity
)
  current_workspace_identity = private_directory_identity!(
    File.dirname(snapshot_path),
    "XcodeGen snapshot workspace"
  )
  opened = snapshot.stat
  path_stat = File.lstat(snapshot_path)
  access_mode = snapshot.fcntl(Fcntl::F_GETFL) & Fcntl::O_ACCMODE
  observed_identity = [
    opened.dev,
    opened.ino,
    opened.size,
    opened.mtime.to_i,
    digest_open_file(snapshot),
  ]
  unless current_workspace_identity == workspace_identity &&
         opened.file? &&
         opened.uid == Process.uid &&
         (opened.mode & 0o777) == 0o500 &&
         access_mode == Fcntl::O_RDONLY &&
         !path_stat.symlink? &&
         path_stat.dev == opened.dev &&
         path_stat.ino == opened.ino &&
         observed_identity == expected_identity
    UI.user_error!("The locked XcodeGen snapshot changed during generation.")
  end
  true
rescue Errno::EACCES, Errno::EBADF, Errno::ELOOP, Errno::ENOENT, Errno::ENOTDIR
  UI.user_error!("Unable to verify the locked XcodeGen snapshot safely.")
end

def stage_locked_xcodegen_snapshot!(
  source_path,
  source_identity,
  expected_version,
  workspace
)
  workspace_identity = private_directory_identity!(
    workspace,
    "XcodeGen snapshot workspace"
  )
  snapshot_path = File.join(
    workspace_identity.first,
    ".xcodegen-#{SecureRandom.hex(12)}"
  )
  source = nil
  writable_snapshot = nil
  locked_snapshot = nil

  begin
    source_flags = File::RDONLY | File::NONBLOCK
    source_flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
    source = File.open(source_path, source_flags)
    source_before = source.stat
    source_path_stat = File.lstat(source_path)
    source_hash = digest_open_file(source)
    observed_source_identity = [
      source_before.dev,
      source_before.ino,
      source_before.size,
      source_before.mtime.to_i,
      source_hash,
    ]
    unless source_before.file? &&
           (source_before.mode & 0o111).positive? &&
           (source_before.mode & 0o222).zero? &&
           !source_path_stat.symlink? &&
           source_path_stat.dev == source_before.dev &&
           source_path_stat.ino == source_before.ino &&
           observed_source_identity == source_identity
      UI.user_error!("The selected XcodeGen changed before private staging.")
    end

    destination_flags = File::WRONLY | File::CREAT | File::EXCL
    destination_flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
    writable_snapshot = File.open(snapshot_path, destination_flags, 0o600)
    copied = IO.copy_stream(source, writable_snapshot, source_before.size + 1)
    source_after = source.stat
    unless copied == source_before.size &&
           [
             source_after.dev,
             source_after.ino,
             source_after.size,
             source_after.mtime.to_i,
             digest_open_file(source),
           ] == source_identity
      UI.user_error!("The selected XcodeGen changed while being privately staged.")
    end
    writable_snapshot.flush
    writable_snapshot.fsync
    writable_snapshot.chmod(0o500)
    writable_snapshot.close
    writable_snapshot = nil

    snapshot_flags = File::RDONLY | File::NONBLOCK
    snapshot_flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
    locked_snapshot = File.open(snapshot_path, snapshot_flags)
    unless locked_snapshot.flock(File::LOCK_EX | File::LOCK_NB)
      UI.user_error!("Unable to lock the private XcodeGen snapshot.")
    end
    snapshot_stat = locked_snapshot.stat
    snapshot_identity = [
      snapshot_stat.dev,
      snapshot_stat.ino,
      snapshot_stat.size,
      snapshot_stat.mtime.to_i,
      digest_open_file(locked_snapshot),
    ]
    unless snapshot_stat.size == source_before.size &&
           snapshot_identity.last == source_hash
      UI.user_error!("The private XcodeGen snapshot does not match its source.")
    end
    verify_locked_xcodegen_snapshot!(
      locked_snapshot,
      snapshot_path,
      snapshot_identity,
      workspace_identity
    )

    output = command_output_without_loader_overrides(snapshot_path, "--version")
    match = output.match(/\AVersion: ([0-9]+\.[0-9]+\.[0-9]+)\z/)
    unless match && match[1] == expected_version
      UI.user_error!("The private XcodeGen snapshot returned an unexpected version.")
    end
    verify_locked_xcodegen_snapshot!(
      locked_snapshot,
      snapshot_path,
      snapshot_identity,
      workspace_identity
    )
    [locked_snapshot, snapshot_path, snapshot_identity, workspace_identity]
  rescue
    if locked_snapshot
      locked_snapshot.flock(File::LOCK_UN) rescue nil
      locked_snapshot.close rescue nil
    end
    FileUtils.rm_f(snapshot_path)
    raise
  ensure
    source.close if source && !source.closed?
    if writable_snapshot && !writable_snapshot.closed?
      writable_snapshot.close
    end
  end
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT, Errno::ENOTDIR
  UI.user_error!("Unable to stage the selected XcodeGen safely.")
end

def ensure_clean_source!
  root = git_command_output("rev-parse", "--show-toplevel")
  unless File.realpath(root) == File.realpath(repository_root)
    UI.user_error!("Run Fastlane from this OrchardProbe checkout.")
  end

  status = git_command_output(
    "status",
    "--porcelain=v1",
    "--untracked-files=all"
  )
  UI.user_error!("Commit or remove every local change before creating evidence.") unless status.empty?
end

def git_ancestor_without_replacements?(
  source_repository,
  ancestor,
  descendant
)
  unless [ancestor, descendant].all? { |value|
    /\A[0-9a-f]{40}\z/.match?(value)
  }
    UI.user_error!("The reviewed Git ancestry input is invalid.")
  end
  stdout, stderr, status = Open3.capture3(
    trusted_git_environment,
    "/usr/bin/git",
    "--no-replace-objects",
    "merge-base",
    "--is-ancestor",
    ancestor,
    descendant,
    chdir: source_repository,
    unsetenv_others: true
  )
  unless stdout.empty? &&
         stderr.empty? &&
         [0, 1].include?(status.exitstatus)
    UI.user_error!("Unable to verify the reviewed Git ancestry safely.")
  end
  status.success?
end

def parse_reviewed_github_main_ref!(output)
  lines = output.lines(chomp: true)
  match = if lines.length == 1
            /\A([0-9a-f]{40}|[0-9a-f]{64})\t#{Regexp.escape(
              DEMO_LAB_REVIEWED_GITHUB_MAIN_REF
            )}\z/.match(lines.first)
          end
  unless match
    UI.user_error!("GitHub returned an ambiguous reviewed main reference.")
  end
  match[1]
end

def reviewed_github_main_commit
  workspace = external_temporary_directory(
    "orchardprobe-lab002-github-main-"
  )
  begin
    ssh = pinned_executable("/usr/bin/ssh", "System SSH")
    host_key_writer = pinned_executable("/bin/echo", "System echo")
    known_hosts_command =
      "#{host_key_writer.fetch('path')} " \
      "#{DEMO_LAB_GITHUB_SSH_ED25519_HOST_KEY}"
    ssh_command = Shellwords.join(
      [
        ssh.fetch("path"),
        "-F",
        "/dev/null",
        "-p",
        "443",
        "-o",
        "BatchMode=yes",
        "-o",
        "IdentitiesOnly=yes",
        "-o",
        "IdentityAgent=none",
        "-o",
        "StrictHostKeyChecking=yes",
        "-o",
        "UserKnownHostsFile=/dev/null",
        "-o",
        "GlobalKnownHostsFile=/dev/null",
        "-o",
        "KnownHostsCommand=#{known_hosts_command}",
        "-o",
        "HostKeyAlgorithms=ssh-ed25519",
        "-o",
        "UpdateHostKeys=no",
      ]
    )
    environment = trusted_git_environment.merge(
      "GIT_SSH_COMMAND" => ssh_command,
      "GIT_TERMINAL_PROMPT" => "0"
    )
    network_git = [
      "/usr/bin/git",
      "--no-replace-objects",
      "-c",
      "core.hooksPath=/dev/null",
      "-c",
      "protocol.allow=never",
      "-c",
      "protocol.ssh.allow=always",
      "-c",
      "fetch.fsckObjects=true",
      "-c",
      "fetch.writeCommitGraph=false",
      "-c",
      "gc.auto=0",
    ]
    stdout, stderr, status = Open3.capture3(
      environment,
      *network_git,
      "ls-remote",
      "--exit-code",
      DEMO_LAB_REVIEWED_GITHUB_SSH_URL,
      DEMO_LAB_REVIEWED_GITHUB_MAIN_REF,
      chdir: workspace,
      unsetenv_others: true
    )
    unless status.success? && stderr.empty?
      UI.user_error!(
        "Unable to authenticate the reviewed GitHub main reference over SSH."
      )
    end
    reviewed_main = parse_reviewed_github_main_ref!(stdout)

    fetch_stdout, fetch_stderr, fetch_status = Open3.capture3(
      environment,
      *network_git,
      "fetch",
      "--quiet",
      "--no-tags",
      "--no-recurse-submodules",
      "--no-write-fetch-head",
      DEMO_LAB_REVIEWED_GITHUB_SSH_URL,
      DEMO_LAB_REVIEWED_GITHUB_MAIN_REF,
      chdir: repository_root,
      unsetenv_others: true
    )
    confirmed_stdout, confirmed_stderr, confirmed_status = Open3.capture3(
      environment,
      *network_git,
      "ls-remote",
      "--exit-code",
      DEMO_LAB_REVIEWED_GITHUB_SSH_URL,
      DEMO_LAB_REVIEWED_GITHUB_MAIN_REF,
      chdir: workspace,
      unsetenv_others: true
    )
    confirmed_main = if confirmed_status.success? && confirmed_stderr.empty?
                       parse_reviewed_github_main_ref!(confirmed_stdout)
                     end
    object_stdout, object_stderr, object_status = Open3.capture3(
      trusted_git_environment,
      "/usr/bin/git",
      "--no-replace-objects",
      "cat-file",
      "-e",
      "#{reviewed_main}^{commit}",
      chdir: repository_root,
      unsetenv_others: true
    )
    unless fetch_status.success? &&
           fetch_stdout.empty? &&
           fetch_stderr.empty? &&
           confirmed_main == reviewed_main &&
           object_status.success? &&
           object_stdout.empty? &&
           object_stderr.empty? &&
           pinned_executable("/usr/bin/ssh", "System SSH") == ssh &&
           pinned_executable("/bin/echo", "System echo") == host_key_writer
      UI.user_error!(
        "Unable to authenticate and materialize the reviewed GitHub main " \
        "reference over SSH."
      )
    end
    reviewed_main
  ensure
    FileUtils.rm_rf(workspace) if workspace
  end
end

def reviewed_main_source_commit
  source_commit = git_command_output("rev-parse", "HEAD")
  reviewed_main = reviewed_github_main_commit
  unless git_ancestor_without_replacements?(
    repository_root,
    source_commit,
    reviewed_main
  )
    UI.user_error!(
      "LAB-002 preparation requires HEAD to be present in the reviewed " \
      "GitHub main history."
    )
  end
  source_commit
end

def ensure_manual_lane!
  detected_ci_keys = DEMO_LAB_CI_ENVIRONMENT_KEYS.select { |key| ENV.key?(key) }
  unless detected_ci_keys.empty?
    UI.user_error!(
      "Controlled signing and upload lanes must never run in CI " \
      "(detected #{detected_ci_keys.join(', ')})."
    )
  end

  confirmation = required_environment("DEMO_LAB_CONFIRM_LOCAL_MANUAL_RUN")
  unless confirmation == DEMO_LAB_LOCAL_RUN_CONFIRMATION
    UI.user_error!("Explicit local manual-run confirmation is missing.")
  end
end

def reject_pilot_environment_overrides!
  overrides = ENV.keys.select do |key|
    key.start_with?("PILOT_") || key == "DEMO_ACCOUNT_REQUIRED"
  end.sort
  return if overrides.empty?

  UI.user_error!(
    "Unset every Pilot-affecting variable before the controlled upload " \
    "(detected #{overrides.join(', ')})."
  )
end

def reject_gym_environment_overrides!
  overrides = ENV.keys.grep(/\AGYM_/).sort
  return if overrides.empty?

  UI.user_error!(
    "Unset every GYM_* variable before the controlled archive " \
    "(detected #{overrides.join(', ')})."
  )
end

def reject_repository_path!(path, label)
  root = File.realpath(repository_root)
  if path == root || path.start_with?("#{root}#{File::SEPARATOR}")
    UI.user_error!("#{label} must stay outside the Git checkout.")
  end
end

def ensure_outside_repository!(path, label)
  resolved = File.realpath(path)
  reject_repository_path!(resolved, label)
  resolved
end

def validate_regular_file_beneath_root!(path, root, label)
  expanded_root = File.expand_path(root)
  root_lstat = File.lstat(expanded_root)
  unless root_lstat.directory? && !root_lstat.symlink?
    UI.user_error!("#{label} root must be a non-symlink directory.")
  end
  resolved_root = File.realpath(expanded_root)
  expanded_path = File.expand_path(path)
  unless expanded_path.start_with?("#{expanded_root}#{File::SEPARATOR}")
    UI.user_error!("#{label} escaped its expected root.")
  end
  relative = Pathname.new(expanded_path).relative_path_from(
    Pathname.new(expanded_root)
  )
  components = relative.each_filename.to_a
  if components.empty? ||
     components.any? { |component| component.empty? || %w[. ..].include?(component) }
    UI.user_error!("#{label} has an unsafe relative path.")
  end

  current = resolved_root
  components.each_with_index do |component, index|
    current = File.join(current, component)
    stat = File.lstat(current)
    UI.user_error!("#{label} contains a symbolic-link component.") if stat.symlink?
    if index == components.length - 1
      UI.user_error!("#{label} must be a regular file.") unless stat.file?
    else
      UI.user_error!("#{label} ancestor must be a directory.") unless stat.directory?
    end
  end
  resolved_path = File.realpath(current)
  unless resolved_path.start_with?("#{resolved_root}#{File::SEPARATOR}")
    UI.user_error!("#{label} resolved outside its expected root.")
  end
  resolved_path
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT, Errno::ENOTDIR
  UI.user_error!("Unable to validate #{label} beneath its expected root.")
end

def validate_creatable_external_directory!(path, label)
  expanded = File.expand_path(path)
  reject_repository_path!(expanded, label)

  existing_ancestor = expanded
  until File.exist?(existing_ancestor) || File.symlink?(existing_ancestor)
    parent = File.dirname(existing_ancestor)
    UI.user_error!("Unable to resolve #{label}.") if parent == existing_ancestor
    existing_ancestor = parent
  end
  resolved_ancestor = File.realpath(existing_ancestor)
  suffix = Pathname.new(expanded).relative_path_from(
    Pathname.new(existing_ancestor)
  )
  resolved_candidate = File.expand_path(suffix.to_s, resolved_ancestor)
  reject_repository_path!(resolved_candidate, label)
  expanded
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT
  UI.user_error!("Unable to resolve #{label} safely.")
end

def private_directory_identity!(path, label)
  stat = File.lstat(path)
  UI.user_error!("#{label} must not be a symbolic link.") if stat.symlink?
  UI.user_error!("#{label} must name a directory.") unless stat.directory?
  unless stat.uid == Process.uid
    UI.user_error!("#{label} must be owned by the current user.")
  end
  unless (stat.mode & 0o777) == 0o700
    UI.user_error!("#{label} must already have mode 0700.")
  end
  resolved = ensure_outside_repository!(path, label)
  [resolved, stat.dev, stat.ino]
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT
  UI.user_error!("Unable to validate #{label} safely.")
end

def verify_private_directory!(path, label)
  private_directory_identity!(path, label).first
end

def validate_fastlane_path_characters!(path, label)
  unsafe_bytes = path.each_byte.any? { |byte| byte < 0x20 || byte == 0x7f }
  if path.include?("'") || unsafe_bytes
    UI.user_error!("#{label} contains characters unsafe for Fastlane shell paths.")
  end
  path
end

def create_exclusive_private_directory!(
  path,
  label,
  private_parent_identity: nil
)
  validated_path = validate_creatable_external_directory!(path, label)
  parent = File.dirname(validated_path)
  unless File.directory?(parent) && !File.symlink?(parent)
    UI.user_error!("#{label} parent must be an existing non-symlink directory.")
  end
  parent_identity = if private_parent_identity
                      observed_identity = private_directory_identity!(
                        parent,
                        "#{label} parent"
                      )
                      unless observed_identity == private_parent_identity
                        UI.user_error!("#{label} parent changed before reservation.")
                      end
                      observed_identity
                    end

  begin
    Dir.mkdir(validated_path, 0o700)
  rescue Errno::EEXIST, Errno::ELOOP
    UI.user_error!("Refusing to reuse an existing #{label}.")
  rescue Errno::EACCES, Errno::ENOENT, Errno::ENOTDIR
    UI.user_error!("Unable to create #{label} safely.")
  end

  if parent_identity
    current_parent_identity = private_directory_identity!(
      parent,
      "#{label} parent"
    )
    unless current_parent_identity == parent_identity
      UI.user_error!(
        "#{label} parent changed while the directory was being reserved."
      )
    end
  end
  private_directory_identity!(validated_path, label)
end

def private_output_directory
  raw_path = required_environment("DEMO_LAB_OUTPUT_DIR")
  unless Pathname.new(raw_path).absolute?
    UI.user_error!("DEMO_LAB_OUTPUT_DIR must be an absolute path.")
  end

  expanded = File.expand_path(raw_path)
  validate_fastlane_path_characters!(expanded, "DEMO_LAB_OUTPUT_DIR")
  reject_repository_path!(expanded, "DEMO_LAB_OUTPUT_DIR")
  unless File.exist?(expanded) || File.symlink?(expanded)
    UI.user_error!(
      "DEMO_LAB_OUTPUT_DIR must be created as a private directory before the lane runs."
    )
  end
  identity = private_directory_identity!(expanded, "DEMO_LAB_OUTPUT_DIR")
  validate_fastlane_path_characters!(identity.first, "Resolved DEMO_LAB_OUTPUT_DIR")
  identity
end

def with_locked_private_directory(path, expected_identity, label)
  flags = File::RDONLY
  flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
  handle = File.open(path, flags)
  observed = handle.stat
  unless observed.directory? &&
         observed.uid == Process.uid &&
         (observed.mode & 0o777) == 0o700 &&
         [File.realpath(path), observed.dev, observed.ino] == expected_identity
    UI.user_error!("#{label} changed before it could be locked.")
  end
  unless handle.flock(File::LOCK_EX | File::LOCK_NB)
    UI.user_error!("#{label} is already in use by another controlled lane.")
  end

  begin
    yield handle
  ensure
    handle.flock(File::LOCK_UN)
    handle.close
  end
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT
  UI.user_error!("Unable to lock #{label} safely.")
end

def verify_locked_directory!(
  handle,
  path,
  expected_identity,
  label
)
  held = handle.stat
  current = private_directory_identity!(path, label)
  unless held.directory? &&
         held.uid == Process.uid &&
         (held.mode & 0o777) == 0o700 &&
         [current[0], held.dev, held.ino] == expected_identity &&
         current == expected_identity
    UI.user_error!("#{label} changed during the controlled operation.")
  end
  current
end

def rename_exclusive_no_follow!(source, destination, label)
  flags = DemoLabDarwin::RENAME_EXCL | DemoLabDarwin::RENAME_NOFOLLOW_ANY
  return if DemoLabDarwin.renamex_np(source, destination, flags).zero?

  error = SystemCallError.new("renamex_np", Fiddle.last_error)
  if error.is_a?(Errno::EEXIST)
    UI.user_error!("Refusing to overwrite an existing #{label}.")
  end
  UI.user_error!("Unable to publish #{label} safely.")
end

def external_temporary_base
  configured_tmpdir = ENV["TMPDIR"]
  expanded = File.expand_path(
    if configured_tmpdir.nil? || configured_tmpdir.empty?
      Dir.tmpdir
    else
      configured_tmpdir
    end
  )
  validate_fastlane_path_characters!(expanded, "DemoLab temporary directory")
  resolved = ensure_outside_repository!(expanded, "DemoLab temporary directory")
  validate_fastlane_path_characters!(
    resolved,
    "Resolved DemoLab temporary directory"
  )
  stat = File.stat(resolved)
  UI.user_error!("DemoLab temporary directory must be a directory.") unless stat.directory?
  private_parent = stat.uid == Process.uid && (stat.mode & 0o077).zero?
  sticky_parent = (stat.mode & 0o1000) == 0o1000
  unless private_parent || sticky_parent
    UI.user_error!(
      "DemoLab temporary directory must be private or protected by the sticky bit."
    )
  end
  UI.user_error!("DemoLab temporary directory is not writable.") unless File.writable?(resolved)
  resolved
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT
  UI.user_error!("Unable to validate the DemoLab temporary directory safely.")
end

def external_temporary_directory(prefix)
  workspace = nil
  begin
    workspace = Dir.mktmpdir(prefix, external_temporary_base)
    private_directory_identity!(
      workspace,
      "DemoLab temporary workspace"
    ).first
  rescue
    FileUtils.rm_rf(workspace) if workspace
    raise
  end
end

def with_external_temporary_file(basename)
  workspace = external_temporary_directory("orchardprobe-demolab-file-")
  begin
    Tempfile.create(basename, workspace) do |file|
      stat = file.stat
      unless stat.file? &&
             stat.uid == Process.uid &&
             (stat.mode & 0o077).zero?
        UI.user_error!("DemoLab temporary file is not private.")
      end
      ensure_outside_repository!(file.path, "DemoLab temporary file")
      yield file
    end
  ensure
    FileUtils.rm_rf(workspace)
  end
end

def existing_external_file(name, private: false)
  raw_path = required_environment(name)
  unless Pathname.new(raw_path).absolute?
    UI.user_error!("#{name} must be an absolute path.")
  end
  UI.user_error!("#{name} must name a regular file.") unless File.file?(raw_path)
  UI.user_error!("#{name} must not be a symbolic link.") if File.symlink?(raw_path)

  resolved = ensure_outside_repository!(raw_path, name)
  stat = File.stat(resolved)
  if private && stat.uid != Process.uid
    UI.user_error!("#{name} must be owned by the current user.")
  end
  if private && (stat.mode & 0o077) != 0
    UI.user_error!(
      "#{name} must not be readable or writable by group or other users."
    )
  end
  resolved
end

def demolab_bundle_identifiers
  app_identifier = required_environment(
    "DEMO_LAB_APP_BUNDLE_ID",
    pattern: /\A[A-Za-z0-9][A-Za-z0-9.-]*\z/
  )
  if app_identifier.start_with?("com.example.")
    UI.user_error!("Use the registered first-party DemoLab bundle identifier.")
  end
  share_identifier = required_environment(
    "DEMO_LAB_SHARE_BUNDLE_ID",
    pattern: /\A[A-Za-z0-9][A-Za-z0-9.-]*\z/
  )
  unless share_identifier.start_with?("#{app_identifier}.")
    UI.user_error!("The share-extension identifier must be nested below the app identifier.")
  end

  [app_identifier, share_identifier]
end

def copy_tracked_demolab_fixture(workspace)
  prefix = "fixtures/DemoLab/"
  listing, stderr, status = Open3.capture3(
    sanitized_dynamic_loader_environment(
      DEMO_LAB_XCODE_OVERRIDE_KEYS.to_h { |key| [key, nil] }
    ),
    "/usr/bin/git",
    "ls-files",
    "--cached",
    "-z",
    "--",
    "fixtures/DemoLab",
    chdir: repository_root
  )
  unless status.success?
    UI.user_error!("Unable to enumerate tracked DemoLab sources:\n#{stderr.strip}")
  end

  relative_paths = listing.split("\0")
  UI.user_error!("The tracked DemoLab fixture is empty.") if relative_paths.empty?
  fixture = File.join(workspace, "DemoLab")
  FileUtils.mkdir_p(fixture, mode: 0o700)
  source_root = File.realpath(File.join(repository_root, "fixtures", "DemoLab"))

  relative_paths.each do |relative_path|
    unless relative_path.start_with?(prefix)
      UI.user_error!("Tracked DemoLab source escaped its fixture prefix.")
    end
    fixture_relative_path = relative_path.delete_prefix(prefix)
    components = fixture_relative_path.split("/")
    if fixture_relative_path.empty? ||
       components.any? { |component| component.empty? || %w[. ..].include?(component) }
      UI.user_error!("Tracked DemoLab source has an unsafe relative path.")
    end

    source_path = File.join(repository_root, relative_path)
    source_stat = File.lstat(source_path)
    unless source_stat.file? && !source_stat.symlink?
      UI.user_error!("Tracked DemoLab sources must be regular files.")
    end
    resolved_source = File.realpath(source_path)
    unless resolved_source.start_with?("#{source_root}#{File::SEPARATOR}")
      UI.user_error!("Tracked DemoLab source escaped its fixture directory.")
    end

    destination_path = File.join(fixture, fixture_relative_path)
    FileUtils.mkdir_p(File.dirname(destination_path), mode: 0o700)
    FileUtils.copy_file(source_path, destination_path, true)
  end
  fixture
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT
  UI.user_error!("Unable to snapshot tracked DemoLab sources safely.")
end

def prepare_demolab_project(source_commit: nil)
  xcodegen_path, xcodegen_version, xcodegen_identity = selected_xcodegen
  workspace = external_temporary_directory("orchardprobe-demolab-")
  xcodegen_snapshot = nil
  xcodegen_snapshot_path = nil
  begin
    xcodegen_snapshot,
      xcodegen_snapshot_path,
      snapshot_identity,
      workspace_identity = stage_locked_xcodegen_snapshot!(
        xcodegen_path,
        xcodegen_identity,
        xcodegen_version,
        workspace
      )
    if source_commit
      unless /\A[0-9a-f]{40,64}\z/.match?(source_commit)
        UI.user_error!("DemoLab source commit has an invalid format.")
      end
      archive = File.join(workspace, "demolab-source.tar")
      git_command_output(
        "archive",
        "--format=tar",
        "--output=#{archive}",
        source_commit,
        "--",
        "fixtures/DemoLab"
      )
      command_output("/usr/bin/tar", "-xf", archive, "-C", workspace)
      FileUtils.rm_f(archive)
      fixture = File.join(workspace, "fixtures", "DemoLab")
    else
      fixture = copy_tracked_demolab_fixture(workspace)
    end

    UI.user_error!("DemoLab fixture snapshot is missing.") unless File.directory?(fixture)
    Find.find(fixture) do |path|
      UI.user_error!("DemoLab fixture must not contain symbolic links.") if File.symlink?(path)
    end
    verify_locked_xcodegen_snapshot!(
      xcodegen_snapshot,
      xcodegen_snapshot_path,
      snapshot_identity,
      workspace_identity
    )
    command_output_without_loader_overrides(
      xcodegen_snapshot_path,
      "generate",
      "--spec",
      File.join(fixture, "project.yml"),
      "--project",
      fixture
    )
    verify_locked_xcodegen_snapshot!(
      xcodegen_snapshot,
      xcodegen_snapshot_path,
      snapshot_identity,
      workspace_identity
    )
    verified_path, verified_version, verified_identity = selected_xcodegen
    unless verified_path == xcodegen_path &&
           verified_version == xcodegen_version &&
           verified_identity == xcodegen_identity
      UI.user_error!("The selected XcodeGen changed during project generation.")
    end
    xcodegen_snapshot.flock(File::LOCK_UN)
    xcodegen_snapshot.close
    xcodegen_snapshot = nil
    FileUtils.rm_f(xcodegen_snapshot_path)
    [
      workspace,
      fixture,
      File.join(fixture, "DemoLab.xcodeproj"),
      xcodegen_version,
    ]
  rescue
    if xcodegen_snapshot
      xcodegen_snapshot.flock(File::LOCK_UN) rescue nil
      xcodegen_snapshot.close rescue nil
    end
    FileUtils.rm_rf(workspace)
    raise
  end
end

def sha256(path)
  Digest::SHA256.file(path).hexdigest
end

def read_regular_file_snapshot(path, maximum_size, label)
  flags = File::RDONLY
  flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
  File.open(path, flags) do |source|
    before = source.stat
    UI.user_error!("#{label} must be a regular file.") unless before.file?
    if before.size <= 0 || before.size > maximum_size
      UI.user_error!("#{label} has an invalid size.")
    end

    content = source.read(maximum_size + 1)
    after = source.stat
    unless content.bytesize == before.size &&
           content.bytesize <= maximum_size &&
           before.dev == after.dev &&
           before.ino == after.ino &&
           before.size == after.size
      UI.user_error!("#{label} changed while it was being read.")
    end
    content
  end
rescue Errno::ELOOP
  UI.user_error!("#{label} must not be a symbolic link.")
end

def private_external_file_snapshot_with_path(name, maximum_size, label)
  raw_path = required_environment(name)
  unless Pathname.new(raw_path).absolute?
    UI.user_error!("#{name} must be an absolute path.")
  end

  expanded = File.expand_path(raw_path)
  reject_repository_path!(expanded, label)
  flags = File::RDONLY | File::NONBLOCK
  flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
  File.open(expanded, flags) do |source|
    opened = source.stat
    UI.user_error!("#{label} must be a regular file.") unless opened.file?
    UI.user_error!("#{label} must be owned by the current user.") unless opened.uid == Process.uid
    if (opened.mode & 0o077) != 0
      UI.user_error!("#{label} must not be accessible by group or other users.")
    end
    if opened.size <= 0 || opened.size > maximum_size
      UI.user_error!("#{label} has an invalid size.")
    end

    resolved = ensure_outside_repository!(expanded, label)
    resolved_stat = File.stat(resolved)
    path_stat = File.lstat(expanded)
    stable_path = !path_stat.symlink? &&
                  resolved_stat.dev == opened.dev &&
                  resolved_stat.ino == opened.ino &&
                  path_stat.dev == opened.dev &&
                  path_stat.ino == opened.ino
    UI.user_error!("#{label} path changed during validation.") unless stable_path

    content = source.read(maximum_size + 1)
    after = source.stat
    unless content.bytesize == opened.size &&
           content.bytesize <= maximum_size &&
           opened.dev == after.dev &&
           opened.ino == after.ino &&
           opened.size == after.size
      UI.user_error!("#{label} changed while it was being read.")
    end
    [resolved, content]
  end
rescue Errno::EACCES,
       Errno::EAGAIN,
       Errno::ELOOP,
       Errno::ENODEV,
       Errno::ENOENT,
       Errno::ENXIO
  UI.user_error!("Unable to snapshot #{label} safely.")
end

def private_external_file_snapshot(name, maximum_size, label)
  _, content = private_external_file_snapshot_with_path(
    name,
    maximum_size,
    label
  )
  content
end

def binary_evidence(path, relative_path, role, xcode_toolchain:)
  content = read_regular_file_snapshot(
    path,
    DEMO_LAB_MAX_BINARY_BYTES,
    "Archived DemoLab binary"
  )
  with_external_temporary_file(
    ["orchardprobe-demolab-binary-", ".macho"]
  ) do |file|
    file.binmode
    file.write(content)
    file.flush

    uuid_lines = command_output(
      xcode_toolchain.dig("dwarfdump", "path"),
      "--uuid",
      file.path
    ).lines
    uuids = uuid_lines.filter_map do |line|
      match = line.match(/UUID: ([0-9A-Fa-f-]+) \(([^)]+)\)/)
      next unless match

      {
        "architecture" => match[2],
        "uuid" => match[1].downcase,
      }
    end

    {
      "role" => role,
      "relative_path" => relative_path,
      "size" => content.bytesize,
      "sha256" => Digest::SHA256.hexdigest(content),
      "architectures" => command_output(
        xcode_toolchain.dig("lipo", "path"),
        "-archs",
        file.path
      ).split,
      "slices" => uuids,
      "initial_protection_status" => "not_observed",
      "expected_plaintext_status" => "candidate_pre_upload_archive_only",
    }
  end
end

def read_zip_entry(entry, maximum_size)
  if entry.directory? || entry.symlink? || entry.encrypted?
    UI.user_error!("DemoLab IPA contains an unsupported required entry.")
  end
  if entry.size.negative? || entry.size > maximum_size
    UI.user_error!("DemoLab IPA contains an oversized required entry.")
  end

  content = entry.get_input_stream.read(maximum_size + 1)
  if content.bytesize != entry.size || content.bytesize > maximum_size
    UI.user_error!("DemoLab IPA entry size does not match its metadata.")
  end
  content
end

def plist_value_from_zip_entry(entry, key, xcode_toolchain:)
  content = read_zip_entry(entry, DEMO_LAB_MAX_PLIST_BYTES)
  with_external_temporary_file(["orchardprobe-demolab-", ".plist"]) do |file|
    file.binmode
    file.write(content)
    file.flush
    command_output(
      xcode_toolchain.dig("plutil", "path"),
      "-extract",
      key,
      "raw",
      file.path
    )
  end
end

def zip_binary_evidence(content, relative_path, role)
  {
    "role" => role,
    "relative_path" => relative_path,
    "size" => content.bytesize,
    "sha256" => Digest::SHA256.hexdigest(content),
    "initial_protection_status" => "not_observed",
    "expected_plaintext_status" => "candidate_pre_upload_archive_only",
  }
end

def validate_demolab_dynamic_linkage_outputs!(
  framework_id_output,
  main_dependencies_output
)
  expected_framework_path =
    "@rpath/DemoFramework.framework/DemoFramework"
  framework_ids = framework_id_output.lines.map(&:strip).reject do |line|
    line.empty? || line.end_with?(":")
  end
  unless framework_ids.length.between?(1, 8) &&
         framework_ids.uniq == [expected_framework_path]
    UI.user_error!(
      "DemoFramework must use the expected @rpath install name."
    )
  end

  main_dependencies = main_dependencies_output.lines.map(&:strip).reject do |line|
    line.empty? || line.end_with?(":")
  end.map do |line|
    match = line.match(/\A(.+?) \(compatibility version /)
    match && match[1]
  end.compact
  framework_dependencies = main_dependencies.select do |path|
    path.end_with?("/DemoFramework.framework/DemoFramework")
  end
  unless framework_dependencies.length.between?(1, 8) &&
         framework_dependencies.uniq == [expected_framework_path]
    UI.user_error!(
      "DemoLab must load DemoFramework through the expected @rpath."
    )
  end
  true
end

def validate_demolab_dynamic_linkage_content!(
  main_content,
  framework_content,
  xcode_toolchain:
)
  with_external_temporary_file(
    ["orchardprobe-demolab-main-", ".macho"]
  ) do |main_file|
    main_file.binmode
    main_file.write(main_content)
    main_file.flush
    with_external_temporary_file(
      ["orchardprobe-demolab-framework-", ".macho"]
    ) do |framework_file|
      framework_file.binmode
      framework_file.write(framework_content)
      framework_file.flush

      framework_id_output = command_output(
        xcode_toolchain.dig("otool", "path"),
        "-D",
        framework_file.path
      )
      main_dependencies_output = command_output(
        xcode_toolchain.dig("otool", "path"),
        "-L",
        main_file.path
      )
      validate_demolab_dynamic_linkage_outputs!(
        framework_id_output,
        main_dependencies_output
      )
    end
  end
  true
end

def validate_demolab_dynamic_linkage_paths!(
  main_path,
  framework_path,
  xcode_toolchain:
)
  main_content = read_regular_file_snapshot(
    main_path,
    DEMO_LAB_MAX_BINARY_BYTES,
    "DemoLab main executable"
  )
  framework_content = read_regular_file_snapshot(
    framework_path,
    DEMO_LAB_MAX_BINARY_BYTES,
    "DemoFramework executable"
  )
  validate_demolab_dynamic_linkage_content!(
    main_content,
    framework_content,
    xcode_toolchain: xcode_toolchain
  )
end

def inspect_demolab_ipa!(
  ipa_path,
  app_identifier:,
  share_identifier:,
  marketing_version:,
  build_number:,
  xcode_toolchain:
)
  ipa_content = read_regular_file_snapshot(
    ipa_path,
    DEMO_LAB_MAX_IPA_BYTES,
    "Evidence-bound IPA"
  )
  ipa_measurement = {
    "size" => ipa_content.bytesize,
    "sha256" => Digest::SHA256.hexdigest(ipa_content),
  }

  inspection = nil
  Zip::File.open_buffer(StringIO.new(ipa_content)) do |archive|
    entries = archive.entries
    if entries.empty? || entries.length > DEMO_LAB_MAX_ZIP_ENTRIES
      UI.user_error!("DemoLab IPA has an invalid entry count.")
    end

    seen_names = {}
    entries.each do |entry|
      name = entry.name
      unless entry.name_safe? && !name.include?("\\") && !name.include?("\0")
        UI.user_error!("DemoLab IPA contains an unsafe entry name.")
      end
      UI.user_error!("DemoLab IPA contains duplicate entries.") if seen_names[name]
      UI.user_error!("DemoLab IPA must not contain symbolic links.") if entry.symlink?
      seen_names[name] = true
    end

    app_root = "Payload/DemoLab.app"
    app_plist = archive.find_entry("#{app_root}/Info.plist")
    share_plist = archive.find_entry(
      "#{app_root}/PlugIns/DemoShareExtension.appex/Info.plist"
    )
    framework_plist = archive.find_entry(
      "#{app_root}/Frameworks/DemoFramework.framework/Info.plist"
    )
    unless app_plist && share_plist && framework_plist
      UI.user_error!("IPA is not the expected DemoLab app/framework/extension package.")
    end

    root_app_plists = entries.select do |entry|
      entry.name.match?(%r{\APayload/[^/]+\.app/Info\.plist\z})
    end
    unless root_app_plists.map(&:name) == ["#{app_root}/Info.plist"]
      UI.user_error!("IPA must contain exactly one DemoLab application.")
    end

    expected_plist_values = [
      [app_plist, "CFBundleIdentifier", app_identifier],
      [app_plist, "CFBundleExecutable", "DemoLab"],
      [app_plist, "CFBundleShortVersionString", marketing_version],
      [app_plist, "CFBundleVersion", build_number],
      [app_plist, "ITSAppUsesNonExemptEncryption", "false"],
      [share_plist, "CFBundleIdentifier", share_identifier],
      [share_plist, "CFBundleExecutable", "DemoShareExtension"],
      [share_plist, "CFBundleShortVersionString", marketing_version],
      [share_plist, "CFBundleVersion", build_number],
      [framework_plist, "CFBundleIdentifier", "#{app_identifier}.framework"],
      [framework_plist, "CFBundleExecutable", "DemoFramework"],
      [framework_plist, "CFBundleShortVersionString", marketing_version],
      [framework_plist, "CFBundleVersion", build_number],
    ]
    expected_plist_values.each do |entry, key, expected|
      unless plist_value_from_zip_entry(
        entry,
        key,
        xcode_toolchain: xcode_toolchain
      ) == expected
        UI.user_error!("IPA identity does not match the authorized DemoLab package.")
      end
    end

    binary_specs = [
      [
        "#{app_root}/DemoLab",
        "DemoLab.app/DemoLab",
        "main_executable",
      ],
      [
        "#{app_root}/Frameworks/DemoFramework.framework/DemoFramework",
        "DemoLab.app/Frameworks/DemoFramework.framework/DemoFramework",
        "dynamic_framework",
      ],
      [
        "#{app_root}/PlugIns/DemoShareExtension.appex/DemoShareExtension",
        "DemoLab.app/PlugIns/DemoShareExtension.appex/DemoShareExtension",
        "app_extension",
      ],
    ]
    binaries = binary_specs.map do |entry_name, relative_path, role|
      entry = archive.find_entry(entry_name)
      UI.user_error!("DemoLab IPA is missing a required packaged binary.") unless entry
      content = read_zip_entry(entry, DEMO_LAB_MAX_BINARY_BYTES)
      [
        zip_binary_evidence(content, relative_path, role),
        content,
      ]
    end
    validate_demolab_dynamic_linkage_content!(
      binaries[0][1],
      binaries[1][1],
      xcode_toolchain: xcode_toolchain
    )

    inspection = {
      "application" => "DemoLab.app",
      "identity_validated" => true,
      "export_compliance_validated" => true,
      "archive" => ipa_measurement,
      "binaries" => binaries.map(&:first),
    }
  end
  inspection
rescue Zip::Error => error
  UI.user_error!("Unable to validate DemoLab IPA: #{error.class}.")
end

def demolab_archive_binary_inputs(archive_path)
  DEMO_LAB_BINARY_SPECS.map do |specification|
    [
      File.join(
        archive_path,
        "Products",
        "Applications",
        specification["relative_path"]
      ),
      specification["relative_path"],
      specification["role"],
    ]
  end
end

def demolab_archive_source_measurements!(
  archive_path,
  archive_binary_evidence
)
  binary_measurements = archive_binary_evidence.map do |measurement|
    {
      "relative_path" => measurement.fetch("relative_path"),
      "size" => measurement.fetch("size"),
      "sha256" => measurement.fetch("sha256"),
    }
  end
  plist_measurements =
    DEMO_LAB_LAB002_ARCHIVE_SOURCE_SPECS
      .drop(DEMO_LAB_BINARY_SPECS.length)
      .map do |specification|
        relative_path = specification.fetch("relative_path")
        path = validate_regular_file_beneath_root!(
          File.join(
            archive_path,
            "Products",
            "Applications",
            relative_path
          ),
          archive_path,
          "Archived DemoLab Info.plist"
        )
        content = read_regular_file_snapshot(
          path,
          specification.fetch("maximum_size"),
          "Archived DemoLab Info.plist"
        )
        {
          "relative_path" => relative_path,
          "size" => content.bytesize,
          "sha256" => Digest::SHA256.hexdigest(content),
        }
      end
  binary_measurements + plist_measurements
end

def verify_lab002_oracle_evidence_sources!(
  oracle_result,
  packaged,
  archive_sources
)
  unless packaged.dig("archive", "size") == oracle_result.fetch("ipa_size") &&
         packaged.dig("archive", "sha256") ==
           oracle_result.fetch("ipa_sha256")
    UI.user_error!(
      "Pre-upload evidence IPA differs from the final LAB-002 oracle source."
    )
  end
  unless archive_sources == oracle_result.fetch("archive_files")
    UI.user_error!(
      "Pre-upload evidence Archive differs from the final LAB-002 oracle source."
    )
  end
end

def open_stable_staged_file!(
  path,
  root,
  maximum_size,
  label
)
  first = nil
  second = nil
  keep_second = false
  resolved = validate_regular_file_beneath_root!(path, root, label)
  flags = File::RDONLY | File::NONBLOCK
  flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
  first = File.open(resolved, flags)
  before = first.stat
  unless before.file? &&
         before.uid == Process.uid &&
         before.size.positive? &&
         before.size <= maximum_size
    UI.user_error!("#{label} has unsafe metadata.")
  end
  first_digest = digest_open_file(first)
  after = first.stat

  reopened_path = validate_regular_file_beneath_root!(path, root, label)
  second = File.open(reopened_path, flags)
  reopened_before = second.stat
  unless reopened_before.file? &&
         reopened_before.uid == Process.uid &&
         reopened_before.size.positive? &&
         reopened_before.size <= maximum_size
    UI.user_error!("#{label} has unsafe reopened metadata.")
  end
  reopened_digest = digest_open_file(second)
  reopened_after = second.stat
  linked = File.lstat(reopened_path)
  identity = ->(stat) {
    [
      stat.dev,
      stat.ino,
      stat.mode & 0o777,
      stat.size,
      stat.mtime.to_f,
    ]
  }
  unless identity.call(after) == identity.call(before) &&
         reopened_path == resolved &&
         identity.call(reopened_before) == identity.call(before) &&
         identity.call(reopened_after) == identity.call(reopened_before) &&
         linked.file? &&
         !linked.symlink? &&
         identity.call(linked) == identity.call(reopened_after) &&
         first_digest == reopened_digest
    UI.user_error!("#{label} changed during final publication binding.")
  end
  result = {
    "device" => reopened_before.dev,
    "inode" => reopened_before.ino,
    "mode" => reopened_before.mode & 0o777,
    "size" => reopened_before.size,
    "mtime" => reopened_before.mtime.to_f,
    "sha256" => reopened_digest,
  }
  keep_second = true
  [second, result]
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT, Errno::ENOTDIR
  UI.user_error!("Unable to bind #{label} before publication.")
ensure
  first&.close unless first&.closed?
  second&.close if second && !keep_second && !second.closed?
end

def stable_staged_file_identity!(
  path,
  root,
  maximum_size,
  label
)
  handle = nil
  handle, identity = open_stable_staged_file!(
    path,
    root,
    maximum_size,
    label
  )
  identity
ensure
  handle&.close unless handle&.closed?
end

def verify_held_staged_file_path!(
  handle,
  path,
  root,
  expected_identity,
  maximum_size,
  label
)
  resolved = validate_regular_file_beneath_root!(path, root, label)
  before = handle.stat
  digest = digest_open_file(handle)
  after = handle.stat
  linked = File.lstat(resolved)
  observed = ->(stat) {
    [
      stat.dev,
      stat.ino,
      stat.mode & 0o777,
      stat.size,
      stat.mtime.to_f,
    ]
  }
  expected = [
    expected_identity.fetch("device"),
    expected_identity.fetch("inode"),
    expected_identity.fetch("mode"),
    expected_identity.fetch("size"),
    expected_identity.fetch("mtime"),
  ]
  unless before.file? &&
         before.uid == Process.uid &&
         before.size.positive? &&
         before.size <= maximum_size &&
         observed.call(before) == expected &&
         observed.call(after) == expected &&
         linked.file? &&
         !linked.symlink? &&
         linked.uid == Process.uid &&
         observed.call(linked) == expected &&
         digest == expected_identity.fetch("sha256")
    UI.user_error!("#{label} changed at the publication commit point.")
  end
  true
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT, Errno::ENOTDIR
  UI.user_error!("Unable to revalidate #{label} at publication.")
end

def open_bound_lab002_archive_app!(archive_path, oracle_result)
  expanded_archive = File.expand_path(archive_path)
  archive_stat = File.lstat(expanded_archive)
  unless archive_stat.directory? &&
         !archive_stat.symlink? &&
         archive_stat.uid == Process.uid
    UI.user_error!("Final DemoLab Archive root is invalid.")
  end
  archive_root = File.realpath(expanded_archive)
  archive_app_path = File.join(
    expanded_archive,
    "Products",
    "Applications",
    "DemoLab.app"
  )
  current = archive_root
  %w[Products Applications DemoLab.app].each do |component|
    current = File.join(current, component)
    stat = File.lstat(current)
    unless stat.directory? && !stat.symlink? && stat.uid == Process.uid
      UI.user_error!("Final DemoLab Archive App path is invalid.")
    end
  end
  flags = File::RDONLY
  flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
  handle = File.open(archive_app_path, flags)
  held = handle.stat
  linked = File.lstat(archive_app_path)
  expected = [
    Integer(oracle_result.fetch("archive_app_device"), 10),
    Integer(oracle_result.fetch("archive_app_inode"), 10),
  ]
  unless held.directory? &&
         held.uid == Process.uid &&
         !linked.symlink? &&
         linked.directory? &&
         linked.uid == Process.uid &&
         [held.dev, held.ino] == expected &&
         [linked.dev, linked.ino] == expected
    UI.user_error!(
      "Final DemoLab Archive App is not the directory measured by the oracle."
    )
  end
  [handle, archive_app_path]
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT, Errno::ENOTDIR
  handle&.close unless handle&.closed?
  UI.user_error!("Unable to bind the final DemoLab Archive App.")
end

def verify_held_lab002_archive_app_path!(
  handle,
  path,
  oracle_result
)
  held = handle.stat
  linked = File.lstat(path)
  expected = [
    Integer(oracle_result.fetch("archive_app_device"), 10),
    Integer(oracle_result.fetch("archive_app_inode"), 10),
  ]
  unless held.directory? &&
         held.uid == Process.uid &&
         linked.directory? &&
         !linked.symlink? &&
         linked.uid == Process.uid &&
         [held.dev, held.ino] == expected &&
         [linked.dev, linked.ino] == expected
    UI.user_error!("Final DemoLab Archive App changed at publication.")
  end
  true
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT, Errno::ENOTDIR
  UI.user_error!("Unable to revalidate the final DemoLab Archive App.")
end

def verify_closed_staging_inventory!(
  staging_handle,
  expected_names
)
  unless expected_names.is_a?(Array) &&
         expected_names.length == 4 &&
         expected_names.uniq.length == expected_names.length &&
         expected_names.all? { |name|
           name.is_a?(String) &&
             /\A[A-Za-z0-9][A-Za-z0-9._-]{0,127}\z/.match?(name)
         }
    UI.user_error!("DemoLab final staging inventory contract is invalid.")
  end
  reader, writer = IO.pipe
  pid = nil
  waited = false
  pid = fork do
    reader.close
    exit! 126 if DemoLabDarwin.fchdir(staging_handle.fileno).nonzero?

    entries = []
    Dir.foreach(".") do |name|
      next if [".", ".."].include?(name)

      entries << name
      exit! 125 if entries.length > expected_names.length
    end
    exit! 125 unless entries.sort == expected_names.sort

    writer.write("closed")
    writer.close
    exit! 0
  rescue StandardError
    exit! 126
  end
  writer.close
  response = reader.read(7)
  _, status = Process.wait2(pid)
  waited = true
  unless status.success? && response == "closed"
    UI.user_error!(
      "DemoLab final staging contains an unexpected or missing artifact."
    )
  end
  true
rescue SystemCallError
  UI.user_error!("Unable to enumerate final DemoLab staging safely.")
ensure
  reader&.close unless reader&.closed?
  writer&.close unless writer&.closed?
  if pid && !waited
    Process.kill("TERM", pid) rescue nil
    Process.wait(pid) rescue nil
  end
end

def lab002_indeterminate_publication_marker_path(output_root, run_directory)
  run_name = File.basename(run_directory)
  unless /\A[A-Za-z0-9._-]+\z/.match?(run_name)
    UI.user_error!("DemoLab run name is unsafe for an indeterminate marker.")
  end
  File.join(
    output_root,
    ".demolab-staging-published-indeterminate-#{run_name}.json"
  )
end

def publish_lab002_publication_gate!(
  output_handle:,
  output_root:,
  output_identity:,
  run_directory:,
  staging_identity:
)
  verify_locked_directory!(
    output_handle,
    output_root,
    output_identity,
    "DEMO_LAB_OUTPUT_DIR"
  )
  marker_path =
    lab002_indeterminate_publication_marker_path(output_root, run_directory)
  marker_file = publish_new_private_json_record!(
    marker_path,
    {
      "schema" => "orchardprobe.lab002.publication-indeterminate.v1",
      "status" => "pending_or_indeterminate",
      "run_name" => File.basename(run_directory),
      "run_device" => staging_identity.fetch(1).to_s,
      "run_inode" => staging_identity.fetch(2).to_s,
      "note" =>
        "Publication is not committed until this gate is removed after " \
        "descriptor-bound final validation. If retained, reconcile this " \
        "exact run identity before retry.",
    },
    "LAB-002 publication gate"
  )
  [marker_file, marker_path]
rescue
  marker_file&.flock(File::LOCK_UN)
  marker_file&.close
  raise
end

def remove_lab002_publication_gate!(
  output_handle:,
  output_root:,
  output_identity:,
  marker_file:,
  marker_path:
)
  verify_locked_directory!(
    output_handle,
    output_root,
    output_identity,
    "DEMO_LAB_OUTPUT_DIR"
  )
  unless File.dirname(marker_path) == output_root &&
         /\A\.demolab-staging-published-indeterminate-[A-Za-z0-9._-]+\.json\z/
           .match?(File.basename(marker_path))
    UI.user_error!("LAB-002 publication gate path is invalid.")
  end
  verify_private_record_path_identity!(
    marker_path,
    marker_file,
    "LAB-002 publication gate"
  )
  result = DemoLabDarwin.unlinkat(
    output_handle.fileno,
    File.basename(marker_path),
    0
  )
  unless result.zero?
    UI.user_error!("Unable to remove the validated LAB-002 publication gate.")
  end
  unless marker_file.stat.nlink.zero? &&
         !File.exist?(marker_path) &&
         !File.symlink?(marker_path)
    UI.user_error!("LAB-002 publication gate removal is indeterminate.")
  end
  begin
    output_handle.fsync
  rescue SystemCallError
    UI.important(
      "The validated LAB-002 publication gate was removed, but its parent " \
      "directory sync could not be confirmed; a crash may conservatively " \
      "restore the retry gate."
    )
  end
  true
end

def publish_verified_lab002_staged_run!(
  output_handle:,
  output_root:,
  output_identity:,
  run_directory:,
  staging_handle:,
  staging_directory:,
  staging_identity:,
  archive_path:,
  ipa_path:,
  evidence_path:,
  evidence_identity:,
  oracle_result:,
  on_publication_change:
)
  held_files = []
  archive_app_handle = nil
  publication_gate_file = nil
  publication_gate_path = nil
  publication_renamed = false
  expected_names = [
    File.basename(archive_path),
    File.basename(ipa_path),
    oracle_result.fetch("oracle_name"),
    File.basename(evidence_path),
  ]
  unless [archive_path, ipa_path, evidence_path].all? { |path|
           File.dirname(path) == staging_directory
         }
    UI.user_error!("A final DemoLab artifact escaped the staging directory.")
  end
  verify_locked_directory!(
    staging_handle,
    staging_directory,
    staging_identity,
    "DemoLab staging directory"
  )
  verify_closed_staging_inventory!(staging_handle, expected_names)

  archive_app_handle, archive_app_path =
    open_bound_lab002_archive_app!(archive_path, oracle_result)
  archive_sources =
    DEMO_LAB_LAB002_ARCHIVE_SOURCE_SPECS.map do |specification|
      relative_path = specification.fetch("relative_path")
      source_path = File.join(
        archive_path,
        "Products",
        "Applications",
        relative_path
      )
      handle, measured = open_stable_staged_file!(
        source_path,
        archive_path,
        specification.fetch("maximum_size"),
        "Final DemoLab Archive source"
      )
      held_files << [
        handle,
        source_path,
        measured,
        specification.fetch("maximum_size"),
        "Final DemoLab Archive source",
      ]
      {
        "relative_path" => relative_path,
        "size" => measured.fetch("size"),
        "sha256" => measured.fetch("sha256"),
      }
    end
  unless archive_sources == oracle_result.fetch("archive_files")
    UI.user_error!("Final DemoLab Archive sources changed before publication.")
  end

  ipa_handle, ipa_identity = open_stable_staged_file!(
    ipa_path,
    staging_directory,
    DEMO_LAB_MAX_IPA_BYTES,
    "Final DemoLab IPA"
  )
  unless ipa_identity["size"] == oracle_result.fetch("ipa_size") &&
         ipa_identity["sha256"] == oracle_result.fetch("ipa_sha256")
    UI.user_error!("Final DemoLab IPA changed before publication.")
  end
  held_files << [
    ipa_handle,
    ipa_path,
    ipa_identity,
    DEMO_LAB_MAX_IPA_BYTES,
    "Final DemoLab IPA",
  ]

  oracle_path = File.join(
    staging_directory,
    oracle_result.fetch("oracle_name")
  )
  oracle_handle, oracle_identity = open_stable_staged_file!(
    oracle_path,
    staging_directory,
    16 * 1024,
    "Final LAB-002 oracle"
  )
  unless oracle_identity.slice(
    "device",
    "inode",
    "mode",
    "size",
    "sha256"
  ) == {
    "device" => Integer(oracle_result.fetch("oracle_device"), 10),
    "inode" => Integer(oracle_result.fetch("oracle_inode"), 10),
    "mode" => oracle_result.fetch("oracle_mode"),
    "size" => oracle_result.fetch("oracle_size"),
    "sha256" => oracle_result.fetch("oracle_sha256"),
  }
    UI.user_error!("Final LAB-002 oracle changed before publication.")
  end
  held_files << [
    oracle_handle,
    oracle_path,
    oracle_identity,
    16 * 1024,
    "Final LAB-002 oracle",
  ]

  evidence_handle, final_evidence_identity = open_stable_staged_file!(
    evidence_path,
    staging_directory,
    DEMO_LAB_MAX_UPLOAD_RESULT_BYTES,
    "Final DemoLab pre-upload evidence"
  )
  unless final_evidence_identity == evidence_identity
    UI.user_error!("Final DemoLab evidence changed before publication.")
  end
  held_files << [
    evidence_handle,
    evidence_path,
    final_evidence_identity,
    DEMO_LAB_MAX_UPLOAD_RESULT_BYTES,
    "Final DemoLab pre-upload evidence",
  ]

  verify_held_lab002_archive_app_path!(
    archive_app_handle,
    archive_app_path,
    oracle_result
  )
  held_files.each do |handle, path, identity, maximum_size, label|
    verify_held_staged_file_path!(
      handle,
      path,
      staging_directory,
      identity,
      maximum_size,
      label
    )
  end
  verify_closed_staging_inventory!(staging_handle, expected_names)
  verify_locked_directory!(
    staging_handle,
    staging_directory,
    staging_identity,
    "DemoLab staging directory"
  )
  verify_locked_directory!(
    output_handle,
    output_root,
    output_identity,
    "DEMO_LAB_OUTPUT_DIR"
  )

  publication_gate_file, publication_gate_path =
    publish_lab002_publication_gate!(
      output_handle: output_handle,
      output_root: output_root,
      output_identity: output_identity,
      run_directory: run_directory,
      staging_identity: staging_identity
    )
  verify_private_record_path_identity!(
    publication_gate_path,
    publication_gate_file,
    "LAB-002 publication gate"
  )
  verify_locked_directory!(
    output_handle,
    output_root,
    output_identity,
    "DEMO_LAB_OUTPUT_DIR"
  )
  rename_exclusive_no_follow!(
    staging_directory,
    run_directory,
    "DemoLab run directory"
  )
  publication_renamed = true
  on_publication_change.call

  published_identity = [
    File.realpath(run_directory),
    staging_identity.fetch(1),
    staging_identity.fetch(2),
  ]
  verify_locked_directory!(
    staging_handle,
    run_directory,
    published_identity,
    "Published DemoLab run directory"
  )
  verify_closed_staging_inventory!(staging_handle, expected_names)
  published_archive_app_path = File.join(
    run_directory,
    Pathname.new(archive_app_path).relative_path_from(
      Pathname.new(staging_directory)
    ).to_s
  )
  verify_held_lab002_archive_app_path!(
    archive_app_handle,
    published_archive_app_path,
    oracle_result
  )
  held_files.each do |handle, path, identity, maximum_size, label|
    published_path = File.join(
      run_directory,
      Pathname.new(path).relative_path_from(
        Pathname.new(staging_directory)
      ).to_s
    )
    verify_held_staged_file_path!(
      handle,
      published_path,
      run_directory,
      identity,
      maximum_size,
      label
    )
  end
  verify_locked_directory!(
    output_handle,
    output_root,
    output_identity,
    "DEMO_LAB_OUTPUT_DIR"
  )
  remove_lab002_publication_gate!(
    output_handle: output_handle,
    output_root: output_root,
    output_identity: output_identity,
    marker_file: publication_gate_file,
    marker_path: publication_gate_path
  )
  publication_gate_file.flock(File::LOCK_UN)
  publication_gate_file.close
  publication_gate_file = nil
  true
rescue => error
  if publication_renamed
    UI.important(
      "Retained an indeterminate published DemoLab run for reconciliation: " \
      "#{run_directory} (gate: #{publication_gate_path})"
    )
  end
  if [
    Errno::EACCES,
    Errno::ELOOP,
    Errno::ENOENT,
    Errno::ENOTDIR,
  ].any? { |error_class| error.is_a?(error_class) }
    UI.user_error!("Unable to publish the closed final DemoLab staging.")
  end
  raise error
ensure
  held_files&.each do |handle, _path, _identity, _maximum_size, _label|
    handle&.close unless handle&.closed?
  end
  archive_app_handle&.close unless archive_app_handle&.closed?
  publication_gate_file&.flock(File::LOCK_UN)
  publication_gate_file&.close
end

def write_pre_upload_evidence(
  run_directory:,
  archive_path:,
  ipa_path:,
  oracle_result:,
  manifest_identity:,
  prebuild_inputs:,
  source_commit:,
  xcodegen_version:,
  marketing_version:,
  build_number:,
  app_identifier:,
  share_identifier:,
  xcode_toolchain:
)
  binaries = demolab_archive_binary_inputs(archive_path).map do |path, relative_path, role|
    [
      validate_regular_file_beneath_root!(
        path,
        archive_path,
        "Archived DemoLab binary"
      ),
      relative_path,
      role,
    ]
  end
  validate_demolab_dynamic_linkage_paths!(
    binaries[0][0],
    binaries[1][0],
    xcode_toolchain: xcode_toolchain
  )
  packaged = inspect_demolab_ipa!(
    ipa_path,
    app_identifier: app_identifier,
    share_identifier: share_identifier,
    marketing_version: marketing_version,
    build_number: build_number,
    xcode_toolchain: xcode_toolchain
  )
  archive_binary_evidence = binaries.map do |path, relative_path, role|
    binary_evidence(
      path,
      relative_path,
      role,
      xcode_toolchain: xcode_toolchain
    )
  end
  archive_source_measurements = demolab_archive_source_measurements!(
    archive_path,
    archive_binary_evidence
  )
  verify_lab002_oracle_evidence_sources!(
    oracle_result,
    packaged,
    archive_source_measurements
  )
  unless manifest_identity.fetch("name") == DEMO_LAB_LAB002_MANIFEST_NAME &&
         manifest_identity.fetch("mode") == 0o400 &&
         manifest_identity.fetch("sha256") ==
           prebuild_inputs.fetch("authorized_target_manifest_sha256")
    UI.user_error!("LAB-002 manifest identity changed before evidence binding.")
  end
  oracle_identity = {
    "name" => oracle_result.fetch("oracle_name"),
    "device" => oracle_result.fetch("oracle_device"),
    "inode" => oracle_result.fetch("oracle_inode"),
    "mode" => oracle_result.fetch("oracle_mode"),
    "size" => oracle_result.fetch("oracle_size"),
    "sha256" => oracle_result.fetch("oracle_sha256"),
  }
  evidence_manifest_identity = {
    "name" => manifest_identity.fetch("name"),
    "device" => manifest_identity.fetch("device").to_s,
    "inode" => manifest_identity.fetch("inode").to_s,
    "mode" => manifest_identity.fetch("mode"),
    "size" => manifest_identity.fetch("size"),
    "sha256" => manifest_identity.fetch("sha256"),
  }

  evidence = {
    "schema_version" => 1,
    "profile" => DEMO_LAB_EVIDENCE_PROFILE,
    "purpose" => DEMO_LAB_EVIDENCE_PURPOSE,
    "decision" => DEMO_LAB_EVIDENCE_DECISION,
    "created_at" => Time.now.utc.iso8601,
    "source" => {
      "commit" => source_commit,
      "tree_clean" => true,
      "fixture" => "fixtures/DemoLab",
    },
    "toolchain" => {
      "fastlane_version" => Fastlane::VERSION,
      "xcodegen_version" => xcodegen_version,
      "xcode" => xcode_toolchain.fetch("xcode_version"),
      "iphoneos_sdk_version" =>
        xcode_toolchain.fetch("iphoneos_sdk_version"),
      "iphoneos_sdk_build" =>
        xcode_toolchain.fetch("iphoneos_sdk_build"),
    },
    "build" => {
      "configuration" => "Release",
      "marketing_version" => marketing_version,
      "build_number" => build_number,
      "distribution" => "app-store",
      "bundle_identifiers" => "operator-provided first-party identifiers; redacted",
    },
    "artifacts" => {
      "ipa" => {
        "filename" => File.basename(ipa_path),
        "size" => packaged.dig("archive", "size"),
        "sha256" => packaged.dig("archive", "sha256"),
      },
      "archive_binaries" => archive_binary_evidence,
      "package" => packaged.reject do |key, _|
        ["archive", "binaries"].include?(key)
      end,
      "ipa_binaries" => packaged["binaries"],
    },
    "lab002" => {
      "build_binding_sha256" => prebuild_inputs.fetch("build_binding_sha256"),
      "target_identity_set_sha256" =>
        prebuild_inputs.fetch("target_identity_set_sha256"),
      "authorized_target_manifest" => evidence_manifest_identity,
      "oracle" => oracle_identity,
    },
    "lineage" => {
      "uploaded_ipa_bound" => false,
      "installed_artifact_bound" => false,
      "note" => DEMO_LAB_LINEAGE_NOTE,
    },
  }

  validate_upload_evidence_structure!(evidence)
  evidence_path = File.join(run_directory, "demolab-pre-upload-evidence.json")
  evidence_file = open_exclusive_private_file(evidence_path)
  begin
    persist_json_record!(evidence_file, evidence)
  ensure
    evidence_file.close
  end
  evidence_identity = stable_staged_file_identity!(
    evidence_path,
    run_directory,
    DEMO_LAB_MAX_UPLOAD_RESULT_BYTES,
    "DemoLab pre-upload evidence"
  )
  expected_serialized = "#{JSON.pretty_generate(evidence)}\n"
  unless evidence_identity["size"] == expected_serialized.bytesize &&
         evidence_identity["sha256"] ==
           Digest::SHA256.hexdigest(expected_serialized)
    UI.user_error!("Written DemoLab pre-upload evidence bytes changed.")
  end
  [evidence_path, evidence_identity]
end

def require_exact_hash_keys!(value, expected_keys, label)
  unless value.is_a?(Hash) && value.keys.sort == expected_keys.sort
    UI.user_error!("#{label} has an incomplete or unexpected structure.")
  end
end

def validate_binary_measurement!(measurement, specification, archive:)
  keys = %w[
    role
    relative_path
    size
    sha256
    initial_protection_status
    expected_plaintext_status
  ]
  keys += %w[architectures slices] if archive
  require_exact_hash_keys!(measurement, keys, "DemoLab binary evidence")

  unless measurement["role"] == specification["role"] &&
         measurement["relative_path"] == specification["relative_path"] &&
         measurement["size"].is_a?(Integer) &&
         measurement["size"].positive? &&
         measurement["size"] <= DEMO_LAB_MAX_BINARY_BYTES &&
         measurement["sha256"].is_a?(String) &&
         /\A[0-9a-f]{64}\z/.match?(measurement["sha256"]) &&
         measurement["initial_protection_status"] == "not_observed" &&
         measurement["expected_plaintext_status"] ==
           "candidate_pre_upload_archive_only"
    UI.user_error!("DemoLab binary evidence is incomplete.")
  end
  return unless archive

  architectures = measurement["architectures"]
  slices = measurement["slices"]
  architectures_valid =
    architectures.is_a?(Array) &&
    architectures.length.between?(1, 8) &&
    architectures.uniq.length == architectures.length &&
    architectures.all? { |architecture|
      architecture.is_a?(String) &&
        /\A[A-Za-z0-9_]+\z/.match?(architecture)
    }
  slices_valid =
    slices.is_a?(Array) &&
    architectures.is_a?(Array) &&
    slices.length == architectures.length
  unless architectures_valid && slices_valid
    UI.user_error!("DemoLab archive architecture evidence is incomplete.")
  end

  slice_architectures = slices.map do |slice|
    require_exact_hash_keys!(
      slice,
      %w[architecture uuid],
      "DemoLab archive slice evidence"
    )
    architecture = slice["architecture"]
    uuid = slice["uuid"]
    unless architecture.is_a?(String) &&
           uuid.is_a?(String) &&
           /\A[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\z/.match?(
             uuid
           )
      UI.user_error!("DemoLab archive slice evidence is incomplete.")
    end
    architecture
  end
  unless slice_architectures.uniq.length == slice_architectures.length &&
         slice_architectures.sort == architectures.sort
    UI.user_error!("DemoLab archive slice evidence does not match its architectures.")
  end
end

def validate_upload_evidence_structure!(evidence)
  expected_evidence_keys = %w[
    schema_version
    profile
    purpose
    decision
    created_at
    source
    toolchain
    build
    artifacts
    lineage
  ]
  expected_evidence_keys << "lab002" if evidence.is_a?(Hash) && evidence.key?("lab002")
  require_exact_hash_keys!(
    evidence,
    expected_evidence_keys,
    "DemoLab evidence"
  )

  created_at = evidence["created_at"]
  unless valid_utc_timestamp?(created_at)
    UI.user_error!("DemoLab evidence creation time is invalid.")
  end

  source = evidence["source"]
  require_exact_hash_keys!(
    source,
    %w[commit tree_clean fixture],
    "DemoLab source evidence"
  )
  unless source["commit"].is_a?(String) &&
         /\A[0-9a-f]{40,64}\z/.match?(source["commit"]) &&
         source["tree_clean"] == true &&
         source["fixture"] == "fixtures/DemoLab"
    UI.user_error!("DemoLab source evidence is incomplete.")
  end

  toolchain = evidence["toolchain"]
  require_exact_hash_keys!(
    toolchain,
    %w[
      fastlane_version
      xcodegen_version
      xcode
      iphoneos_sdk_version
      iphoneos_sdk_build
    ],
    "DemoLab toolchain evidence"
  )
  xcode_lines = toolchain["xcode"]
  xcode_lines_valid =
    xcode_lines.is_a?(Array) &&
    xcode_lines.length == 2 &&
    xcode_lines.all? { |line|
      line.is_a?(String) && !line.empty? && line.bytesize <= 256
    }
  toolchain_valid =
    toolchain["fastlane_version"] == Fastlane::VERSION &&
    toolchain["xcodegen_version"].is_a?(String) &&
    /\A[0-9]+\.[0-9]+\.[0-9]+\z/.match?(
      toolchain["xcodegen_version"]
    ) &&
    xcode_lines_valid &&
    toolchain["iphoneos_sdk_version"].is_a?(String) &&
    /\A[0-9]+(?:\.[0-9]+){0,2}\z/.match?(
      toolchain["iphoneos_sdk_version"]
    ) &&
    toolchain["iphoneos_sdk_build"].is_a?(String) &&
    /\A[A-Za-z0-9.]+\z/.match?(toolchain["iphoneos_sdk_build"])
  unless toolchain_valid
    UI.user_error!("DemoLab toolchain evidence is incomplete.")
  end

  build = evidence["build"]
  require_exact_hash_keys!(
    build,
    %w[
      configuration
      marketing_version
      build_number
      distribution
      bundle_identifiers
    ],
    "DemoLab build evidence"
  )
  unless build["configuration"] == "Release" &&
         build["marketing_version"].is_a?(String) &&
         /\A[0-9]+(?:\.[0-9]+){0,2}\z/.match?(
           build["marketing_version"]
         ) &&
         build["build_number"].is_a?(String) &&
         /\A[1-9][0-9]{0,17}\z/.match?(build["build_number"]) &&
         build["distribution"] == "app-store" &&
         build["bundle_identifiers"] ==
           "operator-provided first-party identifiers; redacted"
    UI.user_error!("DemoLab build evidence is incomplete.")
  end
  checkpoint_3 =
    build["marketing_version"] ==
      DEMO_LAB_LAB002_CHECKPOINT_3_MARKETING_VERSION &&
    build["build_number"] == DEMO_LAB_LAB002_CHECKPOINT_3_BUILD_NUMBER
  unless evidence.key?("lab002") == checkpoint_3
    UI.user_error!("DemoLab LAB-002 evidence binding does not match its build tuple.")
  end

  artifacts = evidence["artifacts"]
  require_exact_hash_keys!(
    artifacts,
    %w[ipa archive_binaries package ipa_binaries],
    "DemoLab artifact evidence"
  )
  ipa = artifacts["ipa"]
  require_exact_hash_keys!(ipa, %w[filename size sha256], "DemoLab IPA evidence")
  unless ipa["filename"].is_a?(String) &&
         ipa["filename"] == "DemoLab-#{build['build_number']}.ipa" &&
         ipa["size"].is_a?(Integer) &&
         ipa["size"].positive? &&
         ipa["size"] <= DEMO_LAB_MAX_IPA_BYTES &&
         ipa["sha256"].is_a?(String) &&
         /\A[0-9a-f]{64}\z/.match?(ipa["sha256"])
    UI.user_error!("DemoLab IPA evidence is incomplete.")
  end

  package = artifacts["package"]
  require_exact_hash_keys!(
    package,
    %w[application identity_validated export_compliance_validated],
    "DemoLab package evidence"
  )
  unless package == {
    "application" => "DemoLab.app",
    "identity_validated" => true,
    "export_compliance_validated" => true,
  }
    UI.user_error!("DemoLab package evidence is incomplete.")
  end

  archive_binaries = artifacts["archive_binaries"]
  ipa_binaries = artifacts["ipa_binaries"]
  unless archive_binaries.is_a?(Array) &&
         ipa_binaries.is_a?(Array) &&
         archive_binaries.length == DEMO_LAB_BINARY_SPECS.length &&
         ipa_binaries.length == DEMO_LAB_BINARY_SPECS.length
    UI.user_error!("DemoLab evidence must contain all required binaries.")
  end
  DEMO_LAB_BINARY_SPECS.each_with_index do |specification, index|
    validate_binary_measurement!(
      archive_binaries[index],
      specification,
      archive: true
    )
    validate_binary_measurement!(
      ipa_binaries[index],
      specification,
      archive: false
    )
  end

  validate_lab002_evidence_binding!(evidence["lab002"], ipa) if checkpoint_3

  lineage = evidence["lineage"]
  require_exact_hash_keys!(
    lineage,
    %w[uploaded_ipa_bound installed_artifact_bound note],
    "DemoLab lineage evidence"
  )
  unless lineage == {
    "uploaded_ipa_bound" => false,
    "installed_artifact_bound" => false,
    "note" => DEMO_LAB_LINEAGE_NOTE,
  }
    UI.user_error!("DemoLab lineage evidence is incomplete.")
  end
end

def validate_lab002_evidence_artifact!(artifact, expected_name, label)
  require_exact_hash_keys!(
    artifact,
    %w[name device inode mode size sha256],
    label
  )
  unless artifact["name"] == expected_name &&
         %w[device inode].all? { |key|
           /\A(?:0|[1-9][0-9]*)\z/.match?(artifact[key].to_s)
         } &&
         artifact["mode"] == 0o400 &&
         artifact["size"].is_a?(Integer) &&
         artifact["size"].positive? &&
         artifact["size"] <= 16 * 1024 &&
         /\A[0-9a-f]{64}\z/.match?(artifact["sha256"].to_s)
    UI.user_error!("#{label} is invalid.")
  end
end

def validate_lab002_evidence_binding!(binding, ipa)
  require_exact_hash_keys!(
    binding,
    %w[
      build_binding_sha256
      target_identity_set_sha256
      authorized_target_manifest
      oracle
    ],
    "LAB-002 evidence binding"
  )
  unless %w[build_binding_sha256 target_identity_set_sha256].all? { |key|
           /\A[0-9a-f]{64}\z/.match?(binding[key].to_s)
         }
    UI.user_error!("LAB-002 evidence digests are invalid.")
  end
  validate_lab002_evidence_artifact!(
    binding["authorized_target_manifest"],
    DEMO_LAB_LAB002_MANIFEST_NAME,
    "LAB-002 manifest evidence"
  )
  validate_lab002_evidence_artifact!(
    binding["oracle"],
    DEMO_LAB_LAB002_ORACLE_NAME,
    "LAB-002 oracle evidence"
  )
  unless ipa["size"].positive? && /\A[0-9a-f]{64}\z/.match?(ipa["sha256"])
    UI.user_error!("LAB-002 IPA evidence binding is invalid.")
  end
end

def load_demolab_evidence
  evidence_path, evidence_content = private_external_file_snapshot_with_path(
    "DEMO_LAB_EVIDENCE_PATH",
    DEMO_LAB_MAX_PLIST_BYTES,
    "DemoLab evidence"
  )
  begin
    evidence = JSON.parse(evidence_content)
  rescue JSON::ParserError
    UI.user_error!("DemoLab evidence is not valid JSON.")
  end
  unless evidence.is_a?(Hash)
    UI.user_error!("DemoLab evidence root must be a JSON object.")
  end

  expected_profile = {
    "schema_version" => 1,
    "profile" => DEMO_LAB_EVIDENCE_PROFILE,
    "purpose" => DEMO_LAB_EVIDENCE_PURPOSE,
    "decision" => DEMO_LAB_EVIDENCE_DECISION,
  }
  expected_profile.each do |key, expected|
    UI.user_error!("Evidence is not a DemoLab pre-upload record.") unless evidence[key] == expected
  end
  validate_upload_evidence_structure!(evidence)
  unless evidence.dig("source", "tree_clean") == true &&
         evidence.dig("source", "fixture") == "fixtures/DemoLab" &&
         evidence.dig("build", "distribution") == "app-store" &&
         evidence.dig("artifacts", "package", "application") == "DemoLab.app" &&
         evidence.dig("artifacts", "package", "identity_validated") == true &&
         evidence.dig(
           "artifacts",
           "package",
           "export_compliance_validated"
         ) == true
    UI.user_error!("Evidence does not describe an authorized DemoLab App Store candidate.")
  end

  source_commit = evidence.dig("source", "commit")
  current_commit = git_command_output("rev-parse", "HEAD")
  unless source_commit == current_commit
    UI.user_error!("Evidence source commit does not match the current checkout.")
  end

  [evidence_path, evidence]
end

def verify_evidence_bound_archive!(
  archive_path,
  evidence,
  xcode_toolchain:
)
  unless File.directory?(archive_path) && !File.symlink?(archive_path)
    UI.user_error!("Evidence-bound DemoLab archive is missing or unsafe.")
  end
  ensure_outside_repository!(archive_path, "Evidence-bound DemoLab archive")
  archive_binaries =
    demolab_archive_binary_inputs(archive_path).map do |path, relative_path, role|
      resolved_path = validate_regular_file_beneath_root!(
        path,
        archive_path,
        "Evidence-bound archive binary"
      )
      ensure_outside_repository!(resolved_path, "Evidence-bound archive binary")
      [resolved_path, relative_path, role]
    end
  validate_demolab_dynamic_linkage_paths!(
    archive_binaries[0][0],
    archive_binaries[1][0],
    xcode_toolchain: xcode_toolchain
  )
  observed_archive_binaries = archive_binaries.map do |path, relative_path, role|
    binary_evidence(
      path,
      relative_path,
      role,
      xcode_toolchain: xcode_toolchain
    )
  end
  unless observed_archive_binaries == evidence.dig(
    "artifacts",
    "archive_binaries"
  )
    UI.user_error!("Archived DemoLab binaries do not match the evidence.")
  end
  true
end

def verify_lab002_upload_gate!(evidence_path, evidence, xcode_toolchain:)
  marketing_version = evidence.dig("build", "marketing_version")
  build_number = evidence.dig("build", "build_number")
  return true unless marketing_version ==
                     DEMO_LAB_LAB002_CHECKPOINT_3_MARKETING_VERSION &&
                     build_number == DEMO_LAB_LAB002_CHECKPOINT_3_BUILD_NUMBER

  source_commit = evidence.dig("source", "commit")
  binding = evidence.fetch("lab002")
  run_directory = File.dirname(evidence_path)
  expected_run_name =
    "#{marketing_version}-#{build_number}-#{source_commit[0, 12]}"
  unless File.basename(run_directory) == expected_run_name &&
         File.basename(evidence_path) == "demolab-pre-upload-evidence.json"
    UI.user_error!("LAB-002 evidence is outside its exact private run directory.")
  end
  output_root = File.dirname(run_directory)
  prebuild_directory = File.join(
    output_root,
    "lab002-prebuild-#{marketing_version}-#{build_number}-#{source_commit}"
  )
  output_identity = private_directory_identity!(
    output_root,
    "LAB-002 upload output root"
  )
  prebuild_identity = private_directory_identity!(
    prebuild_directory,
    "LAB-002 upload prebuild directory"
  )
  run_identity = private_directory_identity!(
    run_directory,
    "LAB-002 upload run directory"
  )

  binary = nil
  tool_workspace = nil
  with_locked_private_directory(
    output_root,
    output_identity,
    "LAB-002 upload output root"
  ) do |output_handle|
    with_locked_private_directory(
      prebuild_directory,
      prebuild_identity,
      "LAB-002 upload prebuild directory"
    ) do |prebuild_handle|
      with_locked_private_directory(
        run_directory,
        run_identity,
        "LAB-002 upload run directory"
      ) do |run_handle|
        begin
          binary, tool_workspace, tool_identity, =
            build_lab002_private_tool(source_commit)
          request = {
            "schema" => DEMO_LAB_LAB002_UPLOAD_GATE_REQUEST_SCHEMA,
            "source_commit" => source_commit,
            "marketing_version" => marketing_version,
            "build_number" => build_number,
            "build_binding_sha256" =>
              binding.fetch("build_binding_sha256"),
            "target_identity_set_sha256" =>
              binding.fetch("target_identity_set_sha256"),
            "authorized_target_manifest" =>
              binding.fetch("authorized_target_manifest"),
            "oracle" => binding.fetch("oracle"),
            "ipa_size" => evidence.dig("artifacts", "ipa", "size"),
            "ipa_sha256" => evidence.dig("artifacts", "ipa", "sha256"),
          }
          verify_locked_directory!(
            output_handle,
            output_root,
            output_identity,
            "LAB-002 upload output root"
          )
          verify_lab002_private_tool!(binary, tool_workspace, tool_identity)
          verify_selected_xcode_toolchain!(xcode_toolchain)
          result_json = nil
          helper_stderr = ""
          status = nil
          Open3.popen3(
            sanitized_dynamic_loader_environment,
            binary,
            "verify-upload-gate",
            "--prebuild-directory",
            prebuild_directory,
            "--prebuild-directory-device",
            prebuild_handle.stat.dev.to_s,
            "--prebuild-directory-inode",
            prebuild_handle.stat.ino.to_s,
            "--run-directory",
            run_directory,
            "--run-directory-device",
            run_handle.stat.dev.to_s,
            "--run-directory-inode",
            run_handle.stat.ino.to_s,
            4 => prebuild_handle,
            5 => run_handle,
            chdir: repository_root,
            close_others: true
          ) do |stdin, stdout, error_stream, wait_thread|
            verify_running_lab002_private_tool!(wait_thread.pid, tool_identity)
            stdin.write(JSON.generate(request))
            stdin.close
            result_json =
              stdout.read(DEMO_LAB_MAX_LAB002_HELPER_OUTPUT_BYTES + 1)
            helper_stderr =
              error_stream.read(DEMO_LAB_MAX_LAB002_HELPER_OUTPUT_BYTES + 1)
            status = wait_thread.value
          end
          if result_json&.bytesize.to_i >
             DEMO_LAB_MAX_LAB002_HELPER_OUTPUT_BYTES ||
             helper_stderr.to_s.bytesize >
               DEMO_LAB_MAX_LAB002_HELPER_OUTPUT_BYTES
            UI.user_error!("LAB-002 upload-gate helper output exceeded its limit.")
          end
          unless status.success?
            UI.user_error!(
              "LAB-002 upload gate rejected the private tuple: " \
              "#{helper_stderr.to_s.strip}"
            )
          end
          result = JSON.parse(result_json)
          require_exact_hash_keys!(
            result,
            %w[schema authorized_target_manifest oracle],
            "LAB-002 upload-gate result"
          )
          unless result == {
            "schema" => DEMO_LAB_LAB002_UPLOAD_GATE_RESULT_SCHEMA,
            "authorized_target_manifest" =>
              binding.fetch("authorized_target_manifest"),
            "oracle" => binding.fetch("oracle"),
          }
            UI.user_error!("LAB-002 upload-gate result changed its evidence binding.")
          end
          verify_locked_directory!(
            output_handle,
            output_root,
            output_identity,
            "LAB-002 upload output root"
          )
          verify_selected_xcode_toolchain!(xcode_toolchain)
          verify_lab002_private_tool!(binary, tool_workspace, tool_identity)
        rescue JSON::ParserError
          UI.user_error!("LAB-002 upload-gate helper returned invalid JSON.")
        ensure
          FileUtils.rm_rf(tool_workspace) if tool_workspace
        end
      end
    end
  end
  true
end

def load_upload_evidence(
  app_identifier:,
  share_identifier:,
  xcode_toolchain:
)
  evidence_path, evidence = load_demolab_evidence
  archive_path = File.join(File.dirname(evidence_path), "DemoLab.xcarchive")
  verify_evidence_bound_archive!(
    archive_path,
    evidence,
    xcode_toolchain: xcode_toolchain
  )

  filename = evidence.dig("artifacts", "ipa", "filename")
  expected_size = evidence.dig("artifacts", "ipa", "size")
  expected_sha256 = evidence.dig("artifacts", "ipa", "sha256")
  unless filename.is_a?(String) && File.basename(filename) == filename
    UI.user_error!("Evidence contains an unsafe IPA filename.")
  end
  marketing_version = evidence.dig("build", "marketing_version")
  build_number = evidence.dig("build", "build_number")
  unless marketing_version.is_a?(String) &&
         /\A[0-9]+(?:\.[0-9]+){0,2}\z/.match?(marketing_version)
    UI.user_error!("Evidence contains an invalid DemoLab marketing version.")
  end
  unless build_number.is_a?(String) &&
         /\A[1-9][0-9]{0,17}\z/.match?(build_number) &&
         filename == "DemoLab-#{build_number}.ipa"
    UI.user_error!("Evidence IPA filename does not match the DemoLab build.")
  end
  unless expected_size.is_a?(Integer) &&
         expected_size.positive? &&
         expected_size <= DEMO_LAB_MAX_IPA_BYTES
    UI.user_error!("Evidence contains an invalid IPA size.")
  end
  unless expected_sha256.is_a?(String) && /\A[0-9a-f]{64}\z/.match?(expected_sha256)
    UI.user_error!("Evidence contains an invalid IPA SHA-256.")
  end

  ipa_path = File.join(File.dirname(evidence_path), filename)
  UI.user_error!("Evidence-bound IPA is missing.") unless File.file?(ipa_path)
  ensure_outside_repository!(ipa_path, "Evidence-bound IPA")
  UI.user_error!("IPA size does not match the evidence.") unless File.size(ipa_path) == expected_size
  UI.user_error!("IPA SHA-256 does not match the evidence.") unless sha256(ipa_path) == expected_sha256
  observed_package = inspect_demolab_ipa!(
    ipa_path,
    app_identifier: app_identifier,
    share_identifier: share_identifier,
    marketing_version: marketing_version,
    build_number: build_number,
    xcode_toolchain: xcode_toolchain
  )
  unless observed_package["archive"] == {
    "size" => expected_size,
    "sha256" => expected_sha256,
  }
    UI.user_error!("Inspected DemoLab IPA bytes do not match the evidence.")
  end
  observed_package_summary = observed_package.reject do |key, _|
    ["archive", "binaries"].include?(key)
  end
  unless observed_package_summary == evidence.dig("artifacts", "package")
    UI.user_error!("Packaged DemoLab metadata does not match the archive evidence.")
  end
  unless observed_package["binaries"] == evidence.dig("artifacts", "ipa_binaries")
    UI.user_error!("Packaged DemoLab binaries do not match the archive evidence.")
  end

  verify_lab002_upload_gate!(
    evidence_path,
    evidence,
    xcode_toolchain: xcode_toolchain
  )

  [evidence_path, evidence, ipa_path, archive_path]
end

def digest_open_file(file)
  digest = Digest::SHA256.new
  file.rewind
  while (chunk = file.read(1024 * 1024))
    digest.update(chunk)
  end
  file.rewind
  digest.hexdigest
end

def reopen_snapshot_read_only!(
  writable_snapshot,
  expected_size:,
  expected_sha256:,
  label:
)
  writable_snapshot.flush
  writable_snapshot.fsync
  writable_snapshot.chmod(0o400)
  snapshot_path = writable_snapshot.path
  written = writable_snapshot.stat
  writable_snapshot.close

  flags = File::RDONLY | File::NONBLOCK
  flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
  read_only_snapshot = File.open(snapshot_path, flags)
  opened = read_only_snapshot.stat
  linked = File.lstat(snapshot_path)
  access_mode =
    read_only_snapshot.fcntl(Fcntl::F_GETFL) & Fcntl::O_ACCMODE
  unless written.file? &&
         opened.file? &&
         !linked.symlink? &&
         written.dev == opened.dev &&
         written.ino == opened.ino &&
         linked.dev == opened.dev &&
         linked.ino == opened.ino &&
         opened.size == expected_size &&
         (opened.mode & 0o777) == 0o400 &&
         access_mode == Fcntl::O_RDONLY &&
         digest_open_file(read_only_snapshot) == expected_sha256
    UI.user_error!("Read-only #{label} snapshot identity check failed.")
  end

  File.unlink(snapshot_path)
  read_only_snapshot.rewind
  read_only_snapshot
rescue Errno::EACCES,
       Errno::EBADF,
       Errno::ELOOP,
       Errno::ENOENT,
       Errno::ENOTDIR
  read_only_snapshot&.close
  UI.user_error!("Unable to reopen the #{label} snapshot read-only.")
rescue
  read_only_snapshot&.close
  raise
end

def verify_locked_ipa_snapshot!(
  snapshot,
  snapshot_path,
  expected_identity,
  workspace_identity
)
  current_workspace_identity = private_directory_identity!(
    File.dirname(snapshot_path),
    "DemoLab IPA snapshot workspace"
  )
  opened = snapshot.stat
  path_stat = File.lstat(snapshot_path)
  access_mode = snapshot.fcntl(Fcntl::F_GETFL) & Fcntl::O_ACCMODE
  observed_identity = [
    opened.dev,
    opened.ino,
    opened.size,
    opened.mtime.to_i,
    digest_open_file(snapshot),
  ]
  unless current_workspace_identity == workspace_identity &&
         File.basename(snapshot_path) == "DemoLab.ipa" &&
         opened.file? &&
         opened.uid == Process.uid &&
         (opened.mode & 0o777) == 0o400 &&
         access_mode == Fcntl::O_RDONLY &&
         !path_stat.symlink? &&
         path_stat.dev == opened.dev &&
         path_stat.ino == opened.ino &&
         observed_identity == expected_identity
    UI.user_error!("The locked DemoLab IPA snapshot changed during upload.")
  end
  true
rescue Errno::EACCES,
       Errno::EBADF,
       Errno::ELOOP,
       Errno::ENOENT,
       Errno::ENOTDIR
  UI.user_error!("Unable to verify the locked DemoLab IPA snapshot safely.")
end

def open_locked_snapshot_from_path(
  source_path,
  expected_size:,
  expected_sha256:,
  label:
)
  workspace = external_temporary_directory("orchardprobe-demolab-ipa-")
  workspace_identity = private_directory_identity!(
    workspace,
    "DemoLab IPA snapshot workspace"
  )
  snapshot_path = File.join(workspace, "DemoLab.ipa")
  writable_snapshot = nil
  locked_snapshot = nil
  begin
    flags = File::RDONLY | File::NONBLOCK
    flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
    File.open(source_path, flags) do |source|
      before = source.stat
      UI.user_error!("#{label} must be a regular file.") unless before.file?
      unless before.size == expected_size &&
             expected_size.positive? &&
             expected_size <= DEMO_LAB_MAX_IPA_BYTES
        UI.user_error!("#{label} has an invalid size.")
      end

      destination_flags = File::WRONLY | File::CREAT | File::EXCL
      destination_flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
      writable_snapshot = File.open(
        snapshot_path,
        destination_flags,
        0o600
      )
      copied = 0
      digest = Digest::SHA256.new
      while (chunk = source.read([1024 * 1024, expected_size - copied + 1].min))
        copied += chunk.bytesize
        UI.user_error!("#{label} exceeded its evidence-bound size.") if copied > expected_size
        digest.update(chunk)
        writable_snapshot.write(chunk)
      end
      after = source.stat
      unless copied == expected_size &&
             digest.hexdigest == expected_sha256 &&
             before.dev == after.dev &&
             before.ino == after.ino &&
             before.size == after.size
        UI.user_error!("#{label} changed or did not match its evidence.")
      end
    end

    writable_snapshot.flush
    writable_snapshot.fsync
    writable_snapshot.chmod(0o400)
    written = writable_snapshot.stat
    writable_snapshot.close
    writable_snapshot = nil

    snapshot_flags = File::RDONLY | File::NONBLOCK
    snapshot_flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
    locked_snapshot = File.open(snapshot_path, snapshot_flags)
    unless locked_snapshot.flock(File::LOCK_EX | File::LOCK_NB)
      UI.user_error!("Unable to lock the private DemoLab IPA snapshot.")
    end
    opened = locked_snapshot.stat
    snapshot_identity = [
      opened.dev,
      opened.ino,
      opened.size,
      opened.mtime.to_i,
      digest_open_file(locked_snapshot),
    ]
    unless written.dev == opened.dev &&
           written.ino == opened.ino &&
           opened.size == expected_size &&
           snapshot_identity.last == expected_sha256
      UI.user_error!("The private DemoLab IPA snapshot does not match its source.")
    end
    verify_locked_ipa_snapshot!(
      locked_snapshot,
      snapshot_path,
      snapshot_identity,
      workspace_identity
    )
    [
      locked_snapshot,
      snapshot_path,
      snapshot_identity,
      workspace_identity,
    ]
  rescue
    if locked_snapshot
      locked_snapshot.flock(File::LOCK_UN) rescue nil
      locked_snapshot.close rescue nil
    end
    writable_snapshot&.close
    FileUtils.rm_rf(workspace) if workspace
    raise
  end
end

def open_unlinked_snapshot_from_content(content, label:, suffix: "")
  UI.user_error!("#{label} is empty.") if content.nil? || content.empty?
  expected_size = content.bytesize
  expected_sha256 = Digest::SHA256.hexdigest(content)
  workspace = external_temporary_directory("orchardprobe-demolab-fd-")
  writable_snapshot = nil
  read_only_snapshot = nil
  begin
    writable_snapshot = Tempfile.new(["snapshot-", suffix], workspace)
    writable_snapshot.binmode
    writable_snapshot.chmod(0o600)
    writable_snapshot.write(content)
    read_only_snapshot = reopen_snapshot_read_only!(
      writable_snapshot,
      expected_size: expected_size,
      expected_sha256: expected_sha256,
      label: label
    )
    FileUtils.rmdir(workspace)
    workspace = nil
    read_only_snapshot
  rescue
    read_only_snapshot&.close
    writable_snapshot&.close!
    FileUtils.rm_rf(workspace) if workspace
    raise
  end
end

def stage_evidence_bound_ipa(ipa_path, evidence)
  expected_size = evidence.dig("artifacts", "ipa", "size")
  expected_sha256 = evidence.dig("artifacts", "ipa", "sha256")
  open_locked_snapshot_from_path(
    ipa_path,
    expected_size: expected_size,
    expected_sha256: expected_sha256,
    label: "Evidence-bound IPA"
  )
end

def read_bounded_altool_output!(file, label)
  file.flush
  size = file.stat.size
  if size > DEMO_LAB_MAX_ALTOOL_OUTPUT_BYTES
    UI.user_error!("#{label} exceeded the bounded output limit.")
  end
  file.rewind
  content = file.read(DEMO_LAB_MAX_ALTOOL_OUTPUT_BYTES + 1)
  if content.bytesize != size || content.bytesize > DEMO_LAB_MAX_ALTOOL_OUTPUT_BYTES
    UI.user_error!("#{label} changed while it was being read.")
  end
  content
end

def validate_altool_upload_result!(output, process_success:)
  result = JSON.parse(output)
  unless result.is_a?(Hash)
    UI.user_error!("Apple altool returned an unexpected JSON result.")
  end

  product_errors = result["product-errors"]
  unless product_errors.nil? || product_errors.is_a?(Array)
    UI.user_error!("Apple altool returned malformed product-errors.")
  end
  unless product_errors.nil? || product_errors.empty?
    UI.user_error!(
      "Apple altool reported product-errors; the upload is not accepted."
    )
  end
  unless process_success
    UI.user_error!(
      "Apple altool did not report a successful DemoLab upload process."
    )
  end

  success_message = result["success-message"]
  unless success_message.is_a?(String) && !success_message.strip.empty?
    UI.user_error!(
      "Apple altool did not return an explicit upload success message."
    )
  end
  result
rescue JSON::ParserError
  UI.user_error!("Apple altool returned invalid JSON; upload state is unknown.")
end

def selected_altool(xcode_toolchain)
  discovered = command_output_with_environment(
    xcode_toolchain.fetch("environment"),
    xcode_toolchain.dig("xcrun", "path"),
    "--find",
    "altool"
  )
  unless Pathname.new(discovered).absolute?
    UI.user_error!("The selected Xcode returned a non-absolute altool path.")
  end
  selected = File.realpath(discovered)
  candidate =
    case File.basename(selected)
    when "altool"
      selected
    when "altoolShim"
      File.join(File.dirname(selected), "altool")
    else
      UI.user_error!("The selected Xcode returned an unexpected altool target.")
    end
  resolved_candidate = File.realpath(candidate)
  unless File.dirname(resolved_candidate) == File.dirname(selected) &&
         File.basename(resolved_candidate) == "altool"
    UI.user_error!("The selected Xcode real altool escaped its resource directory.")
  end
  pinned_executable(
    resolved_candidate,
    "Selected Xcode real altool",
    required_root: xcode_toolchain.fetch("xcode_bundle_root")
  )
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT
  UI.user_error!("Unable to resolve the selected Xcode real altool safely.")
end

def verify_selected_altool!(xcode_toolchain, altool)
  observed = selected_altool(xcode_toolchain)
  unless observed == altool
    UI.user_error!("The selected Xcode real altool changed during use.")
  end
  true
end

def terminate_process_group_and_reap(pid)
  begin
    Process.kill("TERM", -pid)
  rescue Errno::ESRCH
    nil
  end

  deadline =
    Process.clock_gettime(Process::CLOCK_MONOTONIC) +
    DEMO_LAB_PROCESS_TERMINATION_GRACE_SECONDS
  loop do
    waited_pid, status = Process.waitpid2(pid, Process::WNOHANG)
    if waited_pid
      begin
        Process.kill("KILL", -pid)
      rescue Errno::ESRCH
        nil
      end
      return status
    end
    break if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline

    sleep(0.1)
  end

  begin
    Process.kill("KILL", -pid)
  rescue Errno::ESRCH
    nil
  end
  _, status = Process.waitpid2(pid)
  status
rescue Errno::ECHILD
  UI.user_error!("Unable to reconcile the bounded Apple upload process.")
end

def wait_for_bounded_process(pid, timeout_seconds:)
  deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + timeout_seconds
  loop do
    waited_pid, status = Process.waitpid2(pid, Process::WNOHANG)
    return [status, false] if waited_pid
    break if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline

    sleep(0.1)
  end
  [terminate_process_group_and_reap(pid), true]
rescue Errno::ECHILD
  UI.user_error!("Unable to reconcile the bounded Apple upload process.")
end

def validate_private_altool_logs!(log_directory)
  workspace = File.dirname(log_directory)
  workspace_identity = private_directory_identity!(
    workspace,
    "Apple altool private workspace"
  )
  log_root = File.lstat(log_directory)
  unless log_root.directory? &&
         !log_root.symlink? &&
         log_root.uid == Process.uid &&
         (log_root.mode & 0o022).zero?
    UI.user_error!("Apple altool log root is not safely contained.")
  end

  entry_count = 0
  file_count = 0
  total_bytes = 0
  Find.find(log_directory) do |path|
    next if path == log_directory

    entry_count += 1
    if entry_count > DEMO_LAB_MAX_ALTOOL_LOG_ENTRIES
      UI.user_error!("Apple altool log output exceeded its entry limit.")
    end
    stat = File.lstat(path)
    if stat.symlink?
      Find.prune if File.directory?(path)
      UI.user_error!("Apple altool log output contains a symbolic link.")
    end
    unless stat.directory? || stat.file?
      UI.user_error!("Apple altool log output contains a special file.")
    end
    unless stat.uid == Process.uid && (stat.mode & 0o022).zero?
      UI.user_error!("Apple altool log output is writable by another user.")
    end
    next if stat.directory?

    file_count += 1
    total_bytes += stat.size
    if file_count > DEMO_LAB_MAX_ALTOOL_LOG_FILES ||
       stat.size > DEMO_LAB_MAX_ALTOOL_LOG_BYTES ||
       total_bytes > DEMO_LAB_MAX_ALTOOL_LOG_TOTAL_BYTES
      UI.user_error!("Apple altool log output exceeded its safety bounds.")
    end
  end
  unless private_directory_identity!(
    workspace,
    "Apple altool private workspace"
  ) == workspace_identity
    UI.user_error!("Apple altool private workspace changed during validation.")
  end
end

def altool_api_key_arguments(key_type:, key_id:, team_issuer_id:)
  case key_type
  when "team"
    unless team_issuer_id
      UI.user_error!("A team API key requires its App Store Connect issuer ID.")
    end
    [
      "--api-key",
      key_id,
      "--api-issuer",
      team_issuer_id,
    ]
  when "individual"
    unless team_issuer_id.nil?
      UI.user_error!("An individual API key does not use an issuer ID.")
    end
    [
      "--api-key",
      key_id,
      # Xcode 26 altool still requires --api-issuer at argument-parsing time
      # for individual keys. The key ID is its compatibility placeholder;
      # --api-key-subject selects Apple's individual-key authentication path.
      "--api-issuer",
      key_id,
      "--api-key-subject",
      "user",
    ]
  else
    UI.user_error!("App Store Connect API key type is invalid.")
  end
end

def upload_demolab_with_altool!(
  ipa_snapshot:,
  ipa_snapshot_path:,
  ipa_snapshot_identity:,
  ipa_workspace_identity:,
  key_snapshot:,
  archive_path:,
  evidence:,
  altool:,
  xcode_toolchain:,
  key_id:,
  key_type:,
  team_issuer_id:,
  apple_id:,
  app_identifier:,
  marketing_version:,
  build_number:
)
  verify_locked_ipa_snapshot!(
    ipa_snapshot,
    ipa_snapshot_path,
    ipa_snapshot_identity,
    ipa_workspace_identity
  )
  key_snapshot.rewind
  stdout_capture = nil
  stderr_capture = nil
  tool_workspace = external_temporary_directory(
    "orchardprobe-demolab-altool-"
  )
  log_directory = File.join(tool_workspace, "logs")
  Dir.mkdir(log_directory, 0o700)
  stdout_capture = Tempfile.new("stdout-", tool_workspace)
  stderr_capture = Tempfile.new("stderr-", tool_workspace)
  stdout_capture.chmod(0o600)
  stderr_capture.chmod(0o600)
  environment = {
    # selected_altool resolves Xcode's altoolShim to the real sibling
    # executable before this function is called. The shim is intentionally
    # never launched here because it requires a downloaded Defaults.properties
    # file in Home; the real ContentDelivery executable supports an empty
    # private Home and is verified that way by demolab_check.
    "CFFIXED_USER_HOME" => tool_workspace,
    "HOME" => tool_workspace,
    "LANG" => ENV.fetch("LANG", "en_US.UTF-8"),
    "LC_ALL" => ENV.fetch("LC_ALL", "en_US.UTF-8"),
    "PATH" => "/usr/bin:/bin",
    "TMPDIR" => tool_workspace,
  }
  command = [
    altool.fetch("path"),
    "--upload-package",
    ipa_snapshot_path,
    "--platform",
    "ios",
    "--apple-id",
    apple_id,
    "--bundle-version",
    build_number,
    "--bundle-short-version-string",
    marketing_version,
    "--bundle-id",
    app_identifier,
    "--p8-file-path",
    "/dev/fd/#{DEMO_LAB_UPLOAD_KEY_FD}",
    "--log-dir",
    log_directory,
  ]
  command.concat(
    altool_api_key_arguments(
      key_type: key_type,
      key_id: key_id,
      team_issuer_id: team_issuer_id
    )
  )
  command.concat(
    [
      "--wait",
      "--output-format",
      "json",
    ]
  )

  prior_umask = File.umask(0o077)
  begin
    verify_evidence_bound_archive!(
      archive_path,
      evidence,
      xcode_toolchain: xcode_toolchain
    )
    verify_selected_xcode_toolchain!(xcode_toolchain)
    verify_selected_altool!(xcode_toolchain, altool)
    pid = Process.spawn(
      environment,
      *command,
      DEMO_LAB_UPLOAD_KEY_FD => key_snapshot,
      out: stdout_capture,
      err: stderr_capture,
      pgroup: true,
      rlimit_fsize: DEMO_LAB_MAX_ALTOOL_LOG_BYTES,
      unsetenv_others: true
    )
    process_status, timed_out = wait_for_bounded_process(
      pid,
      timeout_seconds: DEMO_LAB_ALTOOL_TIMEOUT_SECONDS
    )
    verify_selected_xcode_toolchain!(xcode_toolchain)
    verify_selected_altool!(xcode_toolchain, altool)
  ensure
    File.umask(prior_umask)
  end
  verify_locked_ipa_snapshot!(
    ipa_snapshot,
    ipa_snapshot_path,
    ipa_snapshot_identity,
    ipa_workspace_identity
  )
  validate_private_altool_logs!(log_directory)
  stdout = read_bounded_altool_output!(stdout_capture, "Apple altool stdout")
  read_bounded_altool_output!(stderr_capture, "Apple altool stderr")
  if timed_out
    UI.user_error!(
      "Apple altool exceeded the 30-minute upload deadline; state is unknown."
    )
  end
  validate_altool_upload_result!(
    stdout,
    process_success: process_status.success?
  )
ensure
  ipa_snapshot&.rewind
  key_snapshot&.rewind
  stdout_capture&.close!
  stderr_capture&.close!
  FileUtils.rm_rf(tool_workspace) if tool_workspace
end

def open_exclusive_private_file(path)
  flags = File::WRONLY | File::CREAT | File::EXCL
  flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
  file = File.open(path, flags, 0o600)
  unless file.flock(File::LOCK_EX | File::LOCK_NB)
    file.close
    UI.user_error!("Unable to lock the newly created private record.")
  end
  file
end

def persist_json_record!(file, record)
  serialized = "#{JSON.pretty_generate(record)}\n"
  if serialized.bytesize > DEMO_LAB_MAX_UPLOAD_RESULT_BYTES
    UI.user_error!("DemoLab JSON record exceeded its bounded size.")
  end
  file.rewind
  file.write(serialized)
  file.truncate(file.pos)
  file.flush
  file.fsync
end

def private_json_temporary_path(path)
  File.join(
    File.dirname(path),
    ".#{File.basename(path)}.tmp-#{SecureRandom.hex(12)}"
  )
end

def verify_private_record_path_identity!(path, file, label)
  current = File.lstat(path)
  held = file.stat
  unless current.file? &&
         !current.symlink? &&
         current.uid == Process.uid &&
         (current.mode & 0o077).zero? &&
         current.dev == held.dev &&
         current.ino == held.ino
    UI.user_error!("#{label} path changed during atomic publication.")
  end
end

def prepare_private_json_temporary_record(path, record)
  temporary_path = private_json_temporary_path(path)
  temporary_file = open_exclusive_private_file(temporary_path)
  persist_json_record!(temporary_file, record)
  [temporary_path, temporary_file]
rescue
  temporary_file&.flock(File::LOCK_UN)
  temporary_file&.close
  FileUtils.rm_f(temporary_path) if temporary_path
  raise
end

def publish_new_private_json_record!(path, record, label)
  expanded = File.expand_path(path)
  reject_repository_path!(expanded, label)
  private_directory_identity!(File.dirname(expanded), "#{label} parent")
  temporary_path = nil
  temporary_file = nil
  published = false
  begin
    temporary_path, temporary_file =
      prepare_private_json_temporary_record(expanded, record)
    rename_exclusive_no_follow!(temporary_path, expanded, label)
    published = true
    verify_private_record_path_identity!(expanded, temporary_file, label)
    fsync_parent_directory!(expanded)
    temporary_file
  rescue
    temporary_file&.flock(File::LOCK_UN)
    temporary_file&.close
    raise
  ensure
    FileUtils.rm_f(temporary_path) if temporary_path && !published
  end
end

def rename_replace_no_follow!(source, destination, label)
  flags = DemoLabDarwin::RENAME_NOFOLLOW_ANY
  return if DemoLabDarwin.renamex_np(source, destination, flags).zero?

  UI.user_error!("Unable to atomically replace #{label} safely.")
end

def replace_locked_private_json_record!(path, current_file, record, label)
  expanded = File.expand_path(path)
  reject_repository_path!(expanded, label)
  private_directory_identity!(File.dirname(expanded), "#{label} parent")
  verify_private_record_path_identity!(expanded, current_file, label)
  temporary_path = nil
  temporary_file = nil
  published = false
  begin
    temporary_path, temporary_file =
      prepare_private_json_temporary_record(expanded, record)
    verify_private_record_path_identity!(expanded, current_file, label)
    rename_replace_no_follow!(temporary_path, expanded, label)
    published = true
    verify_private_record_path_identity!(expanded, temporary_file, label)
    fsync_parent_directory!(expanded)
    temporary_file
  rescue
    temporary_file&.flock(File::LOCK_UN)
    temporary_file&.close
    raise
  ensure
    FileUtils.rm_f(temporary_path) if temporary_path && !published
  end
end

def fsync_parent_directory!(path)
  parent = File.dirname(path)
  flags = File::RDONLY
  flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
  File.open(parent, flags) do |directory|
    stat = directory.stat
    UI.user_error!("DemoLab record parent is not a directory.") unless stat.directory?
    directory.fsync
  end
rescue Errno::EACCES, Errno::ELOOP, Errno::ENOENT
  UI.user_error!("Unable to make the DemoLab record directory entry durable.")
end

def with_locked_private_record(path, maximum_size, label)
  expanded = File.expand_path(path)
  reject_repository_path!(expanded, label)
  flags = File::RDWR | File::NONBLOCK
  flags |= File::NOFOLLOW if defined?(File::NOFOLLOW)
  File.open(expanded, flags) do |file|
    unless file.flock(File::LOCK_EX | File::LOCK_NB)
      UI.user_error!("#{label} is still in use by another upload process.")
    end
    opened = file.stat
    unless opened.file? &&
           opened.uid == Process.uid &&
           (opened.mode & 0o077).zero? &&
           opened.size.positive? &&
           opened.size <= maximum_size
      UI.user_error!("#{label} is not a bounded private regular file.")
    end

    resolved = ensure_outside_repository!(expanded, label)
    resolved_stat = File.stat(resolved)
    path_stat = File.lstat(expanded)
    unless !path_stat.symlink? &&
           resolved_stat.dev == opened.dev &&
           resolved_stat.ino == opened.ino &&
           path_stat.dev == opened.dev &&
           path_stat.ino == opened.ino
      UI.user_error!("#{label} path changed during validation.")
    end

    content = file.read(maximum_size + 1)
    after = file.stat
    unless content.bytesize == opened.size &&
           content.bytesize <= maximum_size &&
           opened.dev == after.dev &&
           opened.ino == after.ino &&
           opened.size == after.size
      UI.user_error!("#{label} changed while it was being read.")
    end
    file.rewind
    yield file, content
  ensure
    file.flock(File::LOCK_UN)
  end
rescue Errno::EACCES,
       Errno::EAGAIN,
       Errno::ELOOP,
       Errno::ENODEV,
       Errno::ENOENT,
       Errno::ENXIO
  UI.user_error!("Unable to lock and snapshot #{label} safely.")
end

def validate_reconcilable_upload_result!(record, evidence)
  unless record.is_a?(Hash)
    UI.user_error!("Indeterminate upload result must be a JSON object.")
  end
  common_keys = %w[
    schema_version
    source_commit
    ipa_sha256
    attempt_started_at
    destination
    external_distribution
    status
    note
  ]
  expected_keys =
    if record["status"] == "reconciled_absent"
      common_keys + %w[reconciled_at reconciliation]
    else
      common_keys
    end
  require_exact_hash_keys!(
    record,
    expected_keys,
    "Indeterminate upload result"
  )

  unless record["schema_version"] == 1 &&
         record["source_commit"] == evidence.dig("source", "commit") &&
         record["ipa_sha256"] == evidence.dig(
           "artifacts",
           "ipa",
           "sha256"
         ) &&
         valid_utc_timestamp?(record["attempt_started_at"]) &&
         record["destination"] == "TestFlight internal preparation" &&
         record["external_distribution"] == false
    UI.user_error!("Indeterminate upload result does not match this evidence.")
  end

  case record["status"]
  when "indeterminate"
    unless record["note"] == DEMO_LAB_UPLOAD_INDETERMINATE_NOTE
      UI.user_error!("Indeterminate upload result has an unexpected note.")
    end
  when "reconciled_absent"
    unless valid_utc_timestamp?(record["reconciled_at"]) &&
           record["reconciliation"] ==
             "operator_confirmed_absent_in_app_store_connect" &&
           record["note"] == DEMO_LAB_RECONCILED_ABSENT_NOTE
      UI.user_error!("Reconciled upload result is incomplete.")
    end
  else
    UI.user_error!("Only an indeterminate upload result can be reconciled.")
  end
  record
end

def reconcile_indeterminate_upload_result!(
  result_path,
  evidence,
  expected_attempt_started_at:
)
  archive_path = File.join(
    File.dirname(result_path),
    "demolab-upload-result-reconciled-#{SecureRandom.hex(12)}.json"
  )
  reconciled_record = nil
  replacement_file = nil
  with_locked_private_record(
    result_path,
    DEMO_LAB_MAX_UPLOAD_RESULT_BYTES,
    "Indeterminate DemoLab upload result"
  ) do |file, content|
    begin
      record = JSON.parse(content)
    rescue JSON::ParserError
      UI.user_error!("Indeterminate upload result is not valid JSON.")
    end
    validate_reconcilable_upload_result!(record, evidence)
    unless record["attempt_started_at"] == expected_attempt_started_at
      UI.user_error!(
        "The reconciled attempt timestamp does not match the current result."
      )
    end

    if record["status"] == "indeterminate"
      record = record.merge(
        "status" => "reconciled_absent",
        "reconciled_at" => Time.now.utc.iso8601,
        "reconciliation" =>
          "operator_confirmed_absent_in_app_store_connect",
        "note" => DEMO_LAB_RECONCILED_ABSENT_NOTE
      )
      replacement_file = replace_locked_private_json_record!(
        result_path,
        file,
        record,
        "reconciled upload result"
      )
    end
    reconciled_record = validate_reconcilable_upload_result!(record, evidence)

    current = File.lstat(result_path)
    held = (replacement_file || file).stat
    unless !current.symlink? &&
           current.dev == held.dev &&
           current.ino == held.ino
      UI.user_error!("Upload result path changed before reconciliation.")
    end
    rename_exclusive_no_follow!(
      result_path,
      archive_path,
      "reconciled upload result"
    )
    archived = File.lstat(archive_path)
    unless archived.file? &&
           !archived.symlink? &&
           archived.dev == held.dev &&
           archived.ino == held.ino
      UI.user_error!("Reconciled upload result publication changed identity.")
    end
    fsync_parent_directory!(archive_path)
  end
  [archive_path, reconciled_record]
ensure
  replacement_file&.flock(File::LOCK_UN)
  replacement_file&.close
end

default_platform(:ios)

platform :ios do
  desc "Build the unsigned DemoLab simulator fixture without Apple credentials"
  lane :demolab_check do
    xcode_toolchain = selected_xcode_toolchain
    parser_commit = git_command_output("rev-parse", "HEAD")
    [parser_commit, "a" * 40, "b" * 64].uniq.each do |candidate_oid|
      parsed_reviewed_main = parse_reviewed_github_main_ref!(
        "#{candidate_oid}\t#{DEMO_LAB_REVIEWED_GITHUB_MAIN_REF}\n"
      )
      unless parsed_reviewed_main == candidate_oid
        UI.user_error!("The authenticated GitHub main parser changed its OID.")
      end
    end
    [
      "#{parser_commit}\trefs/remotes/origin/main\n",
      "#{parser_commit}\t#{DEMO_LAB_REVIEWED_GITHUB_MAIN_REF}\n" \
        "#{"0" * 40}\t#{DEMO_LAB_REVIEWED_GITHUB_MAIN_REF}\n",
      "not-an-object\t#{DEMO_LAB_REVIEWED_GITHUB_MAIN_REF}\n",
    ].each do |ambiguous_output|
      ambiguous_ref_rejected = false
      begin
        parse_reviewed_github_main_ref!(ambiguous_output)
      rescue FastlaneCore::Interface::FastlaneError
        ambiguous_ref_rejected = true
      end
      unless ambiguous_ref_rejected
        UI.user_error!("An ambiguous GitHub main reference was accepted.")
      end
    end
    unless lab002_oracle_publication_indeterminate?(
      "#{DEMO_LAB_LAB002_ORACLE_INDETERMINATE_MARKER} must be reconciled"
    ) &&
           !lab002_oracle_publication_indeterminate?(
             "prefix #{DEMO_LAB_LAB002_ORACLE_INDETERMINATE_MARKER}"
           ) &&
           !lab002_oracle_publication_indeterminate?(
             DEMO_LAB_LAB002_ORACLE_INDETERMINATE_MARKER.delete_prefix("error: ")
           )
      UI.user_error!("LAB-002 indeterminate oracle marker parsing is invalid.")
    end
    Dir.mktmpdir(
      "orchardprobe-lab002-oracle-retention-check-",
      external_temporary_base
    ) do |retention_root|
      retained_staging = File.join(retention_root, "staging")
      Dir.mkdir(retained_staging, 0o700)
      retained_file = File.join(retained_staging, "retained-private-state")
      File.write(retained_file, "private")
      cleanup_unpublished_demolab_staging!(
        retained_staging,
        published: false,
        retain_staging: true
      )
      unless File.read(retained_file) == "private"
        UI.user_error!("Indeterminate LAB-002 staging was not retained.")
      end
      cleanup_unpublished_demolab_staging!(
        retained_staging,
        published: false,
        retain_staging: false
      )
      if File.exist?(retained_staging) || File.symlink?(retained_staging)
        UI.user_error!("Ordinary unpublished DemoLab staging was not cleaned.")
      end
      retained_directory = File.open(retention_root, File::RDONLY)
      unless retained_demolab_staging_names!(retained_directory).empty?
        UI.user_error!("Empty retained staging inventory was not recognized.")
      end
      retained_name = ".demolab-staging-retained-test"
      Dir.mkdir(File.join(retention_root, retained_name), 0o700)
      unless retained_demolab_staging_names!(retained_directory) == [retained_name]
        UI.user_error!("Retained DemoLab staging was not detected.")
      end
      retained_directory.close
    end
    %w[
      none
      ipa
      archive
      archive_root
      oracle
      evidence
      extra
      marker_conflict
      post_publish_ipa
    ].each do |replacement|
      Dir.mktmpdir(
        "orchardprobe-lab002-final-staging-check-",
        external_temporary_base
      ) do |container|
        staging_directory = File.join(container, "staging")
        Dir.mkdir(staging_directory, 0o700)
        staging_identity = private_directory_identity!(
          staging_directory,
          "Final staging regression directory"
        )
        archive_path = File.join(staging_directory, "DemoLab.xcarchive")
        Dir.mkdir(archive_path, 0o700)
        archive_files =
          DEMO_LAB_LAB002_ARCHIVE_SOURCE_SPECS.each_with_index.map do |specification, index|
            path = File.join(
              archive_path,
              "Products",
              "Applications",
              specification.fetch("relative_path")
            )
            FileUtils.mkdir_p(File.dirname(path), mode: 0o700)
            content = "archive-source-#{index}"
            File.write(path, content)
            File.chmod(0o400, path)
            {
              "relative_path" => specification.fetch("relative_path"),
              "size" => content.bytesize,
              "sha256" => Digest::SHA256.hexdigest(content),
            }
          end
        ipa_path = File.join(staging_directory, "DemoLab-3.ipa")
        evidence_path = File.join(
          staging_directory,
          "demolab-pre-upload-evidence.json"
        )
        oracle_path = File.join(
          staging_directory,
          DEMO_LAB_LAB002_ORACLE_NAME
        )
        {
          ipa_path => "ipa-bytes",
          evidence_path => "evidence-bytes",
          oracle_path => "oracle-bytes",
        }.each do |path, content|
          File.write(path, content)
          File.chmod(0o400, path)
        end

        archive_app_path = File.join(
          archive_path,
          "Products",
          "Applications",
          "DemoLab.app"
        )
        archive_app_stat = File.lstat(archive_app_path)
        evidence_identity = nil
        oracle_identity = nil
        with_locked_private_directory(
          staging_directory,
          staging_identity,
          "Final staging regression directory"
        ) do |staging_handle|
          evidence_identity = stable_staged_file_identity!(
            evidence_path,
            staging_directory,
            DEMO_LAB_MAX_UPLOAD_RESULT_BYTES,
            "Regression evidence"
          )
          oracle_identity = lab002_published_artifact_identity!(
            staging_handle,
            DEMO_LAB_LAB002_ORACLE_NAME,
            allowed_names: [DEMO_LAB_LAB002_ORACLE_NAME]
          )
        end
        oracle_result = {
          "oracle_name" => DEMO_LAB_LAB002_ORACLE_NAME,
          "archive_app_device" => archive_app_stat.dev.to_s,
          "archive_app_inode" => archive_app_stat.ino.to_s,
          "oracle_device" => oracle_identity.fetch("device").to_s,
          "oracle_inode" => oracle_identity.fetch("inode").to_s,
          "oracle_mode" => oracle_identity.fetch("mode"),
          "oracle_size" => oracle_identity.fetch("size"),
          "oracle_sha256" => oracle_identity.fetch("sha256"),
          "ipa_size" => File.size(ipa_path),
          "ipa_sha256" => Digest::SHA256.file(ipa_path).hexdigest,
          "archive_files" => archive_files,
        }

        replaced_path =
          case replacement
          when "ipa"
            ipa_path
          when "archive"
            File.join(
              archive_path,
              "Products",
              "Applications",
              archive_files.first.fetch("relative_path")
            )
          when "oracle"
            oracle_path
          when "evidence"
            evidence_path
          end
        if replaced_path
          File.rename(
            replaced_path,
            File.join(container, "replaced-#{replacement}")
          )
          File.write(replaced_path, "substituted-#{replacement}")
          File.chmod(0o400, replaced_path)
        elsif replacement == "archive_root"
          displaced_app = File.join(container, "replaced-archive-app")
          File.rename(archive_app_path, displaced_app)
          FileUtils.cp_r(displaced_app, archive_app_path, preserve: true)
        elsif replacement == "extra"
          File.write(
            File.join(staging_directory, "unexpected-artifact"),
            "unexpected"
          )
        end

        output_identity = private_directory_identity!(
          container,
          "Final staging regression output root"
        )
        run_directory = File.join(container, "published")
        conflicting_marker_path = nil
        if replacement == "marker_conflict"
          conflicting_marker_path =
            lab002_indeterminate_publication_marker_path(
              container,
              run_directory
            )
          File.write(conflicting_marker_path, "existing-retry-gate")
          File.chmod(0o400, conflicting_marker_path)
        end
        publication_changed = false
        substitution_rejected = false
        with_locked_private_directory(
          container,
          output_identity,
          "Final staging regression output root"
        ) do |output_handle|
          with_locked_private_directory(
            staging_directory,
            staging_identity,
            "Final staging regression directory"
          ) do |staging_handle|
            begin
              publish_verified_lab002_staged_run!(
                output_handle: output_handle,
                output_root: container,
                output_identity: output_identity,
                run_directory: run_directory,
                staging_handle: staging_handle,
                staging_directory: staging_directory,
                staging_identity: staging_identity,
                archive_path: archive_path,
                ipa_path: ipa_path,
                evidence_path: evidence_path,
                evidence_identity: evidence_identity,
                oracle_result: oracle_result,
                on_publication_change: lambda do
                  publication_changed = true
                  if replacement == "post_publish_ipa"
                    published_ipa = File.join(
                      run_directory,
                      File.basename(ipa_path)
                    )
                    File.rename(
                      published_ipa,
                      File.join(container, "replaced-post-publish-ipa")
                    )
                    File.write(published_ipa, "substituted-post-publish-ipa")
                    File.chmod(0o400, published_ipa)
                  end
                end
              )
            rescue FastlaneCore::Interface::FastlaneError
              substitution_rejected = true
            end
          end
        end
        if replacement == "none"
          unless publication_changed &&
                 !substitution_rejected &&
                 File.directory?(run_directory) &&
                 !File.exist?(staging_directory)
            UI.user_error!("A valid final staging run was not published.")
          end
        elsif replacement == "marker_conflict"
          unless substitution_rejected &&
                 !publication_changed &&
                 File.directory?(staging_directory) &&
                 !File.exist?(run_directory) &&
                 File.file?(conflicting_marker_path)
            UI.user_error!(
              "A failed publication-gate reservation allowed publication."
            )
          end
        elsif replacement == "post_publish_ipa"
          marker_path = lab002_indeterminate_publication_marker_path(
            container,
            run_directory
          )
          marker_name = File.basename(marker_path)
          retained_names = File.open(container, File::RDONLY) do |root_handle|
            retained_demolab_staging_names!(root_handle)
          end
          unless substitution_rejected &&
                 publication_changed &&
                 File.directory?(run_directory) &&
                 File.file?(marker_path) &&
                 retained_names == [marker_name]
            UI.user_error!(
              "A post-publication substitution lacked an indeterminate marker."
            )
          end
        elsif !substitution_rejected ||
              publication_changed ||
              File.exist?(run_directory)
          UI.user_error!(
            "A #{replacement} final-staging substitution was accepted."
          )
        end
      end
    end
    trusted_toolchain_name, trusted_sources =
      DEMO_LAB_TRUSTED_LAB002_PRIVATE_TOOLS.first
    trusted_source_sha256, trusted_products = trusted_sources.first
    trusted_product = trusted_products.first
    trusted_identity = [
      0,
      0,
      trusted_product.fetch("size"),
      trusted_product.fetch("sha256"),
      trusted_product.fetch("cdhash"),
    ]
    verify_trusted_lab002_private_tool!(
      trusted_identity,
      trusted_source_sha256,
      trusted_toolchain_name
    )
    substituted_product_rejected = false
    begin
      substituted_identity = trusted_identity.dup
      substituted_identity[3] = "0" * 64
      verify_trusted_lab002_private_tool!(
        substituted_identity,
        trusted_source_sha256,
        trusted_toolchain_name
      )
    rescue FastlaneCore::Interface::FastlaneError
      substituted_product_rejected = true
    end
    unless substituted_product_rejected
      UI.user_error!(
        "A non-reviewed LAB-002 helper product passed the allowlist."
      )
    end
    oracle_source_fixture = {
      "ipa_size" => 4096,
      "ipa_sha256" => "1" * 64,
      "archive_files" =>
        DEMO_LAB_LAB002_ARCHIVE_SOURCE_SPECS.each_with_index.map do |specification, index|
          {
            "relative_path" => specification.fetch("relative_path"),
            "size" => index + 1,
            "sha256" => (index + 2).to_s * 64,
          }
        end,
    }
    packaged_source_fixture = {
      "archive" => {
        "size" => oracle_source_fixture.fetch("ipa_size"),
        "sha256" => oracle_source_fixture.fetch("ipa_sha256"),
      },
    }
    archive_source_fixture = oracle_source_fixture.fetch("archive_files")
    verify_lab002_oracle_evidence_sources!(
      oracle_source_fixture,
      packaged_source_fixture,
      archive_source_fixture
    )
    [
      [
        {
          "archive" => packaged_source_fixture.fetch("archive").merge(
            "sha256" => "0" * 64
          ),
        },
        archive_source_fixture,
      ],
