      expected_identifiers = {
        File.join(application, "Info.plist") => "com.example.orchardprobe.demolab",
        File.join(
          application,
          "Frameworks",
          "DemoFramework.framework",
          "Info.plist"
        ) => "com.example.orchardprobe.demolab.framework",
        File.join(
          application,
          "PlugIns",
          "DemoShareExtension.appex",
          "Info.plist"
        ) => "com.example.orchardprobe.demolab.share",
      }
      expected_identifiers.each do |plist, expected_identifier|
